# Caddyfile 최상위에는 3가지 형태의 블록 가능
# 1. 글로벌 옵션 블록
# Caddy 전체 서버 설정 (반드시 파일 최상단에 괄호 없이 { }로 위치)
# {
#   admin off
#   email admin@example.com
# }
#
# 2. 스니펫 정의 (Snippets)
# 재사용할 공통 모듈 (괄호 필수)
# (custom_tls) {
#   tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
# }
#
# 3. 사이트 주소 블록 (Site Blocks)
# 실제 도메인, IP, 포트, 스킴 등 요청을 받는 엔드포인트
# gerrit.jwlee.lan {
#   import custom_tls
#   reverse_proxy gerrit_app:8080
# }
#
# 사이트 주소 블록 지정 방식
# 프로토콜 / 도메인 / 포트 조합으로 블록을 지정할 수 있음.
# 하위 도메인에 와일드카드(*)를 사용할 수 있음. 예: *.example.com
# path를 사이트 주소에 포함하여 지정 불가
# path 기반 분기는 블록 내부에서 handle_path, path 매처 등을 사용할 것

# 프로토콜만 지정
# https:// { ... }
# http:// { ... }

# 프로토콜 + 도메인 지정
# https://example.com { ... }
# http://example.com { ... }

# 도메인만 지정
# example.com { ... }

# 포트 포함
# example.com:8080 { ... }
# :8080 { ... }

# 프로토콜 + 도메인 + 포트 지정
# https://example.com:8080 { ... }

# path, handle, handle_path 에 대해서
# path (matcher)
# 조건문에서 요청 URL 경로를 검사하는 매칭 조건, 단독 로직 실행은 불가하고
# handle, reverse_proxy 같은 지시자의 조건으로 쓰임

# handle (routing directive)
# 배타적인 조건 분기 블록을 만든다. 여러 handle 중 가장 먼저 매칭된 하나만 실행
# 요청 경로를 원본 그대로 백엔드 서버로 전달
# 예: handle /api/* { reverse_proxy app:8000 } → 백엔드에 /api/users 경로가 그대로 들어감.

# handle_path (routing directive + 경로 제거)
# handle과 동일하게 동작하되, 매칭된 경로 prefix를 제거(strip)하고 백엔드 서버로 전달
# 예: handle_path /api/* { reverse_proxy app:8000 } → 백엔드에는 /api가 제거된 /users 경로만 들어감.

# 지시자(directives)들은 기본적으로
# 지시자(directives) + 인자(argument/matchers) + { block } 구조로 이루어져 있음.


(custom_tls) {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
}

kroki.jwlee.priv {
	import custom_tls
	reverse_proxy kroki:8000
}

gerrit.jwlee.lan, gerrit.jwlee.priv {
	import custom_tls
	reverse_proxy gerrit_app:8080
}

ws.jwlee.priv {
	import custom_tls
	reverse_proxy https://host.docker.internal:8910 {
		transport http {
			tls_trust_pool file /etc/caddy/root-certs/rootCA.pem
		}
	}
}

nest.jwlee.priv {
	@cats {
		path /cats
		path /cats/*
	}
	handle @cats {
		# 호스트 OS의 8181 포트로 요청을 전달
		reverse_proxy host.docker.internal:8181
	}
}
