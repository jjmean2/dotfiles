#!/usr/bin/env bash
# worktree-handoff — 브랜치 워크트리에서 새 세션(Claude Code 또는 Cursor CLI)을 연다.
#                    세션에 다시 들어가는 명령을 출력하고 끝낸다. tmux 는 필요 없다 (있으면 윈도우까지 열어 준다).
#                    워크트리는 branch-worktree 가 확보한다 (찾기·만들기·스택 워크트리 규칙은 branch-worktree --help).
#
#   worktree-handoff fork  --session <id> [--prompt-file <파일|->] [--base <ref>] [--open <방식>]                  [<스택>] <브랜치>
#   worktree-handoff fresh --prompt-file <파일|->                  [--base <ref>] [--open <방식>] [--agent <도구>] [<스택>] <브랜치>
#   <스택> = --in-stack | --new-worktree.  --base 와 <스택> 은 branch-worktree ensure 에 그대로 넘긴다
#
# 동작
#   fork   지금 대화를 포크한 세션. Claude 세션만 된다
#          --session 이 없으면 $CLAUDE_CODE_SESSION_ID (Claude Code 가 Bash 도구 셸에 넣어 주는 지금 세션의 ID).
#          --prompt-file 이 없으면 기본 첫 메시지를 쓴다
#   fresh  대화 없는 새 세션. 첫 메시지가 꼭 있어야 한다
#   --prompt-file - 이면 첫 메시지를 표준 입력에서 읽는다
#
# 세션을 여는 도구 (--agent, 기본 claude). 도구마다 다른 것은 이 표가 전부다
#             실행                                             fork  bg     세션 이름             resume: 줄
#   claude    claude [--resume <id> --fork-session] -n <이름>  됨    됨     <브랜치>@<MMDD-HHMM>  claude --resume <이름>
#   cursor    agent (없으면 옛 이름 cursor-agent)              안 됨 안 됨  붙일 수 없다          agent resume (그 워크트리의 최근 세션)
#   둘 다 첫 메시지는 -- "<첫 메시지>" 로 넘긴다. 부른 곳이 어느 도구인지는 짐작하지 않는다.
#   cursor 에서 안 되는 까닭: CLI 에 대화를 포크하는 옵션이 없고, agent persist 는 터미널이 있어야 해서 스크립트가 띄울 수 없다
#
# 세션을 띄우는 방식 (--open)
#   auto   $TMUX 가 있으면 tmux, 없으면 bg, bg 가 안 되는 도구면 none (기본)
#   bg     워크트리에서 claude --bg 로 백그라운드 세션을 띄운다. claude attach <이름> 으로 들어간다.
#          안 되는 도구면 --open bg 는 거절하고, 설정에서 온 open=bg 는 auto 로 바꿔 띄운다
#   tmux   호출한 패널의 tmux 세션에 윈도우(그 워크트리의 윈도우가 있으면 패널)를 -d 로 열고 그 안에서 실행한다
#   none   띄우지 않고 실행할 명령만 출력한다
#
# 하는 순서: 확인 → 첫 메시지 읽기 → 워크트리 확보 → 런처 쓰기 → 띄우기 → 안내
#   확인은 아무것도 바꾸지 않는다. 워크트리를 확보하기 전에 실패하면 남기는 것이 없다.
#   그 뒤에 띄우다 실패하면 worktree: 와 run: 줄을 출력하고 종료 코드 1 로 끝난다 (run: 줄을 터미널에서 실행하면 된다)
#
# 설정: ${XDG_CONFIG_HOME:-~/.config}/worktree-handoff/config 의 key=value (# 주석). 환경 변수가 먼저다
#   open=auto|bg|tmux|none WORKTREE_HANDOFF_OPEN   기본 auto
#   agent=claude|cursor   WORKTREE_HANDOFF_AGENT   기본 claude
#   (root·create 는 branch-worktree 가 읽는다)
set -euo pipefail

die() { echo "worktree-handoff: $*" >&2; exit 1; }
note() { echo "worktree-handoff: $*" >&2; }
usage() { sed -n '2,/^set -euo/{/^set -euo/d;p;}' "$0" | sed 's/^# \{0,1\}//'; }
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/worktree-handoff
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/worktree-handoff/config

# 설정 파일은 실행하지 않고 key=value 만 읽는다. 값 양끝의 따옴표는 벗긴다 (branch-worktree 의 conf 와 같다)
conf() {   # conf <키>
  [ -f "$CONFIG" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONFIG" | tail -n 1 |
    sed -e 's/[[:space:]]*$//' -e "s/^\"\(.*\)\"$/\1/" -e "s/^'\(.*\)'$/\1/"
}
sq() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }   # 작은따옴표 인용: sh·bash·zsh·fish 모두 같은 뜻

# === 도구 어댑터 ================================================================
# 도구마다 다른 것은 이 절이 전부다. 아래 본문은 도구 이름을 모르고 여기서 정한 변수만 본다.
#
#   agent_<도구> caps      할 수 있는 것. 아무것도 바꾸지 않는다
#       cli         실행 파일                  cli_label   오류 메시지에 쓸 이름
#       no_fork     fork 를 못 하는 까닭 (비어 있으면 된다)
#       no_bg       bg 로 못 띄우는 까닭 (비어 있으면 된다)      bg_flag  bg 로 띄울 때 런처에 줄 옵션
#       sid         fork 할 세션 ID 의 기본값 (--session 이 없을 때)
#   agent_<도구> commands  $mode·$sid·$name·$pf 가 정해진 뒤에 부른다
#       pre_line    런처에서 실행 줄 앞에 둘 줄 (없으면 빈 값). 있으면 bg 는 분리해서 띄운다
#       exec_note   런처에 남길 주석            exec_line   런처의 실행 줄. "$@" 에 띄우는 쪽의 옵션이 들어간다
#       session     출력의 session: 값          resume_cmd  다시 여는 명령
#       attach_cmd  bg 세션에 붙는 명령
agent_claude() {
  case $1 in
    caps)
      cli=claude; cli_label=claude; no_fork=""; no_bg=""; bg_flag=--bg
      sid=${sid:-${CLAUDE_CODE_SESSION_ID:-}} ;;
    commands)
      local resume=""
      pre_line=""
      if [ "$mode" = fork ]; then
        # 스킬에서 불렸을 때 원본 세션의 Bash 호출 결과가 기록에 써질 때까지 기다린다
        pre_line="sleep 2"; resume="--resume $sid --fork-session "
      fi
      exec_note="# -n: claude --resume <세션 이름> 으로 바로 열고, /resume 피커에서 브랜치로 찾게. -- : 첫 메시지가 - 로 시작해도 옵션으로 읽히지 않게"
      exec_line="exec claude \"\$@\" ${resume}-n $(sq "$name") -- \"\$(cat $(sq "$pf"))\""
      session=$name
      resume_cmd="claude --resume $(sq "$name")"
      attach_cmd="claude attach $(sq "$name")" ;;
  esac
}
agent_cursor() {
  case $1 in
    caps)
      # 지금 이름은 agent, 옛 이름은 cursor-agent. agent 가 없을 때만 옛 이름을 쓴다
      cli=agent; cli_label="Cursor CLI(agent)"
      if ! command -v agent >/dev/null && command -v cursor-agent >/dev/null; then cli=cursor-agent; fi
      no_fork="Cursor CLI 에는 대화를 포크하는 옵션이 없습니다. fresh 로 넘기세요 (Claude 세션을 포크하려면 --agent claude)"
      no_bg="agent persist 는 터미널이 있어야 해서 스크립트가 띄울 수 없습니다"; bg_flag="" ;;
    commands)
      # 세션 이름 옵션이 없다. -- 가 없으면 - 로 시작하는 첫 메시지를 옵션으로 읽고 "unknown option" 으로 끝난다
      pre_line=""
      exec_note="# -- : 첫 메시지가 - 로 시작해도 옵션으로 읽히지 않게"
      exec_line="exec $cli \"\$@\" -- \"\$(cat $(sq "$pf"))\""
      session="Cursor CLI (이름 없음)"
      resume_cmd="$cli resume"   # 그 워크트리의 가장 최근 세션. 고르려면 $cli ls
      attach_cmd="" ;;
  esac
}

# === 인자와 설정 ================================================================
open=${WORKTREE_HANDOFF_OPEN:-$(conf open)}; open=${open:-auto}
agent=${WORKTREE_HANDOFF_AGENT:-$(conf agent)}; agent=${agent:-claude}
case ${1:-} in
  fork|fresh) mode=$1; shift ;;
  -h|--help) usage; exit 0 ;;
  "") usage >&2; exit 1 ;;
  *) die "동작을 먼저 주세요: fork | fresh (받은 것: $1)" ;;
esac
sid=""; base=""; prompt_file=""; branch=""; stack_mode=""
open_arg=""   # --open 을 명령줄에서 받았는가 (도구가 못 하는 방식이면 명령줄 값은 거절하고 설정 값은 auto 로 바꾼다)
while [ $# -gt 0 ]; do
  case $1 in --session|--base|--prompt-file|--open|--agent) [ $# -ge 2 ] || die "$1 에 값이 없습니다" ;; esac
  case $1 in   # macOS 기본 bash 3.2 에서도 돌게 ;;& 는 쓰지 않는다
    --session) sid=$2; shift 2 ;;
    --base) base=$2; shift 2 ;;
    --prompt-file) prompt_file=$2; shift 2 ;;
    --open) open=$2; open_arg=1; shift 2 ;;
    --agent) agent=$2; shift 2 ;;
    --in-stack|--new-worktree)
      [ -z "$stack_mode" ] || [ "$stack_mode" = "$1" ] || die "--in-stack 과 --new-worktree 는 함께 쓸 수 없습니다"
      stack_mode=$1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; branch=${1:-}; break ;;
    -*) die "unknown option: $1" ;;
    *) [ -z "$branch" ] || die "브랜치는 하나만: $branch, $1"; branch=$1; shift ;;
  esac
done
[ -n "$branch" ] || die "브랜치 이름을 주세요"
case $open in auto|bg|tmux|none) ;; *) die "--open 은 auto | bg | tmux | none 중 하나입니다: $open" ;; esac
case $agent in claude|cursor) ;; *) die "--agent 는 claude | cursor 중 하나입니다: $agent" ;; esac

# === 확인: 아무것도 바꾸지 않는다 ================================================
"agent_$agent" caps
[ "$mode" != fork ] || [ -z "$no_fork" ] || die "$no_fork"
case $mode in
  fork)
    [ -n "$sid" ] || die "세션 ID 를 주세요 (--session <id>)"
    [[ $sid =~ ^[A-Za-z0-9-]+$ ]] || die "세션 ID 형식이 아닙니다: $sid" ;;
  fresh) [ -n "$prompt_file" ] || die "fresh 에는 첫 메시지가 필요합니다 (--prompt-file <파일|->)" ;;
esac
if [ "$open" = bg ] && [ -n "$no_bg" ]; then
  [ -z "$open_arg" ] || die "$agent 세션은 bg 로 띄울 수 없습니다 ($no_bg). --open tmux 나 none 을 쓰세요"
  note "설정의 open=bg 는 $agent 세션에 쓸 수 없어 auto 로 띄웁니다"
  open=auto
fi
if [ "$open" = auto ]; then
  if [ -n "${TMUX:-}" ]; then open=tmux
  elif [ -z "$no_bg" ]; then open=bg
  else open=none
  fi
fi
[ "$open" != tmux ] || [ -n "${TMUX:-}" ] || die "--open tmux 는 tmux 안에서만 됩니다 (bg 나 none 을 쓰세요)"
[ "$open" = none ] || command -v "$cli" >/dev/null || die "$cli_label 가 PATH 에 없습니다"
git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "브랜치 이름으로 쓸 수 없습니다: $branch"
if [ -n "$prompt_file" ] && [ "$prompt_file" != - ]; then
  [ -r "$prompt_file" ] && [ ! -d "$prompt_file" ] || die "프롬프트 파일을 읽을 수 없습니다: $prompt_file"
fi
# 워크트리를 확보해 줄 branch-worktree: 이 스크립트 옆에 있다. 없으면 PATH 에서 찾는다
bw="$(cd "$(dirname "$0")" && pwd)/branch-worktree"
[ -x "$bw" ] || bw=$(command -v branch-worktree || true)
[ -n "$bw" ] || die "branch-worktree 를 찾지 못했습니다 (worktree-handoff 와 같은 디렉토리에 있어야 합니다)"
here=$(git rev-parse --show-toplevel 2>/dev/null || true)   # 이 세션이 있는 체크아웃

# === 첫 메시지 읽기 ==============================================================
# 워크트리보다 먼저 읽어서, 비어 있으면 아무것도 만들지 않고 끝낸다. 세션은 나중에 이 파일을 읽으므로, 연달아 불려도
# 덮어쓰지 않게 호출마다 새 파일로 둔다. 워크트리를 확보하기 전에 실패하면 지운다
mkdir -p "$STATE/prompt"
find "$STATE/prompt" -type f -mtime +7 -delete 2>/dev/null || true
pf=$(mktemp "$STATE/prompt/${branch//\//-}.XXXXXX")
trap 'rm -f "$pf"' EXIT
if [ "$prompt_file" = - ]; then cat >"$pf"
elif [ -n "$prompt_file" ]; then cat -- "$prompt_file" >"$pf"
fi
# 공백뿐이면 빈 것으로 본다 (fork 는 기본 문구로, fresh 는 오류)
grep -q '[^[:space:]]' "$pf" || : >"$pf"
[ "$mode" != fresh ] || [ -s "$pf" ] || die "첫 메시지가 비어 있습니다"

# === 워크트리 확보 ================================================================
# branch-worktree 의 오류와 종료 코드는 그대로 내보낸다. 표준 입력은 위에서 다 읽었으니 넘기지 않는다
ensured=$("$bw" ensure ${base:+--base "$base"} ${stack_mode:+"$stack_mode"} -- "$branch" </dev/null) || exit $?
wt=$(sed -n 's/^worktree: //p' <<<"$ensured")
stack_cur=$(sed -n 's/^stack: //p' <<<"$ensured")
main=$(sed -n 's/^main: //p' <<<"$ensured")
[ -n "$wt" ] && [ -d "$wt" ] || die "branch-worktree 가 워크트리를 알려 주지 않았습니다"
# 한 작업 트리는 한 세션만 고친다. 이 세션이 있는 체크아웃으로는 넘기지 않는다 (이 경우 branch-worktree 는 만든 것이 없다)
if [ "$wt" = "$here" ]; then
  [ -z "$stack_cur" ] || die "$branch 를 품은 스택 워크트리가 지금 이 세션이 있는 체크아웃입니다. 같은 트리를 두 세션이 고치게 되므로 넘기지 않습니다"
  die "$branch 는 지금 이 세션이 있는 체크아웃입니다. 같은 트리를 두 세션이 고치게 되므로 넘기지 않습니다"
fi
trap - EXIT   # 여기부터는 워크트리가 있다. 실패해도 첫 메시지와 런처를 남겨 run: 줄로 이어 갈 수 있게 한다

# === 런처 쓰기 ====================================================================
if [ ! -s "$pf" ]; then   # 포크의 기본 첫 메시지
  stack_note() {
    [ -n "$stack_cur" ] || return 0
    echo "- 이 워크트리에는 $stack_cur 가 체크아웃돼 있고 $branch 는 그 아래에 쌓인 브랜치다. 체크아웃을 바꾸지 말고"
    echo "  $branch 의 커밋을 겨냥한 fixup 커밋을 만든 뒤 git -c sequence.editor=: rebase -i --autosquash --update-refs --keep-base <$branch 의 base>"
    echo "  로 스택 전체를 다시 쌓는다."
  }
  cat >"$pf" <<EOF
너는 원본 대화에서 포크된 구현 세션이다. 위 대화의 /handoff 지시와 "이 세션은 워크트리를 편집하지 않는다"는
원본 세션에 대한 것이다. 이 세션은 아래 워크트리에서 구현한다.
- 작업 디렉토리: $wt (브랜치 $branch)
- 메인 체크아웃($main)의 파일은 읽기만 하고 수정하지 않는다.
$(stack_note)
지금까지 합의한 범위를 짧게 요약한 뒤 시작해.
EOF
fi
# 세션 이름: 겹치지 않게 분 단위 시각을 붙인다 (이름으로 다시 열 때 정확히 하나만 일치해야 한다)
name="$branch@$(date +%m%d-%H%M)"
"agent_$agent" commands
# 어느 방식이든 같은 sh 런처를 돌린다. 사용자 셸(bash/zsh/fish …)의 문법에 기대지 않는다.
# 런처에 준 인자("$@")는 도구의 옵션 앞에 붙는다. 직접 돌리면 지금 터미널의 대화형 세션이 된다
cat >"$pf.sh" <<LAUNCHER
#!/bin/sh
$pre_line
# 셸 rc 가 디렉토리를 바꿔도 워크트리에서 시작하게
cd $(sq "$wt") || exit 1
$exec_note
$exec_line
LAUNCHER

# === 띄우기 ======================================================================
# 실패하면 failed 와 where 만 정하고 계속 간다. 아래 안내가 run: 줄을 내준다
where=""; failed=""
open_bg() {
  if [ -n "$pre_line" ]; then
    # 런처가 기다렸다 시작하므로, 그동안 이 스크립트(와 부른 쪽의 Bash 호출)가 먼저 끝나게 분리해서 돌린다. 실패는 로그로만 보인다.
    # setsid: 부른 쪽이 끝나며 프로세스 그룹을 정리해도 살아남게 (macOS 엔 없어 nohup 만)
    if command -v setsid >/dev/null; then setsid nohup sh "$pf.sh" $bg_flag >"$pf.log" 2>&1 </dev/null &
    else nohup sh "$pf.sh" $bg_flag >"$pf.log" 2>&1 </dev/null &
    fi
    where="background, 2초 뒤 시작 (실패하면 로그에 남는다: $pf.log)"
  elif sh "$pf.sh" $bg_flag >"$pf.log" 2>&1 </dev/null; then
    where="background"     # 띄우고 바로 돌아온다. 실패(작업 폴더 신뢰 등)를 여기서 알 수 있다
  else
    sed "s/^/$cli: /" "$pf.log" >&2
    failed=1; where="background 실패 (위 $cli: 줄). 아래 run: 줄을 터미널에서 직접 실행하세요"
  fi
}
# 그 워크트리의 윈도우를 패널의 경로로 찾는다: 그 워크트리가 주인인 패널이 있는 가장 앞 윈도우.
#   패널의 주인 = 현재 경로(pane_current_path)가 이 저장소의 워크트리 안이면 그 워크트리, 아니면 시작 경로(pane_start_path)의
#   워크트리. 겹치면 가장 깊은 것 (메인 체크아웃이 그 아래의 워크트리를 삼키지 않게). modal 패널(떠 있는 피커)은 뺀다.
# tmux-dev 의 prefix W 와 같은 규칙이다 (dotfiles 의 home/dot_config/tmux/plugins/tmux-dev/lib/panes.sh. 이 플러그인은 따로
# 배포되므로 그 파일을 읽지 않고 같은 규칙을 여기 둔다). 전에는 윈도우 옵션 @worktree 로 찾았는데, 그러면 prefix c 로 연 창은
# 못 찾고 break-pane·join-pane 으로 패널이 옮겨 가면 엉뚱한 창을 가리켰다.
wt_window() {  # $1 세션 → 그 워크트리($wt)의 윈도우 id (없으면 빈 줄)
  local us roots want win modal start cur owner
  us=$(printf '\037')
  roots=$(git -C "$wt" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  want=$(cd -P -- "$wt" 2>/dev/null && pwd) || want=$wt
  owner_of() {  # $1 경로 → owner (그 경로를 담는 가장 깊은 워크트리). 없으면 1
    local w; owner=""
    [ -n "$1" ] || return 1
    while IFS= read -r w; do
      [ -n "$w" ] || continue
      case $1 in "$w"|"$w"/*) [ "${#w}" -le "${#owner}" ] || owner=$w ;; esac
    done <<<"$roots"
    [ -n "$owner" ]
  }
  while IFS=$us read -r win modal start cur; do
    [ "$modal" != 1 ] || continue
    if ! owner_of "$cur"; then
      start=$(cd -P -- "$start" 2>/dev/null && pwd) || continue   # 시작 경로는 받은 그대로라 심볼릭 링크일 수 있다
      owner_of "$start" || continue
    fi
    [ "$owner" = "$want" ] || continue
    printf '%s\n' "$win"; return 0
  done < <(tmux list-panes -s -t "$1" -F "#{window_id}$us#{pane_modal_flag}$us#{pane_start_path}$us#{pane_current_path}" 2>/dev/null)
  return 0
}
open_tmux() {
  local sess wid pane="" wt_esc
  # 대상 세션은 호출한 패널의 세션. -t 없이 두면 tmux 가 "가장 최근 세션"을 골라 다른 저장소에 열 수 있다
  sess=$(tmux display -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{session_id}') || return 1
  # 그 워크트리의 윈도우가 이미 있으면 거기에 새 패널 (기존 패널에서 무엇이 돌지 모르므로 키를 보내지 않는다).
  # 없거나 자리가 없어 나눌 수 없으면 새 윈도우. 어느 쪽이든 -d 라 지금 보는 화면은 그대로다
  wid=$(wt_window "$sess") || return 1
  # -c 와 -n 은 tmux 형식 문자열로 해석된다. 경로·브랜치의 # 을 ## 로 (안 하면 fix/#H 같은 이름이 엉뚱한 디렉토리가 된다)
  fmt_esc() { printf %s "$1" | sed 's/#/##/g'; }
  wt_esc=$(fmt_esc "$wt")
  [ -z "$wid" ] || pane=$(tmux split-window -d -h -P -F '#{pane_id}' -t "$wid" -c "$wt_esc" 2>/dev/null) || pane=""
  if [ -z "$pane" ]; then
    pane=$(tmux new-window -d -P -F '#{pane_id}' -t "$sess:" -c "$wt_esc" -n "$(fmt_esc "$branch")") || return 1
    # 표지는 쓰기만 한다 (읽지 않는다). 경로로 찾기 전의 tmux-dev·이 플러그인이 이 윈도우를 그 워크트리의 것으로 알아보게
    tmux set -w -t "$pane" @worktree "$wt" || return 1
  fi
  # -l: 글자 그대로 입력 (키 이름으로 해석하지 않게). Enter 는 따로
  tmux send-keys -l -t "$pane" "sh $(sq "$pf.sh")" || return 1
  tmux send-keys -t "$pane" Enter || return 1
  where="tmux $(tmux display -p -t "$pane" '#S:#I (#W)')"
}
case $open in
  bg) open_bg ;;
  tmux) open_tmux || { failed=1; where="tmux 실패 (위 오류). 아래 run: 줄을 터미널에서 직접 실행하세요"; } ;;
  none) where="none (아래 run: 줄을 직접 실행)" ;;
esac

# === 안내 ========================================================================
echo "worktree: $wt"
echo "branch:   $branch${stack_cur:+ (스택 워크트리, 체크아웃: $stack_cur)}"
echo "session:  $session"
echo "open:     $where"
[ -n "$failed" ] || [ "$open" != bg ] || echo "attach:   $attach_cmd"
[ -z "$failed" ] && [ "$open" != none ] || echo "run:      sh $(sq "$pf.sh")"
echo "resume:   cd $(sq "$wt") && $resume_cmd"
[ -z "$failed" ]
