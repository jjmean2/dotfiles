#!/usr/bin/env bash
# worktree-handoff — 대화로 정한 작업을 어디서, 어떤 맥락으로 이어 갈지 정하고 준비한다.
#                    세션(Claude Code 또는 Cursor CLI)을 띄우거나, 들어가는 방법·입력할 줄을 출력하고 끝낸다.
#                    tmux 는 필요 없다 (있으면 윈도우까지 열어 준다). 워크트리는 branch-worktree 가 확보한다.
#
#   worktree-handoff plan  [--tmp <디렉토리>] [--base <ref>] [--open <방식>] (<브랜치> | --here)
#   worktree-handoff move                                   [--base <ref>]                  [<스택>] <브랜치>
#   worktree-handoff fork  [--session <id>] [--note <파일|->] [--base <ref>] [--open <방식>] [<스택>] <브랜치>
#   worktree-handoff fresh --brief <파일|-> [--start <시작>]  [--base <ref>] [--open <방식>] [<스택>] <브랜치>
#   worktree-handoff here  --brief <파일|-> [--start <시작>]  [--name <이전 대화 이름>]
#   모든 동작에: --agent <도구> (새 세션을 여는 도구), --from <도구> (지금 세션의 도구. 없으면 --agent 와 같다고 본다)
#   <스택> = --in-stack | --new-worktree (branch-worktree ensure 에 그대로 넘긴다),  <시작> = plan | build
#
# 방식
#   move   지금 세션을 그 브랜치의 워크트리로 옮긴다. 워크트리를 확보하고 들어가는 방법만 출력한다 (옮기는 것은 도구가 한다)
#   fork   지금 대화를 복사한 새 세션을 그 워크트리에 띄운다. 원본은 남는다
#          세션 ID 는 --session, 없으면 $CLAUDE_CODE_SESSION_ID (Claude Code 가 Bash 도구 셸에 넣어 준다)
#          첫 메시지는 스크립트가 쓰고 (포크된 세션이라는 것, 작업 디렉토리), --note 의 내용을 그 뒤에 붙인다
#   fresh  지시서 한 장으로 시작하는 새 세션을 그 워크트리에 띄운다. 원본은 남는다
#   here   지금 체크아웃에서 대화만 비우고 지시서로 다시 시작한다. 지시서를 완성하고 입력할 줄을 출력한다 (비우는 것은 사용자가 한다)
#   plan   읽기만 한다. 지금 체크아웃, 대상 워크트리, 방식마다 되는지·안 되면 대신 쓸 방식, 띄울 방식, 지시서 본문을 쓸 경로를 출력한다
#
# 지시서 (--brief): 부르는 쪽은 본문만 쓴다 (목표, 범위, 결정과 이유, 하지 않기로 한 것, 완료 조건, 남은 질문, 첫 할 일).
#   작업 디렉토리·브랜치, 메인 체크아웃은 고치지 않는다는 것, 스택에서 고치는 방법, 시작(설계부터·구현부터), here 의 커밋하지 않은
#   변경 목록은 스크립트가 머리말로 붙인다. --brief - 와 --note - 는 표준 입력에서 읽는다
#   --start plan  새 세션을 plan mode 로 띄우고 (here 는 바꾸는 방법을 안내한다) 머리말에 "설계안을 확인받은 뒤 구현" 을 적는다
#
# 도구 (--agent·--from: claude | cursor). 도구마다 다른 것은 이 표가 전부다
#             실행                                             move  fork  bg     plan mode          대화 비우기
#   claude    claude [--resume <id> --fork-session] -n <이름>  됨    됨    됨     --permission-mode plan   /clear <이전 대화 이름>
#   cursor    agent (없으면 옛 이름 cursor-agent)              안 됨 안 됨 안 됨  --plan                   /clear
#   둘 다 첫 메시지는 -- "<첫 메시지>" 로 넘긴다. 부른 곳이 어느 도구인지는 짐작하지 않는다.
#   cursor 에서 안 되는 까닭: 채팅이 폴더별로 저장돼 다른 폴더에서 이어 갈 수 없고, CLI 에 대화를 포크하는 옵션이 없고,
#   agent persist 는 터미널이 있어야 해서 스크립트가 띄울 수 없다. 도구를 바꿔 넘길 때도 대화 기록은 옮길 수 없다 (fresh 만)
#
# 세션을 띄우는 방식 (--open, fork·fresh)
#   auto   $TMUX 가 있으면 tmux, 없으면 bg, bg 가 안 되는 도구면 none (기본)
#   bg     워크트리에서 claude --bg 로 백그라운드 세션을 띄운다. claude attach <이름> 으로 들어간다.
#          안 되는 도구면 --open bg 는 거절하고, 설정에서 온 open=bg 는 auto 로 바꿔 띄운다
#   tmux   호출한 패널의 tmux 세션에 윈도우(그 워크트리의 윈도우가 있으면 패널)를 -d 로 열고 그 안에서 실행한다
#   none   띄우지 않고 실행할 명령만 출력한다
#
# 하는 순서 (fork·fresh): 확인 → 첫 메시지 읽기 → 워크트리 확보 → 첫 메시지 완성 → 런처 쓰기 → 띄우기 → 안내
#   확인은 아무것도 바꾸지 않는다. 워크트리를 확보하기 전에 실패하면 남기는 것이 없다.
#   그 뒤에 띄우다 실패하면 worktree: 와 run: 줄을 출력하고 종료 코드 1 로 끝난다 (run: 줄을 터미널에서 실행하면 된다)
#
# 설정: ${XDG_CONFIG_HOME:-~/.config}/worktree-handoff/config 의 key=value (# 주석). 환경 변수가 먼저다
#   open=auto|bg|tmux|none WORKTREE_HANDOFF_OPEN   기본 auto
#   agent=claude|cursor   WORKTREE_HANDOFF_AGENT   기본 claude
#   (root·create 는 branch-worktree 가 읽는다)
set -euo pipefail

die() { echo "worktree-handoff: $*" >&2; exit 1; }
note() { echo "worktree-handoff: $*" >&2; }
usage() { sed -n '2,/^set -euo/{/^set -euo/d;p;}' "$0" | sed 's/^# \{0,1\}//'; }
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/worktree-handoff
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/worktree-handoff/config

# 설정 파일은 실행하지 않고 key=value 만 읽는다. 값 양끝의 따옴표는 벗긴다 (branch-worktree 의 conf 와 같다)
conf() {   # conf <키>
  [ -f "$CONFIG" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONFIG" | tail -n 1 |
    sed -e 's/[[:space:]]*$//' -e "s/^\"\(.*\)\"$/\1/" -e "s/^'\(.*\)'$/\1/"
}
sq() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }   # 작은따옴표 인용: sh·bash·zsh·fish 모두 같은 뜻
slug() { printf %s "${1//\//-}"; }                                  # 파일·세션 이름에 쓸 꼴: / 를 - 로

# === 도구 어댑터 ================================================================
# 도구마다 다른 것은 이 절이 전부다. 아래 본문은 도구 이름을 모르고 여기서 정한 변수만 본다.
#
#   agent_<도구> caps      할 수 있는 것. 아무것도 바꾸지 않는다
#       cli         실행 파일                  cli_label   오류 메시지에 쓸 이름
#       no_move     지금 세션을 다른 워크트리로 못 옮기는 까닭 (비어 있으면 된다)
#       no_fork     fork 를 못 하는 까닭 (비어 있으면 된다)
#       no_bg       bg 로 못 띄우는 까닭 (비어 있으면 된다)      bg_flag  bg 로 띄울 때 런처에 줄 옵션
#       plan_flag   plan mode 로 띄울 때 런처에 줄 옵션
#       sid         fork 할 세션 ID 의 기본값 (--session 이 없을 때)
#   agent_<도구> move      $wt 가 정해진 뒤에 부른다. 그 워크트리로 들어가는 방법을 "키: 값" 줄로 출력한다
#   agent_<도구> commands  $mode·$sid·$name·$pf·$start 가 정해진 뒤에 부른다
#       pre_line    런처에서 실행 줄 앞에 둘 줄 (없으면 빈 값). 있으면 bg 는 분리해서 띄운다
#       exec_note   런처에 남길 주석            exec_line   런처의 실행 줄. "$@" 에 띄우는 쪽의 옵션이 들어간다
#       session     출력의 session: 값          resume_cmd  다시 여는 명령
#       attach_cmd  bg 세션에 붙는 명령
#   agent_<도구> here      $pf·$name·$start 가 정해진 뒤에 부른다. 대화를 비우고 지시서로 시작하는 줄을 "키: 값" 으로 출력한다
#       type: 사용자가 차례로 입력할 줄   note: 알아 둘 것   back: 이전 대화로 돌아가는 방법
agent_claude() {
  case $1 in
    caps)
      cli=claude; cli_label=claude; no_move=""; no_fork=""; no_bg=""; bg_flag=--bg; plan_flag="--permission-mode plan"
      sid=${sid:-${CLAUDE_CODE_SESSION_ID:-}} ;;
    move)
      # EnterWorktree 는 모델이 부르는 도구다. 워크트리 세션(EnterWorktree 로 들어온 세션)에서는 .claude/worktrees/ 아래로만
      # 갈아탈 수 있어서 밖의 경로는 거절된다. ExitWorktree(keep) 로 시작한 자리에 돌아간 뒤에는 들어가진다 (2.1.332 에서 확인)
      echo "enter:    EnterWorktree path=$wt"
      echo "retry:    \".claude/worktrees 아래가 아니다\" 로 거절되면 ExitWorktree action=keep 뒤에 같은 EnterWorktree 를 다시 부른다"
      echo "cd:       /cd $(sq "$wt")   (그래도 안 되면 사용자가 입력한다. 모델은 /cd 를 부를 수 없다)" ;;
    commands)
      local resume="" plan=""
      pre_line=""
      if [ "$mode" = fork ]; then
        # 스킬에서 불렸을 때 원본 세션의 Bash 호출 결과가 기록에 써질 때까지 기다린다
        pre_line="sleep 2"; resume="--resume $sid --fork-session "
      fi
      [ "$start" != plan ] || plan="$plan_flag "
      exec_note="# -n: claude --resume <세션 이름> 으로 바로 열고, /resume 피커에서 브랜치로 찾게. -- : 첫 메시지가 - 로 시작해도 옵션으로 읽히지 않게"
      exec_line="exec claude \"\$@\" ${resume}${plan}-n $(sq "$name") -- \"\$(cat $(sq "$pf"))\""
      session=$name
      resume_cmd="claude --resume $(sq "$name")"
      attach_cmd="claude attach $(sq "$name")" ;;
    here)
      echo "type:     /clear $name"
      # @ 로 언급한 파일은 내용이 바로 새 대화에 들어간다. 경로에 공백이 있으면 @ 언급이 끊기므로 경로만 적는다
      case $pf in
        *[[:space:]]*) echo "type:     $pf 파일을 읽고 시작해" ;;
        *) echo "type:     @$pf 를 읽고 시작해" ;;
      esac
      [ "$start" != plan ] || echo "note:     설계부터: 둘째 줄을 보내기 전에 Shift+Tab 으로 plan mode 로 바꾼다"
      echo "note:     /clear 의 인자는 비우는 이전 대화에 붙는 이름이다 (새 대화의 첫 메시지가 아니다)"
      echo "back:     /resume $name   (또는 claude --resume $(sq "$name"))" ;;
  esac
}
agent_cursor() {
  case $1 in
    caps)
      # 지금 이름은 agent, 옛 이름은 cursor-agent. agent 가 없을 때만 옛 이름을 쓴다
      cli=agent; cli_label="Cursor CLI(agent)"
      if ! command -v agent >/dev/null && command -v cursor-agent >/dev/null; then cli=cursor-agent; fi
      no_move="Cursor 는 채팅을 폴더별로 저장해서 세션을 다른 워크트리로 옮길 수 없습니다"
      no_fork="Cursor CLI 에는 대화를 포크하는 옵션이 없습니다. fresh 로 넘기세요 (Claude 세션을 포크하려면 --agent claude)"
      no_bg="agent persist 는 터미널이 있어야 해서 스크립트가 띄울 수 없습니다"; bg_flag=""; plan_flag="--plan" ;;
    move) die "$no_move" ;;
    commands)
      local plan=""
      [ "$start" != plan ] || plan="$plan_flag "
      # 세션 이름 옵션이 없다. -- 가 없으면 - 로 시작하는 첫 메시지를 옵션으로 읽고 "unknown option" 으로 끝난다
      pre_line=""
      exec_note="# -- : 첫 메시지가 - 로 시작해도 옵션으로 읽히지 않게"
      exec_line="exec $cli \"\$@\" ${plan}-- \"\$(cat $(sq "$pf"))\""
      session="Cursor CLI (이름 없음)"
      resume_cmd="$cli resume"   # 그 워크트리의 가장 최근 세션. 고르려면 $cli ls
      attach_cmd="" ;;
    here)
      # /clear 는 새 채팅을 시작한다 (이름 인자는 없다). @ 파일 언급은 확인하지 못해 경로만 적는다
      echo "type:     /clear"
      if [ "$start" = plan ]; then echo "type:     /plan $pf 파일을 읽고 설계안을 세워 줘"
      else echo "type:     $pf 파일을 읽고 시작해"
      fi
      echo "back:     /resume 에서 이전 채팅을 고른다" ;;
  esac
}

# === 인자와 설정 ================================================================
open=${WORKTREE_HANDOFF_OPEN:-$(conf open)}; open=${open:-auto}
agent=${WORKTREE_HANDOFF_AGENT:-$(conf agent)}; agent=${agent:-claude}
case ${1:-} in
  plan|move|fork|fresh|here) mode=$1; shift ;;
  -h|--help) usage; exit 0 ;;
  "") usage >&2; exit 1 ;;
  *) die "동작을 먼저 주세요: plan | move | fork | fresh | here (받은 것: $1)" ;;
esac
sid=""; base=""; brief=""; note_file=""; branch=""; stack_mode=""; start=""; tmp=""; name=""; from=""; here_flag=""
open_arg=""   # --open 을 명령줄에서 받았는가 (도구가 못 하는 방식이면 명령줄 값은 거절하고 설정 값은 auto 로 바꾼다)
agent_arg=""  # --agent 를 명령줄에서 받았는가 (here 는 지금 세션의 도구만 본다. 다른 도구로 열라고 명시했을 때만 거절한다)
given=" "     # 받은 옵션들. 동작마다 쓸 수 있는 옵션이 달라서 아래에서 걸러 낸다
while [ $# -gt 0 ]; do
  case $1 in --session|--base|--brief|--note|--open|--agent|--from|--start|--tmp|--name) [ $# -ge 2 ] || die "$1 에 값이 없습니다" ;; esac
  case $1 in --*) [ "$1" = -- ] || given="$given$1 " ;; esac
  case $1 in   # macOS 기본 bash 3.2 에서도 돌게 ;;& 는 쓰지 않는다
    --session) sid=$2; shift 2 ;;
    --base) base=$2; shift 2 ;;
    --brief) brief=$2; shift 2 ;;
    --note) note_file=$2; shift 2 ;;
    --open) open=$2; open_arg=1; shift 2 ;;
    --agent) agent=$2; agent_arg=1; shift 2 ;;
    --from) from=$2; shift 2 ;;
    --start) start=$2; shift 2 ;;
    --tmp) tmp=$2; shift 2 ;;
    --name) name=$2; shift 2 ;;
    --here) here_flag=1; shift ;;
    --in-stack|--new-worktree)
      [ -z "$stack_mode" ] || [ "$stack_mode" = "$1" ] || die "--in-stack 과 --new-worktree 는 함께 쓸 수 없습니다"
      stack_mode=$1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; branch=${1:-}; break ;;
    -*) die "unknown option: $1" ;;
    *) [ -z "$branch" ] || die "브랜치는 하나만: $branch, $1"; branch=$1; shift ;;
  esac
done
allow() {   # allow <이 동작이 받는 옵션들> : 그 밖의 옵션을 받았으면 거절한다
  local o
  for o in $given; do
    case " $* --agent --from " in *" $o "*) ;; *) die "$mode 에는 $o 를 쓸 수 없습니다 (worktree-handoff --help)" ;; esac
  done
}
case $mode in
  plan) allow --tmp --base --open --here --in-stack --new-worktree ;;
  move) allow --base --in-stack --new-worktree ;;
  fork) allow --session --note --base --open --in-stack --new-worktree ;;
  fresh) allow --brief --start --base --open --in-stack --new-worktree ;;
  here) allow --brief --start --name ;;
esac
from=${from:-$agent}
case $open in auto|bg|tmux|none) ;; *) die "--open 은 auto | bg | tmux | none 중 하나입니다: $open" ;; esac
case $agent in claude|cursor) ;; *) die "--agent 는 claude | cursor 중 하나입니다: $agent" ;; esac
case $from in claude|cursor) ;; *) die "--from 은 claude | cursor 중 하나입니다: $from" ;; esac
case $start in ""|plan|build) ;; *) die "--start 는 plan | build 중 하나입니다: $start" ;; esac
start=${start:-build}
case $mode in
  here) [ -z "$branch" ] || die "here 는 지금 체크아웃에서 다시 시작합니다. 브랜치를 받지 않습니다 (다른 워크트리로는 fresh)" ;;
  plan) [ -n "$branch" ] || [ -n "$here_flag" ] || die "브랜치 이름이나 --here 를 주세요"
        [ -z "$branch" ] || [ -z "$here_flag" ] || die "브랜치와 --here 는 함께 쓸 수 없습니다" ;;
  *) [ -n "$branch" ] || die "브랜치 이름을 주세요" ;;
esac
[ -z "$branch" ] || git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "브랜치 이름으로 쓸 수 없습니다: $branch"

# 도구가 할 수 있는 것. 지금 세션의 도구(from)와 새 세션을 여는 도구(agent)를 따로 본다
"agent_$from" caps; from_no_move=$no_move; from_no_fork=$no_fork
"agent_$agent" caps
# fork 를 못 하는 까닭 (비어 있으면 된다): 대화 기록은 도구를 건너가지 못하고, 그 도구가 포크를 할 줄 알아야 하고, 세션 ID 가 있어야 한다
fork_blocker() {
  if [ "$from" != "$agent" ]; then echo "대화 기록은 다른 도구로 옮길 수 없습니다 ($from → $agent). fresh 로 넘기세요"
  elif [ -n "$from_no_fork" ]; then echo "$from_no_fork"
  elif [ -z "$sid" ]; then echo "세션 ID 를 주세요 (--session <id>)"
  fi
}
# 띄울 방식을 정한다. 못 하는 조합은 $1 이 strict 면 거절하고, 아니면(plan) 고쳐서 알려 주기만 한다
resolve_open() {
  if [ "$open" = bg ] && [ -n "$no_bg" ]; then
    [ "${1:-}" != strict ] || [ -z "$open_arg" ] || die "$agent 세션은 bg 로 띄울 수 없습니다 ($no_bg). --open tmux 나 none 을 쓰세요"
    [ "${1:-}" != strict ] || note "설정의 open=bg 는 $agent 세션에 쓸 수 없어 auto 로 띄웁니다"
    open=auto
  fi
  if [ "$open" = auto ]; then
    if [ -n "${TMUX:-}" ]; then open=tmux
    elif [ -z "$no_bg" ]; then open=bg
    else open=none
    fi
  fi
}
# 워크트리를 확보해 줄 branch-worktree: 이 스크립트 옆에 있다. 없으면 PATH 에서 찾는다
bw="$(cd "$(dirname "$0")" && pwd)/branch-worktree"
[ -x "$bw" ] || bw=$(command -v branch-worktree || true)
[ -n "$bw" ] || die "branch-worktree 를 찾지 못했습니다 (worktree-handoff 와 같은 디렉토리에 있어야 합니다)"
here=$(git rev-parse --show-toplevel 2>/dev/null || true)   # 이 세션이 있는 체크아웃 (저장소 밖이면 빈 값)
here_branch=""; [ -z "$here" ] || here_branch=$(git -C "$here" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
dirty_count() { [ -n "$here" ] || { echo 0; return; }; git -C "$here" status --porcelain 2>/dev/null | wc -l | tr -d ' '; }
stamp=$(date +%m%d-%H%M%S)   # 이름이 겹치지 않게 붙이는 시각. 세션 이름에는 분까지만 쓴다

# === plan: 읽기만 한다 ============================================================
if [ "$mode" = plan ]; then
  resolve_open
  blocker=$(fork_blocker)
  target_here=""; target_note=""
  echo "from:     $from"
  echo "agent:    $agent"
  echo "here:     ${here:-$(pwd -P) (git 저장소가 아니다)}"
  [ -z "$here" ] || echo "here-branch: ${here_branch:-(detached HEAD)}"
  n=$(dirty_count)
  [ "$n" = 0 ] || echo "dirty:    $n   (지금 체크아웃의 커밋하지 않은 변경. move·fork·fresh 는 가져가지 않는다)"
  if [ -n "$here_flag" ]; then
    target_here=1
  else
    found=$("$bw" find -- "$branch") || exit $?
    f() { sed -n "s/^$1: //p" <<<"$found" | head -1; }
    kind=$(f kind); fwt=$(f worktree); fmain=$(f main)
    echo "main:     $fmain"
    echo "branch:   $branch"
    case $kind in
      self)
        echo "worktree: $fwt   (있다)"
        if [ "$fwt" = "$here" ]; then target_here=1
        elif [ "$fwt" = "$fmain" ]; then target_note="$branch 는 메인 체크아웃에 체크아웃돼 있습니다. 메인을 기본 브랜치로 돌리고 다시 하세요"
        fi ;;
      stack)
        echo "worktree: $fwt   (스택 워크트리. 체크아웃: $(f checkout). $branch 는 그 아래에 쌓인 브랜치다)"
        echo "would-create: $(f would-create)"
        if [ "$fwt" = "$here" ]; then
          echo "stack:    지금 체크아웃이 그 스택 워크트리다. 여기서 이어 가려면 here, 따로 떼려면 --new-worktree"
          [ "$stack_mode" = --new-worktree ] || target_here=1
        elif [ -z "$stack_mode" ]; then
          echo "stack:    골라야 한다. --in-stack (그 워크트리를 쓰고 체크아웃은 바꾸지 않는다) | --new-worktree (새로 만든다. 스택이 갈라진다)"
        fi ;;
      none)
        case $(f exists) in
          local) src="있는 로컬 브랜치" ;;
          remote) src="원격 브랜치를 추적" ;;
          *) src="${base:-$(f base)} 에서 새 브랜치" ;;
        esac
        echo "worktree: $(f would-create)   (새로 만든다: $src)" ;;
    esac
    [ -z "$(f missing)" ] || target_note="$branch 의 워크트리($(f missing))가 없습니다. git worktree prune 후 다시 하세요"
  fi
  # 방식마다: ok, 또는 no → <대신 쓸 방식> (까닭)
  if [ -n "$target_note" ]; then
    for m in move fork fresh; do echo "$m:$(printf '%*s' $((9 - ${#m})) '')no ($target_note)"; done
  elif [ -n "$target_here" ]; then
    # --here 로 물었으면 다른 방식은 묻지 않은 것이다. 브랜치를 줬는데 그것이 지금 체크아웃일 때만 대신 쓸 방식을 알린다
    [ -n "$here_flag" ] || for m in move fork fresh; do
      echo "$m:$(printf '%*s' $((9 - ${#m})) '')no → here (대상이 지금 이 세션의 체크아웃이다. 같은 트리를 두 세션이 고치지 않는다)"
    done
    if [ -z "$agent_arg" ] || [ "$from" = "$agent" ]; then echo "here:     ok"
    else echo "here:     no ($from 세션이 있는 트리에 $agent 세션을 띄우면 한 트리를 두 세션이 고친다. 새 워크트리의 fresh 를 쓴다)"
    fi
  else
    if [ -z "$from_no_move" ]; then echo "move:     ok"; else echo "move:     no → fresh ($from_no_move)"; fi
    if [ -z "$blocker" ]; then echo "fork:     ok"; else echo "fork:     no → fresh ($blocker)"; fi
    echo "fresh:    ok"
    echo "open:     $open   (fork·fresh 를 띄우는 방식)"
    [ "$open" = none ] || command -v "$cli" >/dev/null || echo "warn:     $cli_label 가 PATH 에 없습니다 (fork·fresh 는 --open none 일 때만 됩니다)"
    echo "session:  $branch@${stamp%??}"
  fi
  # 지시서 본문을 쓸 자리: --tmp (없으면 $TMPDIR) 아래, 호출마다 새 이름
  tmp=${tmp:-${TMPDIR:-/tmp}}; tmp=${tmp%/}
  b="$tmp/handoff-$(slug "${branch:-${here_branch:-here}}")-$stamp.md"; i=1
  while [ -e "$b" ]; do i=$((i + 1)); b="$tmp/handoff-$(slug "${branch:-${here_branch:-here}}")-$stamp-$i.md"; done
  echo "brief:    $b   (fresh·here 의 지시서 본문을 여기에 쓴다)"
  [ -z "$target_here" ] || echo "name:     $(slug "${here_branch:-here}")@${stamp%??}   (here 가 이전 대화에 붙일 이름)"
  exit 0
fi

# === 확인: 아무것도 바꾸지 않는다 ================================================
case $mode in
  move) [ -z "$from_no_move" ] || die "$from_no_move. fresh 로 넘기세요" ;;
  fork)
    blocker=$(fork_blocker); [ -z "$blocker" ] || die "$blocker"
    [[ $sid =~ ^[A-Za-z0-9-]+$ ]] || die "세션 ID 형식이 아닙니다: $sid" ;;
  fresh) [ -n "$brief" ] || die "fresh 에는 지시서가 필요합니다 (--brief <파일|->)" ;;
  here)
    [ -n "$brief" ] || die "here 에는 지시서가 필요합니다 (--brief <파일|->)"
    [ -z "$agent_arg" ] || [ "$from" = "$agent" ] || die "$from 세션이 있는 트리에 $agent 세션을 띄우면 한 트리를 두 세션이 고칩니다. 새 워크트리의 fresh 를 쓰세요"
    case $name in *[[:space:]]*) die "이전 대화 이름에는 공백을 쓸 수 없습니다: $name" ;; esac ;;
esac
if [ "$mode" = fork ] || [ "$mode" = fresh ]; then
  resolve_open strict
  [ "$open" != tmux ] || [ -n "${TMUX:-}" ] || die "--open tmux 는 tmux 안에서만 됩니다 (bg 나 none 을 쓰세요)"
  [ "$open" = none ] || command -v "$cli" >/dev/null || die "$cli_label 가 PATH 에 없습니다"
fi
text_file=$brief; [ "$mode" != fork ] || text_file=$note_file
if [ -n "$text_file" ] && [ "$text_file" != - ]; then
  [ -r "$text_file" ] && [ ! -d "$text_file" ] || die "파일을 읽을 수 없습니다: $text_file"
fi

# === 첫 메시지 읽기 ==============================================================
# 워크트리보다 먼저 읽어서, 비어 있으면 아무것도 만들지 않고 끝낸다. 세션은 나중에 이 파일을 읽으므로, 연달아 불려도
# 덮어쓰지 않게 호출마다 새 파일로 둔다. 워크트리를 확보하기 전에 실패하면 지운다
pf=""
if [ "$mode" != move ]; then
  mkdir -p "$STATE/prompt"
  find "$STATE/prompt" -type f -mtime +7 -delete 2>/dev/null || true
  pf=$(mktemp "$STATE/prompt/$(slug "${branch:-here-${here_branch:-x}}").XXXXXX")
  trap 'rm -f "$pf" "$pf.body"' EXIT
  if [ "$text_file" = - ]; then cat >"$pf.body"
  elif [ -n "$text_file" ]; then cat -- "$text_file" >"$pf.body"
  else : >"$pf.body"
  fi
  # 공백뿐이면 빈 것으로 본다 (fork 는 기본 문구로, fresh·here 는 오류)
  grep -q '[^[:space:]]' "$pf.body" || : >"$pf.body"
  [ "$mode" = fork ] || [ -s "$pf.body" ] || die "지시서가 비어 있습니다"
fi

# 머리말의 조각들. 지시서와 포크의 첫 메시지가 함께 쓴다
stack_cur=""; main=""; wt=""
stack_lines() {
  [ -n "$stack_cur" ] || return 0
  echo "- 이 워크트리에는 $stack_cur 가 체크아웃돼 있고 $branch 는 그 아래에 쌓인 브랜치다. 체크아웃을 바꾸지 말고"
  echo "  $branch 의 커밋을 겨냥한 fixup 커밋을 만든 뒤 git -c sequence.editor=: rebase -i --autosquash --update-refs --keep-base <$branch 의 base>"
  echo "  로 스택 전체를 다시 쌓는다."
}
start_line() {
  if [ "$start" = plan ]; then echo "- 시작: 설계부터. 이 지시서를 바탕으로 설계안을 세워 사용자의 확인을 받은 뒤에 구현한다."
  else echo "- 시작: 구현부터. 아래 \"첫 할 일\"부터 한다."
  fi
}

# === here: 지시서를 완성하고 입력할 줄을 알려 준다 ==================================
if [ "$mode" = here ]; then
  name=${name:-$(slug "${here_branch:-here}")@${stamp%??}}
  hmain=""; [ -z "$here" ] || hmain=$(git -C "$here" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p' || true)
  {
    echo "# 작업 지시서"
    echo
    echo "같은 작업 디렉토리의 이전 대화에서 정리해 넘긴 지시서다. 그 대화는 볼 수 없으니 여기 적힌 것만 근거로 삼고, 모자라면 사용자에게 묻는다."
    echo
    echo "- 작업 디렉토리: ${here:-$(pwd -P)}${here_branch:+ (브랜치 $here_branch)}"
    [ -z "$hmain" ] || [ "$hmain" = "$here" ] || echo "- 메인 체크아웃($hmain)의 파일은 읽기만 하고 수정하지 않는다."
    start_line
    if [ -n "$here" ]; then
      st=$(git -C "$here" status --short 2>/dev/null || true)
      if [ -n "$st" ]; then
        echo "- 커밋하지 않은 변경 (이전 대화에서 이어받는다):"
        sed 's/^/      /' <<<"$st"
      else
        echo "- 커밋하지 않은 변경은 없다."
      fi
    fi
    echo
    echo "---"
    echo
    cat "$pf.body"
  } >"$pf"
  rm -f "$pf.body"
  mv "$pf" "$pf.md"; pf=$pf.md   # @ 로 언급할 때 종류가 보이게
  trap - EXIT
  echo "brief:    $pf"
  "agent_$from" here
  exit 0
fi

# === 워크트리 확보 ================================================================
# branch-worktree 의 오류와 종료 코드는 그대로 내보낸다. 표준 입력은 위에서 다 읽었으니 넘기지 않는다
ensured=$("$bw" ensure ${base:+--base "$base"} ${stack_mode:+"$stack_mode"} -- "$branch" </dev/null) || exit $?
wt=$(sed -n 's/^worktree: //p' <<<"$ensured")
stack_cur=$(sed -n 's/^stack: //p' <<<"$ensured")
main=$(sed -n 's/^main: //p' <<<"$ensured")
[ -n "$wt" ] && [ -d "$wt" ] || die "branch-worktree 가 워크트리를 알려 주지 않았습니다"
# 한 작업 트리는 한 세션만 고친다. 이 세션이 있는 체크아웃으로는 넘기지 않는다 (이 경우 branch-worktree 는 만든 것이 없다)
if [ "$wt" = "$here" ]; then
  [ -z "$stack_cur" ] || die "$branch 를 품은 스택 워크트리가 지금 이 세션이 있는 체크아웃입니다. 같은 트리를 두 세션이 고치게 되므로 넘기지 않습니다 (여기서 다시 시작하려면 here)"
  die "$branch 는 지금 이 세션이 있는 체크아웃입니다. 같은 트리를 두 세션이 고치게 되므로 넘기지 않습니다 (여기서 다시 시작하려면 here)"
fi

# === move: 들어가는 방법만 알려 준다 ================================================
if [ "$mode" = move ]; then
  echo "worktree: $wt"
  echo "branch:   $branch${stack_cur:+ (스택 워크트리, 체크아웃: $stack_cur)}"
  "agent_$from" move
  n=$(dirty_count)
  [ "$n" = 0 ] || echo "note:     지금 체크아웃의 커밋하지 않은 변경 ${n}개는 따라가지 않는다"
  [ -z "$stack_cur" ] || stack_lines | sed -e '1s/^- /note:     /' -e '2,$s/^  /          /'
  exit 0
fi
trap - EXIT   # 여기부터는 워크트리가 있다. 실패해도 첫 메시지와 런처를 남겨 run: 줄로 이어 갈 수 있게 한다

# === 첫 메시지 완성 ================================================================
# 작업 디렉토리처럼 워크트리를 확보해야 알 수 있는 것과 늘 같은 문장은 여기서 쓴다. 부르는 쪽은 판단이 드는 본문만 쓴다
{
  if [ "$mode" = fork ]; then
    echo "너는 원본 대화에서 포크된 구현 세션이다. 위 대화의 /handoff 지시와 \"이 세션은 워크트리를 편집하지 않는다\"는"
    echo "원본 세션에 대한 것이다. 이 세션은 아래 워크트리에서 구현한다."
    echo "- 작업 디렉토리: $wt (브랜치 $branch)"
    echo "- 메인 체크아웃($main)의 파일은 읽기만 하고 수정하지 않는다."
    stack_lines
    if [ -s "$pf.body" ]; then echo; cat "$pf.body"
    else echo "지금까지 합의한 범위를 짧게 요약한 뒤 시작해."
    fi
  else
    echo "# 작업 지시서"
    echo
    echo "다른 대화에서 정리해 넘긴 지시서다. 그 대화는 볼 수 없으니 여기 적힌 것만 근거로 삼고, 모자라면 사용자에게 묻는다."
    echo
    echo "- 작업 디렉토리: $wt (브랜치 $branch)"
    echo "- 메인 체크아웃($main)의 파일은 읽기만 하고 수정하지 않는다."
    stack_lines
    start_line
    echo
    echo "---"
    echo
    cat "$pf.body"
  fi
} >"$pf"
rm -f "$pf.body"

# === 런처 쓰기 ====================================================================
# 세션 이름: 겹치지 않게 분 단위 시각을 붙인다 (이름으로 다시 열 때 정확히 하나만 일치해야 한다)
name="$branch@${stamp%??}"
"agent_$agent" commands
# 어느 방식이든 같은 sh 런처를 돌린다. 사용자 셸(bash/zsh/fish …)의 문법에 기대지 않는다.
# 런처에 준 인자("$@")는 도구의 옵션 앞에 붙는다. 직접 돌리면 지금 터미널의 대화형 세션이 된다
cat >"$pf.sh" <<LAUNCHER
#!/bin/sh
$pre_line
# 셸 rc 가 디렉토리를 바꿔도 워크트리에서 시작하게
cd $(sq "$wt") || exit 1
$exec_note
$exec_line
LAUNCHER

# === 띄우기 ======================================================================
# 실패하면 failed 와 where 만 정하고 계속 간다. 아래 안내가 run: 줄을 내준다
where=""; failed=""
open_bg() {
  if [ -n "$pre_line" ]; then
    # 런처가 기다렸다 시작하므로, 그동안 이 스크립트(와 부른 쪽의 Bash 호출)가 먼저 끝나게 분리해서 돌린다. 실패는 로그로만 보인다.
    # setsid: 부른 쪽이 끝나며 프로세스 그룹을 정리해도 살아남게 (macOS 엔 없어 nohup 만)
    if command -v setsid >/dev/null; then setsid nohup sh "$pf.sh" $bg_flag >"$pf.log" 2>&1 </dev/null &
    else nohup sh "$pf.sh" $bg_flag >"$pf.log" 2>&1 </dev/null &
    fi
    where="background, 2초 뒤 시작 (실패하면 로그에 남는다: $pf.log)"
  elif sh "$pf.sh" $bg_flag >"$pf.log" 2>&1 </dev/null; then
    where="background"     # 띄우고 바로 돌아온다. 실패(작업 폴더 신뢰 등)를 여기서 알 수 있다
  else
    sed "s/^/$cli: /" "$pf.log" >&2
    failed=1; where="background 실패 (위 $cli: 줄). 아래 run: 줄을 터미널에서 직접 실행하세요"
  fi
}
# 그 워크트리의 윈도우를 패널의 경로로 찾는다: 그 워크트리가 주인인 패널이 있는 가장 앞 윈도우.
#   패널의 주인 = 현재 경로(pane_current_path)가 이 저장소의 워크트리 안이면 그 워크트리, 아니면 시작 경로(pane_start_path)의
#   워크트리. 겹치면 가장 깊은 것 (메인 체크아웃이 그 아래의 워크트리를 삼키지 않게). modal 패널(떠 있는 피커)은 뺀다.
# tmux-dev 의 prefix W 와 같은 규칙이다 (dotfiles 의 home/dot_config/tmux/plugins/tmux-dev/lib/panes.sh. 이 플러그인은 따로
# 배포되므로 그 파일을 읽지 않고 같은 규칙을 여기 둔다). 전에는 윈도우에 붙인 옵션(worktree)으로 찾았는데, 그러면 prefix c 로 연 창은
# 못 찾고 break-pane·join-pane 으로 패널이 옮겨 가면 엉뚱한 창을 가리켰다.
wt_window() {  # $1 세션 → 그 워크트리($wt)의 윈도우 id (없으면 빈 줄)
  local us roots want win modal start cur owner line
  us=$(printf '\037')
  roots=$(git -C "$wt" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  want=$(cd -P -- "$wt" 2>/dev/null && pwd) || want=$wt
  owner_of() {  # $1 경로 → owner (그 경로를 담는 가장 깊은 워크트리). 없으면 1
    local w; owner=""
    [ -n "$1" ] || return 1
    while IFS= read -r w; do
      [ -n "$w" ] || continue
      case $1 in "$w"|"$w"/*) [ "${#w}" -le "${#owner}" ] || owner=$w ;; esac
    done <<<"$roots"
    [ -n "$owner" ]
  }
  while IFS=$us read -r win modal start cur; do
    [ "$modal" != 1 ] || continue
    if ! owner_of "$cur"; then
      start=$(cd -P -- "$start" 2>/dev/null && pwd) || continue   # 시작 경로는 받은 그대로라 심볼릭 링크일 수 있다
      owner_of "$start" || continue
    fi
    [ "$owner" = "$want" ] || continue
    printf '%s\n' "$win"; return 0
  done < <(tmux list-panes -s -t "$1" -F "#{window_id}$us#{pane_modal_flag}$us#{pane_start_path}$us#{pane_current_path}" 2>/dev/null |
    # tmux 는 -F 출력의 제어 문자를 글자로 바꿔 내보낸다 (US → "\037" 네 글자. tmux 3.4 에서 확인). 되살리지 않으면 한 줄이
    # 한 칸으로 읽혀 그 워크트리의 윈도우를 못 찾고 handoff 마다 새 윈도우를 연다
    while IFS= read -r line; do printf '%s\n' "${line//\\037/$us}"; done)
  return 0
}
open_tmux() {
  local sess wid pane="" wt_esc
  # 대상 세션은 호출한 패널의 세션. -t 없이 두면 tmux 가 "가장 최근 세션"을 골라 다른 저장소에 열 수 있다
  sess=$(tmux display -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{session_id}') || return 1
  # 그 워크트리의 윈도우가 이미 있으면 거기에 새 패널 (기존 패널에서 무엇이 돌지 모르므로 키를 보내지 않는다).
  # 없거나 자리가 없어 나눌 수 없으면 새 윈도우. 어느 쪽이든 -d 라 지금 보는 화면은 그대로다
  wid=$(wt_window "$sess") || return 1
  # -c 와 -n 은 tmux 형식 문자열로 해석된다. 경로·브랜치의 # 을 ## 로 (안 하면 fix/#H 같은 이름이 엉뚱한 디렉토리가 된다)
  fmt_esc() { printf %s "$1" | sed 's/#/##/g'; }
  wt_esc=$(fmt_esc "$wt")
  [ -z "$wid" ] || pane=$(tmux split-window -d -h -P -F '#{pane_id}' -t "$wid" -c "$wt_esc" 2>/dev/null) || pane=""
  if [ -z "$pane" ]; then
    pane=$(tmux new-window -d -P -F '#{pane_id}' -t "$sess:" -c "$wt_esc" -n "$(fmt_esc "$branch")") || return 1
  fi
  # -l: 글자 그대로 입력 (키 이름으로 해석하지 않게). Enter 는 따로
  tmux send-keys -l -t "$pane" "sh $(sq "$pf.sh")" || return 1
  tmux send-keys -t "$pane" Enter || return 1
  where="tmux $(tmux display -p -t "$pane" '#S:#I (#W)')"
}
case $open in
  bg) open_bg ;;
  tmux) open_tmux || { failed=1; where="tmux 실패 (위 오류). 아래 run: 줄을 터미널에서 직접 실행하세요"; } ;;
  none) where="none (아래 run: 줄을 직접 실행)" ;;
esac

# === 안내 ========================================================================
echo "worktree: $wt"
echo "branch:   $branch${stack_cur:+ (스택 워크트리, 체크아웃: $stack_cur)}"
echo "session:  $session"
echo "open:     $where"
[ -n "$failed" ] || [ "$open" != bg ] || echo "attach:   $attach_cmd"
[ -z "$failed" ] && [ "$open" != none ] || echo "run:      sh $(sq "$pf.sh")"
echo "resume:   cd $(sq "$wt") && $resume_cmd"
[ -z "$failed" ]
