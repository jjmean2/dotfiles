#!/usr/bin/env bash
# branch-worktree — 브랜치의 워크트리를 찾거나(find) 확보한다(ensure). git 만 다룬다. 세션이나 도구는 모른다.
#
#   branch-worktree find   [--tip <커밋>]                             <브랜치>
#   branch-worktree ensure [--base <ref>] [--in-stack|--new-worktree] <브랜치>
#
# find — 읽기만 한다. 그 브랜치를 고칠 워크트리가 어디인지 알려 준다. 어떻게 할지는 부르는 쪽이 정한다
#   kind: self | stack | none
#           self   브랜치가 체크아웃된 워크트리가 있다 (메인 체크아웃일 수도 있다)
#           stack  브랜치는 어디에도 체크아웃돼 있지 않지만, 그 브랜치를 조상으로 품은 워크트리(스택 워크트리)가 있다
#           none   둘 다 없다
#   worktree:    그 워크트리 (self·stack)
#   checkout:    거기 체크아웃된 브랜치 (stack 이면 위 브랜치. detached 면 빈 값)
#   matched:     stack 일 때 그 워크트리가 품은 커밋. branch = 로컬 브랜치 끝, tip = --tip 으로 준 커밋.
#                tip 이면 로컬 브랜치에 그 워크트리가 아직 품지 않은 커밋이 있다 (다시 쌓아야 한다)
#   candidates:  stack 일 때 그 커밋을 품은 워크트리 전부 (탭으로 구분)
#   missing:     브랜치가 등록돼 있지만 디렉토리가 사라진 워크트리 (git worktree prune 대상)
#   main: here:  메인 체크아웃과 지금 체크아웃
#
# 스택 워크트리
#   워크트리 하나에서 브랜치를 바꿔 가며 PR 을 쌓으면 하위 브랜치는 어디에도 체크아웃돼 있지 않다. 그 브랜치로 새 워크트리를
#   만들면 스택 워크트리에서 그 브랜치를 체크아웃할 수 없고 git rebase --update-refs 도 그 브랜치를 옮기지 않는다.
#   그래서 그런 브랜치는 "그 브랜치를 품은 워크트리"를 고칠 곳으로 본다. 기본 브랜치가 체크아웃된 워크트리는 치지 않는다
#   (머지된 브랜치를 품을 뿐이다). 여럿이면 지금 체크아웃을, 아니면 커밋 차이가 가장 적은(바로 위) 워크트리를 고른다.
#   품었는지는 로컬 브랜치 끝으로 먼저 보고, 없으면 --tip 으로 본다
#
# ensure — 그 브랜치의 워크트리를 확보하고 경로를 출력한다
#   있으면 그대로 쓴다. 메인 체크아웃은 워크트리로 치지 않고 거부한다.
#   스택 워크트리에 들어 있으면 멈추고 고르게 한다:
#     --in-stack      그 스택 워크트리를 쓴다 (체크아웃은 바꾸지 않는다. 고칠 때는 fixup 커밋 + rebase --update-refs)
#     --new-worktree  그래도 새 워크트리를 만든다
#   없으면 git worktree add 로 <root>/<저장소>/<브랜치의 / 를 - 로> 에 만든다
#   (로컬 브랜치 → 그것, --base 없이 원격 하나에만 있으면 → 추적 브랜치, 아니면 → 베이스에서 새 브랜치.
#    베이스 기본: origin/HEAD 가 가리키는 로컬 브랜치 → main/master → 메인의 HEAD).
#   create=tmux-dev 면 tmux-dev worktree --hook-create 로 만든다 (그 위치·셋업 훅). 실패하면 git 으로.
#   출력: worktree: <경로> / branch: <브랜치> / stack: <위 브랜치> (스택 워크트리를 쓸 때만) / main: <메인 체크아웃>
#   bare 저장소는 지원하지 않는다
#
# 설정: ${XDG_CONFIG_HOME:-~/.config}/worktree-handoff/config 의 key=value (# 주석). 환경 변수가 먼저다
#   root=<절대 경로|~/…>   WORKTREE_HANDOFF_ROOT    기본 ${XDG_DATA_HOME:-~/.local/share}/worktree-handoff/worktrees
#   create=git|tmux-dev   WORKTREE_HANDOFF_CREATE  기본 git
set -euo pipefail

die() { echo "branch-worktree: $*" >&2; exit 1; }
note() { echo "branch-worktree: $*" >&2; }
usage() { sed -n '2,/^set -euo/{/^set -euo/d;p;}' "$0" | sed 's/^# \{0,1\}//'; }
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/worktree-handoff/config

# 설정 파일은 실행하지 않고 key=value 만 읽는다. 값 양끝의 따옴표는 벗긴다 (worktree-handoff 의 conf 와 같다)
conf() {   # conf <키>
  [ -f "$CONFIG" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONFIG" | tail -n 1 |
    sed -e 's/[[:space:]]*$//' -e "s/^\"\(.*\)\"$/\1/" -e "s/^'\(.*\)'$/\1/"
}
expand_home() { case $1 in "~") echo "$HOME" ;; "~/"*) echo "$HOME/${1#\~/}" ;; *) echo "$1" ;; esac; }

# --- 저장소 --------------------------------------------------------------------
# MAIN·HERE 를 정한다. pipefail 이라 저장소 밖에서 git 이 실패하면 대입에서 조용히 끝나므로 || true 로 die 까지 가게 한다
repo() {
  MAIN=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p' || true)
  [ -n "$MAIN" ] || die "git 저장소 안에서 실행하세요"
  HERE=$(git rev-parse --show-toplevel 2>/dev/null || true)
}
# 워크트리 표: 경로 \t HEAD \t 브랜치 (detached 면 빈 칸)
worktree_table() {
  git worktree list --porcelain | awk '
    /^worktree /{p=substr($0,10); h=""; b=""} /^HEAD /{h=$2} /^branch /{b=substr($0,8); sub("^refs/heads/","",b)}
    /^$/{if (p!="") print p "\t" h "\t" b; p=""} END{if (p!="") print p "\t" h "\t" b}'
}
# 기본 브랜치인가: 원격들의 HEAD 가 가리키는 브랜치, 그리고 main·master
is_default_branch() {   # is_default_branch <브랜치>
  case $1 in main|master) return 0 ;; esac
  local r
  for r in $(git for-each-ref --format='%(symref:short)' 'refs/remotes/*/HEAD' 2>/dev/null); do
    [ "${r#*/}" != "$1" ] || return 0
  done
  return 1
}
# 새 브랜치의 베이스: origin/HEAD 가 가리키는 브랜치가 로컬에 있으면 그것, 아니면 main/master, 아니면 메인의 HEAD
default_base() {
  local b
  b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) && b=${b#origin/} &&
    git show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return; }
  for b in main master; do git show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return; }; done
  echo HEAD
}

# --- 찾기 ----------------------------------------------------------------------
# locate <브랜치> [<추가 커밋>] — 읽기만 한다. KIND·WT·CHECKOUT·MATCHED·MISSING·CANDS 를 정한다
locate() {
  local branch=$1 extra=${2:-} table p h b tip name n best i
  KIND=none; WT=""; CHECKOUT=""; MATCHED=""; MISSING=""; CANDS=()
  table=$(worktree_table)

  # 1. 브랜치가 체크아웃된 워크트리. 디렉토리가 사라진 등록은 건너뛰고 적어만 둔다
  p=$(awk -F'\t' -v b="$branch" '$3==b {print $1; exit}' <<<"$table")
  if [ -n "$p" ]; then
    if [ -d "$p" ]; then KIND=self; WT=$p; CHECKOUT=$branch; return 0; fi
    MISSING=$p
  fi

  # 2. 그 브랜치를 품은 워크트리. 로컬 브랜치 끝으로 먼저 보고, 없으면 추가 커밋으로 본다
  local tips=() names=()
  tip=$(git rev-parse -q --verify "refs/heads/$branch^{commit}" 2>/dev/null || true)
  [ -z "$tip" ] || { tips+=("$tip"); names+=(branch); }
  if [ -n "$extra" ]; then
    extra=$(git rev-parse -q --verify "$extra^{commit}" 2>/dev/null || true)   # 로컬에 없는 커밋이면 버린다
    [ -z "$extra" ] || [ "$extra" = "$tip" ] || { tips+=("$extra"); names+=(tip); }
  fi
  i=0
  while [ $i -lt ${#tips[@]} ]; do
    tip=${tips[$i]}; name=${names[$i]}; i=$((i + 1))
    best=""; CANDS=()
    while IFS=$'\t' read -r p h b; do
      [ -n "$p" ] && [ -d "$p" ] && [ -n "$h" ] || continue
      [ -z "$b" ] || ! is_default_branch "$b" || continue
      git merge-base --is-ancestor "$tip" "$h" 2>/dev/null || continue
      n=$(git rev-list --count "$tip..$h"); CANDS+=("$p")
      if [ "$p" = "$HERE" ]; then WT=$p; CHECKOUT=$b; best=-1
      elif [ "$best" != -1 ] && { [ -z "$WT" ] || [ "$n" -lt "$best" ]; }; then WT=$p; CHECKOUT=$b; best=$n; fi
    done <<<"$table"
    if [ -n "$WT" ]; then KIND=stack; MATCHED=$name; return 0; fi
  done
  CANDS=()
}

cmd_find() {
  local extra="" branch=""
  while [ $# -gt 0 ]; do
    case $1 in
      --tip) [ $# -ge 2 ] || die "--tip 에 값이 없습니다"; extra=$2; shift 2 ;;
      --) shift; branch=${1:-}; break ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$branch" ] || die "브랜치는 하나만: $branch, $1"; branch=$1; shift ;;
    esac
  done
  [ -n "$branch" ] || die "브랜치 이름을 주세요"
  repo
  locate "$branch" "$extra"
  echo "kind: $KIND"
  [ -z "$WT" ] || { echo "worktree: $WT"; echo "checkout: $CHECKOUT"; }
  [ -z "$MATCHED" ] || echo "matched: $MATCHED"
  [ ${#CANDS[@]} -eq 0 ] || { printf 'candidates: '; local IFS=$'\t'; echo "${CANDS[*]}"; }
  [ -z "$MISSING" ] || echo "missing: $MISSING"
  echo "main: $MAIN"
  echo "here: $HERE"
}

# --- 확보하기 ------------------------------------------------------------------
cmd_ensure() {
  local base="" stack_mode="" branch=""
  while [ $# -gt 0 ]; do
    case $1 in
      --base) [ $# -ge 2 ] || die "--base 에 값이 없습니다"; base=$2; shift 2 ;;
      --in-stack|--new-worktree)
        [ -z "$stack_mode" ] || [ "$stack_mode" = "$1" ] || die "--in-stack 과 --new-worktree 는 함께 쓸 수 없습니다"
        stack_mode=$1; shift ;;
      --) shift; branch=${1:-}; break ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$branch" ] || die "브랜치는 하나만: $branch, $1"; branch=$1; shift ;;
    esac
  done
  [ -n "$branch" ] || die "브랜치 이름을 주세요"
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "브랜치 이름으로 쓸 수 없습니다: $branch"

  local root create
  root=${WORKTREE_HANDOFF_ROOT:-$(conf root)}
  root=$(expand_home "${root:-${XDG_DATA_HOME:-$HOME/.local/share}/worktree-handoff/worktrees}")
  # 상대 경로는 기준이 모호해서(호출 위치? 메인 체크아웃?) 받지 않는다
  case $root in /*) ;; *) die "root 는 절대 경로나 ~ 로 시작해야 합니다: $root" ;; esac
  create=${WORKTREE_HANDOFF_CREATE:-$(conf create)}; create=${create:-git}
  case $create in git|tmux-dev) ;; *) die "create 는 git | tmux-dev 중 하나입니다: $create" ;; esac

  repo
  # 첫 항목이 bare 면 "메인 체크아웃"이 없다 (bare + 워크트리 구성)
  [ -z "$(git worktree list --porcelain | awk '/^$/{exit} /^bare$/{print}')" ] || die "bare 저장소는 지원하지 않습니다"

  # 여기까지와 아래 판정은 읽기만 한다. 만드는 것은 맨 끝의 한 곳(make)뿐이다
  locate "$branch"
  [ -z "$MISSING" ] || die "$branch 의 워크트리($MISSING)가 없습니다. git worktree prune 후 다시 하세요"
  local wt="" stack=""
  case $KIND in
    self)
      [ "$WT" != "$MAIN" ] || die "$branch 는 메인 체크아웃에 체크아웃돼 있습니다. 메인을 기본 브랜치로 돌리고 다시 하세요"
      wt=$WT ;;
    stack)
      local upper=${CHECKOUT:-detached HEAD}
      case $stack_mode in
        --new-worktree) ;;
        --in-stack)
          [ "$WT" != "$MAIN" ] || die "$branch 의 스택이 메인 체크아웃($upper)에 있습니다. 메인을 기본 브랜치로 돌리고 다시 하세요"
          wt=$WT; stack=$upper ;;
        *)
          local msg="$branch 는 어디에도 체크아웃돼 있지 않지만 스택 워크트리 $WT (체크아웃: $upper) 에 들어 있습니다."
          [ ${#CANDS[@]} -le 1 ] || msg="$msg (그 브랜치를 품은 워크트리: ${CANDS[*]})"
          die "$msg
  새 워크트리를 만들면 스택 워크트리에서 $branch 를 체크아웃할 수 없고 rebase --update-refs 도 $branch 를 옮기지 않습니다.
  스택 워크트리를 쓰려면 --in-stack, 그래도 새로 만들려면 --new-worktree 를 붙이세요" ;;
      esac ;;
    none) [ "$stack_mode" != --in-stack ] || die "--in-stack: $branch 를 품은 스택 워크트리가 없습니다" ;;
  esac
  [ -n "$wt" ] || wt=$(make "$branch" "$base" "$root" "$create")

  echo "worktree: $wt"
  echo "branch: $branch"
  [ -z "$stack" ] || echo "stack: $stack"
  echo "main: $MAIN"
}

# make <브랜치> <베이스> <root> <create> — 워크트리를 만들고 경로를 출력한다. 이 스크립트에서 저장소를 바꾸는 유일한 곳
make() {
  local branch=$1 base=$2 root=$3 create=$4 wt="" td remotes
  if [ "$create" = tmux-dev ]; then
    td=$(command -v tmux-dev 2>/dev/null || true)
    [ -n "$td" ] || [ ! -x "$HOME/.config/tmux/plugins/tmux-dev/bin/tmux-dev" ] || td=$HOME/.config/tmux/plugins/tmux-dev/bin/tmux-dev
    if [ -z "$td" ]; then
      note "tmux-dev 가 없어 git 으로 만듭니다"
    elif ! command -v jq >/dev/null; then
      note "jq 가 없어 git 으로 만듭니다"
    else
      # 훅은 메인 체크아웃에서 돌린다 (JSON 의 cwd 와 같게)
      wt=$(cd "$MAIN" && jq -nc --arg n "$branch" --arg c "$MAIN" '{name:$n,cwd:$c}' | "$td" worktree ${base:+--base "$base"} --hook-create) || wt=""
      # tmux-dev 가 거부하는 구성(서브모듈 등)이면 git 으로 만든다
      [ -n "$wt" ] && [ -d "$wt" ] || { note "tmux-dev 가 워크트리를 만들지 못해 git 으로 만듭니다"; wt=""; }
    fi
  fi
  if [ -z "$wt" ]; then
    wt="$root/$(basename "$MAIN")/${branch//\//-}"
    [ ! -e "$wt" ] || die "$wt 가 이미 있습니다 (같은 이름의 다른 저장소이거나 남은 디렉토리). 지우거나 다른 브랜치 이름을 쓰세요"
    mkdir -p "$(dirname "$wt")"
    remotes=$(git for-each-ref --format='%(refname)' "refs/remotes/*/$branch" | wc -l)
    # 메인 체크아웃에서 만든다: 베이스가 HEAD 일 때 메인의 HEAD 를 뜻하게
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$MAIN" worktree add "$wt" "$branch" >&2
    elif [ -z "$base" ] && [ "$remotes" -eq 1 ]; then
      git -C "$MAIN" worktree add "$wt" "$branch" >&2          # 원격 하나에만 있으면 git 이 추적 브랜치를 만든다
    else
      git -C "$MAIN" worktree add -b "$branch" "$wt" "${base:-$(default_base)}" >&2
    fi
  fi
  echo "$wt"
}

case ${1:-} in
  find) shift; cmd_find "$@" ;;
  ensure) shift; cmd_ensure "$@" ;;
  -h|--help) usage ;;
  "") usage >&2; exit 1 ;;
  *) die "동작을 먼저 주세요: find | ensure (받은 것: $1)" ;;
esac
