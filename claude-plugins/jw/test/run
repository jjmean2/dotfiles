#!/bin/bash
# test/run — jw 플러그인의 스크립트를 가짜 도구와 임시 저장소로 확인한다. 실제 claude·agent·gh 는 부르지 않는다.
#
#   test/run [worktree|handoff|modes|tmux|fetch]…     인자가 없으면 전부
#
# 스크립트는 env -i 와 /bin/bash (macOS 의 3.2) 로 돌린다. tmux 절은 격리된 서버(-L)를 띄우고, tmux 가 없으면 건너뛴다.
# fetch 절은 jq 가 있어야 한다. 실패한 항목이 있으면 종료 코드 1.
BIN=$(cd "$(dirname "$0")/../bin" && pwd)
BW=$BIN/branch-worktree; HO=$BIN/worktree-handoff; PF=$BIN/pr-review-fetch
T=$(mktemp -d "${TMPDIR:-/tmp}/jwtest.XXXXXX"); T=$(cd "$T" && pwd -P)
# UTF-8 로케일: en_US.UTF-8 이 없는 시스템(리눅스 컨테이너 등)에서는 C.UTF-8. 둘 다 없으면 en_US.UTF-8 (경고만 난다)
LOC=$(locale -a 2>/dev/null | awk 'tolower($0) ~ /^en_us\.utf-?8$/ { print; f = 1; exit } tolower($0) ~ /^c\.utf-?8$/ && !c { c = $0 }
  END { if (!f && c) print c }')
LOC=${LOC:-en_US.UTF-8}
pass=0; fail=0
ok() { pass=$((pass + 1)); printf 'ok   %s\n' "$1"; }
no() { fail=$((fail + 1)); printf 'FAIL %s\n' "$1"; [ $# -lt 2 ] || printf '%s\n' "$2" | sed 's/^/       | /'; }
has() { case $1 in *"$2"*) return 0 ;; esac; return 1; }
expect() { if has "$out" "$2"; then ok "$1"; else no "$1" "$out"; fi; }          # expect <이름> <있어야 할 글자>
expect_not() { if has "$out" "$2"; then no "$1" "$out"; else ok "$1"; fi; }
expect_rc() { if [ "$rc" = "$2" ]; then ok "$1"; else no "$1 (rc=$rc)" "$out"; fi; }
check() { local n=$1; shift; if "$@"; then ok "$n"; else no "$n"; fi; }           # check <이름> <명령…>
g() { local r=$1; shift; git -C "$r" -c user.name=t -c user.email=t@example.invalid "$@"; }

mkstub() {   # 받은 인자와 작업 디렉토리를 기록하고 끝나는 가짜 도구
  cat >"$1" <<'STUB'
#!/bin/sh
log=${STUB_LOG_DIR:?}/$(basename "$0").log
{
  printf 'cwd=%s\n' "$(pwd -P)"
  i=0
  for a in "$@"; do i=$((i + 1)); printf 'arg%s=<<%s>>\n' "$i" "$a"; done
  printf 'end\n'
} >>"$log"
STUB
  chmod +x "$1"
}
mkroot() {   # mkroot <디렉토리> [가짜 도구…]   (기본: claude agent). 저장소는 <디렉토리>/repo, 커밋 하나짜리 main
  local r=$1 t; shift
  mkdir -p "$r/home" "$r/bin" "$r/log" "$r/tmp" "$r/state" "$r/config" "$r/data"
  [ $# -gt 0 ] || set -- claude agent
  for t in "$@"; do mkstub "$r/bin/$t"; done
  git init -q -b main "$r/repo"
  g "$r/repo" commit -q --allow-empty -m init
  printf '%s\n' '- 첫 줄이 대시로 시작한다' \
    "작업 디렉토리는 '작은따옴표' \"큰따옴표\" \$HOME \`backtick\` \\역슬래시" '  들여쓴 줄' '' '마지막 줄' >"$r/msg.txt"
}
# run <루트> [VAR=값…] -- <스크립트> <인자…>  → $out (stdout+stderr), $rc
# 작업 디렉토리는 $CWD (기본 <루트>/repo), 표준 입력은 $STDIN 파일 (기본 /dev/null)
CWD=""; STDIN=""
run() {
  local root=$1; shift
  local envs=(HOME="$root/home" PATH="$root/bin:/usr/bin:/bin" XDG_STATE_HOME="$root/state"
    XDG_CONFIG_HOME="$root/config" XDG_DATA_HOME="$root/data" STUB_LOG_DIR="$root/log" TMPDIR="$root/tmp"
    LC_ALL="$LOC")
  while [ "$1" != -- ]; do envs+=("$1"); shift; done; shift
  out=$(cd "${CWD:-$root/repo}" && env -i "${envs[@]}" /bin/bash "$@" <"${STDIN:-/dev/null}" 2>&1); rc=$?
}
val() { printf '%s\n' "$out" | sed -n "s/^$1: *//p" | head -1; }                  # val <키> : 출력의 "키: 값"
wtdir() { echo "$1/data/worktree-handoff/worktrees/repo/$2"; }                    # 기본 위치의 워크트리 경로
worktrees() { git -C "$1/repo" worktree list | wc -l | tr -d ' '; }
state_files() { find "$1/state" -type f 2>/dev/null | wc -l | tr -d ' '; }
launcher() { ls "$1"/state/worktree-handoff/prompt/"$2".*.sh 2>/dev/null | tail -1; }

# === branch-worktree ===========================================================
t_worktree() {
  local R=$T/wt A top c1 c2 extra
  mkroot "$R"

  g "$R/repo" branch at-main
  run "$R" -- "$BW" find at-main
  expect "find: 기본 브랜치의 워크트리만 품은 브랜치는 none" 'kind: none'
  expect "find: main 과 here 를 알려 준다" "main: $R/repo"
  expect "find: none 이면 ensure 가 만들 경로" "would-create: $(wtdir "$R" at-main)"
  expect "find: 로컬 브랜치가 있으면 exists: local" 'exists: local'
  run "$R" -- "$BW" find brand/new
  expect "find: 없는 브랜치는 exists: no" 'exists: no'
  expect "find: 그때 쓸 베이스" 'base: main'
  check "find 는 워크트리를 만들지 않는다" test ! -e "$(wtdir "$R" brand-new)"
  run "$R" WORKTREE_HANDOFF_CREATE=tmux-dev -- "$BW" find brand/new
  expect "find: create=tmux-dev 인데 tmux-dev 에 묻지 못하면 예상이라고 붙인다" "would-create: $(wtdir "$R" brand-new) (예상)"
  run "$R" -- "$BW" find main
  expect "find: 메인 체크아웃도 self 다" 'kind: self'

  run "$R" -- "$BW" ensure feat/a
  expect_rc "ensure: 없는 브랜치는 만든다" 0
  A=$(wtdir "$R" feat-a)
  expect "ensure: <root>/<저장소>/<브랜치의 / 를 - 로>" "worktree: $A"
  expect "ensure: 메인 체크아웃을 알려 준다" "main: $R/repo"
  check "ensure: 그 자리에 워크트리가 생겼다" test -d "$A"
  check "ensure: 브랜치가 체크아웃됐다" test "$(git -C "$A" symbolic-ref --short HEAD)" = feat/a
  run "$R" -- "$BW" ensure feat/a
  expect "ensure: 있으면 그대로 쓴다" "worktree: $A"
  check "ensure: 다시 만들지 않았다" test "$(worktrees "$R")" = 2
  run "$R" -- "$BW" find feat/a
  expect "find: 체크아웃된 워크트리는 self" 'kind: self'
  expect "find: 그 경로" "worktree: $A"

  run "$R" -- "$BW" ensure main
  expect_rc "ensure: 메인 체크아웃은 거부한다" 1
  expect "ensure: 이유" '메인 체크아웃에 체크아웃돼 있습니다'

  g "$A" commit -q --allow-empty -m a1
  run "$R" -- "$BW" ensure --base feat/a feat/c
  check "ensure --base: 그 ref 에서 새 브랜치" test "$(git -C "$R/repo" rev-parse feat/c)" = "$(git -C "$R/repo" rev-parse feat/a)"
  g "$R/repo" branch local-only
  g "$R/repo" update-ref refs/heads/local-only "$(git -C "$R/repo" commit-tree -p main -m x 'main^{tree}')"
  run "$R" -- "$BW" ensure local-only
  check "ensure: 로컬 브랜치가 있으면 그것을 체크아웃" test "$(git -C "$(wtdir "$R" local-only)" rev-parse HEAD)" = "$(git -C "$R/repo" rev-parse local-only)"

  git init -q --bare "$R/origin.git"
  g "$R/repo" remote add origin "$R/origin.git"
  g "$R/repo" push -q origin main:main main:feat/remote
  g "$R/repo" fetch -q origin
  run "$R" -- "$BW" ensure feat/remote
  check "ensure: 원격 하나에만 있으면 추적 브랜치" test "$(git -C "$(wtdir "$R" feat-remote)" rev-parse --abbrev-ref '@{u}' 2>/dev/null)" = origin/feat/remote

  # 스택: 워크트리 하나(stk/top)가 아래 브랜치(stk/low)를 품고, stk/low 는 어디에도 체크아웃돼 있지 않다
  run "$R" -- "$BW" ensure stk/top
  top=$(wtdir "$R" stk-top)
  g "$top" commit -q --allow-empty -m c1; c1=$(git -C "$top" rev-parse HEAD)
  g "$top" branch stk/low
  g "$top" commit -q --allow-empty -m c2; c2=$(git -C "$top" rev-parse HEAD)
  run "$R" -- "$BW" find stk/low
  expect "find: 품은 워크트리가 있으면 stack" 'kind: stack'
  expect "find stack: 그 워크트리" "worktree: $top"
  expect "find stack: 위 브랜치" 'checkout: stk/top'
  expect "find stack: 로컬 브랜치 끝을 품었다" 'matched: branch'
  run "$R" -- "$BW" ensure stk/low
  expect_rc "ensure: 스택 워크트리에 든 브랜치는 멈춘다" 1
  expect "ensure stack: 고르게 한다" '--in-stack, 그래도 새로 만들려면 --new-worktree'
  check "ensure stack: 멈출 때 만든 것이 없다" test ! -e "$(wtdir "$R" stk-low)"
  run "$R" -- "$BW" ensure --in-stack stk/low
  expect "ensure --in-stack: 스택 워크트리를 쓴다" "worktree: $top"
  expect "ensure --in-stack: 위 브랜치를 알려 준다" 'stack: stk/top'
  run "$R" -- "$BW" ensure --in-stack feat/zzz
  expect_rc "ensure --in-stack: 품은 워크트리가 없으면 거부" 1
  check "ensure --in-stack: 거부할 때 만든 것이 없다" test ! -e "$(wtdir "$R" feat-zzz)"

  # 로컬 브랜치에 스택 워크트리가 아직 품지 않은 커밋이 생겼다 → 로컬 끝으로는 못 찾고 --tip(원격의 끝)으로 찾는다
  extra=$(git -C "$R/repo" commit-tree -p stk/low -m extra 'stk/low^{tree}')
  g "$R/repo" update-ref refs/heads/stk/low "$extra"
  run "$R" -- "$BW" find stk/low
  expect "find: 로컬 끝을 품은 워크트리가 없으면 none" 'kind: none'
  run "$R" -- "$BW" find --tip "$c1" stk/low
  expect "find --tip: 그 커밋을 품은 워크트리" 'kind: stack'
  expect "find --tip: tip 으로 찾았다 (다시 쌓아야 한다)" 'matched: tip'
  run "$R" -- "$BW" find --tip 0000000000000000000000000000000000000000 stk/low
  expect "find --tip: 로컬에 없는 커밋은 버린다" 'kind: none'
  g "$R/repo" update-ref refs/heads/stk/low "$c1"
  run "$R" -- "$BW" ensure --new-worktree stk/low
  expect "ensure --new-worktree: 그래도 새로 만든다" "worktree: $(wtdir "$R" stk-low)"

  # 지금 체크아웃이 후보면 그것을 고른다 (둘이 품었을 때)
  g "$top" branch two-homes "$c1"
  run "$R" -- "$BW" ensure --base "$c2" stk/other
  CWD=$(wtdir "$R" stk-other); run "$R" -- "$BW" find two-homes; CWD=""
  expect "find: 여럿이면 지금 체크아웃" "worktree: $(wtdir "$R" stk-other)"
  expect "find: 후보를 모두 알려 준다" "candidates: "
  run "$R" -- "$BW" find two-homes
  expect "find: 지금 체크아웃이 후보가 아니면 커밋 차이가 가장 적은 것" "worktree: $(wtdir "$R" stk-low)"

  run "$R" -- "$BW" ensure gone
  /bin/rm -rf "$(wtdir "$R" gone)"
  run "$R" -- "$BW" find gone
  expect "find: 디렉토리가 사라진 등록을 알려 준다" "missing: $(wtdir "$R" gone)"
  expect_not "find: 그것을 self 로 치지 않는다" 'kind: self'
  run "$R" -- "$BW" ensure gone
  expect_rc "ensure: 디렉토리가 사라진 등록은 거부" 1
  expect "ensure: prune 을 안내한다" 'git worktree prune'

  mkdir -p "$(wtdir "$R" feat-taken)"
  run "$R" -- "$BW" ensure feat/taken
  expect_rc "ensure: 만들 자리에 무엇이 있으면 거부" 1

  run "$R" WORKTREE_HANDOFF_ROOT="$R/elsewhere" -- "$BW" ensure feat/env
  expect "설정: 환경 변수의 root" "worktree: $R/elsewhere/repo/feat-env"
  mkdir -p "$R/config/worktree-handoff"; printf 'root = "%s"  \n' "$R/fromfile" >"$R/config/worktree-handoff/config"
  run "$R" -- "$BW" ensure feat/file
  expect "설정: 파일의 root (따옴표·공백을 벗긴다)" "worktree: $R/fromfile/repo/feat-file"
  run "$R" WORKTREE_HANDOFF_ROOT=relative/path -- "$BW" ensure feat/rel
  expect_rc "설정: 상대 경로 root 는 거부" 1
  run "$R" WORKTREE_HANDOFF_CREATE=bogus -- "$BW" ensure feat/rel
  expect_rc "설정: 모르는 create 는 거부" 1
  run "$R" WORKTREE_HANDOFF_CREATE=tmux-dev -- "$BW" ensure feat/td
  expect "create=tmux-dev: 없으면 알리고 git 으로" 'tmux-dev 가 없어 git 으로 만듭니다'
  expect_rc "create=tmux-dev: 그래도 만든다" 0
  /bin/rm -f "$R/config/worktree-handoff/config"

  run "$R" -- "$BW" ensure 'bad..name'
  expect_rc "ensure: 브랜치 이름으로 쓸 수 없으면 거부" 1
  CWD=$R/tmp; run "$R" -- "$BW" ensure feat/x; CWD=""
  expect "저장소 밖에서는 거부" 'git 저장소 안에서 실행하세요'
  CWD=$R/origin.git; run "$R" -- "$BW" ensure feat/x; CWD=""
  expect "bare 저장소는 거부" 'bare 저장소는 지원하지 않습니다'
}

# === worktree-handoff ==========================================================
t_handoff() {
  local R=$T/ho L want n0 s0 old
  mkroot "$R"

  # --- claude ---
  run "$R" -- "$HO" fresh --brief ../msg.txt --open none -- feat/a
  expect_rc "claude fresh: 성공" 0
  expect "claude fresh: worktree 줄" "worktree: $(wtdir "$R" feat-a)"
  expect "claude fresh: 세션 이름은 <브랜치>@<MMDD-HHMM>" 'session:  feat/a@'
  expect "claude fresh: none 이면 run 줄" 'run:      sh '
  expect "claude fresh: resume 줄" "resume:   cd '$(wtdir "$R" feat-a)' && claude --resume 'feat/a@"
  expect_not "claude fresh: none 이면 attach 줄 없음" 'attach:'
  L=$(launcher "$R" feat-a); out=$(cat "$L")
  expect "claude 런처: 워크트리로 들어간다" "cd '$(wtdir "$R" feat-a)' || exit 1"
  expect "claude 런처: 이름과 첫 메시지" "exec claude \"\$@\" -n 'feat/a@"
  expect_not "claude 런처: fresh 는 기다리지 않는다" 'sleep'
  ( cd / && env -i HOME="$R/home" PATH="$R/bin:/usr/bin:/bin" STUB_LOG_DIR="$R/log" sh "$L" --extra )
  out=$(cat "$R/log/claude.log")
  expect "가짜 claude: 워크트리에서 실행" "cwd=$(wtdir "$R" feat-a)"
  expect "가짜 claude: 런처 인자가 앞에" 'arg1=<<--extra>>'
  expect "가짜 claude: 첫 메시지는 스크립트가 붙인 머리말로 시작한다" 'arg5=<<# 작업 지시서'
  expect "  머리말: 작업 디렉토리와 브랜치" "- 작업 디렉토리: $(wtdir "$R" feat-a) (브랜치 feat/a)"
  expect "  머리말: 메인 체크아웃은 고치지 않는다" "- 메인 체크아웃($R/repo)의 파일은 읽기만"
  expect "  머리말: 시작은 기본이 구현부터" '- 시작: 구현부터'
  want=$(printf '%s>>' "$(cat "$R/msg.txt")")
  expect "가짜 claude: 지시서 본문이 글자 그대로 같은 인자의 끝에" "$want"

  run "$R" -- "$HO" fresh --brief ../msg.txt --start plan --open none -- feat/pl
  L=$(launcher "$R" feat-pl); out=$(cat "$L")
  expect "--start plan: claude 를 plan mode 로 띄운다" "exec claude \"\$@\" --permission-mode plan -n 'feat/pl@"
  out=$(cat "${L%.sh}")
  expect "--start plan: 머리말에 설계부터" '- 시작: 설계부터'
  run "$R" -- "$HO" fresh --brief ../msg.txt --start bogus --open none -- feat/pl2
  expect "--start: 모르는 값은 거부" '--start 는 plan | build 중 하나입니다'

  run "$R" -- "$HO" fresh --brief ../msg.txt -- feat/bg
  expect "claude: tmux 밖이면 bg" 'open:     background'
  expect "claude bg: attach 줄" "attach:   claude attach 'feat/bg@"
  expect_not "claude bg: run 줄 없음" 'run:'
  out=$(cat "$R/log/claude.log")
  expect "claude bg: --bg 로 띄웠다" 'arg1=<<--bg>>'

  run "$R" CLAUDE_CODE_SESSION_ID=sid-9 -- "$HO" fork --open none -- feat/fk
  expect_rc "claude fork: 세션 ID 는 환경 변수에서" 0
  L=$(launcher "$R" feat-fk); out=$(cat "$L")
  expect "fork 런처: 포크 옵션" "exec claude \"\$@\" --resume sid-9 --fork-session -n 'feat/fk@"
  expect "fork 런처: 원본의 기록이 써지길 기다린다" 'sleep 2'
  out=$(cat "${L%.sh}")
  expect "fork: 기본 첫 메시지에 워크트리" "작업 디렉토리: $(wtdir "$R" feat-fk) (브랜치 feat/fk)"
  expect "fork: 기본 첫 메시지에 메인 체크아웃" "메인 체크아웃($R/repo)"
  run "$R" CLAUDE_CODE_SESSION_ID=sid-9 -- "$HO" fork --session other-1 --open none -- feat/fk2
  out=$(cat "$(launcher "$R" feat-fk2)")
  expect "fork: --session 이 환경 변수보다 먼저" '--resume other-1 --fork-session'
  run "$R" -- "$HO" fork --open none -- feat/fk3
  expect "fork: 세션 ID 가 없으면 거부" '세션 ID 를 주세요'
  run "$R" -- "$HO" fork --session 'bad id;' --open none -- feat/fk3
  expect "fork: 세션 ID 형식이 아니면 거부" '세션 ID 형식이 아닙니다'
  run "$R" CLAUDE_CODE_SESSION_ID=sid-9 -- "$HO" fork --note ../msg.txt --open none -- feat/fkn
  out=$(cat "$(launcher "$R" feat-fkn | sed 's/\.sh$//')")
  expect "fork --note: 포크된 세션이라는 문장이 먼저" '너는 원본 대화에서 포크된 구현 세션이다'
  expect "fork --note: 그 뒤에 받은 내용" '마지막 줄'
  expect_not "fork --note: 기본 문구는 뺀다" '짧게 요약한 뒤 시작해'
  run "$R" CLAUDE_CODE_SESSION_ID=sid-9 -- "$HO" fork --brief ../msg.txt --open none -- feat/fkx
  expect "fork: --brief 는 받지 않는다" 'fork 에는 --brief 를 쓸 수 없습니다'
  run "$R" CLAUDE_CODE_SESSION_ID=sid-9 -- "$HO" fork --from cursor --open none -- feat/fkx
  expect "fork: 다른 도구의 대화는 포크할 수 없다" '대화 기록은 다른 도구로 옮길 수 없습니다'
  check "  거절된 fork 는 워크트리를 만들지 않았다" test ! -d "$(wtdir "$R" feat-fkx)"
  run "$R" CLAUDE_CODE_SESSION_ID=sid-9 -- "$HO" fork -- feat/fkbg
  expect "fork bg: 분리해서 띄운다" 'open:     background, 2초 뒤 시작'
  sleep 3.5; out=$(cat "$R/log/claude.log")
  expect "fork bg: 2초 뒤 가짜 claude 가 --bg 와 포크 옵션을 받았다" 'arg3=<<sid-9>>'

  printf 'from stdin\n' >"$R/stdin.txt"
  STDIN=$R/stdin.txt; run "$R" -- "$HO" fresh --brief - --open none -- feat/stdin; STDIN=""
  expect_rc "첫 메시지를 표준 입력에서" 0
  check "  그 내용이 첫 메시지 파일로 남았다" grep -qx 'from stdin' "$(launcher "$R" feat-stdin | sed 's/\.sh$//')"

  # --- 거절: 아무것도 남기지 않는다 ---
  n0=$(worktrees "$R"); s0=$(state_files "$R")
  run "$R" -- "$HO" fresh --open none -- feat/no
  expect "fresh: 지시서가 없으면 거부" 'fresh 에는 지시서가 필요합니다'
  printf '  \n\n' >"$R/blank.txt"
  run "$R" -- "$HO" fresh --brief ../blank.txt --open none -- feat/no
  expect "fresh: 공백뿐인 지시서는 거부" '지시서가 비어 있습니다'
  run "$R" -- "$HO" fresh --brief ../nope.txt --open none -- feat/no
  expect "지시서 파일이 없으면 거부" '파일을 읽을 수 없습니다'
  run "$R" -- "$HO" fresh --prompt-file ../msg.txt --open none -- feat/no
  expect "옛 옵션 --prompt-file 은 없다" 'unknown option: --prompt-file'
  run "$R" -- "$HO" fresh --brief ../msg.txt --open tmux -- feat/no
  expect "--open tmux: tmux 밖이면 거부" 'tmux 안에서만 됩니다'
  run "$R" -- "$HO" fresh --brief ../msg.txt --agent auto -- feat/no
  expect_rc "--agent: 모르는 도구는 거부" 1
  run "$R" -- "$HO" fresh --brief ../msg.txt --open bogus -- feat/no
  expect_rc "--open: 모르는 방식은 거부" 1
  run "$R" -- "$HO" path feat/no
  expect_rc "path 동작은 없다 (branch-worktree ensure 를 쓴다)" 1
  run "$R" PATH=/usr/bin:/bin -- "$HO" fresh --brief ../msg.txt -- feat/no
  expect "claude 가 없으면 거부" 'claude 가 PATH 에 없습니다'
  run "$R" -- "$HO" fresh --brief ../msg.txt --agent cursor --open bg -- feat/no
  expect "cursor --open bg: 거부" 'cursor 세션은 bg 로 띄울 수 없습니다 (agent persist'
  run "$R" CLAUDE_CODE_SESSION_ID=sid-9 -- "$HO" fork --agent cursor -- feat/no
  expect "cursor fork: 거부" 'Cursor CLI 에는 대화를 포크하는 옵션이 없습니다'
  run "$R" TMUX=fake PATH=/usr/bin:/bin -- "$HO" fresh --brief ../msg.txt --agent cursor --open tmux -- feat/no
  expect "cursor: CLI 가 없으면 거부" 'Cursor CLI(agent) 가 PATH 에 없습니다'
  run "$R" -- "$HO" fresh --brief ../msg.txt --open none -- main
  expect "메인 체크아웃은 branch-worktree 가 거부하고 그 오류가 그대로 나온다" 'branch-worktree: main 는 메인 체크아웃에'
  expect_rc "  종료 코드도 그대로" 1
  CWD=$(wtdir "$R" feat-a); run "$R" -- "$HO" fresh --brief "$R/msg.txt" --open none -- feat/a; CWD=""
  expect "이 세션이 있는 체크아웃으로는 넘기지 않는다" '지금 이 세션이 있는 체크아웃입니다'
  check "거절된 호출은 워크트리를 만들지 않았다" test "$(worktrees "$R")" = "$n0"
  check "거절된 호출은 첫 메시지·런처를 남기지 않았다" test "$(state_files "$R")" = "$s0"

  # --- cursor ---
  run "$R" -- "$HO" fresh --brief ../msg.txt --agent cursor -- feat/cu
  expect_rc "cursor fresh: 성공" 0
  expect "cursor: tmux 밖이면 none" 'open:     none'
  expect "cursor: session 줄" 'session:  Cursor CLI (이름 없음)'
  expect "cursor: resume 줄" "resume:   cd '$(wtdir "$R" feat-cu)' && agent resume"
  expect_not "cursor: attach 줄 없음" 'attach:'
  L=$(launcher "$R" feat-cu); out=$(cat "$L")
  expect "cursor 런처: agent -- 첫 메시지" 'exec agent "$@" -- "$(cat '
  ( cd / && env -i HOME="$R/home" PATH="$R/bin:/usr/bin:/bin" STUB_LOG_DIR="$R/log" sh "$L" --extra )
  out=$(cat "$R/log/agent.log")
  expect "가짜 agent: -- 가 첫 메시지 앞에" 'arg2=<<-->>'
  expect "가짜 agent: 첫 메시지는 머리말로 시작한다" 'arg3=<<# 작업 지시서'
  want=$(printf '%s>>' "$(cat "$R/msg.txt")")
  expect "가짜 agent: 지시서 본문이 글자 그대로 같은 인자의 끝에" "$want"
  run "$R" -- "$HO" fresh --brief ../msg.txt --agent cursor --start plan -- feat/cup
  out=$(cat "$(launcher "$R" feat-cup)")
  expect "--start plan: cursor 는 --plan" 'exec agent "$@" --plan -- "$(cat '
  run "$R" WORKTREE_HANDOFF_OPEN=bg -- "$HO" fresh --brief ../msg.txt --agent cursor -- feat/cu2
  expect "cursor, 설정의 open=bg: 알리고" '설정의 open=bg 는 cursor 세션에 쓸 수 없어'
  expect "cursor, 설정의 open=bg: auto 로 띄운다" 'open:     none'
  run "$R" CURSOR_AGENT=1 -- "$HO" fresh --brief ../msg.txt --open none -- feat/env
  expect "부른 곳을 환경 변수로 짐작하지 않는다" "claude --resume 'feat/env@"
  mkdir -p "$R/config/worktree-handoff"; printf 'agent=cursor\n' >"$R/config/worktree-handoff/config"
  run "$R" -- "$HO" fresh --brief ../msg.txt -- feat/cf
  expect "설정 파일의 agent" 'session:  Cursor CLI'
  run "$R" WORKTREE_HANDOFF_AGENT=claude -- "$HO" fresh --brief ../msg.txt --open none -- feat/cf2
  expect "환경 변수가 설정 파일보다 먼저" 'session:  feat/cf2@'
  /bin/rm -f "$R/config/worktree-handoff/config"
  local O=$T/ho-old; mkroot "$O" cursor-agent
  run "$O" -- "$HO" fresh --brief ../msg.txt --agent cursor -- feat/o
  expect "cursor: agent 가 없으면 옛 이름 cursor-agent" 'cursor-agent resume'

  # --- 스택 워크트리 ---
  g "$(wtdir "$R" feat-a)" commit -q --allow-empty -m c1
  g "$(wtdir "$R" feat-a)" branch low
  g "$(wtdir "$R" feat-a)" commit -q --allow-empty -m c2
  s0=$(state_files "$R")
  run "$R" -- "$HO" fresh --brief ../msg.txt --open none -- low
  expect_rc "스택 워크트리에 든 브랜치: 멈춘다" 1
  check "  멈출 때 읽어 둔 첫 메시지를 지운다" test "$(state_files "$R")" = "$s0"
  run "$R" CLAUDE_CODE_SESSION_ID=sid-9 -- "$HO" fork --open none --in-stack -- low
  expect "--in-stack: 스택 워크트리를 쓴다" "branch:   low (스택 워크트리, 체크아웃: feat/a)"
  out=$(cat "$(launcher "$R" low | sed 's/\.sh$//')")
  expect "--in-stack: 포크의 기본 첫 메시지에 고치는 방법" 'rebase -i --autosquash --update-refs --keep-base'
  CWD=$(wtdir "$R" feat-a); run "$R" -- "$HO" fresh --brief "$R/msg.txt" --open none --in-stack -- low; CWD=""
  expect "--in-stack: 그 워크트리가 이 세션의 체크아웃이면 넘기지 않는다" '스택 워크트리가 지금 이 세션이 있는 체크아웃입니다'

  # --- 띄우다 실패해도 안내는 나온다 ---
  printf '#!/bin/sh\necho "tmux: boom" >&2\nexit 1\n' >"$R/bin/tmux"; chmod +x "$R/bin/tmux"
  run "$R" TMUX=fake -- "$HO" fresh --brief ../msg.txt -- feat/tf
  expect_rc "tmux 가 실패하면 종료 코드 1" 1
  expect "tmux 실패: worktree 줄은 나온다" "worktree: $(wtdir "$R" feat-tf)"
  expect "tmux 실패: run 줄로 이어 갈 수 있다" 'run:      sh '
  /bin/rm -f "$R/bin/tmux"
  printf '#!/bin/sh\necho "not trusted" >&2\nexit 3\n' >"$R/bin/claude"
  run "$R" -- "$HO" fresh --brief ../msg.txt -- feat/bf
  expect_rc "bg 가 실패하면 종료 코드 1" 1
  expect "bg 실패: 도구의 오류를 보여 준다" 'claude: not trusted'
  expect "bg 실패: run 줄" 'run:      sh '
  mkstub "$R/bin/claude"

  # --- 상태 디렉토리 ---
  old=$R/state/worktree-handoff/prompt/old.AAAAAA; : >"$old"; touch -t 202001010000 "$old"
  run "$R" -- "$HO" fresh --brief ../msg.txt --open none -- feat/gc
  check "7일 지난 첫 메시지·런처는 지운다" test ! -e "$old"
}

# === worktree-handoff plan · move · here =======================================
t_modes() {
  local R=$T/md A b n0 s0
  mkroot "$R"
  n0=$(worktrees "$R"); s0=$(state_files "$R")

  # --- plan: 읽기만 한다 ---
  run "$R" CLAUDE_CODE_SESSION_ID=sid-1 -- "$HO" plan --agent claude --tmp "$R/log" feat/p
  expect_rc "plan: 성공" 0
  expect "plan: 지금 체크아웃과 브랜치" "here:     $R/repo"
  expect "plan: 만들 경로와 브랜치가 어디서 오는지" "worktree: $(wtdir "$R" feat-p)   (새로 만든다: main 에서 새 브랜치)"
  expect "plan claude: move ok" 'move:     ok'
  expect "plan claude: fork ok" 'fork:     ok'
  expect "plan claude: fresh ok" 'fresh:    ok'
  expect "plan: tmux 밖의 claude 는 bg" 'open:     bg'
  expect "plan: 세션 이름" 'session:  feat/p@'
  expect "plan: 지시서 본문 경로는 --tmp 아래" "brief:    $R/log/handoff-feat-p-"
  expect_not "plan: 깨끗하면 dirty 줄 없음" 'dirty:'
  run "$R" -- "$HO" plan --agent claude feat/p
  expect "plan claude: 세션 ID 가 없으면 fork 대신 fresh" 'fork:     no → fresh (세션 ID'
  expect "plan: --tmp 가 없으면 TMPDIR" "brief:    $R/tmp/handoff-feat-p-"
  run "$R" -- "$HO" plan --agent cursor feat/p
  expect "plan cursor: move 대신 fresh" 'move:     no → fresh (Cursor 는 채팅을 폴더별로'
  expect "plan cursor: fork 대신 fresh" 'fork:     no → fresh (Cursor CLI 에는'
  expect "plan cursor: fresh ok" 'fresh:    ok'
  expect "plan cursor: tmux 밖이면 none" 'open:     none'
  run "$R" CLAUDE_CODE_SESSION_ID=sid-1 -- "$HO" plan --from claude --agent cursor feat/p
  expect "plan, 도구를 바꿔 넘길 때: 지금 세션은 옮길 수 있다" 'move:     ok'
  expect "plan, 도구를 바꿔 넘길 때: fork 는 fresh 로" 'fork:     no → fresh (대화 기록은 다른 도구로'
  run "$R" -- "$HO" plan --agent claude --base v1 feat/p
  expect "plan: --base 를 보여 준다" '새로 만든다: v1 에서 새 브랜치'
  g "$R/repo" branch has-local
  run "$R" -- "$HO" plan --agent claude has-local
  expect "plan: 있는 로컬 브랜치" '새로 만든다: 있는 로컬 브랜치'
  : >"$R/repo/untracked.txt"
  run "$R" -- "$HO" plan --agent claude feat/p
  expect "plan: 커밋하지 않은 변경 수" 'dirty:    1 '
  /bin/rm -f "$R/repo/untracked.txt"
  run "$R" PATH=/usr/bin:/bin TMUX=fake -- "$HO" plan --agent claude feat/p
  expect "plan: 도구가 없으면 알린다" 'warn:     claude 가 PATH 에 없습니다'
  run "$R" -- "$HO" plan --agent claude main
  expect "plan: 대상이 지금 체크아웃이면 here 로" 'fresh:    no → here'
  expect "plan: 그때 here ok" 'here:     ok'
  expect "plan: 이전 대화에 붙일 이름" 'name:     main@'
  run "$R" -- "$HO" plan --agent claude --here
  expect "plan --here: here ok" 'here:     ok'
  expect "plan --here: 지시서 본문 경로" "brief:    $R/tmp/handoff-main-"
  expect_not "plan --here: 묻지 않은 방식은 내지 않는다" 'fresh:'
  run "$R" -- "$HO" plan --from cursor --here
  expect "plan --here: 지금 세션의 도구(--from)만 본다" 'here:     ok'
  run "$R" -- "$HO" plan --from claude --agent cursor --here
  expect "plan --here: 다른 도구의 세션은 같은 트리에 띄우지 않는다" 'here:     no ('
  run "$R" -- "$HO" plan --agent claude
  expect "plan: 브랜치나 --here 가 있어야 한다" '브랜치 이름이나 --here 를 주세요'
  run "$R" -- "$HO" plan --agent claude --here feat/p
  expect "plan: 둘 다 주면 거부" '함께 쓸 수 없습니다'
  run "$R" -- "$HO" plan --agent claude --brief ../msg.txt feat/p
  expect "plan: --brief 는 받지 않는다" 'plan 에는 --brief 를 쓸 수 없습니다'
  check "plan 은 워크트리를 만들지 않았다" test "$(worktrees "$R")" = "$n0"
  check "plan 은 상태 디렉토리에 아무것도 남기지 않았다" test "$(state_files "$R")" = "$s0"
  check "plan 은 지시서 파일을 만들지 않았다" test "$(find "$R/tmp" "$R/log" -type f | wc -l | tr -d " ")" = 0

  # --- move: 워크트리를 확보하고 들어가는 방법만 알려 준다 ---
  run "$R" -- "$HO" move --agent claude feat/m
  expect_rc "move: 성공" 0
  A=$(wtdir "$R" feat-m)
  expect "move: worktree 줄" "worktree: $A"
  check "move: 그 자리에 워크트리가 생겼다" test -d "$A"
  expect "move claude: EnterWorktree 에 줄 경로" "enter:    EnterWorktree path=$A"
  expect "move claude: 거절되면 ExitWorktree 뒤 다시" 'ExitWorktree action=keep'
  expect "move claude: 마지막은 사용자가 치는 /cd" "cd:       /cd '$A'"
  expect_not "move: 깨끗하면 변경 알림 없음" '따라가지 않는다'
  check "move 는 상태 디렉토리에 아무것도 남기지 않는다" test "$(state_files "$R")" = "$s0"
  check "move 는 도구를 띄우지 않는다" test ! -e "$R/log/claude.log"
  run "$R" -- "$HO" move --agent cursor feat/m2
  expect "move cursor: 거부" 'Cursor 는 채팅을 폴더별로 저장해서'
  check "  워크트리를 만들지 않았다" test ! -d "$(wtdir "$R" feat-m2)"
  run "$R" -- "$HO" move --from claude --agent cursor feat/m
  expect_rc "move: 옮기는 것은 지금 세션의 도구(--from)다" 0
  run "$R" -- "$HO" move --agent claude --brief ../msg.txt feat/m3
  expect "move: --brief 는 받지 않는다" 'move 에는 --brief 를 쓸 수 없습니다'
  : >"$R/repo/untracked.txt"; run "$R" -- "$HO" move --agent claude feat/m; /bin/rm -f "$R/repo/untracked.txt"
  expect "move: 커밋하지 않은 변경은 따라가지 않는다고 알린다" '커밋하지 않은 변경 1개는 따라가지 않는다'
  CWD=$A; run "$R" -- "$HO" move --agent claude feat/m; CWD=""
  expect "move: 이미 그 워크트리면 거부" '지금 이 세션이 있는 체크아웃입니다'
  CWD=$A; run "$R" -- "$HO" plan --agent claude main; CWD=""
  expect "plan: 메인 체크아웃에 있는 브랜치는 넘길 수 없다" 'move:     no (main 는 메인 체크아웃에'
  g "$A" commit -q --allow-empty -m c1; g "$A" branch low; g "$A" commit -q --allow-empty -m c2
  run "$R" -- "$HO" plan --agent claude low
  expect "plan: 스택 워크트리에 든 브랜치는 고르게 한다" 'stack:    골라야 한다. --in-stack'
  run "$R" -- "$HO" move --agent claude --in-stack low
  expect "move --in-stack: 스택 워크트리로" "branch:   low (스택 워크트리, 체크아웃: feat/m)"
  expect "move --in-stack: 고치는 방법을 알린다" 'note:     이 워크트리에는 feat/m 가 체크아웃돼 있고'
  CWD=$A; run "$R" -- "$HO" plan --agent claude low; CWD=""
  expect "plan: 지금 체크아웃이 그 스택 워크트리면 here 로" 'fresh:    no → here'

  # --- here: 지시서를 완성하고 입력할 줄을 알려 준다 ---
  n0=$(worktrees "$R")
  printf 'x\n' >"$A/new.txt"
  CWD=$A; run "$R" -- "$HO" here --agent claude --brief "$R/msg.txt" --start plan
  expect_rc "here: 성공" 0
  b=$(val brief)
  expect "here: 지시서 완성본은 상태 디렉토리에" "brief:    $R/state/worktree-handoff/prompt/here-feat-m."
  check "here: 이름이 .md 로 끝난다" test "${b%.md}" != "$b"
  expect "here claude: /clear 에 이전 대화 이름" 'type:     /clear feat-m@'
  expect "here claude: 설계부터면 /plan 으로 지시서를 @ 로 읽힌다" "type:     /plan @$b 를 읽고 시작해"
  expect "here claude: 돌아가는 방법" 'back:     /resume feat-m@'
  out=$(cat "$b")
  expect "here 지시서: 작업 디렉토리와 브랜치" "- 작업 디렉토리: $A (브랜치 feat/m)"
  expect "here 지시서: 메인 체크아웃은 고치지 않는다" "- 메인 체크아웃($R/repo)의 파일은 읽기만"
  expect "here 지시서: 설계부터" '- 시작: 설계부터'
  expect "here 지시서: 커밋하지 않은 변경 목록" '      ?? new.txt'
  want=$(cat "$R/msg.txt")
  expect "here 지시서: 본문이 글자 그대로" "$want"
  run "$R" -- "$HO" here --agent claude --brief "$R/msg.txt" --name before-redesign
  expect "here: --name 으로 이전 대화 이름" 'type:     /clear before-redesign'
  expect "here claude: 구현부터면 지시서를 @ 로 읽힌다" "type:     @$(val brief) 를 읽고 시작해"
  expect_not "here: 구현부터면 /plan 을 쓰지 않는다" '/plan'
  run "$R" -- "$HO" here --agent claude --brief "$R/msg.txt" --name 'two words'
  expect "here: 이름에 공백은 거부" '공백을 쓸 수 없습니다'
  run "$R" -- "$HO" here --agent cursor --brief "$R/msg.txt" --start plan
  expect_not "here cursor: /clear 에 이름을 붙이지 않는다" '/clear feat-m'
  expect "here cursor: 설계부터면 /plan 으로 시작" 'type:     /plan '
  run "$R" -- "$HO" here --from cursor --brief "$R/msg.txt"
  expect "here cursor: 지시서 경로를 읽힌다 (--from 만 줘도 된다)" '.md 파일을 읽고 시작해'
  s0=$(state_files "$R")
  run "$R" -- "$HO" here --from claude --agent cursor --brief "$R/msg.txt"
  expect "here: 다른 도구의 세션은 같은 트리에 띄우지 않는다" '한 트리를 두 세션이 고칩니다'
  run "$R" -- "$HO" here --agent claude
  expect "here: 지시서가 없으면 거부" 'here 에는 지시서가 필요합니다'
  run "$R" -- "$HO" here --agent claude --brief "$R/blank.txt"
  expect_rc "here: 없는 지시서 파일은 거부" 1
  run "$R" -- "$HO" here --agent claude --brief "$R/msg.txt" feat/x
  expect "here: 브랜치는 받지 않는다" '브랜치를 받지 않습니다'
  run "$R" -- "$HO" here --agent claude --brief "$R/msg.txt" --open none
  expect "here: --open 은 받지 않는다" 'here 에는 --open 를 쓸 수 없습니다'
  check "거절된 here 는 아무것도 남기지 않았다" test "$(state_files "$R")" = "$s0"
  CWD=""
  check "here 는 워크트리를 만들지 않았다" test "$(worktrees "$R")" = "$n0"
  check "here 는 도구를 띄우지 않는다" test ! -e "$R/log/claude.log" -a ! -e "$R/log/agent.log"
  run "$R" -- "$HO" here --agent claude --brief ../msg.txt
  out=$(cat "$(val brief)")
  expect_not "here 지시서: 메인 체크아웃에서는 메인 줄이 없다" '메인 체크아웃('
  expect "here 지시서: 깨끗하면 그렇다고 적는다" '커밋하지 않은 변경은 없다'
  expect "here 지시서: 기본은 구현부터" '- 시작: 구현부터'
}

# === tmux (격리된 서버) =========================================================
t_tmux() {
  local TMUX_BIN M sock i wtp want
  TMUX_BIN=$(command -v tmux || true)
  [ -n "$TMUX_BIN" ] || { echo "skip tmux (tmux 없음)"; return 0; }
  M=$T/tm; mkroot "$M"; sock="jwtest$$"
  # 패널 셸을 로그인 셸로 띄우지 않는다. 로그인 셸은 /etc/profile 로 PATH 를 다시 짜서, 진짜 claude 가 깔린 곳이 가짜 도구보다
  # 앞에 올 수 있다 (그러면 진짜 claude 가 뜬다)
  printf '%s\n' 'set -g default-command "exec /bin/sh"' >"$M/tmux.conf"
  tm() { "$TMUX_BIN" -L "$sock" -f "$M/tmux.conf" "$@"; }
  ( cd "$M/repo" && env -i HOME="$M/home" PATH="$M/bin:$(dirname "$TMUX_BIN"):/usr/bin:/bin" SHELL=/bin/sh TERM=xterm-256color \
      XDG_STATE_HOME="$M/state" XDG_CONFIG_HOME="$M/config" XDG_DATA_HOME="$M/data" STUB_LOG_DIR="$M/log" \
      LC_ALL="$LOC" "$TMUX_BIN" -L "$sock" -f "$M/tmux.conf" new-session -d -s main -x 200 -y 50 )
  tm new-session -d -s other -x 80 -y 24   # 가장 최근 세션은 other. 윈도우는 부른 패널의 세션(main)에 생겨야 한다
  inside() {   # inside <브랜치> <가짜 도구 로그> <worktree-handoff 인자…> : main 세션의 첫 패널에서 돌리고 끝나길 기다린다
    local br=$1 logname=$2; shift 2
    wtp=$(wtdir "$M" "${br//\//-}"); i=0
    /bin/rm -f "$M/done"
    tm send-keys -t main:0.0 "/bin/bash '$HO' fresh --brief ../msg.txt $* -- '$br' >'$M/out.txt' 2>&1; echo \$? >'$M/done'" Enter
    while [ ! -s "$M/done" ] && [ $i -lt 50 ]; do sleep 0.2; i=$((i + 1)); done
    i=0; while ! grep -qF "cwd=$wtp" "$M/log/$logname.log" 2>/dev/null && [ $i -lt 50 ]; do sleep 0.2; i=$((i + 1)); done
    sleep 0.3
    out=$(cat "$M/out.txt" 2>/dev/null); rc=$(cat "$M/done" 2>/dev/null)
  }
  inside feat/t1 claude
  expect_rc "tmux 안의 claude: 성공" 0
  expect "tmux: 부른 패널의 세션에 윈도우를 연다" 'open:     tmux main:1 (feat/t1)'
  expect_not "tmux: run 줄 없음" 'run:'
  out=$(tm list-windows -t main -F '#{window_name}|#{pane_start_path}|#{@worktree}')
  expect "tmux: 윈도우 이름과 시작 경로. 표지는 붙이지 않는다" "feat/t1|$(wtdir "$M" feat-t1)|"
  out=$(cat "$M/log/claude.log")
  expect "tmux: 가짜 claude 가 그 워크트리에서 실행" "cwd=$(wtdir "$M" feat-t1)"
  expect "tmux: 세션 이름을 받았다" 'arg2=<<feat/t1@'
  check "tmux: 지금 보는 윈도우는 그대로다 (-d)" test "$(tm display -p -t main '#{window_index}')" = 0

  inside feat/t1 claude
  expect "tmux: 그 워크트리의 윈도우가 있으면 새 윈도우를 열지 않는다" 'open:     tmux main:1 (feat/t1)'
  check "tmux: 대신 거기에 패널을 연다" test "$(tm list-panes -t main:1 | wc -l | tr -d ' ')" = 2
  check "tmux: 윈도우 수는 그대로" test "$(tm list-windows -t main | wc -l | tr -d ' ')" = 2

  # 윈도우는 패널의 경로로 찾는다 (표지를 붙이지도 읽지도 않는다). 예전 버전이 남긴 표지가 있어도 따라가지 않는다:
  # 표지만 있고 그 워크트리의 패널이 없는 창은 그 워크트리의 창이 아니다
  tm set-option -w -t main:0 @worktree "$(wtdir "$M" feat-t9)"
  inside feat/t9 claude
  expect "tmux: 남아 있는 옛 표지를 따라가지 않고 새 윈도우를 연다" 'open:     tmux main:2 (feat/t9)'
  tm set-option -w -u -t main:0 @worktree; tm kill-window -t main:2

  inside feat/t2 agent --agent cursor
  expect_rc "tmux 안의 cursor: 성공" 0
  out=$(cat "$M/log/agent.log")
  expect "tmux: 가짜 agent 가 -- 다음에 첫 메시지를 받았다" 'arg1=<<-->>'
  want=$(printf '%s>>' "$(cat "$M/msg.txt")")
  expect "tmux: 지시서 본문이 글자 그대로" "$want"

  inside 'fix/#H' claude
  out=$(tm list-windows -t main -F '#{window_name}|#{pane_start_path}')
  expect "tmux: 브랜치의 # 을 형식 문자로 읽지 않는다" "fix/#H|$(wtdir "$M" 'fix-#H')"
  tm kill-server 2>/dev/null
}

# === pr-review-fetch 의 local (가짜 gh) ========================================
t_fetch() {
  local JQ R W1 top c1 extra
  JQ=$(command -v jq || true)
  [ -n "$JQ" ] || { echo "skip fetch (jq 없음)"; return 0; }
  R=$T/pf; mkroot "$R" claude
  cat >"$R/bin/gh" <<'GH'
#!/bin/sh
# 가짜 gh: PR #7 (head 는 STUB_HEAD 브랜치·STUB_OID 커밋) 과 스택 main ← #8 (s8) ← #9 (s9) ← #10 (s10), 리뷰는 모두 비었다.
# 인자에 nope 가 든 PR 은 없다. pr view 를 부른 인자는 STUB_LOG_DIR/gh-view.log 에 남긴다
empty() { printf '{"data":{"repository":{"pullRequest":{"%s":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[]}}}}}\n' "$1"; }
pr() {   # pr <번호> : PR 하나의 JSON
  case $1 in
    8) h=s8 b=main ;; 9) h=s9 b=s8 ;; 10) h=s10 b=s9 ;; *) h=$STUB_HEAD b=main ;;
  esac
  printf '{"number":%s,"url":"https://github.com/o/r/pull/%s","title":"t%s","body":"","author":{"login":"me"},"state":"OPEN","baseRefName":"%s","headRefName":"%s","headRefOid":"%s","isCrossRepository":false}' \
    "$1" "$1" "$1" "$b" "$h" "$STUB_OID"
}
case "$1 $2" in
  "pr view")
    a=$3; echo "$a" >>"${STUB_LOG_DIR:?}/gh-view.log"
    case $a in *nope*) echo "no pull requests found for branch \"$a\"" >&2; exit 1 ;; esac
    n=$(printf '%s' "$a" | sed -n 's#^.*/pull/##; s#^s\([0-9][0-9]*\)$#\1#; /^[0-9][0-9]*$/p')
    pr "${n:-7}"; echo ;;
  "pr list")
    shift 2; want=""
    while [ $# -gt 0 ]; do case $1 in --head) want="h $2"; shift ;; --base) want="b $2"; shift ;; esac; shift; done
    sep=""; printf '['
    for n in 8 9 10; do
      j=$(pr "$n")
      case "$want" in
        "h s$n") ;;
        "b main") [ "$n" = 8 ] || continue ;;
        "b s"*) [ "s$((n - 1))" = "${want#b }" ] || continue ;;
        *) continue ;;
      esac
      printf '%s%s' "$sep" "$j"; sep=,
    done
    echo ']' ;;
  "api graphql")
    case "$*" in
      *reviewThreads*) empty reviewThreads ;;
      *"reviews(first"*) empty reviews ;;
      *) empty comments ;;
    esac ;;
  *) echo "가짜 gh: 모르는 호출: $*" >&2; exit 1 ;;
esac
GH
  chmod +x "$R/bin/gh"
  g "$R/repo" remote add origin https://github.com/o/r.git
  fetch() {   # fetch <브랜치> <커밋> : $out 에 local 블록 (JSON 한 줄)
    run "$R" PATH="$R/bin:$(dirname "$JQ"):/usr/bin:/bin" STUB_HEAD="$1" STUB_OID="$2" -- "$PF" 7
    [ "$rc" = 0 ] || { no "pr-review-fetch 실행 ($1)" "$out"; return; }
    out=$(printf '%s\n' "$out" | "$JQ" -c .local)
  }

  run "$R" -- "$BW" ensure pr/self; W1=$(wtdir "$R" pr-self)
  fetch pr/self "$(git -C "$R/repo" rev-parse pr/self)"
  expect "self: PR 브랜치가 체크아웃된 워크트리" "\"checkout\":\"self\",\"worktree\":\"$W1\",\"worktree_branch\":\"pr/self\""
  expect "self: 지금 그 안은 아니다" '"in_worktree":false'
  expect "self: 미커밋 변경 없음" '"worktree_dirty":false'
  expect "self: PR head 와 같다" '"ahead_of_pr_head":0,"behind_pr_head":0'
  expect_not "안 쓰던 필드는 없다 (pr_worktree)" 'pr_worktree'
  expect_not "뜻이 겹치던 필드는 없다 (uncommitted_changes)" 'uncommitted_changes'
  : >"$W1/untracked"
  CWD=$W1; fetch pr/self "$(git -C "$R/repo" rev-parse pr/self)"; CWD=""
  expect "self: 그 워크트리 안에서 부르면" '"in_worktree":true'
  expect "self: 미커밋 변경이 있으면" '"worktree_dirty":true'

  run "$R" -- "$BW" ensure pr/top; top=$(wtdir "$R" pr-top)
  g "$top" commit -q --allow-empty -m c1; c1=$(git -C "$top" rev-parse HEAD)
  g "$top" branch pr/low
  g "$top" commit -q --allow-empty -m c2
  fetch pr/low "$c1"
  expect "stack: 그 브랜치를 품은 워크트리와 위 브랜치" "\"checkout\":\"stack\",\"worktree\":\"$top\",\"worktree_branch\":\"pr/top\""
  expect "stack: 다시 쌓을 것 없음" '"stack_needs_restack":false'
  expect "stack: 위 브랜치의 작업 트리 상태" '"worktree_dirty":false'

  extra=$(git -C "$R/repo" commit-tree -p pr/low -m extra 'pr/low^{tree}')
  g "$R/repo" update-ref refs/heads/pr/low "$extra"
  fetch pr/low "$c1"
  expect "stale: 로컬 브랜치에만 새 커밋이 있어도 PR head 로 스택 워크트리를 찾는다" "\"checkout\":\"stack\",\"worktree\":\"$top\""
  expect "stale: 다시 쌓아야 한다" '"stack_needs_restack":true'
  expect "stale: 로컬이 PR head 보다 한 커밋 앞" '"ahead_of_pr_head":1'

  g "$R/repo" update-ref refs/heads/pr/alone "$(git -C "$R/repo" commit-tree -p main -m alone 'main^{tree}')"
  fetch pr/alone "$(git -C "$R/repo" rev-parse pr/alone)"
  expect "none: 체크아웃도 품은 워크트리도 없다" '"checkout":"none","worktree":null'
  expect "none: 작업 트리 상태는 없다" '"worktree_dirty":null'
  fetch pr/nowhere "$(git -C "$R/repo" rev-parse main)"
  expect "로컬에 브랜치가 없으면 branch_head 가 없다" '"branch_head":null'

  # --- 인자 해석, 여러 PR, 개수 제한, --range ---
  local M; M=$(git -C "$R/repo" rev-parse main)
  pf() { : >"$R/log/gh-view.log"; run "$R" PATH="$R/bin:$(dirname "$JQ"):/usr/bin:/bin" STUB_HEAD=pr/alone STUB_OID="$M" -- "$PF" "$@"; }
  jqo() { printf '%s\n' "$out" | grep -v '^/bin/bash: warning: setlocale' | "$JQ" -c "$1" 2>&1; }   # jqo <필터> : 출력 JSON 에서 고른 것

  pf '#9'
  check "#12 꼴은 # 을 떼고 gh 에 넘긴다" test "$(cat "$R/log/gh-view.log")" = 9
  out=$(jqo .pr.number); expect "#9 → PR #9" 9
  pf 8 https://github.com/o/r/pull/10 '#8' s9
  expect_rc "여러 PR: 성공" 0
  out=$(jqo '[.prs[].pr.number]'); expect "여러 PR: 중복을 빼고 준 순서대로" '[8,10,9]'
  pf 8 https://github.com/o/r/pull/10 '#8' s9
  out=$(jqo '.multi.requested'); expect "여러 PR: 준 인자를 그대로 남긴다" '["8","https://github.com/o/r/pull/10","8","s9"]'
  pf 8 https://github.com/o/r/pull/10 '#8' s9
  out=$(jqo '.multi.warnings | join(" / ")')
  expect "여러 PR: 중복 경고" '같은 PR #8 을 여러 번 줬다'
  expect "여러 PR: 위아래로 쌓인 PR 이면 --stack 을 권한다" '#9 은 #8 위에 쌓인 PR 이다'
  pf 8 nope-1 9 nope-2
  expect_rc "여러 PR: 못 찾은 인자가 있으면 멈춘다" 1
  expect "여러 PR: 못 찾은 인자를 모두 알려 준다" 'PR 을 찾지 못한 인자: nope-1 (no pull requests found for branch "nope-1") nope-2'
  expect "여러 PR: 찾은 것도 알려 준다" '찾은 것: 8 → #8, 9 → #9'
  check "여러 PR: 못 찾으면 리뷰를 모으지 않았다 (pr view 를 인자마다 한 번만)" test "$(wc -l <"$R/log/gh-view.log" | tr -d ' ')" = 4
  pf 8 9 --stack
  expect_rc "여러 PR 과 --stack 은 함께 쓰지 않는다" 1
  pf 8 --range 1-2
  expect_rc "--range 는 --stack 과만" 1

  pf 7 8 9 --max 2
  expect_rc "개수 초과: 종료 코드 3" 3
  out=$(jqo '.over_limit | [.mode, .count, .max, (.targets | map(.number))]'); expect "개수 초과: 대상 목록만 낸다" '["multi",3,2,[7,8,9]]'
  pf 7 8 9 --max 3
  expect_rc "개수가 max 와 같으면 모은다" 0
  pf 7 8 9 10 6 5 --max all
  out=$(jqo '.prs | length'); expect "--max all 이면 개수를 따지지 않는다" 6

  pf 9 --stack
  expect_rc "스택: 3개면 기본 max(5) 안이다" 0
  out=$(jqo '[.stack.order[] | [.position, .number, .parent, .selected]]'); expect "스택: 아래→위 위치·부모" '[[1,8,null,true],[2,9,8,true],[3,10,9,true]]'
  pf 9 --stack
  out=$(jqo '.stack.order[0].head_oid'); expect "스택: order 에 head_oid" "\"$M\""
  pf 9 --stack --max 2
  expect_rc "스택 개수 초과: 종료 코드 3" 3
  out=$(jqo '.over_limit | [.mode, .count, .total, (.order | map(.number))]'); expect "스택 개수 초과: 스택 전체 목록을 낸다" '["stack",3,3,[8,9,10]]'
  pf 9 --stack --range 2- --max 2
  expect_rc "--range: 고른 수가 max 안이면 모은다" 0
  out=$(jqo '[([.prs[].pr.number]), .stack.range, ([.stack.order[] | .selected])]')
  expect "--range 2-: 위치 2 부터 끝까지만 모으고 order 는 전체" '[[9,10],{"from":2,"to":3,"total":3},[false,true,true]]'
  pf 10 --stack --range 1
  out=$(jqo '[.prs[].pr.number]'); expect "--range 1: 맨 아래 하나" '[8]'
  pf 9 --stack --range 2-4
  expect_rc "--range: 스택 밖이면 멈춘다" 1
  expect "--range: 스택 크기를 알려 준다" '이 스택은 1-3'
  pf 9 --stack --range 0-2
  expect_rc "--range: 위치는 1 부터" 1
}

[ $# -gt 0 ] || set -- worktree handoff modes tmux fetch
for s in "$@"; do
  case $s in
    worktree|handoff|modes|tmux|fetch) echo "== $s"; "t_$s" ;;
    *) echo "모르는 절: $s (worktree | handoff | modes | tmux | fetch)" >&2; exit 2 ;;
  esac
done
echo
echo "pass=$pass fail=$fail"
[ "$fail" = 0 ] && /bin/rm -rf "$T" || echo "임시 디렉토리를 남겼다: $T"
[ "$fail" = 0 ]
