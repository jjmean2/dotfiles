# 패턴은 소스 경로가 아니라 대상(홈 기준) 경로에 매칭된다. 파일 전체가 템플릿으로 해석된다.

# 다른 OS 전용 파일(.darwin/.linux 토큰이 붙은 파일)은 설치하지 않는다.
{{ if ne .chezmoi.os "darwin" -}}
**/*.darwin
**/*.darwin.*
{{ end -}}
{{ if ne .chezmoi.os "linux" -}}
**/*.linux
**/*.linux.*
{{ end -}}

# mpv 의 include 는 대상 파일이 없으면 에러를 내므로 플랫폼 파일을 OS 와 상관없이 빈 파일로 만들어 둔다.
# (exclude(!)는 위의 include 보다 항상 우선한다)
!.config/mpv/mpv.darwin.conf
!.config/mpv/mpv.linux.conf

# ghostty 테마 선택기가 써넣는 머신별 덮어쓰기 파일. 기본값은 config.ghostty 의 theme 에 있다.
.config/ghostty/auto/theme.ghostty

# mise 의 머신 전용 전역 설정. 공유 기본값은 .config/mise/conf.d/shared.toml 에 있다.
.config/mise/config.toml

# 이 머신에서 꺼진 기능의 전용 설정은 배포하지 않는다. 경로는 .chezmoidata/packages.yaml 의
# packages.features.<이름>.ignore 에 있고, 켜졌는지는 .chezmoitemplates/enabled-features 가 정한다.
# 여기서 빠진 경로는 관리만 멈출 뿐 이미 있는 파일을 지우지는 않는다.
# 예: ide 가 꺼진 머신에는 ~/.config/nvim(LazyVim) 없이 플러그인 없는 ~/.config/nvim-lite 만 배포되고,
# 셸이 그것을 고른다 (shell/profile.sh 의 NVIM_APPNAME).
{{ $on := includeTemplate "enabled-features" . | fromJson -}}
{{ range $name, $def := .packages.features -}}
{{ if not (has $name $on) -}}
{{ range (dig "ignore" list $def) -}}
{{ . }}
{{ end -}}
{{ end -}}
{{ end -}}

# nvim 상태 파일 두 개.
# - lazyvim.json (LazyVim 의 extras 목록): git 으로 추적하되 배포하지 않는다. LazyVim 이 소스 디렉터리의
#   파일에 직접 쓰도록 lua/config/lazy.lua.tmpl 의 vim.g.lazyvim_json 이 가리키고 있어서, 여기서 빼지
#   않으면 같은 파일의 복사본이 ~/.config/nvim 에 하나 더 생기고 apply 때마다 덮어쓰려 한다.
# - lazy-lock.json (lazy.nvim lockfile): 머신 상태라 저장소에 없다. lazy.nvim 이 ~/.config/nvim 에
#   직접 쓰는 관리 밖 파일이다. `chezmoi add ~/.config/nvim` 같은 일괄 추가로 딸려 들어오지 않게 막아 둔다.
.config/nvim/lazy-lock.json
.config/nvim/lazyvim.json
