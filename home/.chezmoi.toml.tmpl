{{- /* chezmoi init 시 ~/.config/chezmoi/chezmoi.toml 을 생성하는 템플릿. 설계는 docs/machines.md.
       이 템플릿에서는 .chezmoidata(packages.yaml)를 읽을 수 없다. 그래서 기능 목록과 기본값은 여기 없고,
       여기서는 이 머신에 대한 답(신원, 등급, 사람이 정해야 하는 기능)만 묻는다. */ -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- /* git 커밋에 쓰는 이름. 저장소에 개인 이름을 박아 두지 않으려고 이메일처럼 머신에서 묻는다. */ -}}
{{- $name := promptStringOnce . "name" "Full name (git user.name)" -}}

{{- /* 머신 등급. minimal = true 면 필수 도구와 설정만 깐다 (서버·dev container 처럼 잠깐 쓰는 곳).
       tier 가 full 인 기능(packages.yaml 의 packages.features)이 꺼진다.
       질문 없이 init 하려면 chezmoi init --promptBool minimal=true 처럼 미리 답을 준다.
       --promptBool 의 키는 경로가 아니라 질문 문구 자체라서, 문구를 짧은 "minimal" 로 고정해 둔다.
       이전 구조(profile = personal | work | ephemeral)로 init 한 머신은 묻지 않고 그 값에서 옮긴다. */ -}}
{{- $legacy := and (hasKey . "profile") (not (hasKey . "minimal")) -}}
{{- $minimal := false -}}
{{- if $legacy -}}
{{-   $minimal = eq .profile "ephemeral" -}}
{{- else -}}
{{-   $minimal = promptBoolOnce . "minimal" "minimal" false -}}
{{- end -}}

{{- /* 기능 스위치. 이 머신에서 기본값과 다르게 둘 것만 적는다 (규칙은 .chezmoitemplates/enabled-features).
       - 이미 적혀 있는 것은 그대로 옮겨 적는다. init 은 이 파일을 통째로 다시 쓰므로, 옮기지 않으면
         chezmoi edit-config 로 적어 둔 값이 사라진다.
       - 이전 구조는 ide·dev·credentials 를 프로필 기본값으로 채워 적어 두었다. 그 값이 기본값 그대로면
         지워서 앞으로는 저장소의 선언(tier)을 따르게 하고, 다르면 사람이 바꾼 것이므로 남긴다. */ -}}
{{- $features := dict -}}
{{- range $k, $v := (dig "features" dict .) -}}
{{-   $_ := set $features $k $v -}}
{{- end -}}
{{- if $legacy -}}
{{-   range $k := list "ide" "dev" "credentials" -}}
{{-     if and (hasKey $features $k) (eq (index $features $k) (not $minimal)) -}}
{{-       $_ := unset $features $k -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- /* 사람이 정해야 하는 기능만 묻는다 (tier: opt-in 인 기능의 답을 적어 두는 자리).
       karabiner: 보안 소프트웨어가 관리하는 머신에서는 설치하면 안 된다. */ -}}
{{- if and (eq .chezmoi.os "darwin") (not $minimal) -}}
{{-   $_ := set $features "karabiner" (promptBoolOnce . "features.karabiner" "Karabiner-Elements 설치 (보안 소프트웨어가 관리하는 머신이면 n)" true) -}}
{{- end -}}

{{- /* 기본 위치(~/.local/share/chezmoi)가 아닌 곳의 저장소로 init 한 경우에도 그 위치를 유지한다. */ -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
  email = {{ $email | quote }}
  name = {{ $name | quote }}
  # true 면 필수 도구와 설정만 깐다 (tier 가 full 인 기능이 꺼진다)
  minimal = {{ $minimal }}

# 기능 스위치: 이 머신에서 기본값과 다르게 둘 것만 <이름> = true / false 로 적는다.
# 적지 않은 기능은 저장소의 선언을 따른다. 목록과 기본값은 저장소의 home/.chezmoidata/packages.yaml,
# 지금 켜진 것은 chezmoi execute-template '{{ "{{" }} includeTemplate "enabled-features" . {{ "}}" }}'
# 꺼도 이미 설치된 것은 지우지 않는다 (관리만 멈춘다). 바꾼 뒤 chezmoi apply.
[data.features]
{{- range $k, $v := $features }}
  {{ $k }} = {{ $v }}
{{- end }}
