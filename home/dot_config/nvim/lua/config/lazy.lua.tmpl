-- LazyVim starter 의 lua/config/lazy.lua 와 같다. 다른 점은 아래 두 가지뿐이다.
--
-- 1. lazyvim.json (:LazyExtras 로 켠 extras 목록, 읽은 NEWS 버전) 은 공용 시작점이라 git 으로
--    추적한다. 기본 위치(stdpath("config"))는 chezmoi 가 배포하는 쪽이라, 거기 두면 바뀔 때마다
--    chezmoi add 로 되가져와야 한다. 대신 LazyVim 이 저장소(chezmoi 소스 디렉터리)의 파일에 직접
--    쓰게 하고 .chezmoiignore 로 배포에서 뺀다. 그래서 이 파일만 .tmpl 이다: 소스 경로가 머신마다 다르다.
-- 2. lazy-lock.json 은 머신 상태라 기본 위치(~/.config/nvim/lazy-lock.json, 관리 밖)에 둔다.
--    lazy.nvim 은 병합된 spec 의 플러그인을 전부 기록하므로 관리 밖 lua/plugins/local-*.lua 로 더한
--    머신 전용 플러그인도 들어간다. 저장소에 두면 그 이름이 공개 저장소로 올라가고, 머신마다 서로
--    지우고 넣는 diff 가 생긴다. 대신 업데이트를 되돌릴 git 기록이 없으므로 아래에서 백업한다.
local source = {{ printf "%s/dot_config/nvim" .chezmoi.sourceDir | quote }}

-- LazyVim 이 플러그인을 로드할 때 읽으므로 lazy.setup 보다 먼저 정한다 (lazyvim/config/init.lua).
vim.g.lazyvim_json = source .. "/lazyvim.json"

-- lockfile 백업: lazy.nvim 은 :Lazy update / sync / restore 가 끝나면 lockfile 을 새 commit 으로
-- 덮어쓰므로, 그 상태로는 :Lazy restore 로 업데이트 전으로 돌아갈 수 없다. 시작 직전(…Pre 이벤트)에
-- stdpath("state")/lazy-lock-backups/ 에 시각을 붙여 복사하고 최근 10개만 남긴다.
-- 되돌리기: 백업을 ~/.config/nvim/lazy-lock.json 으로 복사한 뒤 :Lazy restore (README 의 nvim 절).
vim.api.nvim_create_autocmd("User", {
  pattern = { "LazyUpdatePre", "LazyRestorePre" }, -- sync 도 update 를 거치므로 LazyUpdatePre 가 온다
  callback = function()
    local lockfile = vim.fn.stdpath("config") .. "/lazy-lock.json" -- lazy.nvim 기본값
    if not vim.uv.fs_stat(lockfile) then
      return
    end
    local dir = vim.fn.stdpath("state") .. "/lazy-lock-backups"
    vim.fn.mkdir(dir, "p")
    vim.uv.fs_copyfile(lockfile, dir .. "/lazy-lock." .. os.date("%Y%m%d-%H%M%S") .. ".json")
    local backups = vim.fn.glob(dir .. "/lazy-lock.*.json", false, true) -- 이름이 시각이라 정렬 = 시간순
    table.sort(backups)
    for i = 1, #backups - 10 do
      vim.uv.fs_unlink(backups[i])
    end
  end,
})

local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
if not (vim.uv or vim.loop).fs_stat(lazypath) then
  local lazyrepo = "https://github.com/folke/lazy.nvim.git"
  local out = vim.fn.system({ "git", "clone", "--filter=blob:none", "--branch=stable", lazyrepo, lazypath })
  if vim.v.shell_error ~= 0 then
    vim.api.nvim_echo({
      { "Failed to clone lazy.nvim:\n", "ErrorMsg" },
      { out, "WarningMsg" },
      { "\nPress any key to exit..." },
    }, true, {})
    vim.fn.getchar()
    os.exit(1)
  end
end
vim.opt.rtp:prepend(lazypath)

require("lazy").setup({
  spec = {
    -- add LazyVim and import its plugins
    { "LazyVim/LazyVim", import = "lazyvim.plugins" },
    -- import/override with your plugins
    { import = "plugins" },
  },
  defaults = {
    -- By default, only LazyVim plugins will be lazy-loaded. Your custom plugins will load during startup.
    -- If you know what you're doing, you can set this to `true` to have all your custom plugins lazy-loaded by default.
    lazy = false,
    -- It's recommended to leave version=false for now, since a lot the plugin that support versioning,
    -- have outdated releases, which may break your Neovim install.
    version = false, -- always use the latest git commit
    -- version = "*", -- try installing the latest stable version for plugins that support semver
  },
  install = { colorscheme = { "tokyonight", "habamax" } },
  checker = {
    enabled = true, -- check for plugin updates periodically
    notify = false, -- notify on update
  }, -- automatically check for plugin updates
  performance = {
    rtp = {
      -- disable some rtp plugins
      disabled_plugins = {
        "gzip",
        -- "matchit",
        -- "matchparen",
        -- "netrwPlugin",
        "tarPlugin",
        "tohtml",
        "tutor",
        "zipPlugin",
      },
    },
  },
})
