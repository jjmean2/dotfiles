#!/usr/bin/env bash
# tmux-dev worktree: 지금 세션에 윈도우를 연다 (prefix W). 출처는 세 모드다.
#
# 멘탈 모델 (자세히: ../worktree-picker.md. 공용 규칙은 ../session-picker.md)
#   W 가 만드는 것은 윈도우다. 세션은 그대로 두고 그 안에 윈도우를 연다(이미 있으면 그리로 간다).
#   worktree      세션 디렉토리가 git 저장소일 때만. 워크트리 = 브랜치 = 윈도우. 없으면 워크트리를 만들어 준다
#   subdirectory  세션 디렉토리 아래의 아무 디렉토리. directory 와 같은 흐름이고 시작 경로만 제한한다
#   directory     홈 전체의 아무 디렉토리 (prefix S 의 디렉토리 모드와 같은 탐색). 열면 지금 세션의 윈도우가 된다
#   세션 디렉토리 = 세션 옵션 @tmux-dev-path (prefix S 가 붙인다), 없으면 session_path. 패널의 cwd 가 아니다.
#   tmux 의 세션·윈도우를 대체하지 않고 그 위에 얹는 관례다. prefix c 의 보통 윈도우, 순정 `tmux new -c <워크트리>` 모두 정상.
#   순정 대응은 `git worktree add -b <브랜치> <경로> main` + `tmux new-window -n <브랜치> -c <경로>`.
#
# 사용
#   tmux-dev worktree                    피커 (tmux 안에서는 prefix W 가 띄운다)
#   tmux-dev worktree <브랜치>           바로 그 브랜치의 윈도우로 (브랜치·워크트리가 없으면 묻고 만든다)
#   tmux-dev worktree <워크트리 경로>    바로 그 워크트리의 윈도우로
#   tmux-dev worktree <디렉토리>         워크트리가 아닌 디렉토리면 그 디렉토리의 윈도우로 (tmux 안에서만)
#   tmux-dev worktree --base <ref>       새 브랜치의 베이스 (기본: 로컬 main. origin/HEAD 가 가리키는 이름)
#   tmux-dev worktree --layout <이름>    새 윈도우의 레이아웃. 없으면 저장소 설정(git config tmux-dev.layout) →
#                                        전역(@tmux-dev-layout) → ide 순 (lib/layout.sh). --layouts 로 목록
#   tmux-dev worktree -t <세션>          윈도우를 만들 세션 (기본: 지금 클라이언트의 세션)
#   tmux-dev worktree --path <브랜치>    그 브랜치의 워크트리가 만들어질 경로만 출력
#   tmux-dev worktree --list [worktree|subdirectory|directory] [--marks]   후보 목록만 출력 (디버그)
#   tmux-dev worktree --archived         보관된 브랜치 목록 (복구: git branch <이름> refs/archive/<날짜>/<이름>)
#   tmux 밖에서 실행하면 워크트리만 만들고(있으면 그대로) 경로를 출력한다.
#
# 피커 (fzf 순정 키는 그대로. 아래는 비어 있던 키와, 같은 뜻으로 덮은 enter·esc·tab)
#   alt-m / alt-n     모드 다음 / 이전 (왼쪽 Option. n 이 m 의 왼쪽이라 뒤로. 맨 위 모드 이름을 클릭해도). 저장소가 아니면 worktree 모드가 없다
#   tab / shift-tab   선택 토글 (fzf 순정, worktree 모드에서만). 선택은 정리(ctrl-x)에만 쓴다. enter 는 늘 커서 항목을 연다
#   ctrl-t            토글: 선택이 없으면 merged 인 워크트리·브랜치를 모두 선택, 있으면 모두 풀기 (t = toggle)
#   enter             커서 항목으로. 열린 윈도우가 있으면 그리로, 없으면 만든다
#                     worktree 모드에서 만들어야 하는 것(브랜치, 원격 브랜치, 사라진 워크트리)은 푸터에서 먼저 묻는다:
#                       enter 만들기 · alt-l 레이아웃 골라 만들기 · esc 취소 (커서를 옮기거나 글자를 치면 취소)
#   alt-enter         worktree: 친 이름으로 새 브랜치 + 워크트리 (베이스에서 분기, 푸터에서 묻는다)
#                     subdirectory / directory: 친 이름으로 새 디렉토리 (prefix S 와 같은 위치 피커. 경로를 치면 그 자리에)
#   alt-l             레이아웃을 골라서 열기 (이번만. 레이아웃 목록의 alt-enter 는 worktree 모드에서 저장소 기본으로도 저장)
#   ctrl-x            worktree 모드에서 커서 항목 정리 (워크트리, 로컬 브랜치). 정리 목록이 겹쳐 뜬다: clean up(창 → 워크트리 →
#                     백업 → 브랜치 삭제, 머지 안 됐으면 푸터에서 한 번 더) / keep branch(창 → 워크트리 제거까지). 미리보기가 할 일을
#                     보여 준다. 선택이 있으면 선택 전체(clean up N / keep branches. 못 하는 것은 건너뛰고 이유별 개수를 결과에). 푸터에서 묻고(enter · esc), 브랜치가 머지 안 됐으면
#                     한 번 더 묻는다. 창 닫기 → 워크트리 제거 → refs/archive/<날짜>/<브랜치> 백업(-2, -3) → 브랜치 삭제.
#                     메인 체크아웃·베이스 브랜치·원격 브랜치·locked 는 하지 않고, dirty 면 실패한다. 피커는 열린 채로 남는다.
#                     워크트리는 .trash/ 로 옮겨 바로 비우고 실제 삭제는 뒤에서 한다. 정리하는 동안 푸터에 스피너와 진행이 돈다
#   alt-p             미리보기 오른쪽 → 아래 → 숨김
#   alt-h             키 안내를 미리보기 자리에
#   esc               닫기 (확인 중이면 취소). ctrl-c 는 언제나 닫기
#
# worktree 모드 목록: 워크트리(열린 윈도우 ●N → 최근 고른 것 ◷ → 나머지, 메인 체크아웃 포함) → 로컬 브랜치(최근 커밋 순)
#   → 원격 브랜치(origin/*, 같은 이름의 로컬 브랜치가 있으면 숨긴다). 마커: dirty · merged · [ahead n, behind m] · missing · locked
#   merged 는 베이스 브랜치에 모두 들어 있다는 뜻이다. 로컬 베이스가 origin 보다 뒤처져 있으면 origin/<베이스> 로 판정한다
#   (PR 로 머지한 뒤 pull 하지 않아도 맞게). 피커가 뜰 때 백그라운드에서 git fetch --prune 을 하고, 원격 ref 가 바뀌었으면
#   목록을 다시 읽는다. 머지 판정은 ~/.cache/tmux-dev/ 에 캐시한다.
# subdirectory / directory 목록: 이 세션에 열린 윈도우의 디렉토리(●N) → 최근 고른 곳(◷) → 탐색.
# 최근 기록: ~/.local/state/tmux-dev/windows (피커로 연 것만).
#
# Claude Code 훅 (에이전트가 만드는 워크트리도 같은 위치·이름·베이스로. 설치 방법은 claude-code.md)
#   tmux-dev worktree --hook-create      WorktreeCreate 훅. stdin JSON 의 name·cwd 로 워크트리를 만들고(있으면 그대로)
#                                        경로 한 줄만 stdout 에 쓴다. 질문 없음. 브랜치는 name 그대로, 베이스는 로컬 main
#   tmux-dev worktree --hook-remove      WorktreeRemove 훅. stdin JSON 의 worktree_path 를 강제 제거하고, 브랜치는 베이스에
#                                        모두 들어 있을 때만 보관 → 삭제 (머지 안 된 것은 남긴다). tmux 윈도우는 건드리지 않는다
#
# 워크트리 위치 (git config. 전역 --global 과 저장소별 값이 한 메커니즘. 스크립트가 tmux 밖에서도 돌아야 해서
# tmux 옵션이 아니라 git config 에 둔다)
#   tmux-dev.worktree.location  central(기본) | sibling
#       central:  <root>/<name>/<브랜치의 / 를 - 로>      기본 ~/.local/share/tmux-dev/worktrees/dotfiles/feat-foo
#       sibling:  <저장소 부모>/<name>.worktrees/<...>      예) ~/dev/jwlee/dotfiles.worktrees/feat-foo
#   tmux-dev.worktree.root      central 의 모음 디렉토리 (기본 $XDG_DATA_HOME/tmux-dev/worktrees)
#   tmux-dev.worktree.name      모음 안에서 이 저장소가 쓰는 이름 (기본: 메인 체크아웃의 디렉토리 이름)
#   tmux-dev.worktree.setup     새 워크트리를 만든 뒤 그 안에서 한 번 실행할 셸 명령 (예: cp "$TMUX_WORKTREE_MAIN/.env" .)
#                               환경변수 TMUX_WORKTREE_MAIN / TMUX_WORKTREE_PATH / TMUX_WORKTREE_BRANCH 를 받는다.
#
# 윈도우 식별: 워크트리 윈도우는 사용자 옵션 @worktree <경로>, 디렉토리 윈도우는 @dir <경로>. 메인 체크아웃 행은
# 옵션이 없을 때 패널 경로로 보완한다 (project 가 세션을 만들며 첫 윈도우에 @worktree 를 둔다). 탐색 범위는 세션 하나다.
set -euo pipefail

SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
LIB=$(cd "$(dirname "$SELF")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"
# shellcheck source=../lib/layout.sh
. "$LIB/layout.sh"
# shellcheck source=../lib/dirs.sh
. "$LIB/dirs.sh"
# shellcheck source=../lib/picker.sh
. "$LIB/picker.sh"           # 상태 디렉토리·판정·탭·테두리·위치 피커·레이아웃 목록. project 와 공유

LAYOUT=""                                  # --layout 으로 명시한 값. 비어 있으면 resolve_layout (저장소 설정 → 전역 → ide)
BASE=""                                    # --base. 비어 있으면 default_base
SESSION="${TMUX_WORKTREE_SESSION:-}"       # -t
HISTORY_MAX=500
TMUX_DEV_WINDOWS="${TMUX_DEV_WINDOWS:-${TMUX_DEV_HISTORY%/*}/windows}"   # 피커로 연 윈도우의 경로 (최근 순)
CONFIRMED=""                               # 피커에서 이미 확인을 받았으면 1 (open_target 이 다시 묻지 않는다)

conf() { git config --get "tmux-dev.worktree.$1" 2>/dev/null || true; }   # 없으면 빈 문자열

# --- 저장소 ---------------------------------------------------------------------
# 현재 디렉토리에서 메인 체크아웃을 찾는다. 워크트리 안에서 불러도 된다 (worktree list 의 첫 줄이 메인).
IN_REPO=""   # repo_try 가 저장소를 찾았으면 1
repo_try() {  # 저장소가 아니면 1 (죽지 않는다)
  COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  WT_LIST=$(list_worktrees)                              # 워크트리 목록은 한 번만 읽는다
  WT_PATHS=$(cut -f1 <<< "$WT_LIST")
  MAIN=${WT_PATHS%%$'\n'*}
  [ -n "$MAIN" ] && [ -d "$MAIN/.git" ] || die "bare repositories are not supported"
  NAME=$(conf name); NAME=${NAME:-$(basename "$MAIN")}
  IN_REPO=1
}
repo_init() { repo_try || die "not a git repository: $(abbrev_home "$PWD")"; }
default_base() {  # origin/HEAD 가 가리키는 브랜치의 로컬 사본 → main → master → HEAD
  local b
  if b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); then
    b=${b#origin/}; git show-ref -q --verify "refs/heads/$b" && { echo "$b"; return; }
  fi
  for b in main master; do git show-ref -q --verify "refs/heads/$b" && { echo "$b"; return; }; done
  echo HEAD
}
base() { echo "${BASE:-$(default_base)}"; }
# 머지 판정의 기준 ref. 로컬 베이스가 업스트림(origin/main 등)의 조상이면(= 뒤처졌거나 같으면) 업스트림이 둘 다를 담으므로
# 업스트림으로 판정한다. 그래서 "로컬 main 또는 origin/main 에 들어 있으면 머지됨" 을 계산 한 번으로 얻는다.
# 로컬이 앞서 있거나 갈라졌으면 로컬로 판정한다.
judge_ref() {
  local b up; b=$(base)
  up=$(git rev-parse -q --abbrev-ref --symbolic-full-name "$b@{u}" 2>/dev/null) || { echo "$b"; return; }
  if git merge-base --is-ancestor "$b" "$up" 2>/dev/null; then echo "$up"; else echo "$b"; fi
}

# --- 경로 규칙 --------------------------------------------------------------------
project_dir() {  # 이 저장소의 워크트리들이 모이는 디렉토리
  local loc root; loc=$(conf location); loc=${loc:-central}
  case $loc in
    central) root=$(conf root); root=$(expand_tilde "${root:-$TMUX_DEV_WORKTREES}"); printf '%s/%s\n' "$root" "$NAME" ;;
    sibling) printf '%s/%s.worktrees\n' "$(dirname "$MAIN")" "$NAME" ;;
    *) die "unknown tmux-dev.worktree.location '$loc' (central, sibling)" ;;
  esac
}
wt_dir() { local p; p=$(project_dir) || exit 1; printf '%s/%s\n' "$p" "${1//\//-}"; }   # 브랜치 → 새 워크트리 경로
# 모음 디렉토리가 다른 저장소의 것이면 거절한다. 그 안의 워크트리 .git 파일 한 줄(gitdir: <메인>/.git/worktrees/<n>)로 판별.
check_project_dir() {
  local pdir=$1 g line other
  [ -d "$pdir" ] || return 0
  for g in "$pdir"/*/.git; do
    [ -f "$g" ] || continue
    IFS= read -r line < "$g" || continue
    line=${line#gitdir: }; other=${line%/worktrees/*}
    [ "$other" = "$COMMON" ] && return 0
    die "$(abbrev_home "$pdir") holds worktrees of $(abbrev_home "${other%/.git}"). Give this repository another name:  git config tmux-dev.worktree.name <name>"
  done
}

# --- 워크트리·윈도우 -----------------------------------------------------------------
list_worktrees() {  # "<경로>\t<브랜치>\t<플래그>" (메인이 첫 줄. 브랜치는 비지 않는다)
  local path="" head="" branch="" flags=""
  while IFS= read -r line; do
    case $line in
      "worktree "*) path=${line#worktree } ;;
      "HEAD "*)     head=${line#HEAD } ;;
      "branch "*)   branch=${line#branch refs/heads/} ;;
      detached)     flags="$flags detached" ;;
      locked*)      flags="$flags locked" ;;
      prunable*)    flags="$flags prunable" ;;
      "") case $path in */.trash/*) path="" ;; esac   # 정리하며 휴지통으로 옮긴 것(지우는 중)은 없는 것으로
          [ -n "$path" ] && printf '%s\t%s\t%s\n' "$path" "${branch:-(detached ${head:0:7})}" "${flags# }"
          path="" head="" branch="" flags="" ;;
    esac
  done < <(git worktree list --porcelain; echo)
}
# 세션의 윈도우: "<인덱스> US <id> US <@worktree> US <활성 패널 경로> US <@dir>" (옵션은 비어 있을 수 있다)
list_windows() { [ -n "$SESSION" ] && tmux list-windows -t "$SESSION" -F "#{window_index}${US}#{window_id}${US}#{@worktree}${US}#{pane_current_path}${US}#{@dir}" 2>/dev/null || true; }
# 워크트리 경로 → 그 윈도우. 결과는 WIN(id, 없으면 빈 문자열)과 WIN_IDX(인덱스)에 둔다 (행마다 $(...) 서브셸을 띄우지
# 않기 위해 echo 대신 전역). @worktree 가 우선, 메인은 패널 경로로 보완(메인 안이되 다른 워크트리 안은 아닌 패널을 가진,
# 옵션 없는 가장 앞 윈도우). 윈도우 목록은 한 번만 읽어 둔다 (행마다 tmux 를 부르면 워크트리 19개에 ~100ms).
WIN_LIST=""; WIN_LIST_READY=""; WIN=""; WIN_IDX=""
window_for() {
  local want=$1 idx id tag pane _dir inside
  WIN=""; WIN_IDX=""
  [ -n "$WIN_LIST_READY" ] || { WIN_LIST=$(list_windows); WIN_LIST_READY=1; }
  while IFS=$US read -r idx id tag pane _dir; do
    [ "$tag" = "$want" ] && { WIN=$id; WIN_IDX=$idx; return 0; }
    if [ "$want" = "${MAIN:-}" ] && [ -z "$tag" ] && [ -z "$WIN" ]; then
      case $pane in "$MAIN"|"$MAIN"/*)
        inside=0
        while IFS= read -r other; do
          [ -z "$other" ] || [ "$other" = "$MAIN" ] && continue
          case $pane in "$other"|"$other"/*) inside=1; break ;; esac
        done <<< "$WT_PATHS"
        [ "$inside" = 0 ] && { WIN=$id; WIN_IDX=$idx; } ;;
      esac
    fi
  done <<< "$WIN_LIST"
  [ -n "$WIN" ]
}

# --- 세션 디렉토리 -----------------------------------------------------------------
# prefix S 가 붙인 @tmux-dev-path, 없으면 session_path. 지워졌으면 빈 값.
session_dir() {
  local p; p=$(tmux show-options -qv -t "$SESSION" @tmux-dev-path 2>/dev/null || true)
  [ -n "$p" ] || p=$(tmux display-message -p -t "$SESSION:" '#{session_path}' 2>/dev/null || true)
  [ -n "$p" ] && canon_dir "$p" || true
}

# --- 후보 -------------------------------------------------------------------------
# 행: "<이름>\t<표시>\t<종류>\t<경로>\t<브랜치>". fzf 는 1·2칸을 보여 주고(--with-nth 1,2) 1칸만 검색한다(--nth 1).
#   worktree  1칸 = 브랜치, 경로 = 워크트리 디렉토리 (메인 체크아웃 포함)
#   prunable  디렉토리가 사라진 워크트리 (표시 missing)
#   branch    로컬 브랜치, 워크트리 없음. 경로 비어 있음
#   remote    원격에만 있는 브랜치. 경로 = 원격 ref (origin/이름), 브랜치 = 짧은 이름
#   dir       subdirectory / directory 모드의 디렉토리. 1칸 = ~경로
mode_name() { printf '%s' "$1"; }   # 탭 이름 = 모드 이름 (worktree, subdirectory, directory)
modes() { if [ -n "$IN_REPO" ]; then echo worktree subdirectory directory; else echo subdirectory directory; fi; }
cur_mode() { st_get mode; MODE=${ST:-}; [ -n "$MODE" ] || { if [ -n "$IN_REPO" ]; then MODE=worktree; else MODE=subdirectory; fi; }; }
# subdirectory 모드면 탐색·위치 피커를 세션 디렉토리 아래로 (lib/dirs.sh 의 SCAN_ROOT, lib/picker.sh 의 LOC_ROOT)
apply_scope() {
  LOC_ROOT=""
  # shellcheck disable=SC2034  # lib/dirs.sh(scan_dirs)와 lib/picker.sh(under_loc_root)가 읽는다
  if [ "$1" = subdirectory ]; then st_get root; [ -n "$ST" ] && { SCAN_ROOT=$ST; LOC_ROOT=$ST; }; fi
  return 0
}
HIST=()
load_hist() { HIST=(); local p; while IFS= read -r p; do HIST+=("$p"); done < <(hist_paths "$TMUX_DEV_WINDOWS"); }
hist_rank() {  # $1 경로 → RANK (0 부터, 없으면 -1)
  local i; RANK=-1
  for ((i = 0; i < ${#HIST[@]}; i++)); do [ "${HIST[$i]}" = "$1" ] && { RANK=$i; return 0; }; done
  return 1
}

rows_worktree() {  # $1 = --marks 면 상태 마커(dirty, merged/new/+N)까지 (없으면 빠른 목록)
  local marks=${1:-} path branch flags ref track sha ts subj w=12 n
  local -a wt=() br=() rm=()
  # 로컬 브랜치 표: 같은 인덱스의 배열들 (이름, 업스트림 대비, 커밋, 커밋 시각). 긴 문자열에 ${var#*패턴} 글로브 매칭을 하면
  # 멀티바이트 로케일에서 아주 느리므로(행마다 수 ms) 배열을 단순 비교로 훑는다.
  local -a names=() trks=() shas=() tss=()
  while IFS=$'\t' read -r path branch flags; do
    wt+=("$path|$branch|$flags"); n=${#branch}; [ "$n" -gt "$w" ] && w=$n
  done <<< "$WT_LIST"
  # worktreepath 는 비어 있을 수 있으므로 구분자는 US (git 포맷의 %1f). 최근 커밋 순. 제목은 마지막 칸 (US 가 들어 있을 리 없다)
  while IFS=$US read -r ref path track sha ts subj; do
    names+=("$ref"); trks+=("$track"); shas+=("$sha"); tss+=("$ts")
    [ -z "$path" ] && { br+=("$ref|$ts|$subj"); n=${#ref}; [ "$n" -gt "$w" ] && w=$n; }
  done < <(git for-each-ref refs/heads --sort=-committerdate --format='%(refname:short)%1f%(worktreepath)%1f%(upstream:track)%1f%(objectname)%1f%(committerdate:unix)%1f%(subject)')
  find_branch() {  # 이름 → IDX (없으면 -1). 서브셸 없이 전역에 둔다
    local i; IDX=-1
    for ((i = 0; i < ${#names[@]}; i++)); do [ "${names[$i]}" = "$1" ] && { IDX=$i; return 0; }; done
    return 1
  }
  while IFS=$US read -r ref ts subj; do
    case $ref in */HEAD) continue ;; esac       # origin/HEAD 는 브랜치가 아니다
    ref=${ref#refs/remotes/}; branch=${ref#origin/}
    find_branch "$branch" && continue           # 같은 이름의 로컬 브랜치가 있으면 그쪽 행이 대표한다
    rm+=("$ref|$ts|$subj"); n=${#ref}; [ "$n" -gt "$w" ] && w=$n
  done < <(git for-each-ref refs/remotes/origin --sort=-committerdate --format='%(refname)%1f%(committerdate:unix)%1f%(subject)')
  [ "$w" -gt 30 ] && w=30                       # 이름 칸. 더 긴 이름은 그 행만 밀린다 (모든 행을 가장 긴 이름에 맞추지 않는다)
  # 상태 마커는 행마다 git 을 띄워야 해서 비용이 크다. 그래서 (1) 마커 없는 목록을 먼저 띄우고 fzf 의 load 이벤트에서
  # --marks 로 다시 읽으며, (2) --marks 때는 베이스 쪽 계산을 한 번만 하고(merge_prepare) 행마다는 작은 일만 남기며
  # 그것도 캐시하고(is_merged), (3) 행 작업은 코어 수만큼만 동시에 띄운다. 결과는 임시 파일로 ("<dirty 수>\t<상태>").
  find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'tmux-dev.*' -type d -mmin +60 -exec /bin/rm -rf {} + 2>/dev/null || true
  local tmp b bsha lb lbsha i; tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-dev.XXXXXX")
  # shellcheck disable=SC2064  # 지금 값의 tmp 를 지우는 것이 맞다
  trap "/bin/rm -rf '$tmp'" EXIT
  if [ "$marks" = --marks ]; then
    b=$(judge_ref); bsha=$(git rev-parse -q --verify "$b^{commit}" 2>/dev/null || true)
    lb=$(base); lbsha=$(git rev-parse -q --verify "$lb^{commit}" 2>/dev/null || true)
    [ -n "$bsha" ] && merge_prepare "$bsha"     # 자식들이 상속받도록 fork 전에
    local jobs running=0; jobs=${TMUX_DEV_JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 8)}
    i=0; for e in "${wt[@]+"${wt[@]}"}"; do
      path=${e%%|*}; branch=${e#*|}; branch=${branch%%|*}
      sha=""; find_branch "$branch" && sha=${shas[$IDX]}
      ( marks_for "$path" "$branch" "$b" "$sha" "$bsha" "$lb" "$lbsha" > "$tmp/w$i" ) & i=$((i + 1))
      running=$((running + 1)); [ "$running" -ge "$jobs" ] && { wait; running=0; }
    done
    i=0; for e in "${br[@]+"${br[@]}"}"; do
      sha=""; find_branch "${e%%|*}" && sha=${shas[$IDX]}
      ( marks_for "" "${e%%|*}" "$b" "$sha" "$bsha" "$lb" "$lbsha" > "$tmp/b$i" ) & i=$((i + 1))
      running=$((running + 1)); [ "$running" -ge "$jobs" ] && { wait; running=0; }
    done
    wait
    cache_prune
  fi
  load_hist
  NOW=$(date +%s); PDIR=$(project_dir 2>/dev/null || true); [ -n "$PDIR" ] || PDIR=/nonexistent
  # 정렬 키 (묶음, 묶음 안 순서): 0 창 열림(창 번호) · 1 최근(최근 순) · 2 진행 중 워크트리(메인 먼저, 그다음 최근 커밋 순)
  #   · 3 끝난 워크트리(merged) · 4 진행 중 브랜치 · 5 끝난 브랜치 · 6 원격. 상태는 마커를 읽은 뒤에야 알므로 끝난 것이
  #   아래로 내려가는 것은 --marks 로 다시 읽을 때다.
  {
    local dirty st key sub kind name_style
    local -a parts
    i=0; for e in "${wt[@]+"${wt[@]}"}"; do
      path=${e%%|*}; branch=${e#*|}; flags=${branch#*|}; branch=${branch%%|*}
      kind=worktree; parts=(); dirty=0; st=""; ts=0
      find_branch "$branch" && ts=${tss[$IDX]:-0}
      [ "$marks" = --marks ] && { IFS=$'\t' read -r dirty st < "$tmp/w$i" || true; }; i=$((i + 1))
      if [ "$path" = "$MAIN" ]; then key=2 sub=-9999999999; elif [ "$st" = merged ]; then key=3 sub=$((-ts)); else key=2 sub=$((-ts)); fi
      if window_for "$path"; then parts+=("${G}●${WIN_IDX}${R}"); key=0; sub=$WIN_IDX
      elif hist_rank "$path"; then parts+=("${D}◷${R}"); key=1; sub=$RANK; fi
      case " $flags " in *" prunable "*) kind=prunable; parts+=("${Y}missing${R}") ;; esac
      case " $flags " in *" locked "*) parts+=("${D}locked${R}") ;; esac
      state_marks "$st" "$dirty"
      [ "$ts" -gt 0 ] && { age_of "$ts"; parts+=("${D}$AGE${R}"); }
      short_loc "$path"; [ -n "$LOC" ] && parts+=("${D}$LOC${R}")
      name_style=""; [ "$key" = 3 ] && name_style=$D
      printf '%s\t%s\t%s%-*s%s\t%s\t%s\t%s\t%s\n' "$key" "$sub" "$name_style" "$w" "$branch" "$R" "${parts[*]+"${parts[*]}"}" "$kind" "$path" "$branch"
    done
    i=0; for e in "${br[@]+"${br[@]}"}"; do
      ref=${e%%|*}; ts=${e#*|}; subj=${ts#*|}; ts=${ts%%|*}
      parts=(); dirty=0; st=""
      [ "$marks" = --marks ] && { IFS=$'\t' read -r dirty st < "$tmp/b$i" || true; }; i=$((i + 1))
      key=4; name_style=""; [ "$st" = merged ] && { key=5; name_style=$D; }
      state_marks "$st" 0
      age_of "${ts:-$NOW}"; parts+=("${D}$AGE (branch) $(trim "$subj" 50)${R}")
      printf '%s\t%s\t%s%-*s%s\t%s\tbranch\t\t%s\n' "$key" "$((-${ts:-0}))" "$name_style" "$w" "$ref" "$R" "${parts[*]}" "$ref"
    done
    for e in "${rm[@]+"${rm[@]}"}"; do
      ref=${e%%|*}; ts=${e#*|}; subj=${ts#*|}; ts=${ts%%|*}
      age_of "${ts:-$NOW}"
      printf '6\t%s\t%s%-*s%s\t%s\tremote\t%s\t%s\n' "$((-${ts:-0}))" "$D" "$w" "$ref" "$R" "${D}$AGE (remote) $(trim "$subj" 50)${R}" "$ref" "${ref#origin/}"
    done
  } | sort -s -t$'\t' -k1,1n -k2,2n | cut -f3-
  /bin/rm -rf "$tmp"
}
# 상태 마커를 parts 에 더한다: $1 상태(merged | new | +N | 빈 값) $2 dirty 수. 베이스 기준 하나만 행에 둔다
# (브랜치 자신의 업스트림 대비 ahead/behind/gone 은 미리보기에서 말로 보여 준다).
state_marks() {
  case $1 in
    merged) parts+=("${G}merged${R}") ;;
    new)    parts+=("${D}new${R}") ;;
    +*)     parts+=("${Y}$1${R}") ;;
  esac
  [ "${2:-0}" -gt 0 ] 2>/dev/null && parts+=("${Y}dirty $2${R}")
  return 0
}
age_of() {  # $1 커밋 시각(unix) → AGE (5m 3h 2d 3w 4mo 2y)
  local s=$(( NOW - ${1:-0} ))
  if [ "$s" -lt 3600 ]; then AGE="$(( s / 60 ))m"
  elif [ "$s" -lt 86400 ]; then AGE="$(( s / 3600 ))h"
  elif [ "$s" -lt 1209600 ]; then AGE="$(( s / 86400 ))d"
  elif [ "$s" -lt 5184000 ]; then AGE="$(( s / 604800 ))w"
  elif [ "$s" -lt 63072000 ]; then AGE="$(( s / 2592000 ))mo"
  else AGE="$(( s / 31536000 ))y"; fi
}
# 위치를 짧게: 표준 모음 위치(tmux-dev.worktree.*)는 생략, Claude Code 의 .claude/worktrees 는 claude:<이름>. 전체 경로는 미리보기에
short_loc() {
  case $1 in
    "$PDIR"/*) LOC="" ;;
    "$MAIN"/.claude/worktrees/*) LOC="claude:${1#"$MAIN"/.claude/worktrees/}" ;;
    "$HOME") LOC='~' ;;
    "$HOME"/*) LOC="~${1#"$HOME"}" ;;   # 행마다 $(...) 를 띄우지 않으려고 home_disp 대신 직접
    *) LOC=$1 ;;
  esac
}
trim() { if [ "${#1}" -gt "$2" ]; then printf '%s…' "${1:0:$(( $2 - 1 ))}"; else printf '%s' "$1"; fi; }
# subdirectory / directory: 이 세션에 열린 윈도우의 디렉토리(●N) → 최근(◷) → 탐색. 앞에 나온 것이 이긴다 (경로 기준)
rows_dir() {  # $1 모드
  local idx _id tag _pane dir p n=0
  {
    [ -n "$WIN_LIST_READY" ] || { WIN_LIST=$(list_windows); WIN_LIST_READY=1; }
    while IFS=$US read -r idx _id tag _pane dir; do
      p=${dir:-$tag}; [ -n "$p" ] && [ -d "$p" ] && under_loc_root "$p" || continue
      row "$p" "${G}●${idx}${R}"
    done <<< "$WIN_LIST"
    while IFS= read -r p; do
      [ "$n" -lt "$RECENT_MAX" ] || break
      [ -d "$p" ] && under_loc_root "$p" || continue
      row "$p" "${D}◷${R}"; n=$((n + 1))
    done < <(hist_paths "$TMUX_DEV_WINDOWS")
    [ -n "$LOC_ROOT" ] && row "$LOC_ROOT" "${D}⌂ session directory${R}"   # 탐색은 그 아래만 나오므로 시작점 자체를 넣는다
    dir_rows
  } | awk -F'\t' -v OFS='\t' '!seen[$3]++ { print $1, $2, "dir", $3, ""; fflush() }'
}
list_mode() {  # $1 모드 $2 --marks
  case $1 in
    worktree) [ -n "$IN_REPO" ] || return 0; rows_worktree "${2:-}" ;;
    subdirectory|directory) apply_scope "$1"; rows_dir "$1" ;;
  esac
}

# --- 머지 판정 ------------------------------------------------------------------------
# 비싼 계산을 "베이스 쪽은 한 번, 브랜치 쪽은 작게" 로 나눈다. git cherry 는 호출마다 베이스 쪽 커밋 전부의 patch-id 를
# 다시 계산해서 브랜치 수만큼 비쌌다. 같은 일을 한 번만 한다.
#   MERGED_SET  `for-each-ref --merged <베이스>`: 조상 관계로 들어간 브랜치(ff·merge commit) 전부를 프로세스 하나로
#   PATCHIDS    베이스 커밋들의 patch-id 집합 (모든 브랜치와의 공통 조상 이후). 베이스 커밋당 한 번 계산해 캐시 파일로
#   브랜치별    고유 커밋의 patch-id 가 모두 집합에 있으면 rebase 머지(새 SHA). 아니면 merge-base 와 브랜치 트리의 diff 하나의
#               patch-id 가 집합에 있으면 squash 머지. 한계: squash 될 때 베이스가 앞서 diff 문맥이 달라졌으면 못 잡는다
#   캐시        ~/.cache/tmux-dev/merged/<브랜치 커밋> 에 "<베이스 커밋> <0|1>". 지워도 다시 계산된다. 60일 지나면 치운다
#   기준은 judge_ref (로컬 베이스, 뒤처졌으면 그 업스트림)
MERGE_READY=""; MERGED_SET=""; PATCHIDS=""
merge_prepare() {  # $1 베이스 커밋. 한 번만. 행 작업을 fork 하기 전에 불러 자식이 결과를 상속받게 한다
  [ "$MERGE_READY" = "$1" ] && return 0
  MERGE_READY=$1
  MERGED_SET=$(git for-each-ref --merged "$1" refs/heads --format='%(refname:short)' 2>/dev/null || true)
  PATCHIDS="$TMUX_DEV_CACHE/patchids/$1"
  [ -s "$PATCHIDS" ] && return 0
  mkdir -p "${PATCHIDS%/*}"
  local mb; mb=$(git for-each-ref refs/heads --format='%(objectname)' | xargs git merge-base --octopus "$1" 2>/dev/null) || mb=""
  { if [ -n "$mb" ]; then git log -p --format=%H "$1" --not "$mb"; else git log -p --format=%H --max-count=2000 "$1"; fi; } 2>/dev/null \
    | git patch-id --stable | cut -d' ' -f1 > "$PATCHIDS.$$" && { mv -f "$PATCHIDS.$$" "$PATCHIDS" 2>/dev/null || rm -f "$PATCHIDS.$$"; }
  # 다른 베이스 커밋의 집합은 더 안 쓴다. 단 임시 파일(<커밋>.<pid>)은 건드리지 않는다: 목록의 마커와 미리보기가 같은 집합을
  # 동시에 계산하는데, 먼저 끝난 쪽이 아직 쓰는 중인 쪽의 임시 파일을 지우면 그쪽 mv 가 실패했다 (그래서 mv 실패도 죽지 않게).
  # 집합 파일이 없으면 is_merged 는 patch-id 비교 없이 조상 관계로만 판정한다. 남은 임시 파일은 1시간 뒤 치운다.
  find "${PATCHIDS%/*}" -type f ! -name "$1" ! -name '*.*' -delete 2>/dev/null || true
  find "${PATCHIDS%/*}" -type f -name '*.*' -mmin +60 -delete 2>/dev/null || true
}
in_merged_set() { local x; while IFS= read -r x; do [ "$x" = "$1" ] && return 0; done <<< "$MERGED_SET"; return 1; }
cache_file()  { printf '%s/merged/%s' "$TMUX_DEV_CACHE" "$1"; }
cache_get()   { local f; f=$(cache_file "$1"); CACHED=""; [ -f "$f" ] && IFS= read -r CACHED < "$f"; }
cache_put()   { local f; f=$(cache_file "$1"); mkdir -p "${f%/*}"; printf '%s\n' "$2" > "$f.$$" && mv -f "$f.$$" "$f"; }
cache_prune() { [ -d "$TMUX_DEV_CACHE/merged" ] && find "$TMUX_DEV_CACHE/merged" -type f -mtime +60 -delete 2>/dev/null || true; }
# 브랜치 $1 이 기준($2, 생략하면 judge_ref)에 모두 들어 있나. $3 $4 는 두 커밋 (생략하면 구한다).
is_merged() {
  local ref=$1 b=${2:-} rsha=${3:-} bsha=${4:-} ids id mb result=0
  [ -n "$b" ] || b=$(judge_ref)
  [ -n "$bsha" ] || bsha=$(git rev-parse -q --verify "$b^{commit}" 2>/dev/null) || return 1
  merge_prepare "$bsha"
  in_merged_set "$ref" && return 0
  [ -n "$rsha" ] || rsha=$(git rev-parse -q --verify "$ref^{commit}" 2>/dev/null) || return 1
  if cache_get "$rsha" && [ "${CACHED%% *}" = "$bsha" ]; then [ "${CACHED##* }" = 1 ]; return; fi
  if [ -s "$PATCHIDS" ]; then
    ids=$(git log -p --format=%H "$rsha" --not "$bsha" 2>/dev/null | git patch-id --stable | cut -d' ' -f1)
    if [ -n "$ids" ] && [ -z "$(grep -vxF -f "$PATCHIDS" <<< "$ids")" ]; then result=1; fi
    if [ "$result" = 0 ] && mb=$(git merge-base "$bsha" "$rsha" 2>/dev/null); then
      # --no-ext-diff: diff.external(difft) 출력은 patch 가 아니라 patch-id 가 비고, 빈 id 는 "머지됨"이 된다
      id=$(git diff --no-ext-diff "$mb" "$rsha" 2>/dev/null | git patch-id --stable | cut -d' ' -f1)
      if [ -z "$id" ] || grep -qxF "$id" "$PATCHIDS"; then result=1; fi
    fi
  fi
  cache_put "$rsha" "$bsha $result"
  [ "$result" = 1 ]
}
# 브랜치에서 커밋한 적이 없나 (reflog 에 commit 항목이 없다). 베이스의 조상인(고유 커밋이 없는) 브랜치는 "막 만든 것" 과
# "커밋한 뒤 ff 로 머지된 것" 이 같아 보여서 이것으로 가른다. reflog 가 없으면(꺼 두었거나 지워졌으면) 커밋한 적 없는 것으로 본다.
# 파이프 + grep -q 로 쓰면 안 된다: grep 이 먼저 끝나 git 이 SIGPIPE 로 죽고 pipefail 이 그것을 실패로 돌려 판정이 뒤집혔다.
never_committed() {
  local l; l=$(git reflog show --format=%gs "refs/heads/$1" 2>/dev/null) || true
  case $'\n'$l in *$'\n'commit*) return 1 ;; esac
  return 0
}
marks_for() {  # $1 워크트리 경로 $2 브랜치 $3 기준 ref $4 브랜치 커밋 $5 기준 커밋 $6 로컬 베이스 이름 $7 로컬 베이스 커밋
  # 출력 "<dirty 수>\t<상태>". 상태: new(커밋한 적 없고 고유 커밋도 없다), merged(변경이 기준에 모두 들어 있다),
  # +N(기준에 없는 커밋 수). 베이스 브랜치 자신과 detached 는 상태가 없다. new 는 커밋한 적도 없어야 한다(never_committed).
  local dirty=0 st="" n
  if [ -n "$1" ] && [ -d "$1" ]; then dirty=$(git -C "$1" status --porcelain 2>/dev/null | wc -l | tr -d ' '); fi
  case $2 in "(detached "*|"$3"|"${6:-}") ;; *)
    if in_merged_set "$2" && never_committed "$2"; then st=new   # 고유 커밋이 없고(기준의 조상) 커밋한 적도 없다
    elif is_merged "$2" "$3" "${4:-}" "${5:-}"; then st=merged
    else n=$(git rev-list --count "${5:-$3}..${4:-$2}" 2>/dev/null || echo '?'); st="+$n"; fi ;;
  esac
  printf '%s\t%s\n' "$dirty" "$st"
}

# --- 피커 화면 -------------------------------------------------------------------
# shellcheck disable=SC2046  # 모드 목록을 단어로 나눠 넘긴다
tabs() { picker_tabs "$1" $(modes); }   # 맨 위 헤더의 모드 탭. 클릭하면 그 모드로
hint() {
  if [ "$1" = worktree ]; then printf '%s' "${D}enter open · alt-enter new · ctrl-x clean up · tab select · ctrl-t merged · alt-m mode · alt-h keys${R}"
  else printf '%s' "${D}enter open · alt-enter new · alt-l layout · alt-m mode · alt-h keys${R}"; fi
}
create_hint() {  # $1 검색어 $2 모드. 검색어가 있으면 늘 보이는 만들기 안내
  local q=${1%/}
  if [ "$2" = worktree ]; then printf '%s' "alt-enter create branch ${B}'$q'${R} from $(base) ${D}· enter open · alt-h keys${R}"
  else printf '%s' "alt-enter create directory ${B}'$q'${R} ${D}· enter open · alt-h keys${R}"; fi
}
help_keys() {
  cat <<EOF
${B}prefix W: open a window in this session${R}

enter         go to the item's window (created if missing)
alt-enter     worktree: new branch + worktree from the typed name
              subdirectory / directory: new directory → pick a location
alt-l         open with a chosen layout
                enter this time only · alt-enter also save as repo default
ctrl-x        clean up (worktree mode): a menu opens to pick
              "clean up" (window, worktree, branch) or "keep branch"
              (window, worktree only). With a selection: all selected.
tab/shift-tab select / deselect (worktree mode, for clean up only)
ctrl-t        select all merged worktrees and branches
              (deselect all if anything is selected)
alt-m / alt-n mode: next / previous (or click a mode name)
ctrl-]        put the item's path into the query (directory modes)
alt-p         preview right → bottom → hidden
alt-h         toggle this help
esc           close (while asking: cancel)
ctrl-c        close

${B}asking first${R}
Creating a worktree (from a branch, a remote branch or a new name)
asks in the footer first:
  enter       create and open
  alt-l       create with a chosen layout
  esc         cancel (moving the cursor or typing also cancels)

${B}clean up (ctrl-x)${R}
A menu opens: "clean up" closes the worktree's window, removes the
worktree, archives the branch to refs/archive/<date>/<branch> and
deletes it (asks again if not merged); "keep branch" only closes the
window and removes the worktree. The preview shows exactly what will
happen. Refused for the main checkout, the base branch, remote branches
and locked worktrees; fails if dirty.

${B}worktree list${R}
● open window · ◷ recently opened · then worktrees in progress, finished
(merged, dimmed), local branches, remote branches (origin/*), recent first.
merged = all changes are in $(base) (or its upstream if $(base) is behind)
new = no commits yet · +N = commits not in $(base) · dirty N = uncommitted
missing = worktree directory is gone · claude:x = .claude/worktrees/x
5m 3h 2d 3w 4mo 2y = age of the last commit. The preview shows the full
path and the branch's own upstream (pushed / not pushed / deleted).
EOF
}

# --- 콜백 (fzf 가 이벤트마다 부른다. 액션 한 줄을 출력한다) -----------------------------
# 상태 키: mode, root(세션 디렉토리), target("<종류>US<경로>US<브랜치>" 지금 다룰 대상), confirm(1 이면 푸터에서 묻는 중),
#   help, 그리고 lib 의 name, near, loc, pending, near_pick, layout. decision 은 fzf 를 끝낼 때의 결정.
footer_now() {  # 지금 모드의 푸터 (검색어에 따라)
  local q=${FZF_QUERY:-}; cur_mode
  if [ -z "$q" ]; then hint "$MODE"
  elif [ "$MODE" != worktree ] && pathish "$q"; then
    if [ "${FZF_MATCH_COUNT:-1}" -eq 0 ]; then classify "$q" dir; printf '%s' "$J_SAY"
    else printf '%s' "enter open the item ${D}· alt-enter create at the typed path${R}"; fi
  else create_hint "$q" "$MODE"; fi
}
# 푸터에서 묻기. 상태 op 가 무엇을 묻는지 정한다: create(만들기. alt-l 로 레이아웃), clean(정리), clean2(머지 안 된 브랜치 정리).
# 커서를 옮기면(focus) 취소되도록 묻는 동안만 focus 를 묶는다.
key_hint() { printf '%s' "${B}$1${R}${D} $2${R}"; }
ask() {  # $1 종류 $2 경로 $3 브랜치 $4 질문 [$5 op, 기본 create]
  local op=${5:-create} keys
  st_set target "$1$US$2$US$3"; st_set confirm 1; st_set op "$op"
  if [ "$op" = create ]; then keys="$(key_hint enter create) ${D}·${R} $(key_hint alt-l 'with layout') ${D}·${R} $(key_hint esc cancel)"
  else keys="$(key_hint enter 'clean up') ${D}·${R} $(key_hint esc cancel)"; fi
  printf 'rebind(focus)+%s' "$(act change-footer "$4 ${D}·${R} $keys")"
}
cancel_ask() { st_del confirm target op; printf 'unbind(focus)+%s' "$(act change-footer "$(footer_now)")"; }
decide() {  # $1 종류 $2 경로 $3 브랜치 [$4 만들기 dir] [$5 위치 피커에서 고른 부모] → 결정 파일을 쓰고 fzf 를 끝낸다
  local l="" s=""; st_get layout; [ -n "$ST" ] && IFS=$'\t' read -r l s <<< "$ST"
  st_set decision "$1$US$2$US$3$US$l$US$s$US${4:-}$US${5:-}"
  printf 'accept'
}
# worktree 모드의 행을 대상으로: 바로 열 것이면 결정, 만들어야 하면 묻는다
worktree_target() {  # $1 종류 $2 경로 $3 브랜치 $4 now(바로) | ask
  local kind=$1 path=$2 branch=$3
  case $kind in
    worktree) decide worktree "$path" "$branch" ;;
    prunable) ask prunable "$path" "$branch" "${Y}worktree directory is gone${R}: $(home_disp "$path") · recreate ${B}$branch${R}?" ;;
    branch)   ask branch "" "$branch" "create worktree for ${B}$branch${R} → $(home_disp "$(wt_dir "$branch")")" ;;
    remote)   ask remote "$path" "$branch" "create ${B}$branch${R} tracking $path → $(home_disp "$(wt_dir "$branch")")" ;;
    *)        printf 'bell' ;;
  esac
}
# 디렉토리 모드의 열 대상: 커서 항목, 아니면 경로 모양 검색어가 가리키는 있는 디렉토리. 없으면 안내 액션을 출력하고 1
dir_target() {  # $1 커서 항목의 경로
  local q=${FZF_QUERY:-}
  if [ -n "$1" ]; then J_PATH=$1; return 0; fi
  if pathish "$q"; then
    classify "$q" dir
    case $J_KIND in open|worktree) return 0 ;; esac
    nope "$J_SAY"; return 1
  fi
  if [ -n "$q" ]; then nope "${Y}no match${R} · $(create_hint "$q" "$MODE")"; else nope "$(hint "$MODE")"; fi
  return 1
}
on_enter() {  # $1 종류 $2 경로 $3 브랜치
  busy && return
  st_get confirm
  if [ "$ST" = 1 ]; then
    local k p b op; st_get target; IFS=$US read -r k p b <<< "$ST"; st_get op; op=${ST:-create}
    case $op in
      clean2) start_job one ;;    # 정리 목록에서 clean up 을 고른 뒤 머지 안 된 브랜치를 한 번 더 확인 (대상은 상태 target)
      bulk2)  start_job many ;;
      *)      st_del layout; decide "$k" "$p" "$b" ;;
    esac
    return
  fi
  cur_mode; st_del layout
  if [ "$MODE" = worktree ]; then
    [ -n "${1:-}" ] || { local q=${FZF_QUERY:-}; if [ -n "$q" ]; then nope "${Y}no match${R} · $(create_hint "$q" worktree)"; else nope "$(hint worktree)"; fi; return; }
    worktree_target "$1" "${2:-}" "${3:-}"
  else
    dir_target "${2:-}" || return 0
    decide dir "$J_PATH" ""
  fi
}
on_layout() {  # alt-l: 대상을 정하고 레이아웃 목록을 겹쳐 띄운다. 만들어야 하는 행은 먼저 묻는다 (거기서 alt-l)
  local k p b
  busy && return
  st_get confirm
  if [ "$ST" = 1 ]; then
    st_get op; [ "${ST:-create}" = create ] || { printf 'bell'; return; }   # 정리를 묻는 중에는 레이아웃이 없다
    st_get target; IFS=$US read -r k p b <<< "$ST"
  else
    cur_mode
    if [ "$MODE" = worktree ]; then
      [ -n "${1:-}" ] || { printf 'bell'; return; }
      case $1 in worktree) k=worktree p=$2 b=$3 ;; *) worktree_target "$1" "${2:-}" "${3:-}"; return ;; esac
    else dir_target "${2:-}" || return 0; k=dir p=$J_PATH b=""; fi
    st_set target "$k$US$p$US$b"
  fi
  st_del layout
  st_set pending "none"$'\t'"${p:-$(wt_dir "$b")}"
  printf 'execute(%s --choose-layout)+transform(%s --on after-layout)' "$SELF" "$SELF"
}
on_after_layout() {  # 레이아웃에서 esc 면 그대로(묻던 중이면 계속 묻는다), 골랐으면 대상을 실행
  local k p b; st_get layout; [ -n "$ST" ] || return 0
  st_get target; IFS=$US read -r k p b <<< "$ST"
  decide "$k" "$p" "$b"
}
on_create() {  # alt-enter. worktree: 친 이름으로 새 브랜치(묻는다). 디렉토리: 경로면 그 자리에, 이름이면 위치 피커
  local q=${FZF_QUERY:-} path branch flags
  busy && return
  cur_mode; st_del layout loc
  if [ -z "$q" ]; then nope "${Y}type a name first${R}"; return; fi
  if [ "$MODE" = worktree ]; then
    git check-ref-format --branch "$q" >/dev/null 2>&1 || { nope "${Y}not a valid branch name: $q${R}"; return; }
    while IFS=$'\t' read -r path branch flags; do   # 이미 있는 이름이면 그 행처럼
      [ "$branch" = "$q" ] || continue
      case " $flags " in *" prunable "*) worktree_target prunable "$path" "$q" ;; *) decide worktree "$path" "$q" ;; esac
      return
    done <<< "$WT_LIST"
    if git show-ref -q --verify "refs/heads/$q"; then worktree_target branch "" "$q"; return; fi
    if git show-ref -q --verify "refs/remotes/origin/$q"; then worktree_target remote "origin/$q" "$q"; return; fi
    ask new "" "$q" "create branch ${B}$q${R} from $(base) → $(home_disp "$(wt_dir "$q")")"
    return
  fi
  if pathish "$q"; then
    classify "$q" dir
    case $J_KIND in
      create) decide dir "$J_PATH" "" dir ;;
      open|worktree) decide dir "$J_PATH" "" ;;
      *) nope "$J_SAY" ;;
    esac
    return
  fi
  name_ok "$q" || { nope "${Y}not a valid name: $q${R} (no .. or empty parts)"; return; }
  st_set name "${q%/}"
  [ -n "${1:-}" ] && st_set near "$(dirname "$1")" || st_del near
  printf 'execute(%s --choose-location)+transform(%s --on after-location)' "$SELF" "$SELF"
}
on_after_location() {  # 위치 피커에서 esc 면 그대로, 골랐으면 만든다(이미 있으면 연다)
  local parent name; st_get loc; parent=$ST; [ -n "$parent" ] || return 0
  st_get name; name=$ST
  classify "$parent/$name" dir
  case $J_KIND in
    create) decide dir "$J_PATH" "" dir "$parent" ;;
    open|worktree) decide dir "$J_PATH" "" ;;
    *) nope "$J_SAY" ;;
  esac
}
on_change() {  # 글자를 치면 묻던 것은 취소. 디렉토리 모드의 경로 모양 검색어는 접두 일치로
  local out="bg-cancel+"
  st_get select_merged; [ "$ST" = 1 ] && { printf 'rebind(result)'; return 0; }   # ctrl-t 가 검색어를 지운 것: result 를 기다린다
  st_get confirm; [ "$ST" = 1 ] && { st_del confirm target op; out+="unbind(focus)+"; }
  cur_mode
  if [ "$MODE" != worktree ] && pathish "${FZF_QUERY:-}"; then printf '%srebind(result)+first+%s' "$out" "$(search_action "$FZF_QUERY")"
  else printf '%sunbind(result)+first+%s' "$out" "$(act change-footer "$(footer_now)")"; fi
}
on_result() {
  st_get select_merged; if [ "$ST" = 1 ]; then st_del select_merged; printf 'unbind(result)+'; select_merged_actions; return 0; fi
  cur_mode; [ "$MODE" != worktree ] && pathish "${FZF_QUERY:-}" && act change-footer "$(footer_now)"; return 0
}
on_esc() { st_get confirm; if [ "$ST" = 1 ]; then cancel_ask; else printf 'abort'; fi; }
on_focus() { st_get confirm; if [ "$ST" = 1 ]; then cancel_ask; else printf 'unbind(focus)'; fi; }
to_mode() {  # $1 새 모드 → 목록·탭·푸터를 바꾸는 액션. worktree 는 마커를 다시 계산하도록 load 를 다시 묶는다
  local load=""; st_set mode "$1"; st_del confirm target op
  # 다중 선택(tab)은 worktree 모드의 정리에만 쓴다. 다른 모드로 가면 선택을 비우고 tab 을 푼다
  if [ "$1" = worktree ]; then load="rebind(load)+rebind(tab,shift-tab)+"; else load="deselect-all+unbind(tab,shift-tab)+"; fi
  printf 'unbind(focus)+%sreload(%s --list %s)+%s+first+%s' "$load" "$SELF" "$1" "$(act change-header "$(tabs "$1")")" "$(act change-footer "$(footer_now)")"
}
on_mode() {  # $1 next | prev
  busy && return
  local -a ms; read -r -a ms <<< "$(modes)"; cur_mode
  local i n=${#ms[@]} cur=0
  for ((i = 0; i < n; i++)); do [ "${ms[$i]}" = "$MODE" ] && cur=$i; done
  if [ "${1:-next}" = prev ]; then cur=$(( (cur + n - 1) % n )); else cur=$(( (cur + 1) % n )); fi
  to_mode "${ms[$cur]}"
}
on_tab_click() {  # 헤더의 모드 이름을 클릭: 그 모드로. 이미 그 모드거나 이름 밖이면 아무것도 안 한다
  local w=${FZF_CLICK_HEADER_WORD:-} m; busy && return; cur_mode
  for m in $(modes); do [ "$w" = "$m" ] && { [ "$m" = "$MODE" ] || to_mode "$m"; return 0; }; done
  return 0
}
# ctrl-t (선택이 없을 때): 마커가 붙은 목록(상태 rows, --list worktree --marks 가 남긴다)에서 merged 행을 골라 선택한다. 검색어가 있으면 먼저 지우고
# 필터가 끝나는 result 이벤트에서 고른다 (검색어가 없을 때 목록 위치 = rows 의 줄 번호라 pos(N)+select 로 고를 수 있다).
on_select_merged() {
  busy && return; cur_mode; [ "$MODE" = worktree ] || { nope "${Y}ctrl-t selects merged worktrees and branches${R} ${D}(worktree mode)${R}"; return; }
  [ -s "$TMUX_DEV_STATE/rows" ] || { nope "${Y}markers are still loading${R} ${D}· try again in a moment${R}"; return; }
  if [ -n "${FZF_QUERY:-}" ]; then st_set select_merged 1; printf 'rebind(result)+clear-query'; return; fi
  select_merged_actions
}
on_toggle_merged() {  # ctrl-t: 선택이 있으면 모두 풀고, 없으면 merged 를 모두 고른다
  if [ "${FZF_SELECT_COUNT:-0}" -gt 0 ]; then on_deselect; else on_select_merged; fi
}
on_deselect() {  # 선택을 모두 푼다 (ctrl-t 의 해제 쪽. 하나씩은 tab / shift-tab). 푸터의 "selected N" 안내도 지운다
  st_del select_merged
  printf 'deselect-all+%s' "$(act change-footer "$(footer_now)")"
}
select_merged_actions() {
  local i=0 n=0 out="" _name disp kind _rest
  while IFS=$US read -r _name disp kind _rest; do   # 탭을 US 로 (on_cleanup_many 와 같은 이유)
    i=$((i + 1))
    case $kind in worktree|prunable|branch) ;; *) continue ;; esac
    case $disp in *merged*) out+="pos($i)+select+"; n=$((n + 1)) ;; esac
  done < <(tr '\t' '\037' < "$TMUX_DEV_STATE/rows")
  [ "$n" -gt 0 ] || { nope "${Y}nothing merged${R}"; return; }
  printf 'deselect-all+%sfirst+%s' "$out" "$(act change-footer "${G}selected $n merged${R} ${D}· ctrl-x clean up · tab toggle · ctrl-t deselect all${R}")"
}
on_marks() { cur_mode; [ "$MODE" = worktree ] && printf 'reload-sync(%s --list worktree --marks)' "$SELF"; return 0; }
on_refresh() { cur_mode; to_mode "$MODE"; }
# 백그라운드 fetch (피커가 뜰 때 한 번). 원격 ref 가 바뀌었고 아직 worktree 모드면 목록을 다시 읽는다. 실패는 조용히 넘긴다
on_fetch() {
  [ -n "$IN_REPO" ] || return 0
  st_get busy; [ "$ST" = 1 ] || trash_sweep   # 지난번에 다 못 지운 휴지통이 있으면 마저 (tmux 서버에서)
  git remote get-url origin >/dev/null 2>&1 || return 0
  local before after; before=$(git for-each-ref refs/remotes/origin --format='%(objectname) %(refname)' | cksum)
  GIT_TERMINAL_PROMPT=0 git fetch --prune --quiet origin >/dev/null 2>&1 || return 0
  after=$(git for-each-ref refs/remotes/origin --format='%(objectname) %(refname)' | cksum)
  [ "$before" = "$after" ] && return 0
  cur_mode; [ "$MODE" = worktree ] || return 0
  st_get confirm; [ "$ST" = 1 ] && return 0          # 묻는 중에는 목록을 바꾸지 않는다
  st_get busy; [ "$ST" = 1 ] && return 0             # 정리 중이면 끝날 때 다시 읽는다
  printf 'rebind(load)+reload(%s --list worktree)' "$SELF"
}
on_fill() {  # ctrl-]: 디렉토리 모드에서 커서 항목의 경로를 검색어에
  cur_mode; [ "$MODE" != worktree ] && [ -n "${1:-}" ] || { printf 'bell'; return; }
  local q; q=$(home_disp "$1")
  printf '%s+rebind(result)+first+%s' "$(act change-query "$q")" "$(search_action "$q")"
}
on_help() {
  st_get help
  if [ "$ST" = 1 ]; then st_del help; act change-preview "$SELF --preview {3} {4} {5}"
  else st_set help 1; printf '%s+show-preview' "$(act change-preview "$SELF --help-keys")"; fi
}
# 레이아웃 목록 (lib 의 choose_layout_step 과 같되, 저장소 기본값 저장은 worktree 모드에서만)
w_choose_layout_step() {
  local create path can="" picked
  st_get pending; IFS=$'\t' read -r create path <<< "$ST"
  cur_mode; [ "$MODE" = worktree ] && can=save
  style_opts
  # shellcheck disable=SC2034  # choose_layout(lib/layout.sh)이 읽는다
  LAYOUT_ESC=abort
  # shellcheck disable=SC2034
  LAYOUT_FZF_OPTS=("${STYLE[@]}" --border-label " layout · $(home_disp "$path") ")
  picked=$(choose_layout "$SELF --layout-art" "$can") || return 0
  st_set layout "$picked"
}

# --- 미리보기 -----------------------------------------------------------------------
merge_summary() {  # $1 = 브랜치. 기준(judge_ref)에 대한 상태: merged / new / 기준에 없는 커밋 수
  local j n; j=$(judge_ref)
  [ "$1" = "$(base)" ] && return 0
  if git merge-base --is-ancestor "$1" "$j" 2>/dev/null && never_committed "$1"; then
    echo "${D}new: no commits yet (same as $j)${R}"; return 0
  fi
  if is_merged "$1" "$j"; then echo "${G}merged into $j${R}"; return 0; fi
  n=$(git rev-list --count "$j..$1" 2>/dev/null || echo '?')
  echo "${Y}+$n${R} commits not in $j"
}
upstream_summary() {  # $1 = 브랜치. 자신의 업스트림 대비를 말로 (행에서는 뺀 정보)
  local up track
  IFS=$US read -r up track < <(git for-each-ref "refs/heads/$1" --format='%(upstream:short)%1f%(upstream:track)') || true
  if [ -z "$up" ]; then echo "${D}not pushed (no upstream)${R}"; return; fi
  case $track in
    "[gone]") echo "${D}upstream $up was deleted (usually after the PR merged)${R}" ;;
    "") echo "${D}in sync with $up${R}" ;;
    *) # "[ahead 1]" "[behind 3]" "[ahead 1, behind 3]"
       local a="" bh="" out=""
       case $track in *ahead*) a=${track#*ahead }; a=${a%%[],]*} ;; esac
       case $track in *behind*) bh=${track#*behind }; bh=${bh%%]*} ;; esac
       [ -n "$a" ] && out="$a not pushed to $up"
       [ -n "$bh" ] && out="${out:+$out, }$bh behind $up"
       echo "${D}$out${R}" ;;
  esac
}
preview() {  # $1 종류 $2 경로 $3 브랜치
  local kind=$1 path=$2 branch=$3
  case $kind in
    worktree|prunable)
      printf '%s%s%s\n%s\n' "$B" "$branch" "$R" "$(abbrev_home "$path")"
      [ "$kind" = prunable ] && { printf '%sthe directory is gone. enter recreates it%s\n' "$Y" "$R"; return 0; }
      [ -d "$path" ] || return 0
      local st; st=$(git -C "$path" status --short 2>/dev/null | head -12)
      [ -n "$st" ] && printf '\n%suncommitted changes%s\n%s\n' "$Y" "$R" "$st"
      echo; merge_summary "$branch"; upstream_summary "$branch"
      echo; git -C "$path" log --oneline --color=always -8 2>/dev/null ;;
    branch)
      printf '%s%s%s  %sno worktree%s\n' "$B" "$branch" "$R" "$D" "$R"
      printf 'would create: %s\n\n' "$(abbrev_home "$(wt_dir "$branch")")"
      merge_summary "$branch"; upstream_summary "$branch"; echo; git log --oneline --color=always -8 "$branch" 2>/dev/null ;;
    remote)
      printf '%s%s%s  %sremote only%s\n' "$B" "$path" "$R" "$D" "$R"
      printf 'would create: branch %s tracking it → %s\n\n' "$branch" "$(abbrev_home "$(wt_dir "$branch")")"
      git log --oneline --color=always -8 "$path" 2>/dev/null ;;
    dir) dir_preview "$path" ;;
  esac
}

# --- 피커 ---------------------------------------------------------------------------
pick() {
  command -v fzf >/dev/null || die "fzf is required"
  picker_state_init tmux-dev-worktree
  local root; root=$(session_dir); [ -n "$root" ] && st_set root "$root"
  cur_mode; st_set mode "$MODE"
  local start_tab=""; [ "$MODE" = worktree ] || start_tab="unbind(tab,shift-tab)+"   # 다중 선택은 worktree 모드에서만
  style_opts
  # 정렬은 행 순서 그대로(--tiebreak index 가 마지막). 바인딩은 fzf 기본 키와 겹치지 않는 것만 (prefix S 와 같다).
  # 마커: 마커 없는 목록을 먼저 그리고 load 이벤트에서 --marks 로 바꿔 끼운다. fetch 는 백그라운드로 (원격이 바뀌었을 때만 다시 읽는다)
  fzf --ansi --delimiter '\t' --with-nth 1,2 --nth 1 --tabstop 2 --scheme path --tiebreak pathname,index \
      "${STYLE[@]}" --border-label " open window · ${SESSION} " --header "$(tabs "$MODE")" --header-first --prompt '> ' \
      --footer "$(hint "$MODE")" --footer-border line \
      --preview "$SELF --preview {3} {4} {5}" --preview-window 'right,45%,border-left' \
      --multi --bind "start:unbind(result)+unbind(focus)+unbind($EVERY)+${start_tab}bg-transform($SELF --on fetch)" \
      --bind "$EVERY:transform($SELF --cleanup-tick)" \
      --bind "load:unbind(load)+transform($SELF --on marks)" \
      --bind "change:transform($SELF --on change)" \
      --bind "result:bg-transform($SELF --on result)" \
      --bind "focus:transform($SELF --on focus)" \
      --bind "enter:transform($SELF --on enter {3} {4} {5})" \
      --bind "double-click:transform($SELF --on enter {3} {4} {5})" \
      --bind "alt-enter:transform($SELF --on create {4})" \
      --bind "alt-l:transform($SELF --on layout {3} {4} {5})" \
      --bind "esc:transform($SELF --on esc)" \
      --bind "alt-m:transform($SELF --on mode next)" --bind "alt-n:transform($SELF --on mode prev)" \
      --bind "ctrl-t:transform($SELF --on toggle-merged)" \
      --bind "click-header:transform($SELF --on tab-click)" \
      --bind "ctrl-x:transform($SELF --on cleanup {3} {4} {5} {+f})" \
      --bind "ctrl-]:transform($SELF --on fill {4})" \
      --bind 'alt-p:change-preview-window(down,40%,border-top|hidden|right,45%,border-left)' \
      --bind "alt-h:transform($SELF --on help)" \
      < <(list_mode "$MODE") > /dev/null || true
  [ -f "$TMUX_DEV_STATE/decision" ] || exit 0     # 결정 없이 끝남 = 취소
  local kind path branch layout save create parent
  IFS=$US read -r kind path branch layout save create parent < "$TMUX_DEV_STATE/decision"
  apply_decision "$kind" "$path" "$branch" "$layout" "$save" "$create" "$parent"
}

# --- 실행 ---------------------------------------------------------------------------
resolve_name() {  # 셸에서 준 브랜치 이름 → KIND/BRANCH/TARGET
  local name=$1 path branch flags
  while IFS=$'\t' read -r path branch flags; do
    if [ "$branch" = "$name" ]; then
      KIND=worktree; BRANCH=$branch; TARGET=$path
      case " $flags " in *" prunable "*) KIND=prunable ;; esac
      return
    fi
  done <<< "$WT_LIST"
  if git show-ref -q --verify "refs/heads/$name"; then KIND=branch; BRANCH=$name; TARGET=""; return; fi
  local remotes; remotes=$(git for-each-ref "refs/remotes/*/$name" --format='%(refname:short)')
  if [ -n "$remotes" ] && [ "$(wc -l <<< "$remotes")" -eq 1 ]; then KIND=remote; BRANCH=$name; TARGET=$remotes; return; fi
  git check-ref-format --branch "$name" >/dev/null 2>&1 || die "not a valid branch name: $name"
  KIND=new; BRANCH=$name; TARGET=""
}
# 디렉토리를 종류로 푼다: 이 저장소의 워크트리(메인 포함)면 worktree, 아니면 dir (아무 디렉토리의 윈도우)
resolve_dir() {
  local want path branch flags; want=$(cd "$1" && pwd -P)   # 실제 경로로 (fd 가 주는 경로, git worktree list 와 맞춘다)
  if [ -n "$IN_REPO" ]; then
    while IFS=$'\t' read -r path branch flags; do
      case " $flags " in *" prunable "*) continue ;; esac
      [ "$path" = "$want" ] && { KIND=worktree; BRANCH=$branch; TARGET=$path; return; }
    done <<< "$WT_LIST"
  fi
  KIND=dir; BRANCH=""; TARGET=$want
}
ensure_dir_window() {  # 디렉토리 $TARGET 의 윈도우로. @dir 이 같은 윈도우가 있으면 그리로, 없으면 만들고 레이아웃
  local id tag win
  while IFS=$US read -r id tag; do
    [ "$tag" = "$TARGET" ] && { tmux select-window -t "$id"; return; }
  done < <(tmux list-windows -t "$SESSION" -F "#{window_id}${US}#{@dir}" 2>/dev/null)
  win=$(tmux new-window -P -F '#{window_id}' -t "$SESSION:" -n "$(basename "$TARGET")" -c "$TARGET")
  tmux set-option -w -t "$win" @dir "$TARGET"
  apply_layout "$(resolve_layout "$LAYOUT" "$TARGET")" "$win" "$TARGET"
}
run_setup() {  # 새 워크트리 안에서 tmux-dev.worktree.setup 을 한 번
  local cmd; cmd=$(conf setup); [ -n "$cmd" ] || return 0
  echo "setup: $cmd"
  ( cd "$TARGET" && TMUX_WORKTREE_MAIN=$MAIN TMUX_WORKTREE_PATH=$TARGET TMUX_WORKTREE_BRANCH=$BRANCH sh -c "$cmd" ) \
    || echo "tmux-dev: setup failed (the worktree was created)" >&2
}
add_worktree() {  # $@ = git worktree add 의 인자 (경로 뒤)
  TARGET=$(wt_dir "$BRANCH")
  check_project_dir "$(dirname "$TARGET")"
  [ -e "$TARGET" ] && die "path already exists: $(abbrev_home "$TARGET")"
  mkdir -p "$(dirname "$TARGET")"
  local out; out=$(git worktree add "$TARGET" "$@" 2>&1) || die "$out"
  run_setup
}
ensure_window() {  # 워크트리 $TARGET(브랜치 $BRANCH)의 윈도우로. 없으면 만들고 레이아웃
  local win
  if window_for "$TARGET"; then tmux select-window -t "$WIN"; return; fi
  win=$(tmux new-window -P -F '#{window_id}' -t "$SESSION:" -n "$BRANCH" -c "$TARGET")
  tmux set-option -w -t "$win" @worktree "$TARGET"
  apply_layout "$(resolve_layout "$LAYOUT" "$MAIN")" "$win" "$TARGET"
}
open_target() {  # KIND/BRANCH/TARGET 을 연다. 셸에서 부르면 만들기 전에 묻는다 (피커는 이미 물었다: CONFIRMED)
  if [ "$KIND" = dir ]; then
    [ -n "$SESSION" ] || die "a directory window needs tmux: $(abbrev_home "$TARGET")"
    ensure_dir_window; return
  fi
  local ans
  case $KIND in
    prunable)
      if [ -z "$CONFIRMED" ]; then
        printf '%s is gone. Prune it (git worktree prune) and recreate? [y/N] ' "$(abbrev_home "$TARGET")"
        IFS= read -r ans || exit 0; case $ans in y|Y) ;; *) exit 0 ;; esac   # 입력이 끊기면(EOF) 취소
      fi
      git worktree prune
      case $BRANCH in "(detached "*) exit 0 ;; esac
      KIND=branch ;;
    new)
      if [ -z "$CONFIRMED" ]; then
        printf 'Create branch %s%s%s from %s? → %s [Y/n] ' "$B" "$BRANCH" "$R" "$(base)" "$(abbrev_home "$(wt_dir "$BRANCH")")"
        IFS= read -r ans || exit 0; case $ans in n|N) exit 0 ;; esac
      fi ;;
  esac
  case $KIND in
    worktree) ;;
    branch)   add_worktree "$BRANCH" ;;
    remote)   add_worktree --track -b "$BRANCH" "$TARGET" ;;
    new)      add_worktree -b "$BRANCH" "$(base)" ;;
  esac
  if [ -n "$SESSION" ]; then ensure_window; else printf '%s\n' "$TARGET"; fi
}
# 피커의 결정을 실행한다: $1 종류 $2 경로 $3 브랜치 $4 레이아웃 $5 save $6 만들기(dir) $7 위치 피커에서 고른 부모
apply_decision() {
  local kind=$1 path=$2 branch=$3
  LAYOUT=$4; CONFIRMED=1
  [ -n "$5" ] && [ -n "$LAYOUT" ] && [ -n "$IN_REPO" ] && git -C "$MAIN" config tmux-dev.layout "$LAYOUT"
  case $kind in
    dir)
      [ "${6:-}" = dir ] && { mkdir -p "$path" || die "cannot create: $(home_disp "$path")"; }
      path=$(canon_dir "$path") || die "not a directory: $2"
      [ -n "${7:-}" ] && hist_record "$TMUX_DEV_PARENTS" "$7" 100   # 다음 위치 피커의 위쪽에 둔다
      resolve_dir "$path" ;;
    worktree) KIND=worktree; BRANCH=$branch; TARGET=$path ;;
    prunable) KIND=prunable; BRANCH=$branch; TARGET=$path ;;
    branch)   KIND=branch; BRANCH=$branch; TARGET="" ;;
    remote)   KIND=remote; BRANCH=$branch; TARGET=$path ;;
    new)      KIND=new; BRANCH=$branch; TARGET="" ;;
    *) die "unknown decision: $kind" ;;
  esac
  open_target
  hist_record "$TMUX_DEV_WINDOWS" "$TARGET" "$HISTORY_MAX"   # 피커로 연 것만 기록한다 (셸 호출은 기록하지 않는다)
}

# --- 정리 (ctrl-x) -------------------------------------------------------------------
# worktree 모드에서 워크트리·로컬 브랜치를 정리한다. 피커 안에서 끝나고 피커는 열린 채로 남는다 (이어서 다른 것을 정리하거나 연다).
#   ctrl-x → 검사 (메인 체크아웃·베이스 브랜치·원격 브랜치·locked 는 하지 않는다, dirty 면 실패) → 푸터 확인
#          → 브랜치가 머지 안 됐으면 한 번 더 확인 → 실행 → 목록을 다시 읽고 푸터에 결과(백업 ref)
#   실행 순서: 창 닫기 → 워크트리 제거(git worktree remove, 강제 없이. missing 이면 prune) → 브랜치 백업 → 브랜치 삭제.
#   창을 먼저 닫는 것은 그 안의 프로세스(셸, nvim, 에이전트)를 먼저 끝내기 위해서다.
# 피커가 그 창 안의 패널이면(prefix W 를 modal floating pane 으로 띄울 때) 창을 닫으면 피커도 같이 죽는다. modal pane 은
# move-pane·join-pane 으로 옮길 수 없다(tmux 3.8: "pane is modal"). 그래서 그 창의 다른 패널만 닫고 @worktree 를 지운다.
# 피커가 끝나면 마지막 패널이 사라지며 창도 닫히고 tmux 가 다른 창으로 옮겨 준다 (3.8 에서 확인).
# 세션의 마지막 창을 닫아야 하면 세션이 끝나지 않도록 세션 디렉토리에 창을 하나 먼저 연다.
picker_window() {  # 피커가 창 안의 modal 패널이면 그 창 id, 아니면 빈 값 (팝업은 패널이 아니다)
  [ -n "${TMUX_PANE:-}" ] || return 0
  [ "$(tmux display-message -p -t "$TMUX_PANE" '#{pane_modal_flag}' 2>/dev/null)" = 1 ] || return 0
  tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null || true
}
wt_flags() {  # $1 경로 → FLAGS
  local path branch flags; FLAGS=""
  while IFS=$'\t' read -r path branch flags; do [ "$path" = "$1" ] && { FLAGS=$flags; return 0; }; done <<< "$WT_LIST"
  return 1
}
real_branch() { case $1 in ""|"(detached "*) return 1 ;; esac; git show-ref -q --verify "refs/heads/$1"; }
# 정리할 수 있나: $1 종류 $2 경로 $3 브랜치. 아니면 1 과 REASON(main | base | remote | locked | dirty | dir), REASON_SAY(안내).
# 하나씩 정리와 한꺼번에 정리가 같은 규칙을 쓴다.
cleanable() {
  local n; REASON="" REASON_SAY=""
  case $1 in
    remote) REASON=remote; REASON_SAY="remote branches are not cleaned up here ${D}(git push origin --delete $3)${R}"; return 1 ;;
    worktree|prunable)
      [ "$2" = "$MAIN" ] && { REASON=main; REASON_SAY="the main checkout is not cleaned up"; return 1; }
      wt_flags "$2" || true
      case " $FLAGS " in *" locked "*) REASON=locked; REASON_SAY="locked worktree ${D}(git worktree unlock $(home_disp "$2"))${R}"; return 1 ;; esac
      if [ "$1" = worktree ] && [ -d "$2" ]; then
        n=$(git -C "$2" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        [ "$n" -gt 0 ] && { REASON=dirty; REASON_SAY="dirty: $n uncommitted change(s) in $(home_disp "$2") ${D}· commit or discard first${R}"; return 1; }
      fi ;;
    branch) ;;
    *) REASON=dir; REASON_SAY="nothing to clean up here"; return 1 ;;
  esac
  [ "$3" = "$(base)" ] && { REASON=base; REASON_SAY="the base branch $3 is not cleaned up"; return 1; }
  return 0
}
on_cleanup() {  # ctrl-x. $1 종류 $2 경로 $3 브랜치 $4 선택한 행들의 파일(fzf {+f}). 선택이 있으면 한꺼번에 정리
  local kind=${1:-} path=${2:-} branch=${3:-}
  busy && return
  st_del confirm target op; cur_mode
  [ "$MODE" = worktree ] || { nope "${Y}nothing to clean up here${R} ${D}(ctrl-x cleans up worktrees and branches in worktree mode)${R}"; return; }
  if [ "${FZF_SELECT_COUNT:-0}" -gt 0 ] && [ -f "${4:-}" ]; then on_cleanup_many "$4"; return; fi
  [ -n "$kind" ] || { printf 'bell'; return; }
  cleanable "$kind" "$path" "$branch" || { nope "${Y}$REASON_SAY${R}"; return; }
  st_set target "$kind$US$path$US$branch"; st_set cleanup_scope one; st_del cleanup_choice
  printf 'execute(%s --choose-cleanup)+transform(%s --on after-cleanup)' "$SELF" "$SELF"
}
# 한꺼번에 정리: 선택한 행 가운데 정리할 수 있는 것만 상태 bulk 에 적고, 정리 목록(clean up N / keep branches)을 겹쳐 띄운다.
# 못 하는 것은 건너뛰고 이유를 센다. clean up 을 골랐는데 머지 안 된 것이 섞여 있으면 그 수를 보여 주고 푸터에서 한 번 더 묻는다.
on_cleanup_many() {  # $1 선택한 행들 (fzf 의 {+f}: 한 줄에 한 행, 칸은 탭)
  local _name disp kind path branch ok=0 wins=0 wts=0 brs=0 unmerged=0 skip="" r x
  local -a reasons=()
  : > "$TMUX_DEV_STATE/bulk"
  # 칸 구분은 탭이지만 IFS=$'\t' read 는 연속 탭을 하나로 합친다 (브랜치 행은 경로 칸이 비어 브랜치가 경로 자리로 밀린다).
  # 그래서 탭을 US 로 바꿔 읽는다 (US 는 공백 IFS 가 아니라 빈 칸을 지킨다)
  while IFS=$US read -r _name disp kind path branch; do
    if cleanable "$kind" "$path" "$branch"; then
      printf '%s%s%s%s%s\n' "$kind" "$US" "$path" "$US" "$branch" >> "$TMUX_DEV_STATE/bulk"
      ok=$((ok + 1))
      [ -n "$path" ] && window_for "$path" && wins=$((wins + 1))
      case $kind in worktree|prunable) wts=$((wts + 1)) ;; esac
      if real_branch "$branch"; then
        brs=$((brs + 1))
        case $disp in *merged*|*new*) ;; *) is_merged "$branch" || unmerged=$((unmerged + 1)) ;; esac   # 마커가 있으면 그대로 쓴다
      fi
    else reasons+=("$REASON"); fi
  done < <(tr '\t' '\037' < "$1")
  if [ "${#reasons[@]}" -gt 0 ]; then   # "2 dirty, 1 main" 처럼 이유별 개수
    for r in main base remote locked dirty dir; do
      x=0; for k in "${reasons[@]}"; do [ "$k" = "$r" ] && x=$((x + 1)); done
      [ "$x" -gt 0 ] && skip+="${skip:+, }$x $r"
    done
    skip="skipping ${#reasons[@]} ($skip)"
  fi
  st_set bulk_skip "$skip"; st_set bulk_unmerged "$unmerged"
  [ "$ok" -gt 0 ] || { nope "${Y}nothing to clean up in the selection${R}${skip:+ ${D}· $skip${R}}"; return; }
  st_set bulk_counts "$ok $wins $wts $brs"; st_set cleanup_scope many; st_del cleanup_choice
  printf 'execute(%s --choose-cleanup)+transform(%s --on after-cleanup)' "$SELF" "$SELF"
}
# --- 정리 목록 (ctrl-x 로 겹쳐 뜬다. 레이아웃 목록과 같은 구조) ---------------------------------
# 항목: clean up(창 → 워크트리 → 백업 → 브랜치 삭제) / keep branch(창 → 워크트리 제거까지, 브랜치는 남긴다).
# 고른 것은 상태 cleanup_choice 에 남기고 메인 목록의 after-cleanup 이 이어받는다. esc·ctrl-c 면 아무것도 안 한다.
# 브랜치만 있는 행은 keep 이 할 일이 없어 clean up 하나만 보인다.
choose_cleanup_step() {
  local scope kind path branch title rows="" picked ok wins wts brs n warn=""
  st_get cleanup_scope; scope=$ST
  if [ "$scope" = many ]; then
    st_get bulk_counts; read -r ok wins wts brs <<< "$ST"
    st_get bulk_unmerged; n=${ST:-0}; [ "$n" -gt 0 ] && warn=" ${Y}($n not merged)${R}"
    title=" clean up $ok selected "
    rows+="clean up $ok$warn"$'	'"clean"$'
'
    [ "$wts" -gt 0 ] && rows+="keep branches ${D}· remove $wts worktree(s) only${R}"$'	'"keep"$'
'
  else
    st_get target; IFS=$US read -r kind path branch <<< "$ST"
    if real_branch "$branch" && ! is_merged "$branch"; then
      warn=" ${Y}(+$(git rev-list --count "$(judge_ref)..$branch" 2>/dev/null || echo '?') not in $(judge_ref))${R}"
    fi
    title=" clean up ${branch:-$(basename "$path")} "
    rows+="clean up$warn"$'	'"clean"$'
'
    case $kind in worktree|prunable) real_branch "$branch" && rows+="keep branch ${D}· remove the worktree only${R}"$'	'"keep"$'
' ;; esac
  fi
  style_opts
  picked=$(printf '%s' "$rows" | fzf --ansi --delimiter '\t' --with-nth 1 --no-sort "${STYLE[@]}" --border-label "$title" \
      --prompt 'clean up> ' --footer "${D}enter choose · esc back${R}" --footer-border line \
      --preview "$SELF --cleanup-preview {2}" --preview-window 'right,55%,border-left' \
      --bind 'alt-p:change-preview-window(down,40%,border-top|hidden|right,55%,border-left)') || return 0
  st_set cleanup_choice "${picked##*$'\t'}"
}
next_archive_ref() {  # archive_branch 가 쓸 이름을 미리 (만들지 않는다)
  local base ref i=2; base="refs/archive/$(date +%Y-%m-%d)/$1"; ref=$base
  while git show-ref -q --verify "$ref"; do ref="$base-$i"; i=$((i + 1)); done
  printf '%s' "$ref"
}
plan_lines() {  # $1 clean | keep $2 종류 $3 경로 $4 브랜치 → 할 일을 한 줄씩 (정리 목록의 미리보기)
  local ref
  [ -n "$3" ] && window_for "$3" && echo "close window ●$WIN_IDX"
  case $2 in worktree) echo "remove worktree $(home_disp "$3")" ;; prunable) echo "prune missing worktree $(home_disp "$3")" ;; esac
  real_branch "$4" || return 0
  if [ "$1" = keep ]; then echo "${G}keep branch $4${R} ${D}(enter on its row later to recreate the worktree)${R}"; return 0; fi
  ref=$(next_archive_ref "$4")
  echo "archive $4 → $ref"; echo "delete branch $4"
  is_merged "$4" || echo "${Y}+$(git rev-list --count "$(judge_ref)..$4" 2>/dev/null || echo '?') commits not in $(judge_ref)${R} ${D}(kept in the archive)${R}"
  echo "${D}restore: git branch $4 $ref${R}"
}
cleanup_preview() {  # $1 clean | keep
  local scope kind path branch skipped=0
  st_get cleanup_scope; scope=$ST
  if [ "$scope" != many ]; then
    st_get target; IFS=$US read -r kind path branch <<< "$ST"
    plan_lines "$1" "$kind" "$path" "$branch"; return 0
  fi
  while IFS=$US read -r kind path branch; do
    if [ "$1" = keep ] && [ "$kind" = branch ]; then skipped=$((skipped + 1)); continue; fi
    echo "${B}${branch:-$(basename "$path")}${R}"
    plan_lines "$1" "$kind" "$path" "$branch" | sed 's/^/  /'
  done < "$TMUX_DEV_STATE/bulk"
  st_get bulk_skip; [ -n "$ST" ] && printf '\n%s%s%s\n' "$D" "$ST" "$R"
  [ "$skipped" -gt 0 ] && printf '%sskipping %s branch row(s): no worktree to remove%s\n' "$D" "$skipped" "$R"
  return 0
}
# 정리 목록에서 고른 뒤 (메인 목록의 transform). clean up 이면 머지 안 된 것이 있을 때 푸터에서 한 번 더 묻는다
on_after_cleanup() {
  local choice scope kind path branch n
  st_get cleanup_choice; choice=$ST; st_del cleanup_choice
  [ -n "$choice" ] || return 0
  st_get cleanup_scope; scope=$ST
  if [ "$scope" = many ]; then
    if [ "$choice" = keep ]; then start_job many keep; return; fi
    st_get bulk_unmerged; n=${ST:-0}
    if [ "$n" -gt 0 ]; then ask "" "" "" "${Y}$n of them have commits not in $(judge_ref)${R} · clean up anyway?" bulk2; return; fi
    start_job many; return
  fi
  st_get target; IFS=$US read -r kind path branch <<< "$ST"
  if [ "$choice" = keep ]; then start_job one keep; return; fi
  if real_branch "$branch" && ! is_merged "$branch"; then
    n=$(git rev-list --count "$(judge_ref)..$branch" 2>/dev/null || echo '?')
    ask "$kind" "$path" "$branch" "${Y}$branch has $n commit(s) not in $(judge_ref)${R} · clean up anyway?" clean2
    return
  fi
  start_job one
}

# --- 정리 작업 (진행 표시) -----------------------------------------------------------------
# 정리는 피커의 콜백(transform)에서 바로 하지 않고 tmux 서버의 run-shell -b 로 띄운다. 그래서 fzf 가 멈추지 않고, 피커가
# 끝나도(esc, 피커 창 닫힘) 정리는 끝까지 간다. 피커는 every 이벤트로 틱마다 상태 progress 를 푸터에 그리다가 finished 가
# 생기면 목록을 다시 읽고 결과(result)를 푸터에 남긴다. 정리 중에는 busy 가 다른 키(enter, ctrl-x, 모드 …)를 막는다.
# 상태 디렉토리는 피커가 끝나면 지워지므로 작업은 시작할 때 할 일을 모두 읽어 두고, 이후의 쓰기는 실패해도 넘어간다.
EVERY='every(0.15)'
SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
busy() { st_get busy; [ "$ST" = 1 ] || return 1; printf 'bell'; }   # 정리 중이면 벨만 (푸터는 틱이 그린다)
start_job() {  # $1 one(상태 target) | many(상태 bulk) [$2 keep]
  st_del confirm op finished result fail progress
  st_set job "$1$US${2:-}$US$(picker_window)"
  st_set busy 1; st_set tick 0
  # run-shell 의 출력은 패널에 뜨므로 버린다. 피커 패널(TMUX_PANE)은 close_windows 가 남겨야 해서 넘긴다
  tmux run-shell -b "$(printf 'TMUX_DEV_STATE=%q TMUX_PANE=%q %q -t %q --cleanup-job >/dev/null 2>&1' \
    "$TMUX_DEV_STATE" "${TMUX_PANE:-}" "$SELF" "$SESSION")"
  printf 'unbind(focus)+%s+rebind(%s)' "$(act change-footer "${SPIN[0]} ${B}cleaning up${R}")" "$EVERY"
}
cleanup_tick() {  # every 이벤트: 끝났으면 결과, 아니면 스피너와 진행
  local n msg f
  if [ -f "$TMUX_DEV_STATE/finished" ]; then
    st_get result; msg=$ST; st_get fail; f=$ST
    st_del busy finished result fail progress tick job
    printf 'unbind(%s)+%sdeselect-all+rebind(load)+reload(%s --list worktree)+%s' "$EVERY" "${f:+bell+}" "$SELF" "$(act change-footer "$msg")"
    return 0
  fi
  st_get busy; [ "$ST" = 1 ] || { printf 'unbind(%s)' "$EVERY"; return 0; }
  st_get tick; n=$(( (${ST:-0} + 1) % ${#SPIN[@]} )); st_set tick "$n"
  st_get progress
  act change-footer "${SPIN[$n]} ${B}cleaning up${R}${ST:+ ${D}· $ST${R}}"
}
job_put() { [ -d "${TMUX_DEV_STATE:-/nonexistent}" ] && { printf '%s\n' "$2" > "$TMUX_DEV_STATE/$1"; } 2>/dev/null; return 0; }
job_finish() {  # 결과를 알린다 (한 번만). 중간에 죽어도 EXIT 트랩이 불러 피커가 계속 돌지 않게 한다
  [ -n "${JOB_DONE:-}" ] && return 0; JOB_DONE=1
  job_put result "${JOB_MSG:-${Y}cleanup stopped unexpectedly${R}}"; job_put fail "${JOB_FAIL:-}"; job_put finished 1
}
cleanup_job() {
  local scope keep selfwin kind path branch
  local -a items=()
  JOB_MSG="" JOB_FAIL="" JOB_DONE=""
  trap job_finish EXIT
  st_get job; IFS=$US read -r scope keep selfwin <<< "$ST"
  [ -n "$scope" ] || exit 0
  if [ "$scope" = many ]; then
    while IFS= read -r kind; do items+=("$kind"); done < "$TMUX_DEV_STATE/bulk"
    st_get bulk_skip; JOB_SKIP=$ST
  else st_get target; items=("$ST"); fi
  cd "$MAIN"   # 세션 디렉토리가 지우려는 워크트리일 수 있다
  if [ "$scope" = many ]; then bulk_run "$keep" "$selfwin" "${items[@]}"
  else IFS=$US read -r kind path branch <<< "${items[0]}"; clean_run "$kind" "$path" "$branch" "$keep" "$selfwin"; fi
  job_finish
  empty_trash   # 느린 디스크 삭제는 결과를 알린 뒤에
}
bulk_run() {  # $1 keep|"" $2 피커 창 $3.. "종류 US 경로 US 브랜치". 하나씩 정리하고 실패해도 나머지는 계속한다. 결과는 JOB_MSG
  local keep=$1 selfwin=$2 kind path branch done_n=0 failed=0 refs=0 err="" msg any_self="" noworktree=0 i=0 total item
  shift 2; total=$#
  for item in "$@"; do
    i=$((i + 1)); IFS=$US read -r kind path branch <<< "$item"
    if [ "$keep" = keep ] && [ "$kind" = branch ]; then noworktree=$((noworktree + 1)); continue; fi
    JOB_ITEM="$i/$total ${branch:-$(basename "$path")}"
    if clean_one "$kind" "$path" "$branch" "$selfwin" "$keep"; then
      done_n=$((done_n + 1)); [ -n "$ONE_REF" ] && refs=$((refs + 1)); [ -n "$SELF_CLOSING" ] && any_self=1
    else failed=$((failed + 1)); err=${err:-$ONE_ERR}; fi
  done
  if [ "$keep" = keep ]; then msg="${G}removed $done_n worktree(s)${R} ${D}· branches kept${R}"
  else msg="${G}cleaned up $done_n${R}"; fi
  [ "$noworktree" -gt 0 ] && msg+=" ${D}· skipped $noworktree branch row(s) with no worktree${R}"
  [ "$refs" -gt 0 ] && msg+=" ${D}· archived $refs branch(es) under refs/archive/$(date +%Y-%m-%d)/ (tmux-dev worktree --archived)${R}"
  [ -n "${JOB_SKIP:-}" ] && msg+=" ${D}· $JOB_SKIP${R}"
  [ "$failed" -gt 0 ] && { msg+=" · ${Y}$failed failed${R}: $err"; JOB_FAIL=1; }
  [ -n "$any_self" ] && msg+=" ${D}· this window closes when you leave the picker${R}"
  JOB_MSG=$msg
}
keep_session_window() {  # 세션의 마지막 창을 닫기 전에 세션 디렉토리에 창을 하나 연다 (메인 체크아웃이면 @worktree 도)
  local root win; st_get root; root=${ST:-$MAIN}
  win=$(tmux new-window -d -P -F '#{window_id}' -t "$SESSION:" -c "$root")
  [ "$root" = "$MAIN" ] && tmux set-option -w -t "$win" @worktree "$MAIN"
  return 0
}
close_windows() {  # $1 워크트리 경로 $2 피커가 속한 창(없으면 빈 값). 피커 창을 다뤘으면 SELF_CLOSING=1
  SELF_CLOSING=""
  [ -n "$SESSION" ] && [ -n "$1" ] || return 0
  local id tag p total
  while IFS=$US read -r id tag; do
    [ "$tag" = "$1" ] || continue
    total=$(tmux list-windows -t "$SESSION" 2>/dev/null | wc -l | tr -d ' ')
    [ "$total" -le 1 ] && keep_session_window
    if [ -n "$2" ] && [ "$id" = "$2" ]; then
      for p in $(tmux list-panes -t "$id" -F '#{pane_id}'); do [ "$p" = "$TMUX_PANE" ] || tmux kill-pane -t "$p"; done
      tmux set-option -w -u -t "$id" @worktree
      SELF_CLOSING=1
    else
      tmux kill-window -t "$id"
    fi
  done < <(tmux list-windows -t "$SESSION" -F "#{window_id}${US}#{@worktree}" 2>/dev/null)
}
# 하나를 정리한다: 창 → 워크트리 → 백업 → 브랜치. 결과는 ONE_REF(백업 ref, 없으면 빈 값), 실패면 1 과 ONE_ERR.
# $4 피커가 속한 창 (picker_window. 한꺼번에 정리할 때 한 번만 구한다) $5 keep 이면 브랜치는 그대로 (백업·삭제 없음)
clean_one() {
  local kind=$1 path=$2 branch=$3 out
  ONE_REF="" ONE_ERR=""
  step "closing windows"; close_windows "$path" "${4:-}"
  case $kind in
    worktree) step "removing worktree"; trash_worktree "$path" || return 1 ;;
    prunable) git worktree prune ;;
  esac
  if [ "${5:-}" != keep ] && real_branch "$branch"; then
    step "archiving branch"
    ONE_REF=$(archive_branch "$branch") || { ONE_ERR="could not archive $branch"; return 1; }
    out=$(git branch -D "$branch" 2>&1) || { ONE_ERR="git branch -D failed: ${out##*$'\n'}"; return 1; }
  fi
  return 0
}
step() { job_put progress "${JOB_ITEM:+$JOB_ITEM · }$1"; }
clean_run() {  # $1 종류 $2 경로 $3 브랜치 $4 keep|"" $5 피커 창. 하나를 정리한다. 결과는 JOB_MSG (실패면 JOB_FAIL)
  local label=$3 msg
  real_branch "$3" || label=$(basename "$2")
  JOB_ITEM=$label
  clean_one "$1" "$2" "$3" "${5:-}" "${4:-}" || { JOB_MSG="${Y}$ONE_ERR${R}"; JOB_FAIL=1; return 0; }
  if [ "${4:-}" = keep ]; then msg="${G}removed worktree${R} ${B}$label${R} ${D}· kept branch $3 (enter on its row to recreate)${R}"
  else msg="${G}cleaned up${R} ${B}$label${R}"; fi
  [ -n "$ONE_REF" ] && msg+=" ${D}· archived →${R} $ONE_REF ${D}· restore: git branch $3 $ONE_REF${R}"
  [ -n "$SELF_CLOSING" ] && msg+=" ${D}· this window closes when you leave the picker${R}"
  JOB_MSG=$msg
}
# --- 빠른 제거: 휴지통으로 옮긴 뒤 지운다 ----------------------------------------------------------
# git worktree remove 는 디렉토리를 다 지울 때까지 기다린다 (node_modules 같은 무시 파일이 많으면 몇 초). 대신 같은 부모의
# .trash/ 로 git worktree move 한다: 같은 파일시스템의 이름 바꾸기라 즉시 끝나고, 경로·목록 행이 바로 비며, HEAD 를 떼어
# 브랜치도 바로 지울 수 있다(같은 이름으로 다시 만들 수도). 실제 삭제(git worktree remove --force)는 결과를 알린 뒤에 한다.
# 옮기지 못하면(서브모듈, 다른 파일시스템 …) 예전처럼 바로 지운다. 휴지통의 워크트리는 목록에 안 보이고(list_worktrees),
# 중간에 끊겨 남은 것은 다음에 피커가 뜰 때 마저 지운다(trash_sweep).
TRASHED=()
trash_worktree() {  # $1 워크트리 경로. 실패면 1 과 ONE_ERR
  local path=$1 tdir dest out
  tdir="$(dirname "$path")/.trash"; dest="$tdir/$(basename "$path").$(date +%Y%m%d-%H%M%S).$$"
  if mkdir -p "$tdir" 2>/dev/null && git worktree move "$path" "$dest" >/dev/null 2>&1; then
    git -C "$dest" checkout -q --detach >/dev/null 2>&1 || true
    TRASHED+=("$dest"); return 0
  fi
  rmdir "$tdir" 2>/dev/null || true
  out=$(git worktree remove "$path" 2>&1) || { ONE_ERR="git worktree remove failed: ${out##*$'\n'}"; return 1; }
}
trashed_worktrees() {  # 휴지통에 있는(아직 등록된) 워크트리 경로들
  local line
  while IFS= read -r line; do
    case $line in "worktree "*/.trash/*) printf '%s\n' "${line#worktree }" ;; esac
  done < <(git worktree list --porcelain)
}
empty_trash() {  # 휴지통의 워크트리를 모두 지운다 (이번 것 + 지난번에 남은 것). 지운 뒤 빈 .trash 도
  local p t
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    git worktree remove --force --force "$p" >/dev/null 2>&1 || { rm -rf "$p"; git worktree prune; }
    t=${p%/*}; rmdir "$t" 2>/dev/null || true
  done < <(trashed_worktrees)
  return 0
}
trash_sweep() {  # 남은 휴지통이 있으면 tmux 서버에서 지운다 (피커를 기다리게 하지 않는다)
  local left; left=$(trashed_worktrees)
  [ -n "$left" ] && [ -n "${TMUX:-}" ] || return 0
  tmux run-shell -b "$(printf 'cd %q && %q --empty-trash >/dev/null 2>&1' "$MAIN" "$SELF")"
}
# 브랜치를 지우기 전에 refs/archive/<날짜>/<브랜치> 에 남긴다 (같은 날 같은 이름이 또 있으면 -2, -3 …). refs/heads 밖이라
# 브랜치 목록에는 안 뜨고 git log --all 과 for-each-ref refs/archive 에는 보인다. 기록한 ref 를 출력한다.
archive_branch() {
  local base ref i=2; base="refs/archive/$(date +%Y-%m-%d)/$1"; ref=$base
  while git show-ref -q --verify "$ref"; do ref="$base-$i"; i=$((i + 1)); done
  git update-ref "$ref" "refs/heads/$1" && printf '%s\n' "$ref"
}
list_archived() {
  git for-each-ref refs/archive --sort=-refname --format='%(refname)  %(objectname:short)  %(committerdate:short)  %(contents:subject)'
  echo
  echo "restore: git branch <name> <ref>    delete: git update-ref -d <ref>"
}

# --- Claude Code 훅 --------------------------------------------------------------------
# WorktreeCreate 는 Claude 의 기본 생성(git worktree add)을 통째로 대체한다. 비대화형: 질문 없고, 멱등이며,
# stdout 의 마지막 비어 있지 않은 줄이 경로다 (나머지 출력은 stderr). 실패는 비정상 종료.
hook_json() { command -v jq >/dev/null || die "hooks need jq"; HOOK_IN=$(cat); }
hook_field() { printf '%s' "$HOOK_IN" | jq -r --arg k "$1" '.[$k] // empty'; }
hook_create() {
  hook_json
  local name cwd; name=$(hook_field name); cwd=$(hook_field cwd)
  [ -n "$name" ] || die "WorktreeCreate: no name"
  [ -d "$cwd" ] && cd "$cwd"
  repo_init
  {
    echo "tmux-dev: WorktreeCreate name=$name repo=$(abbrev_home "$MAIN")"
    resolve_name "$name"
    case $KIND in
      prunable) git worktree prune; KIND=branch ;;
    esac
    case $KIND in
      worktree) ;;
      branch)   add_worktree "$BRANCH" ;;
      remote)   add_worktree --track -b "$BRANCH" "$TARGET" ;;
      new)      add_worktree -b "$BRANCH" "$(base)" ;;
    esac
  } >&2
  printf '%s\n' "$TARGET"
}
# WorktreeRemove: Claude 가 워크트리를 지우기로 한 뒤 불린다. 워크트리는 강제로 지우되 브랜치는 베이스에 모두 들어 있을
# 때만 보관 → 삭제한다. 머지 안 된 커밋이 있는 브랜치는 남긴다 (피커의 ctrl-x 가 확인을 거쳐 정리한다). 윈도우는 그대로.
hook_remove() {
  hook_json
  local path branch common ref; path=$(hook_field worktree_path)
  [ -n "$path" ] || die "WorktreeRemove: no worktree_path"
  if [ ! -d "$path" ]; then echo "tmux-dev: already gone: $path" >&2; exit 0; fi
  common=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "not a git worktree: $path"
  branch=$(git -C "$path" symbolic-ref -q --short HEAD 2>/dev/null || true)
  cd "${common%/.git}"
  repo_init
  {
    echo "tmux-dev: WorktreeRemove $(abbrev_home "$path") (${branch:-detached})"
    git worktree remove --force --force "$path"
    if [ -n "$branch" ] && [ "$branch" != "$(base)" ] && git show-ref -q --verify "refs/heads/$branch"; then
      if is_merged "$branch"; then ref=$(archive_branch "$branch") && echo "archived: $ref" && git branch -D "$branch"
      else echo "keeping branch $branch: it has commits not in $(base) (clean up with ctrl-x in prefix W)"; fi
    fi
  } >&2
}

# --- 인자 ------------------------------------------------------------------------------
# 콜백·목록·미리보기는 피커가 띄운 것이라 세션 디렉토리에서 저장소를 찾는다 (상태 root). 셸 호출은 지금 디렉토리 기준.
in_session_dir() { st_get root; [ -n "$ST" ] && [ -d "$ST" ] && cd "$ST"; repo_try || true; }
arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --base)   BASE=$2; shift 2 ;;
    --layout) LAYOUT=$2; shift 2 ;;
    -t)       SESSION=$2; shift 2 ;;
    --on)
      SESSION=${SESSION:-$(tmux display-message -p '#S' 2>/dev/null || true)}
      in_session_dir; cur_mode; apply_scope "$MODE"
      # 콜백은 출력이 전부다. 마지막 조건식의 종료 코드로 set -e 가 끊지 않게 || true
      case $2 in
        enter) on_enter "${3:-}" "${4:-}" "${5:-}" || true ;; layout) on_layout "${3:-}" "${4:-}" "${5:-}" || true ;;
        after-layout) on_after_layout || true ;; create) on_create "${3:-}" || true ;; after-location) on_after_location || true ;;
        loc-enter) on_loc_enter "${3:-}" || true ;; loc-layout) on_loc_layout "${3:-}" || true ;;
        loc-after-layout) on_loc_after_layout || true ;;
        esc) on_esc || true ;; change) on_change || true ;; result) on_result || true ;; focus) on_focus || true ;;
        mode) on_mode "${3:-next}" || true ;; tab-click) on_tab_click || true ;; marks) on_marks || true ;;
        refresh) on_refresh || true ;; cleanup) on_cleanup "${3:-}" "${4:-}" "${5:-}" "${6:-}" || true ;;
        toggle-merged) on_toggle_merged || true ;; after-cleanup) on_after_cleanup || true ;; deselect) on_deselect || true ;; fetch) on_fetch || true ;; fill) on_fill "${3:-}" || true ;; help) on_help || true ;;
      esac; exit 0 ;;
    --cleanup-tick)    cleanup_tick; exit 0 ;;   # 저장소를 찾지 않는다 (틱마다 불린다)
    --cleanup-job)     in_session_dir; cleanup_job; exit 0 ;;
    --empty-trash)     repo_init; empty_trash; exit 0 ;;
    --choose-layout)   in_session_dir; w_choose_layout_step; exit 0 ;;
    --choose-cleanup)  SESSION=${SESSION:-$(tmux display-message -p '#S' 2>/dev/null || true)}; in_session_dir; choose_cleanup_step; exit 0 ;;
    --cleanup-preview) SESSION=${SESSION:-$(tmux display-message -p '#S' 2>/dev/null || true)}; in_session_dir; cleanup_preview "${2:-clean}"; exit 0 ;;
    --choose-location) in_session_dir; cur_mode; apply_scope "$MODE"; choose_location_step; exit 0 ;;
    --loc-preview)     loc_preview "${2:-}"; exit 0 ;;
    --help-keys)       in_session_dir; help_keys; exit 0 ;;
    --list)
      SESSION=${SESSION:-$(tmux display-message -p '#S' 2>/dev/null || true)}
      in_session_dir
      case ${2:-} in
        worktree)  # 마커가 붙은 목록은 ctrl-t 가 읽도록 상태에도 남긴다 (마커 없는 목록이면 지운다)
          if [ "${3:-}" = --marks ] && [ -n "${TMUX_DEV_STATE:-}" ]; then list_mode worktree --marks | tee "$TMUX_DEV_STATE/rows"
          else [ -n "${TMUX_DEV_STATE:-}" ] && rm -f "$TMUX_DEV_STATE/rows"; list_mode worktree "${3:-}"; fi ;;
        subdirectory|directory) list_mode "$2" "${3:-}" ;;
        *) cur_mode; list_mode "$MODE" "${2:-}" ;;
      esac
      exit 0 ;;
    --preview) in_session_dir; preview "${2:-}" "${3:-}" "${4:-}"; exit 0 ;;
    --path)    repo_init; wt_dir "${2:?--path needs a branch}"; exit 0 ;;
    --archived) repo_init; list_archived; exit 0 ;;
    --layouts)    layout_list; exit 0 ;;
    --layout-art) layout_art "${2:-}"; exit 0 ;;
    --hook-create) hook_create; exit 0 ;;
    --hook-remove) hook_remove; exit 0 ;;
    -h|--help) sed -n '2,/^set -euo/{/^set -euo/d;p;}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) arg=$1; shift ;;
  esac
done

if [ -n "${TMUX:-}" ]; then SESSION=${SESSION:-$(tmux display-message -p '#S')}; fi
if [ -z "$arg" ]; then
  [ -n "$SESSION" ] || die "outside tmux, give a branch or a path"
  # 피커는 세션 디렉토리에서 저장소를 찾는다 (패널의 cwd 가 아니다)
  sd=$(session_dir); [ -n "$sd" ] && cd "$sd"
  repo_try || true
  pick
  exit 0
fi
# 인자가 디렉토리면 그 안에서 저장소를 찾는다 (project 가 다른 디렉토리에서 넘길 수 있다). 저장소가 아니어도 된다 (dir)
[ -d "$arg" ] && cd "$arg"
repo_try || true
if [ -d "$arg" ]; then resolve_dir .
else repo_init; resolve_name "$arg"; fi
open_target
