#!/usr/bin/env bash
# tmux-dev worktree: 워크트리(브랜치)를 골라 그 윈도우로 간다 (없으면 워크트리와 윈도우를 만든다).
#
# 멘탈 모델: 세션 = 저장소(tmux-dev project), 윈도우 = 워크트리 = 브랜치. 윈도우 탭에 브랜치 이름이
# 나열되어 "지금 벌어져 있는 작업" 이 상태바에 보인다. 윈도우 안은 왼쪽 셸(에이전트 CLI 등) /
# 오른쪽 nvim (lib/layout.sh 의 ide 레이아웃).
# 이것은 tmux 의 세션·윈도우를 대체하는 것이 아니라 그 위에 얹는 관례다. 워크트리가 아닌 윈도우
# (prefix c), 저장소가 아닌 세션, 순정 `tmux new -c <워크트리>` 모두 그대로 정상이다.
# 순정 대응은 `git worktree add -b <브랜치> <경로> main` + `tmux new-window -n <브랜치> -c <경로>` 이고,
# 이 스크립트는 "없으면 만들어 준다", 경로 규칙, 레이아웃만 보탠다.
#
# 사용
#   tmux-dev worktree                    fzf 로 고른다 (tmux 안에서는 prefix W 가 팝업으로 띄움)
#   tmux-dev worktree <브랜치>           바로 그 브랜치의 윈도우로 (브랜치·워크트리가 없으면 만든다)
#   tmux-dev worktree <워크트리 경로>    바로 그 워크트리의 윈도우로
#   tmux-dev worktree --base <ref>       새 브랜치의 베이스 (기본: 로컬 main. origin/HEAD 가 가리키는 이름)
#   tmux-dev worktree --layout plain     새 윈도우의 레이아웃 (ide | plain)
#   tmux-dev worktree -t <세션>          윈도우를 만들 세션 (기본: 지금 클라이언트의 세션)
#   tmux-dev worktree --path <브랜치>    그 브랜치의 워크트리가 만들어질 경로만 출력
#   tmux-dev worktree --list             후보 목록만 출력 (디버그)
#   tmux 밖에서 실행하면 워크트리만 만들고(있으면 그대로) 경로를 출력한다.
#
# 팝업(fzf) 안에서 (fzf 기본 키와 겹치지 않는 키만 썼다)
#   tab / shift-tab   all(워크트리 + 브랜치) ↔ worktrees(워크트리만) 필터
#   Enter             선택. 행의 상태가 동작을 정한다:
#                       윈도우 열려 있음(●N) → 그 윈도우로.  워크트리만 있음 → 윈도우 만들기.
#                       브랜치만 있음 → 워크트리 만들고 윈도우.  원격 브랜치 → 추적 브랜치 + 워크트리 + 윈도우.
#                     맞는 후보가 없으면 친 글자를 새 브랜치 이름으로 쓴다 (베이스에서 분기)
#   alt-enter         후보가 있어도 친 글자를 브랜치 이름으로 쓴다 (macOS Ghostty: 왼쪽 option)
#   ctrl-x            커서 항목 정리. 워크트리 → git worktree remove (변경이 있으면 거절) + 그 윈도우 닫기,
#                     브랜치가 베이스에 모두 들어 있으면 물어보고 git branch -D. 브랜치 행 → 머지됐을 때만 -D.
#                     prunable 행 → git worktree prune. 메인 체크아웃과 원격 브랜치는 건드리지 않는다.
#   행 마커           ●N 열린 윈도우 번호 · dirty 커밋 안 된 변경 · merged 베이스에 모두 들어 있음(rebase 머지도
#                     git cherry 가 패치 내용으로 잡는다) · [ahead n, behind m] 업스트림 대비 · prunable · locked
#
# 워크트리 위치 (git config. 전역 --global 과 저장소별 값이 한 메커니즘. 스크립트가 tmux 밖에서도 돌아야 해서
# tmux 옵션이 아니라 git config 에 둔다)
#   tmux-dev.worktree.location  central(기본) | sibling
#       central:  <root>/<name>/<브랜치의 / 를 - 로>      기본 ~/.local/share/tmux-dev/worktrees/dotfiles/feat-foo
#       sibling:  <저장소 부모>/<name>.worktrees/<...>      예) ~/dev/jwlee/dotfiles.worktrees/feat-foo
#   tmux-dev.worktree.root      central 의 모음 디렉토리 (기본 $XDG_DATA_HOME/tmux-dev/worktrees. 워크트리는
#                               저장소에서 파생된 체크아웃이라 도구가 관장하는 데이터 자리에 둔다. ls 로는 안 보이므로
#                               무엇이 있는지는 이 팝업으로 본다)
#   tmux-dev.worktree.name      모음 안에서 이 저장소가 쓰는 이름 (기본: 메인 체크아웃의 디렉토리 이름).
#                               같은 이름의 저장소가 둘이면 만들 때 감지해 거절하므로, 그때 저장소별로 준다
#   tmux-dev.worktree.setup     새 워크트리를 만든 뒤 그 안에서 한 번 실행할 셸 명령 (예: cp "$TMUX_WORKTREE_MAIN/.env" .)
#                               환경변수 TMUX_WORKTREE_MAIN / TMUX_WORKTREE_PATH / TMUX_WORKTREE_BRANCH 를 받는다.
#                               순정 대응은 git 의 post-checkout 훅이다 (git worktree add 가 실행한다).
#
# 윈도우 식별: 만든 윈도우에 사용자 옵션 @worktree <경로> 를 둔다 (man tmux OPTIONS: '@' 접두 user option.
# 포맷 #{@worktree} 로 읽음). 이 옵션이 있는 윈도우만 "워크트리 윈도우" 이고, 메인 체크아웃 행은 옵션이 없을
# 때 패널 경로로 보완한다 (project 가 세션을 만들며 첫 윈도우에 옵션을 둔다). 탐색 범위는 세션 하나다.
set -euo pipefail

SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
LIB=$(cd "$(dirname "$SELF")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"
# shellcheck source=../lib/layout.sh
. "$LIB/layout.sh"

LAYOUT=$TMUX_DEV_LAYOUT
BASE=""                                    # --base. 비어 있으면 default_base
SESSION="${TMUX_WORKTREE_SESSION:-}"       # -t
US=$'\x1f'   # 빈 필드가 있을 수 있는 행의 구분자. bash 의 read 는 tab 같은 공백 IFS 가 연속되면 빈 필드를 합친다.

conf() { git config --get "tmux-dev.worktree.$1" 2>/dev/null || true; }   # 없으면 빈 문자열

# --- 저장소 ---------------------------------------------------------------------
# 현재 디렉토리에서 메인 체크아웃을 찾는다. 워크트리 안에서 불러도 된다 (worktree list 의 첫 줄이 메인).
repo_init() {
  COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "git 저장소가 아닙니다: $(abbrev_home "$PWD")  (워크트리가 아닌 윈도우는 prefix c)"
  WT_LIST=$(list_worktrees)                              # 워크트리 목록은 한 번만 읽는다
  WT_PATHS=$(cut -f1 <<< "$WT_LIST")
  MAIN=${WT_PATHS%%$'\n'*}
  [ -n "$MAIN" ] && [ -d "$MAIN/.git" ] || die "bare 저장소는 지원하지 않습니다"
  NAME=$(conf name); NAME=${NAME:-$(basename "$MAIN")}
}
default_base() {  # origin/HEAD 가 가리키는 브랜치의 로컬 사본 → main → master → HEAD
  local b
  if b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); then
    b=${b#origin/}; git show-ref -q --verify "refs/heads/$b" && { echo "$b"; return; }
  fi
  for b in main master; do git show-ref -q --verify "refs/heads/$b" && { echo "$b"; return; }; done
  echo HEAD
}
base() { echo "${BASE:-$(default_base)}"; }

# --- 경로 규칙 --------------------------------------------------------------------
project_dir() {  # 이 저장소의 워크트리들이 모이는 디렉토리
  local loc root; loc=$(conf location); loc=${loc:-central}
  case $loc in
    central) root=$(conf root); root=$(expand_tilde "${root:-$TMUX_DEV_WORKTREES}"); printf '%s/%s\n' "$root" "$NAME" ;;
    sibling) printf '%s/%s.worktrees\n' "$(dirname "$MAIN")" "$NAME" ;;
    *) die "모르는 tmux-dev.worktree.location '$loc' (central, sibling)" ;;
  esac
}
wt_dir() { local p; p=$(project_dir) || exit 1; printf '%s/%s\n' "$p" "${1//\//-}"; }   # 브랜치 → 새 워크트리 경로
# 모음 디렉토리가 다른 저장소의 것이면 거절한다. 그 안의 워크트리 .git 파일 한 줄(gitdir: <메인>/.git/worktrees/<n>)로 판별.
check_project_dir() {
  local pdir=$1 g line other
  [ -d "$pdir" ] || return 0
  for g in "$pdir"/*/.git; do
    [ -f "$g" ] || continue
    IFS= read -r line < "$g" || continue
    line=${line#gitdir: }; other=${line%/worktrees/*}
    [ "$other" = "$COMMON" ] && return 0
    die "$(abbrev_home "$pdir") 는 $(abbrev_home "${other%/.git}") 의 워크트리 모음입니다. 이 저장소에는 다른 이름을 주세요:  git config tmux-dev.worktree.name <이름>"
  done
}

# --- 후보 -------------------------------------------------------------------------
# 행 형식: "<표시>\t<종류>\t<브랜치>\t<경로>". fzf 는 TAB 앞만 보여주고 뒤를 돌려준다.
#   worktree  경로 = 워크트리 디렉토리. 브랜치가 비면 detached
#   branch    로컬 브랜치, 워크트리 없음. 경로 비어 있음 (마지막 필드라 tab 이어도 안전)
#   remote    원격에만 있는 브랜치. 브랜치 = 짧은 이름, 경로 = 원격 ref (origin/이름)
#   prunable  디렉토리가 사라진 워크트리 (git worktree prune 대상)
list_worktrees() {  # "<경로>\t<브랜치>\t<플래그>" (메인이 첫 줄. 브랜치는 비지 않는다)
  local path="" head="" branch="" flags=""
  while IFS= read -r line; do
    case $line in
      "worktree "*) path=${line#worktree } ;;
      "HEAD "*)     head=${line#HEAD } ;;
      "branch "*)   branch=${line#branch refs/heads/} ;;
      detached)     flags="$flags detached" ;;
      locked*)      flags="$flags locked" ;;
      prunable*)    flags="$flags prunable" ;;
      "") [ -n "$path" ] && printf '%s\t%s\t%s\n' "$path" "${branch:-(detached ${head:0:7})}" "${flags# }"
          path="" head="" branch="" flags="" ;;
    esac
  done < <(git worktree list --porcelain; echo)
}
# 세션의 윈도우: "<인덱스> US <id> US <@worktree> US <활성 패널 경로>" (@worktree 는 비어 있을 수 있다)
list_windows() { [ -n "$SESSION" ] && tmux list-windows -t "$SESSION" -F "#{window_index}${US}#{window_id}${US}#{@worktree}${US}#{pane_current_path}" 2>/dev/null || true; }
# 워크트리 경로 → 그 윈도우 id (없으면 빈 줄). @worktree 가 우선, 메인은 패널 경로로 보완
# (메인 안이되 다른 워크트리 안은 아닌 패널을 가진, 옵션 없는 가장 앞 윈도우).
# 윈도우 목록은 한 번만 읽어 둔다 (행마다 tmux 를 부르면 워크트리 19개에 ~100ms).
WIN_LIST=""; WIN_LIST_READY=""
window_for() {
  local want=$1 idx id tag pane fallback="" inside
  [ -n "$WIN_LIST_READY" ] || { WIN_LIST=$(list_windows); WIN_LIST_READY=1; }
  while IFS=$US read -r idx id tag pane; do
    [ "$tag" = "$want" ] && { echo "$id"; return; }
    if [ "$want" = "$MAIN" ] && [ -z "$tag" ] && [ -z "$fallback" ]; then
      case $pane in "$MAIN"|"$MAIN"/*)
        inside=0
        while IFS= read -r other; do
          [ -z "$other" ] || [ "$other" = "$MAIN" ] && continue
          case $pane in "$other"|"$other"/*) inside=1; break ;; esac
        done <<< "$WT_PATHS"
        [ "$inside" = 0 ] && fallback=$id ;;
      esac
    fi
  done <<< "$WIN_LIST"
  echo "$fallback"
}
rows() {  # $1 = all | worktrees
  local mode=${1:-all} path branch flags ref track w=12 n
  local -a wt=() br=() rm=()
  local has_local=$'\n'   # 로컬 브랜치 이름 목록 (줄바꿈으로 감쌈. macOS bash 3.2 에는 연관 배열이 없다)
  while IFS=$'\t' read -r path branch flags; do
    wt+=("$path|$branch|$flags"); n=${#branch}; [ "$n" -gt "$w" ] && w=$n
  done <<< "$WT_LIST"
  if [ "$mode" = all ]; then
    # worktreepath 는 비어 있을 수 있으므로 구분자는 US (git 포맷의 %1f)
    while IFS=$US read -r ref path track; do
      has_local="$has_local$ref"$'\n'
      [ -z "$path" ] && { br+=("$ref|$track"); n=${#ref}; [ "$n" -gt "$w" ] && w=$n; }
    done < <(git for-each-ref refs/heads --format='%(refname:short)%1f%(worktreepath)%1f%(upstream:track)')
    while IFS= read -r ref; do
      case $ref in */HEAD) continue ;; esac       # origin/HEAD 는 브랜치가 아니다
      ref=${ref#refs/remotes/}; branch=${ref#*/}
      case $has_local in *$'\n'"$branch"$'\n'*) continue ;; esac
      rm+=("$ref"); n=${#ref}; [ "$n" -gt "$w" ] && w=$n
    done < <(git for-each-ref refs/remotes --format='%(refname)' | sort)
  fi
  [ "$w" -gt 40 ] && w=40
  # 행 마커(dirty, merged)는 행마다 git 을 띄워야 해서 병렬로 계산한다. dotfiles(워크트리 19, 브랜치 21) 기준
  # 직렬이면 ~700ms 가 더 걸려 첫 화면이 늦는다. 결과는 임시 파일에 받아 순서대로 읽는다.
  local tmp b i; tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-dev.XXXXXX"); b=$(base)
  # shellcheck disable=SC2064  # 지금 값의 tmp 를 지우는 것이 맞다
  trap "/bin/rm -rf '$tmp'" EXIT
  i=0; for e in "${wt[@]+"${wt[@]}"}"; do
    path=${e%%|*}; branch=${e#*|}; branch=${branch%%|*}
    ( marks_for "$path" "$branch" "$b" > "$tmp/w$i" ) & i=$((i + 1))
  done
  i=0; for e in "${br[@]+"${br[@]}"}"; do
    ( marks_for "" "${e%%|*}" "$b" > "$tmp/b$i" ) & i=$((i + 1))
  done
  wait
  # 정렬 키: 0 윈도우 열림, 1 워크트리, 2 브랜치, 3 원격. 같은 키 안에서는 원래 순서(메인 먼저, 나머지 경로순)
  {
    i=0; for e in "${wt[@]+"${wt[@]}"}"; do
      path=${e%%|*}; branch=${e#*|}; flags=${branch#*|}; branch=${branch%%|*}
      local win; win=$(window_for "$path"); local mark="" key=1 kind=worktree
      if [ -n "$win" ]; then
        local idx; idx=$(tmux display-message -p -t "$win" '#{window_index}' 2>/dev/null || true)
        mark="${G}●${idx}${R}"; key=0
      fi
      case " $flags " in *" prunable "*) kind=prunable; mark="${Y}prunable${R}" ;; esac
      case " $flags " in *" locked "*) mark="$mark ${D}locked${R}" ;; esac
      mark="$mark $(cat "$tmp/w$i")"; i=$((i + 1))
      printf '%s\t%-*s  %s%s%s  %s\t%s\t%s\t%s\n' "$key" "$w" "$branch" "$D" "$(abbrev_home "$path")" "$R" "${mark# }" "$kind" "$branch" "$path"
    done
    i=0; for e in "${br[@]+"${br[@]}"}"; do
      ref=${e%%|*}; track=${e#*|}
      printf '2\t%-*s  %s %s%s%s\tbranch\t%s\t\n' "$w" "$ref" "$(cat "$tmp/b$i")" "$D" "$track" "$R" "$ref"; i=$((i + 1))
    done | sort -s -t$'\t' -k2,2
    for ref in "${rm[@]+"${rm[@]}"}"; do
      printf '3\t%s%-*s%s  %s원격%s\tremote\t%s\t%s\n' "$D" "$w" "$ref" "$R" "$D" "$R" "${ref#*/}" "$ref"
    done
  } | sort -s -t$'\t' -k1,1n | cut -f2-
  /bin/rm -rf "$tmp"
}
# 행 마커. $1 워크트리 경로(비면 브랜치만 본다) $2 브랜치 $3 베이스
#   dirty  커밋 안 된 변경(untracked 포함)이 있다
#   merged 베이스에 없는 커밋이 없다 (git cherry: 패치 내용 비교라 GitHub 의 rebase 머지도 잡는다)
marks_for() {
  local m="" out
  if [ -n "$1" ] && [ -d "$1" ] && [ -n "$(git -C "$1" status --porcelain 2>/dev/null | head -1)" ]; then m="${Y}dirty${R}"; fi
  case $2 in "(detached "*|"$3") ;; *)
    if out=$(git cherry "$3" "$2" 2>/dev/null) && ! grep -q '^+' <<< "$out"; then m="$m ${G}merged${R}"; fi ;;
  esac
  printf '%s' "${m# }"
}
is_merged() { local out; out=$(git cherry "$(base)" "$1" 2>/dev/null) && ! grep -q '^+' <<< "$out"; }

# --- fzf ----------------------------------------------------------------------------
header_for() {
  local a="all" o="worktrees"
  case "$1" in all) a="${B}[all]${R}" ;; worktrees) o="${B}[worktrees]${R}" ;; esac
  printf '%s   %s   %stab 필터   ctrl-x 정리%s\n%s\n%s\n' "$a" "$o" "$D" "$R" \
    "${D}enter: ●N 윈도우로 · 워크트리 → 윈도우 · 브랜치 → 워크트리+윈도우${R}" \
    "${D}없는 이름 enter · alt-enter: 새 브랜치 (베이스 $(base))${R}"
}
mode_from_prompt() { case "${FZF_PROMPT:-}" in worktrees*) echo worktrees ;; *) echo all ;; esac; }
action_toggle() {
  local mode; case $(mode_from_prompt) in all) mode=worktrees ;; *) mode=all ;; esac
  printf 'reload(%s --list %s)+change-prompt(%s> )+change-header(%s)\n' "$SELF" "$mode" "$mode" "$(header_for "$mode")"
}
action_refresh() { printf 'reload(%s --list %s)\n' "$SELF" "$(mode_from_prompt)"; }   # 정리 뒤 같은 모드로 다시 읽기
cherry_summary() {  # $1 = ref. 베이스에 없는 커밋 수 (git cherry 는 패치 내용으로 비교해 rebase 머지도 잡는다)
  local b n; b=$(base)
  [ "$1" = "$b" ] && return 0
  n=$(git cherry "$b" "$1" 2>/dev/null | grep -c '^+' || true)
  if [ "${n:-0}" -eq 0 ]; then echo "${G}$b 에 모두 들어 있음 (머지됨)${R}"; else echo "$b 에 없는 커밋 ${B}$n${R}"; fi
}
preview() {  # $1 종류 $2 브랜치 $3 경로
  local kind=$1 branch=$2 path=$3
  case $kind in
    worktree|prunable)
      printf '%s%s%s\n%s\n' "$B" "$branch" "$R" "$(abbrev_home "$path")"
      [ "$kind" = prunable ] && { printf '%s디렉토리가 없다. Enter 로 prune 한다%s\n' "$Y" "$R"; return 0; }
      [ -d "$path" ] || return 0
      local st; st=$(git -C "$path" status --short 2>/dev/null | head -12)
      [ -n "$st" ] && printf '\n%s변경 있음%s\n%s\n' "$Y" "$R" "$st"
      echo; cherry_summary "$branch"
      echo; git -C "$path" log --oneline --color=always -8 2>/dev/null ;;
    branch)
      printf '%s%s%s  %s워크트리 없음%s\n' "$B" "$branch" "$R" "$D" "$R"
      printf '만들면: %s\n\n' "$(abbrev_home "$(wt_dir "$branch")")"
      cherry_summary "$branch"; echo; git log --oneline --color=always -8 "$branch" 2>/dev/null ;;
    remote)
      printf '%s%s%s  %s원격에만 있음%s\n' "$B" "$path" "$R" "$D" "$R"
      printf '만들면: 추적 브랜치 %s → %s\n\n' "$branch" "$(abbrev_home "$(wt_dir "$branch")")"
      git log --oneline --color=always -8 "$path" 2>/dev/null ;;
  esac
}
pick() {
  command -v fzf >/dev/null || die "fzf 가 필요합니다"
  local out rc=0 query key sel
  out=$(fzf --ansi --delimiter=$'\t' --with-nth=1 --nth=1 \
      --prompt='all> ' --header="$(header_for all)" --height=100% --reverse \
      --print-query --expect=alt-enter \
      --preview="$SELF --preview {2} {3} {4}" --preview-window='right,45%,border-left,<60(down,40%,border-top)' \
      --bind "tab:transform($SELF --action toggle)" \
      --bind "shift-tab:transform($SELF --action toggle)" \
      --bind "ctrl-x:execute($SELF --remove {2} {3} {4})+transform($SELF --action refresh)" \
      < <(rows all)) || rc=$?
  [ "$rc" -eq 130 ] && exit 0          # 취소
  [ "$rc" -gt 1 ] && exit "$rc"        # 1 = 후보 없음 (입력을 브랜치 이름으로)
  { IFS= read -r query; IFS= read -r key; IFS= read -r sel; } <<< "$out" || true
  if [ -n "${sel:-}" ] && [ -z "$key" ]; then
    IFS=$'\t' read -r _ KIND BRANCH TARGET <<< "$sel"
  else
    [ -n "$query" ] || exit 0
    resolve_name "$query"
  fi
}

# --- 열기 ---------------------------------------------------------------------------
# 이름(브랜치) 하나를 종류로 푼다: 워크트리 있음 → worktree, 로컬 브랜치 → branch, 원격 하나에만 → remote, 없으면 new
resolve_name() {
  local name=$1 path branch flags
  while IFS=$'\t' read -r path branch flags; do
    if [ "$branch" = "$name" ]; then
      KIND=worktree; BRANCH=$branch; TARGET=$path
      case " $flags " in *" prunable "*) KIND=prunable ;; esac
      return
    fi
  done <<< "$WT_LIST"
  if git show-ref -q --verify "refs/heads/$name"; then KIND=branch; BRANCH=$name; TARGET=""; return; fi
  local remotes; remotes=$(git for-each-ref "refs/remotes/*/$name" --format='%(refname:short)')
  if [ -n "$remotes" ] && [ "$(wc -l <<< "$remotes")" -eq 1 ]; then KIND=remote; BRANCH=$name; TARGET=$remotes; return; fi
  git check-ref-format --branch "$name" >/dev/null 2>&1 || die "브랜치 이름으로 쓸 수 없습니다: $name"
  KIND=new; BRANCH=$name; TARGET=""
}
# 경로가 등록된 워크트리면 worktree 로 푼다
resolve_path() {
  local want path branch flags; want=$(cd "$1" && pwd)
  while IFS=$'\t' read -r path branch flags; do
    [ "$path" = "$want" ] && { KIND=worktree; BRANCH=$branch; TARGET=$path; return; }
  done <<< "$WT_LIST"
  die "등록된 워크트리가 아닙니다: $(abbrev_home "$want")"
}
run_setup() {  # 새 워크트리 안에서 tmux-dev.worktree.setup 을 한 번
  local cmd; cmd=$(conf setup); [ -n "$cmd" ] || return 0
  echo "setup: $cmd"
  ( cd "$TARGET" && TMUX_WORKTREE_MAIN=$MAIN TMUX_WORKTREE_PATH=$TARGET TMUX_WORKTREE_BRANCH=$BRANCH sh -c "$cmd" ) \
    || echo "tmux-dev: setup 이 실패했다 (워크트리는 만들어졌다)" >&2
}
add_worktree() {  # $@ = git worktree add 의 인자 (경로 뒤)
  TARGET=$(wt_dir "$BRANCH")
  check_project_dir "$(dirname "$TARGET")"
  [ -e "$TARGET" ] && die "이미 있는 경로입니다: $(abbrev_home "$TARGET")"
  mkdir -p "$(dirname "$TARGET")"
  local out; out=$(git worktree add "$TARGET" "$@" 2>&1) || die "$out"
  run_setup
}
ensure_window() {  # 워크트리 $TARGET(브랜치 $BRANCH)의 윈도우로. 없으면 만들고 레이아웃
  local win; win=$(window_for "$TARGET")
  if [ -n "$win" ]; then tmux select-window -t "$win"; return; fi
  win=$(tmux new-window -P -F '#{window_id}' -t "$SESSION:" -n "$BRANCH" -c "$TARGET")
  tmux set-option -w -t "$win" @worktree "$TARGET"
  apply_layout "$LAYOUT" "$win" "$TARGET"
}
# --- 정리 (ctrl-x) -------------------------------------------------------------------
# fzf 의 execute 로 불린다. 끝나면 바로 팝업으로 돌아가 출력이 사라지므로 메시지 뒤에 Enter 를 기다린다.
pause()   { [ $# -gt 0 ] && printf '%s\n' "$*"; printf '%s(enter)%s ' "$D" "$R"; IFS= read -r _ || true; }
confirm() { printf '%s ' "$1"; local a; IFS= read -r a || true; case $a in y|Y) return 0 ;; *) return 1 ;; esac; }
close_windows() {  # 이 워크트리의 윈도우를 닫는다. 세션의 마지막 윈도우면 세션(과 이 팝업)이 죽으므로 남긴다
  [ -n "$SESSION" ] || return 0
  local id tag
  while IFS=$US read -r id tag; do
    [ "$tag" = "$1" ] || continue
    if [ "$(tmux list-windows -t "$SESSION" | wc -l)" -le 1 ]; then echo "세션의 마지막 윈도우라 닫지 않는다"
    else tmux kill-window -t "$id"; fi
  done < <(tmux list-windows -t "$SESSION" -F "#{window_id}${US}#{@worktree}" 2>/dev/null)
}
delete_branch_if_merged() {  # $1 브랜치. 베이스에 모두 들어 있을 때만 물어보고 지운다
  local b; b=$(base)
  case $1 in "(detached "*|"$b") return 0 ;; esac
  git show-ref -q --verify "refs/heads/$1" || return 0   # 브랜치가 이미 없으면 할 일 없음
  if is_merged "$1"; then
    confirm "브랜치 ${B}$1${R} 도 지울까요? ($b 에 모두 들어 있음) [y/N]" && git branch -D "$1" || true
  else
    echo "브랜치 $1 는 $b 에 없는 커밋이 있어 남겨 둔다 (지우려면 git branch -D $1)"
  fi
}
remove_target() {  # $1 종류 $2 브랜치 $3 경로
  local kind=$1 branch=$2 path=$3 st out
  cd "$MAIN"   # 지우려는 워크트리 안에서 불렸을 수 있다
  case $kind in
    remote)   pause "원격 브랜치는 여기서 지우지 않는다 (git push origin --delete $branch)" ;;
    branch)   delete_branch_if_merged "$branch"; pause ;;
    prunable)
      if confirm "사라진 워크트리의 등록을 지울까요? (git worktree prune) [y/N]"; then
        git worktree prune; delete_branch_if_merged "$branch"
      fi; pause ;;
    worktree)
      [ "$path" = "$MAIN" ] && { pause "메인 체크아웃은 지울 수 없다"; return 0; }
      st=$(git -C "$path" status --porcelain 2>/dev/null | head -8)
      [ -n "$st" ] && { printf '%s\n' "$st"; pause "변경이 있어 지우지 않는다. 커밋하거나 되돌린 뒤 다시"; return 0; }
      confirm "워크트리 ${B}$(abbrev_home "$path")${R} 를 지울까요? [y/N]" || return 0
      out=$(git worktree remove "$path" 2>&1) || { pause "$out"; return 0; }   # locked 등은 git 이 거절한다
      close_windows "$path"
      echo "지웠다: $(abbrev_home "$path")"
      delete_branch_if_merged "$branch"; pause ;;
  esac
}

open_target() {
  case $KIND in
    prunable)
      printf '%s 의 디렉토리가 없습니다. 등록을 지우고(git worktree prune) 다시 만들까요? [y/N] ' "$(abbrev_home "$TARGET")"
      IFS= read -r ans || exit 0; case $ans in y|Y) ;; *) exit 0 ;; esac   # 입력이 끊기면(EOF) 취소
      git worktree prune
      case $BRANCH in "(detached "*) exit 0 ;; esac
      KIND=branch ;;
    new)
      printf '새 브랜치 %s%s%s 를 %s 에서 만들까요? → %s [Y/n] ' "$B" "$BRANCH" "$R" "$(base)" "$(abbrev_home "$(wt_dir "$BRANCH")")"
      IFS= read -r ans || exit 0; case $ans in n|N) exit 0 ;; esac ;;   # 입력이 끊기면(EOF) 취소
  esac
  case $KIND in
    worktree) ;;
    branch)   add_worktree "$BRANCH" ;;
    remote)   add_worktree --track -b "$BRANCH" "$TARGET" ;;
    new)      add_worktree -b "$BRANCH" "$(base)" ;;
  esac
  if [ -n "$SESSION" ]; then ensure_window; else printf '%s\n' "$TARGET"; fi
}

# --- 인자 ------------------------------------------------------------------------------
arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --base)   BASE=$2; shift 2 ;;
    --layout) LAYOUT=$2; shift 2 ;;
    -t)       SESSION=$2; shift 2 ;;
    --list)    repo_init; SESSION=${SESSION:-$(tmux display-message -p '#S' 2>/dev/null || true)}; rows "${2:-all}"; exit 0 ;;
    --remove)  repo_init; SESSION=${SESSION:-$(tmux display-message -p '#S' 2>/dev/null || true)}; remove_target "${2:-}" "${3:-}" "${4:-}"; exit 0 ;;
    --preview) repo_init; preview "${2:-}" "${3:-}" "${4:-}"; exit 0 ;;
    --action)  repo_init; case "${2:-}" in toggle) action_toggle ;; refresh) action_refresh ;; esac; exit 0 ;;
    --path)    repo_init; wt_dir "${2:?--path 에는 브랜치가 필요합니다}"; exit 0 ;;
    -h|--help) sed -n '2,/^set -euo/{/^set -euo/d;p;}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "모르는 옵션: $1" ;;
    *) arg=$1; shift ;;
  esac
done

# 인자가 디렉토리면 그 안에서 저장소를 찾는다 (project 가 다른 디렉토리에서 넘길 수 있다)
[ -n "$arg" ] && [ -d "$arg" ] && cd "$arg"
repo_init
if [ -n "${TMUX:-}" ]; then SESSION=${SESSION:-$(tmux display-message -p '#S')}; fi

if [ -z "$arg" ]; then
  [ -n "$SESSION" ] || die "tmux 밖에서는 브랜치나 경로를 주세요"
  pick
elif [ -d "$arg" ]; then
  resolve_path "$arg"
else
  resolve_name "$arg"
fi
open_target
