#!/usr/bin/env bash
# tmux-dev project: 디렉토리 하나를 골라 그 디렉토리의 세션으로 간다. 세션이 없으면 만들고, 디렉토리가 없으면 만든다.
#
# 멘탈 모델 (자세히: ../session-picker.md)
#   세션 = 디렉토리. 세션의 정체는 이름이 아니라 디렉토리의 실제 경로다. 같은 경로의 세션이 있으면 전환만 한다.
#   모드는 "무엇을 후보로 보여 주나" 만 정한다. 어느 모드에서 골라도 결과는 같다.
#   피커(fzf)는 결정만 한다. 만들기·전환은 fzf 가 끝난 뒤 이 스크립트가 한다. 셸에서 경로를 주는 것과 같은 길이다.
#   순정 대응은 `tmux new -s 이름 -c 경로` + `prefix s`. 이 스크립트는 "없으면 만들어 준다" 와 레이아웃만 보탠다.
#
# 사용
#   tmux-dev project                  피커 (tmux 안에서는 prefix S 가 팝업으로 띄운다)
#   tmux-dev project <디렉토리>       바로 그 디렉토리의 세션으로 (있는 디렉토리만. 최근 내역에는 남기지 않는다)
#   tmux-dev project --layout <이름>  새 세션의 레이아웃. 없으면 저장소 설정 → 전역 → ide (lib/layout.sh). --layouts 로 목록
#   tmux-dev project --list [repo|dir|loc]  후보 목록만 출력 (디버그. loc 은 위치 피커)
#
# 피커 (fzf 순정 키는 그대로. 아래는 비어 있던 키와, 같은 뜻으로 덮은 enter·esc·tab)
#   tab / shift-tab   모드 전환: 저장소(메인 체크아웃만) ↔ 디렉토리(모든 디렉토리)
#   enter             커서 항목으로. 열기만 한다. 걸리는 항목이 없으면 벨과 안내 (경로를 쳤고 있으면 연다)
#   alt-enter         친 이름으로 새로 만들기. 위치 피커가 겹쳐 뜬다(최근 만든 곳 → 커서 옆 → 디렉토리 전부).
#                     거기서 enter 는 여기에 만들기, alt-l 은 레이아웃 골라 만들기, esc 는 돌아가기.
#                     저장소 모드는 git init 까지. 경로(/ 나 ~ 로 시작)를 쳤으면 위치를 묻지 않고 그 자리에
#   alt-l             레이아웃을 골라서 열기. 겹쳐 뜬 목록에서 enter 는 이번만, alt-enter 는 저장소 기본으로도 저장
#   ctrl-]            커서 항목의 경로를 검색어에 채운다
#   alt-p             미리보기 오른쪽 → 아래 → 숨김 (겹쳐 뜬 위치·레이아웃 목록에서도)
#   alt-h             키 안내를 미리보기 자리에 (다시 누르면 원래대로)
#   esc               검색어 지우기. 겹쳐 뜬 목록(위치, 레이아웃)에서는 돌아가기. 닫기는 ctrl-c
#   경로 모양 검색어는 퍼지가 아니라 경로 접두 일치로 거른다. 끝 슬래시는 "이 디렉토리 아래" 다.
#
# 목록: 열린 세션(●) → 최근 고른 곳(◷) → 홈 전체 탐색 (lib/dirs.sh). 한 경로는 한 번만, 모드 조건에 맞는 것만.
# 파일: ~/.config/tmux-dev/ignore (탐색 제외, gitignore 문법), ~/.local/state/tmux-dev/history (피커로 고른 곳만),
#   ~/.local/state/tmux-dev/parents (위치 피커로 무언가를 만든 곳)
# 세션 찾기: 세션 옵션 @tmux-dev-path 가 그 경로 → 옵션 없는 세션의 session_path 가 그 경로 → 없으면 만든다.
#   여럿이면 최근에 붙었던 것. 만들 때 @tmux-dev-path 를 붙이고, 저장소면 첫 윈도우에 @worktree 를 둔다 (worktree 가 읽는다).
# 워크트리(.git 이 파일)를 고르면 그 워크트리로 이동한다: 그 경로의 세션 → 그 워크트리를 연 윈도우(@worktree)
#   → 메인 저장소 세션에 윈도우를 열어 준다 (tmux-dev worktree 에 넘김). 세션 = 저장소, 윈도우 = 워크트리.
set -euo pipefail

SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
LIB=$(cd "$(dirname "$SELF")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"
# shellcheck source=../lib/dirs.sh
. "$LIB/dirs.sh"             # 홈 탐색(scan_repos, scan_dirs)·미리보기. worktree 의 dir 모드와 공유
# shellcheck source=../lib/layout.sh
. "$LIB/layout.sh"           # 새 세션의 첫 윈도우에 한 번 적용. worktree 와 공유
WORKTREE_BIN="$(dirname "$SELF")/tmux-dev-worktree"

LAYOUT=""          # --layout 으로 명시한 값, 또는 피커의 alt-l. 비어 있으면 resolve_layout
RECENT_MAX=20      # 목록 위쪽에 보여 줄 최근 항목 수
HISTORY_MAX=500    # 히스토리 파일 상한 (줄)
TMUX_DEV_PARENTS="${TMUX_DEV_HISTORY%/*}/parents"   # 위치 피커로 무언가를 만든 부모 디렉토리 (최근 순)
US=$'\x1f'         # tmux 포맷 출력의 칸 구분자 (빈 칸이 있을 수 있다)
C=$'\033[36m'      # 브랜치 색

# --- 작은 도구 -------------------------------------------------------------------
# fzf 액션 한 개. 인자에 괄호가 있어도 깨지지 않게, 인자에 없는 구분 기호 쌍을 고른다 (man fzf: ACTION ARGUMENT)
act() {
  local name=$1 text=$2 pair
  for pair in '()' '[]' '{}' '<>' '~~' '!!' '@@' '##' '%%' '^^' '&&' '**' ';;' '||'; do
    case $text in *"${pair:0:1}"*|*"${pair:1:1}"*) continue ;; esac
    printf '%s%s%s%s' "$name" "${pair:0:1}" "$text" "${pair:1:1}"; return
  done
  printf '%s:%s' "$name" "$text"   # 마지막 수단. 액션 줄의 맨 끝에만 써야 한다
}
home_disp() { case $1 in "$HOME") printf '~' ;; "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }
# 경로 모양 검색어: / 나 ~/ 로 시작하거나 ~ 하나
pathish() { case ${1:-} in /*|'~'|'~/'*) return 0 ;; *) return 1 ;; esac; }
# ~ 를 풀고 . .. // 끝 슬래시를 글자로만 정리한다 (파일시스템을 보지 않는다). 절대 경로가 아니면 1
norm_path() {
  local p=$1 seg out=""
  case $p in '~') p=$HOME ;; '~/'*) p=$HOME/${p#'~/'} ;; esac
  [[ $p = /* ]] || return 1
  local -a parts=()
  local IFS=/
  for seg in $p; do
    case $seg in ''|.) ;; ..) [ ${#parts[@]} -gt 0 ] && unset "parts[$((${#parts[@]} - 1))]" ;; *) parts+=("$seg") ;; esac
  done
  for seg in "${parts[@]+"${parts[@]}"}"; do out+="/$seg"; done
  printf '%s' "${out:-/}"
}
canon_dir() { (cd "$1" 2>/dev/null && pwd -P); }
# 워크트리의 메인 체크아웃. .git 파일의 "gitdir: <메인>/.git/worktrees/<이름>" 에서 역산한다 (git 프로세스 없음)
worktree_main() {
  local g=$1/.git line
  [ -f "$g" ] || return 0
  IFS= read -r line < "$g" || return 0
  g=${line#gitdir: }; [[ $g = /* ]] || g=$1/$g
  case $g in */.git/worktrees/*) g=${g%/.git/worktrees/*}; [ -d "$g/.git" ] && printf '%s' "$g" ;; esac
  return 0
}
fits_mode() { if [ "$1" = repo ]; then [ -d "$2/.git" ]; else [ -d "$2" ]; fi; }
mode_name() { if [ "$1" = repo ]; then printf '저장소'; else printf '디렉토리'; fi; }

# --- 상태 (팝업 하나당 디렉토리 하나) ----------------------------------------------
# fzf 가 띄우는 콜백은 매번 새 프로세스라 상태를 파일로 주고받는다. 경로는 환경변수로 물려받는다.
# 읽기·쓰기는 bash 내장(read, printf 리다이렉션)이라 프로세스를 더 띄우지 않는다.
#   mode     repo | dir             help    1 이면 미리보기 자리에 키 안내
#   layout   고른 레이아웃 "<이름>\t<save 또는 빈 값>"
#   pending  레이아웃을 고를 대상 "<만들기: none|dir|repo>\t<경로>"
#   name     새로 만들 이름 (alt-enter)      near  커서 항목의 부모 (위치 피커 후보)      loc  위치 피커에서 고른 부모
#   decision fzf 를 끝낼 때 쓰는 결정 "<경로>US<만들기>US<레이아웃>US<save>US<고른 부모>" (빈 칸이 있어 US)
st_get() { ST=""; [ -f "${TMUX_DEV_STATE:-/nonexistent}/$1" ] && IFS= read -r ST < "$TMUX_DEV_STATE/$1" || true; }
st_set() { printf '%s\n' "$2" > "$TMUX_DEV_STATE/$1"; }
st_del() { local k; for k in "$@"; do rm -f "$TMUX_DEV_STATE/$k"; done; }

# --- 후보 ------------------------------------------------------------------------
# 행: "<~경로>\t<표시>\t<실제 경로>". fzf 는 1·2칸을 보여 주고(--with-nth 1,2) 1칸(경로)만 검색한다(--nth 1).
# 표시를 경로 뒤에 두어야 경로 접두 일치(^~/...)가 맞는다.
row() { printf '%s\t%s\t%s\n' "$(home_disp "$1")" "$2" "$1"; }
branch_mark() { local b; b=$(git_branch "$1"); [ -n "$b" ] && printf ' %s%s%s' "$C" "$b" "$R"; return 0; }
session_list() {  # "<최근 붙은 시각>US<id>US<이름>US<@tmux-dev-path>US<session_path>", 최근 붙은 순
  tmux list-sessions -F "#{session_last_attached}${US}#{session_id}${US}#{session_name}${US}#{@tmux-dev-path}${US}#{session_path}" 2>/dev/null \
    | sort -t "$US" -k1,1nr || true
}
session_rows() {
  local _t _id name tag sp p
  while IFS=$US read -r _t _id name tag sp; do
    # 세션 디렉토리가 지워졌으면 canon_dir 이 실패한다. set -e 아래서 대입이 그 실패를 받으면
    # 스크립트 전체가 끝나 목록이 비므로, || p="" 로 받아 그 세션만 건너뛴다
    p=$tag; [ -n "$p" ] || p=$(canon_dir "$sp") || p=""
    [ -n "$p" ] || continue
    fits_mode "$1" "$p" || continue
    row "$p" "${G}●${R} ${D}$name${R}$(branch_mark "$p")"
  done < <(session_list)
}
history_paths() {  # 최근 순, 중복 없이. 옛 형식(경로만)과 새 형식(<epoch>\t<경로>) 둘 다 읽는다
  [ -f "$TMUX_DEV_HISTORY" ] || return 0
  { tail -r "$TMUX_DEV_HISTORY" 2>/dev/null || tac "$TMUX_DEV_HISTORY"; } | awk -F'\t' '{ p = NF > 1 ? $2 : $1; if (p != "" && !seen[p]++) print p }'
}
recent_rows() {
  local p n=0
  while IFS= read -r p; do
    [ "$n" -lt "$RECENT_MAX" ] || break
    fits_mode "$1" "$p" || continue   # 지금 없는 곳은 건너뛴다 (파일에서는 지우지 않는다)
    row "$p" "${D}◷${R}$(branch_mark "$p")"; n=$((n + 1))
  done < <(history_paths)
}
scan_rows() {
  if [ "$1" = repo ]; then
    local p; while IFS= read -r p; do row "$p" "$(branch_mark "$p")"; done < <(scan_repos)
  else
    scan_dirs | awk -v home="$HOME" -v OFS='\t' '{ d = $0; if (index(d, home "/") == 1) d = "~" substr(d, length(home) + 1); else if (d == home) d = "~"; print d, "", $0 }'
  fi
}
rows() {  # 앞에 나온 것이 이긴다. fflush 로 한 줄씩 흘려 보내 fzf 가 찾는 대로 그린다
  { session_rows "$1"; recent_rows "$1"; scan_rows "$1"; } | awk -F'\t' '!seen[$3]++ { print; fflush() }'
}
record_history() {  # 피커로 고른 것만 기록한다 (CLI 는 기록하지 않는다)
  mkdir -p "$(dirname "$TMUX_DEV_HISTORY")"
  local tmp; tmp=$(mktemp "$TMUX_DEV_HISTORY.XXXXXX")
  { [ -f "$TMUX_DEV_HISTORY" ] && awk -F'\t' -v p="$1" '{ q = NF > 1 ? $2 : $1; if (q != p) print (NF > 1 ? $0 : "0\t" $1) }' "$TMUX_DEV_HISTORY"
    printf '%s\t%s\n' "$(date +%s)" "$1"; } | tail -n "$HISTORY_MAX" > "$tmp" && mv -f "$tmp" "$TMUX_DEV_HISTORY"
}

# --- 세션 찾기·만들기 --------------------------------------------------------------
find_session() {  # $1 실제 경로 → 세션 id. 옵션이 붙은 세션이 먼저, 그다음 옵션 없는 세션의 session_path
  local _t id _n tag sp by_path=""
  while IFS=$US read -r _t id _n tag sp; do
    if [ -n "$tag" ]; then [ "$tag" = "$1" ] && { printf '%s' "$id"; return 0; }
    elif [ -z "$by_path" ] && [ "$(canon_dir "$sp")" = "$1" ]; then by_path=$id; fi
  done < <(session_list)
  [ -n "$by_path" ] && printf '%s' "$by_path"
  return 0
}
session_name_for() {  # 표시용 이름. 겹치면 부모 이름을 붙이고, 그래도 겹치면 -2, -3
  local base parent name i=2
  base=$(basename "$1" | tr '.:' '__'); name=$base
  tmux has-session -t "=$name" 2>/dev/null || { printf '%s' "$name"; return; }
  parent=$(basename "$(dirname "$1")" | tr '.:' '__'); name="${parent}_$base"
  while tmux has-session -t "=$name" 2>/dev/null; do name="${parent}_$base-$i"; i=$((i + 1)); done
  printf '%s' "$name"
}
ensure_session() {  # $1 실제 경로 → 세션 id (없으면 만들고 레이아웃)
  local sid win
  sid=$(find_session "$1")
  if [ -z "$sid" ]; then
    win=$(tmux new-session -d -s "$(session_name_for "$1")" -c "$1" -P -F '#{window_id}')
    sid=$(tmux display-message -p -t "$win" '#{session_id}')
    tmux set-option -t "$sid" @tmux-dev-path "$1"
    [ -d "$1/.git" ] && tmux set-option -w -t "$win" @worktree "$1"
    apply_layout "$(resolve_layout "$LAYOUT" "$1")" "$win" "$1"
  fi
  printf '%s' "$sid"
}
switch_to() { if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$1"; else tmux attach-session -t "$1"; fi; }
# 워크트리를 고르면 그 워크트리로 이동한다 (session-picker.md 결정 3). 읽기를 바꾸려면 이 함수만 고친다.
open_worktree() {
  local path=$1 sid _t win tag main
  sid=$(find_session "$path")                       # 순정으로 만든 워크트리 세션은 존중한다
  if [ -n "$sid" ]; then switch_to "$sid"; return; fi
  while IFS=$US read -r _t sid win tag; do          # 그 워크트리를 연 윈도우가 어느 세션에든 있으면 그리로
    [ "$tag" = "$path" ] || continue
    tmux select-window -t "$win"; switch_to "$sid"; return
  done < <(tmux list-windows -a -F "#{session_last_attached}${US}#{session_id}${US}#{window_id}${US}#{@worktree}" 2>/dev/null | sort -t "$US" -k1,1nr)
  main=$(worktree_main "$path")
  if [ -z "$main" ]; then switch_to "$(ensure_session "$path")"; return; fi
  sid=$(LAYOUT="" ensure_session "$main")           # 메인 세션은 기본 레이아웃으로. 고른 레이아웃은 워크트리 윈도우에
  "$WORKTREE_BIN" -t "$sid" ${LAYOUT:+--layout "$LAYOUT"} "$path"
  switch_to "$sid"
}
open_path() {  # $1 실제 경로
  if [ -f "$1/.git" ]; then open_worktree "$1"; else switch_to "$(ensure_session "$1")"; fi
}
record_parent() {  # 위치 피커로 무언가를 만든 부모. 다음 위치 피커의 위쪽에 둔다
  mkdir -p "$(dirname "$TMUX_DEV_PARENTS")"
  local tmp; tmp=$(mktemp "$TMUX_DEV_PARENTS.XXXXXX")
  { [ -f "$TMUX_DEV_PARENTS" ] && awk -F'\t' -v p="$1" '{ q = NF > 1 ? $2 : $1; if (q != p) print }' "$TMUX_DEV_PARENTS"
    printf '%s\t%s\n' "$(date +%s)" "$1"; } | tail -n 100 > "$tmp" && mv -f "$tmp" "$TMUX_DEV_PARENTS"
}
# 결정을 실행한다: $1 경로 $2 만들기(none|dir|repo) $3 레이아웃 $4 save $5 위치 피커에서 고른 부모
apply_decision() {
  local path=$1 create=$2
  case $create in
    dir)  mkdir -p "$path" || die "만들 수 없습니다: $(home_disp "$path")" ;;
    repo) mkdir -p "$path" && git -C "$path" init -q || die "저장소를 만들 수 없습니다: $(home_disp "$path")" ;;
  esac
  path=$(canon_dir "$path") || die "디렉토리가 아닙니다: $1"
  LAYOUT=$3
  [ -n "$4" ] && [ -n "$LAYOUT" ] && [ -d "$path/.git" ] && git -C "$path" config tmux-dev.layout "$LAYOUT"
  record_history "$path"
  [ -n "${5:-}" ] && record_parent "$5"
  open_path "$path"
}

# --- 판정: 경로 모양 검색어 ----------------------------------------------------------
# 결과: J_KIND (block | open | worktree | create), J_PATH (실제 경로, create 면 만들 경로), J_CREATE (dir | repo),
#       J_SAY (푸터에 보여 줄 판정). 있는 디렉토리는 목록에 있었든 없었든 묻지 않고 연다(생성이 아니므로).
classify() {  # $1 경로 글자 $2 모드
  local p a rest="" top d extra=""
  J_KIND=block J_PATH="" J_CREATE="" J_SAY=""
  p=$(norm_path "$1") || { J_SAY="${Y}절대 경로가 아니다${R}"; return; }
  d=$(home_disp "$p")
  if [ -e "$p" ] && [ ! -d "$p" ]; then J_SAY="${Y}파일이 이미 있다: $d${R}"; return; fi
  if [ -d "$p" ]; then
    J_PATH=$(canon_dir "$p"); d=$(home_disp "$J_PATH")
    if [ -f "$J_PATH/.git" ]; then J_KIND=worktree; J_SAY="enter 워크트리로 이동: $d"
    else
      J_KIND=open; J_SAY="enter 열기: $d"
      [ "$2" = repo ] && [ ! -d "$J_PATH/.git" ] && J_SAY+=" ${D}(저장소 아님. git init 은 하지 않는다)${R}"
    fi
    return
  fi
  a=$p; while [ ! -e "$a" ]; do rest="/$(basename "$a")$rest"; a=$(dirname "$a"); done   # 있는 가장 가까운 조상
  [ -d "$a" ] || { J_SAY="${Y}중간 경로가 파일이다: $(home_disp "$a")${R}"; return; }
  [ -w "$a" ] || { J_SAY="${Y}쓸 수 없다: $(home_disp "$a")${R}"; return; }
  [ "$rest" = "/$(basename "$p")" ] || extra=" · 중간 디렉토리도"
  top=$(git -C "$a" rev-parse --show-toplevel 2>/dev/null || true)
  a=$(canon_dir "$a"); [ "$a" = / ] && a=""; J_PATH=$a$rest; d=$(home_disp "$J_PATH")
  J_KIND=create
  if [ "$2" = repo ]; then
    J_CREATE=repo; extra=" (git init)$extra"
    [ -n "$top" ] && extra+=" · ${Y}저장소 $(home_disp "$top") 안${R}"
  else J_CREATE=dir; fi
  J_SAY="${D}없는 경로${R} · alt-enter 만들기: $d$extra"
}
# 새로 만들 이름 (경로 모양이 아닌 검색어). 위치 피커에서 고른 디렉토리 아래에 붙는다. a/b 처럼 / 를 넣어도 된다
name_ok() {
  local n=${1%/}
  case $n in ''|/*|'~'*) return 1 ;; esac
  case "/$n/" in */../*|*/./*|*//*) return 1 ;; esac
  return 0
}

# --- 피커 화면 -------------------------------------------------------------------
tabs() {  # 바깥 테두리 라벨에 그리는 모드 탭
  local m out=""
  for m in repo dir; do
    if [ "$m" = "$1" ]; then out+="${B}$(mode_name "$m")${R}  "; else out+="${D}$(mode_name "$m")${R}  "; fi
  done
  printf ' %s' "${out%  } "
}
hint() { printf '%s' "${D}enter 열기 · alt-enter 새로 만들기 · alt-l 레이아웃 · tab 모드 · alt-h 키 안내${R}"; }
create_hint() {  # 검색어가 있으면 늘 보이는 만들기 안내 (결과가 있어도 alt-enter 는 친 이름으로 만든다)
  local q=${1%/} what="디렉토리"; st_get mode; [ "${ST:-repo}" = repo ] && what="저장소"
  printf '%s' "alt-enter ${B}'$q'${R} 새 $what 만들기 ${D}· enter 열기 · alt-h 키 안내${R}"
}
help_keys() {
  cat <<EOF
${B}prefix S: 디렉토리 → 세션${R}

enter         커서 항목의 세션으로 (없으면 만든다)
alt-enter     친 이름으로 새로 만들기 → 위치 고르기
alt-l         레이아웃을 골라서 열기
                enter 이번만 · alt-enter 저장소 기본으로도
tab           모드: 저장소 ↔ 디렉토리
ctrl-]        커서 경로를 검색어에 채우기
alt-p         미리보기 오른쪽 → 아래 → 숨김 (겹쳐 뜬 목록도)
alt-h         이 안내 열고 닫기
esc           검색어 지우기 (겹쳐 뜬 목록에서는 돌아가기)
ctrl-c        닫기

${B}새로 만들기${R}
이름을 치고 alt-enter. 위치를 고르는 목록이 겹쳐 뜬다.
  enter       거기에 만들고 연다 (저장소 모드는 git init)
  alt-l       레이아웃을 골라 만들고 연다
  esc         돌아가기
위쪽은 최근에 만든 곳, 그다음은 커서 항목의 부모.

${B}경로 입력${R}
/ 나 ~ 로 시작하면 경로 접두 일치로 거른다.
  enter       그 경로가 있으면 연다 (목록 밖이어도)
  alt-enter   그 경로에 바로 만든다
끝 슬래시는 "이 디렉토리 아래" 다.

${B}목록${R}
● 열린 세션 · ◷ 최근 고른 곳 · 나머지는 홈 전체 탐색
탐색 제외: ~/.config/tmux-dev/ignore (gitignore 문법)
EOF
}
# tmux 팝업 테두리와 같은 모양으로 그린다 (팝업은 -B 로 테두리 없이 띄운다). 런타임에 읽어 tmux.conf 를 따라간다
popup_border() {
  BORDER=rounded BCOLOR=""
  [ -n "${TMUX:-}" ] || return 0
  case $(tmux show -gqv popup-border-lines 2>/dev/null) in
    rounded) BORDER=rounded ;; double) BORDER=double ;; heavy) BORDER=bold ;; *) BORDER=sharp ;;
  esac
  local fg; fg=$(tmux show -gqv popup-border-style 2>/dev/null | sed -n 's/.*fg=\([^,]*\).*/\1/p')
  case $fg in   # fzf 가 모르는 색 이름을 넘기면 fzf 가 뜨지 않으므로 아는 꼴만 넘긴다
    colour[0-9]*|color[0-9]*) BCOLOR=${fg#colo*r} ;;
    '#'[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]|[0-9]|[0-9][0-9]|[0-9][0-9][0-9]) BCOLOR=$fg ;;
    black|red|green|yellow|blue|magenta|cyan|white) BCOLOR=$fg ;;
  esac
}
style_opts() {  # STYLE 배열: 피커와 겹쳐 뜨는 목록(위치, 레이아웃)이 같이 쓴다
  popup_border
  STYLE=(--border "$BORDER" --border-label-pos 3 --input-border "$BORDER" --list-border "$BORDER" --reverse --height=100%)
  [ -n "$BCOLOR" ] && STYLE+=(--color "border:$BCOLOR,label:$BCOLOR")
  return 0
}

# --- 콜백 (fzf 가 이벤트마다 부른다. 액션 한 줄을 출력한다) -----------------------------
footer_now() {  # 메인 목록의 푸터
  local q=${FZF_QUERY:-}
  if [ -z "$q" ]; then hint
  elif pathish "$q"; then
    if [ "${FZF_MATCH_COUNT:-1}" -eq 0 ]; then local mode; st_get mode; mode=${ST:-repo}; classify "$q" "$mode"; printf '%s' "$J_SAY"
    else printf '%s' "enter 커서 항목 열기 ${D}· alt-enter 친 경로에 만들기${R}"; fi
  else create_hint "$q"; fi
}
nope() { printf 'bell+%s' "$(act change-footer "$1")"; }   # 할 일이 없을 때: 벨과 안내만
search_action() {  # 경로 모양 검색어 → 경로 접두 일치. /Users/<나>/... 도 ~/... 로 맞춘다. 공백은 fzf 검색 문법대로 \ 로
  local q=$1
  case $q in "$HOME") q='~' ;; "$HOME"/*) q="~${q#"$HOME"}" ;; esac
  q=${q// /\\ }
  printf 'search:^%s' "$q"    # search: 꼴은 액션 줄의 맨 끝이어야 한다
}
decide() {  # $1 경로 $2 만들기(none|dir|repo) [$3 위치 피커에서 고른 부모] → 결정 파일을 쓰고 fzf 를 끝낸다
  local l="" s=""; st_get layout; [ -n "$ST" ] && IFS=$'\t' read -r l s <<< "$ST"
  st_set decision "$1$US$2$US$l$US$s$US${3:-}"   # 빈 칸이 있으므로 US. 탭이면 read 가 연속 탭을 하나로 합친다
  printf 'accept'
}
# 열 대상을 정한다: 커서 항목, 아니면 경로 모양 검색어가 가리키는 있는 디렉토리. J_KIND/J_PATH 를 채운다.
# 열 것이 없으면 안내 액션을 출력하고 1 (만들기는 alt-enter 의 몫이다)
open_target() {  # $1 커서 항목의 실제 경로 (없으면 빈 값)
  local mode q=${FZF_QUERY:-}; st_get mode; mode=${ST:-repo}
  if [ -n "$1" ]; then J_PATH=$1; if [ -f "$1/.git" ]; then J_KIND=worktree; else J_KIND=open; fi; return 0; fi
  if pathish "$q"; then
    classify "$q" "$mode"
    case $J_KIND in open|worktree) return 0 ;; esac
    nope "$J_SAY"; return 1
  fi
  if [ -n "$q" ]; then nope "${Y}맞는 항목이 없다${R} · $(create_hint "$q")"; else nope "$(hint)"; fi
  return 1
}
on_enter() {
  st_del layout
  open_target "${1:-}" || return 0
  decide "$J_PATH" none
}
on_layout() {  # alt-l: 열 대상을 정해 두고 레이아웃 목록을 겹쳐 띄운다
  st_del layout
  open_target "${1:-}" || return 0
  st_set pending none$'\t'"$J_PATH"
  printf 'execute(%s --choose-layout)+transform(%s --on after-layout)' "$SELF" "$SELF"
}
on_after_layout() {  # 레이아웃에서 esc 면 그대로 목록, 골랐으면 연다
  local create path; st_get layout; [ -n "$ST" ] || return 0
  st_get pending; IFS=$'\t' read -r create path <<< "$ST"
  decide "$path" "$create"
}
choose_layout_step() {  # execute 안에서 돈다. 고른 것을 상태에 쓴다. esc·ctrl-c 면 아무것도 안 쓴다
  local create path can="" picked
  st_get pending; IFS=$'\t' read -r create path <<< "$ST"
  { [ -d "$path/.git" ] || [ "$create" = repo ]; } && can=save
  style_opts
  LAYOUT_ESC=abort
  LAYOUT_FZF_OPTS=("${STYLE[@]}" --border-label " 레이아웃 · $(home_disp "$path") ")
  picked=$(choose_layout "$SELF --layout-art" "$can") || return 0
  st_set layout "$picked"
}
on_create() {  # alt-enter: 경로를 쳤으면 그 자리에 바로, 이름을 쳤으면 위치 피커를 겹쳐 띄운다
  local mode q=${FZF_QUERY:-}; st_get mode; mode=${ST:-repo}
  st_del layout loc
  if [ -z "$q" ]; then nope "${Y}만들 이름을 먼저 친다${R}"; return; fi
  if pathish "$q"; then
    classify "$q" "$mode"
    case $J_KIND in
      create) decide "$J_PATH" "$J_CREATE" ;;
      open|worktree) decide "$J_PATH" none ;;       # 이미 있으면 연다
      *) nope "$J_SAY" ;;
    esac
    return
  fi
  name_ok "$q" || { nope "${Y}이름으로 쓸 수 없다: $q${R} (.. 이나 빈 칸 없이)"; return; }
  st_set name "${q%/}"
  [ -n "${1:-}" ] && st_set near "$(dirname "$1")" || st_del near
  printf 'execute(%s --choose-location)+transform(%s --on after-location)' "$SELF" "$SELF"
}
on_after_location() {  # 위치 피커에서 esc 면 그대로 목록, 골랐으면 만든다(이미 있으면 연다)
  local mode parent name; st_get loc; parent=$ST; [ -n "$parent" ] || return 0
  st_get name; name=$ST; st_get mode; mode=${ST:-repo}
  classify "$parent/$name" "$mode"
  case $J_KIND in
    create) decide "$J_PATH" "$J_CREATE" "$parent" ;;
    open|worktree) decide "$J_PATH" none ;;
    *) nope "$J_SAY" ;;
  esac
}
on_change() {
  local out="bg-cancel+"   # 이전 검색어로 돌던 푸터 판정(bg-transform)을 버린다. 늦게 끝난 낡은 결과가 덮지 않게
  if pathish "${FZF_QUERY:-}"; then printf '%srebind(result)+first+%s' "$out" "$(search_action "$FZF_QUERY")"
  else printf '%sunbind(result)+first+%s' "$out" "$(act change-footer "$(footer_now)")"; fi
}
on_result() { pathish "${FZF_QUERY:-}" && act change-footer "$(footer_now)"; return 0; }  # 경로 모양 검색어일 때만 묶인다
on_esc() { printf 'clear-query'; }
on_mode() {
  local mode; st_get mode; if [ "${ST:-repo}" = repo ]; then mode=dir; else mode=repo; fi
  st_set mode "$mode"
  printf 'reload(%s --list %s)+%s+first+%s' "$SELF" "$mode" "$(act change-border-label "$(tabs "$mode")")" "$(act change-footer "$(footer_now)")"
}
on_fill() {  # ctrl-]: 커서 항목의 경로를 검색어에 (끝 슬래시 없이. 이어서 /이름 을 치면 그 아래)
  [ -n "${1:-}" ] || return 0
  printf '%s+rebind(result)+first+%s' "$(act change-query "$1")" "$(search_action "$1")"
}
on_help() {
  st_get help
  if [ "$ST" = 1 ]; then st_del help; act change-preview "$SELF --preview {3}"
  else st_set help 1; printf '%s+show-preview' "$(act change-preview "$SELF --help-keys")"; fi
}

# --- 위치 피커 (alt-enter 로 겹쳐 뜬다) ------------------------------------------------
# 행은 메인 목록과 같은 꼴. 최근에 무언가를 만든 부모(◷) → 커서 항목의 부모(↳) → 디렉토리 탐색.
parents_paths() {  # 최근 순, 중복 없이
  [ -f "$TMUX_DEV_PARENTS" ] || return 0
  { tail -r "$TMUX_DEV_PARENTS" 2>/dev/null || tac "$TMUX_DEV_PARENTS"; } | awk -F'\t' '{ p = NF > 1 ? $2 : $1; if (p != "" && !seen[p]++) print p }'
}
loc_rows() {
  {
    local p n=0
    while IFS= read -r p; do [ "$n" -lt "$RECENT_MAX" ] || break; [ -d "$p" ] || continue; row "$p" "${D}◷${R}"; n=$((n + 1)); done < <(parents_paths)
    st_get near; [ -n "$ST" ] && [ -d "$ST" ] && row "$ST" "${D}↳ 커서 옆${R}"
    scan_rows dir
  } | awk -F'\t' '!seen[$3]++ { print; fflush() }'
}
loc_preview() {  # $1 고를 부모 → 만들어질 경로와 판정, 그 아래 부모의 내용
  local mode name; st_get name; name=$ST; st_get mode; mode=${ST:-repo}
  [ -d "${1:-}" ] || return 0
  classify "$1/$name" "$mode"
  case $J_KIND in
    create)  printf '%s새로 만든다%s  %s\n' "$B" "$R" "$(home_disp "$J_PATH")"; printf '%s\n' "${J_SAY#*: }" | sed 's/^[^ ]* *//' ;;
    open|worktree) printf '%s이미 있다%s  %s  %s(enter 면 연다)%s\n' "$Y" "$R" "$(home_disp "$J_PATH")" "$D" "$R" ;;
    *) printf '%s\n' "$J_SAY" ;;
  esac
  echo; dir_preview "$1"
}
on_loc_enter() {  # 위치 피커의 enter: 만들 수 있으면(또는 이미 있으면) 고르고 끝, 막히면 안내
  local mode name; st_get name; name=$ST; st_get mode; mode=${ST:-repo}
  [ -n "${1:-}" ] || { printf 'bell'; return; }
  classify "$1/$name" "$mode"
  [ "$J_KIND" = block ] && { nope "$J_SAY"; return; }
  st_set loc "$1"; printf 'accept'
}
on_loc_layout() {  # 위치 피커의 alt-l: 레이아웃을 겹쳐 띄우고, 고르면 위치도 고른 것으로 끝낸다
  local mode name; st_get name; name=$ST; st_get mode; mode=${ST:-repo}
  [ -n "${1:-}" ] || { printf 'bell'; return; }
  classify "$1/$name" "$mode"
  [ "$J_KIND" = block ] && { nope "$J_SAY"; return; }
  st_set pending "${J_CREATE:-none}"$'\t'"$J_PATH"; st_set near_pick "$1"; st_del layout
  printf 'execute(%s --choose-layout)+transform(%s --on loc-after-layout)' "$SELF" "$SELF"
}
on_loc_after_layout() {  # 레이아웃에서 esc 면 위치 피커에 그대로 남는다
  st_get layout; [ -n "$ST" ] || return 0
  st_get near_pick; st_set loc "$ST"; printf 'accept'
}
choose_location_step() {  # execute 안에서 돈다. 고른 부모는 상태 loc 에 남는다 (esc 면 남기지 않는다)
  local name what="디렉토리"; st_get name; name=$ST; st_get mode; [ "${ST:-repo}" = repo ] && what="저장소"
  style_opts
  fzf --ansi --delimiter '\t' --with-nth 1,2 --nth 1 --tabstop 2 --scheme path --tiebreak pathname,index \
      "${STYLE[@]}" --border-label " 새 $what '$name' 를 어디에? " --prompt '위치> ' \
      --footer "${D}enter 여기에 만들기 · alt-l 레이아웃 골라 만들기 · esc 돌아가기${R}" --footer-border line \
      --preview "$SELF --loc-preview {3}" --preview-window 'right,45%,border-left' \
      --bind 'change:first' --bind 'esc:abort' \
      --bind "enter:transform($SELF --on loc-enter {3})" \
      --bind "double-click:transform($SELF --on loc-enter {3})" \
      --bind "alt-l:transform($SELF --on loc-layout {3})" \
      --bind 'alt-p:change-preview-window(down,40%,border-top|hidden|right,45%,border-left)' \
      < <(loc_rows) > /dev/null || true
}

pick() {
  command -v fzf >/dev/null || die "fzf 가 필요합니다"
  TMUX_DEV_STATE=$(mktemp -d "${TMPDIR:-/tmp}/tmux-dev-project.XXXXXX"); export TMUX_DEV_STATE
  # shellcheck disable=SC2064  # 지금 값의 디렉토리를 지운다
  trap "rm -rf '$TMUX_DEV_STATE'" EXIT
  find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'tmux-dev-project.*' -type d -mmin +60 -exec rm -rf {} + 2>/dev/null || true  # 비정상 종료 흔적
  st_set mode repo
  style_opts
  # 정렬: --scheme=path 의 점수에 동점이면 파일 이름 일치 → 입력 순서(열린 세션 → 최근 → 탐색). path 의 기본 length 대신 index.
  # 바인딩은 fzf 기본 키와 겹치지 않는 것만. enter·esc·tab·double-click 은 같은 뜻으로 덮는다(판정을 거치게).
  fzf --ansi --delimiter '\t' --with-nth 1,2 --nth 1 --tabstop 2 --scheme path --tiebreak pathname,index \
      "${STYLE[@]}" --border-label "$(tabs repo)" --prompt '> ' \
      --footer "$(hint)" --footer-border line \
      --preview "$SELF --preview {3}" --preview-window 'right,45%,border-left' \
      --bind 'start:unbind(result)' \
      --bind "change:transform($SELF --on change)" \
      --bind "result:bg-transform($SELF --on result)" \
      --bind "enter:transform($SELF --on enter {3})" \
      --bind "double-click:transform($SELF --on enter {3})" \
      --bind "alt-enter:transform($SELF --on create {3})" \
      --bind "alt-l:transform($SELF --on layout {3})" \
      --bind "esc:transform($SELF --on esc)" \
      --bind "tab:transform($SELF --on mode)" --bind "shift-tab:transform($SELF --on mode)" \
      --bind "ctrl-]:transform($SELF --on fill {1})" \
      --bind 'alt-p:change-preview-window(down,40%,border-top|hidden|right,45%,border-left)' \
      --bind "alt-h:transform($SELF --on help)" \
      < <(rows repo) > /dev/null || true
  [ -f "$TMUX_DEV_STATE/decision" ] || exit 0     # 결정 없이 끝남 = 취소 (ctrl-c 는 130)
  local path create layout save parent
  IFS=$US read -r path create layout save parent < "$TMUX_DEV_STATE/decision"
  apply_decision "$path" "$create" "$layout" "$save" "$parent"
}

# --- 인자 ------------------------------------------------------------------------
target=""
while [ $# -gt 0 ]; do
  case "$1" in
    --on)
      # 콜백은 출력이 전부다. 마지막 조건식의 종료 코드로 set -e 가 끊지 않게 || true
      case $2 in
        enter) on_enter "${3:-}" || true ;; layout) on_layout "${3:-}" || true ;; after-layout) on_after_layout || true ;;
        create) on_create "${3:-}" || true ;; after-location) on_after_location || true ;;
        loc-enter) on_loc_enter "${3:-}" || true ;; loc-layout) on_loc_layout "${3:-}" || true ;;
        loc-after-layout) on_loc_after_layout || true ;;
        esc) on_esc || true ;; change) on_change || true ;; result) on_result || true ;; mode) on_mode || true ;;
        fill) on_fill "${3:-}" || true ;; help) on_help || true ;;
      esac; exit 0 ;;
    --choose-layout)   choose_layout_step; exit 0 ;;
    --choose-location) choose_location_step; exit 0 ;;
    --loc-preview)     loc_preview "${2:-}"; exit 0 ;;
    --preview)    dir_preview "${2:-}"; exit 0 ;;
    --help-keys)  help_keys; exit 0 ;;
    --list)       if [ "${2:-}" = loc ]; then loc_rows; else rows "${2:-repo}"; fi; exit 0 ;;
    --layout)     LAYOUT=$2; shift 2 ;;
    --layouts)    layout_list; exit 0 ;;
    --layout-art) layout_art "${2:-}"; exit 0 ;;
    -h|--help) sed -n '2,/^set -euo/{/^set -euo/d;p;}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "모르는 옵션: $1" ;;
    *) target=$1; shift ;;
  esac
done

if [ -z "$target" ]; then pick; exit 0; fi
target=$(canon_dir "$target") || die "디렉토리가 아닙니다: $target"   # CLI 는 있는 디렉토리만. 최근 내역에 남기지 않는다
open_path "$target"
