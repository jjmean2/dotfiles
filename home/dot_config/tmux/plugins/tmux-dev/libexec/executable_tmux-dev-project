#!/usr/bin/env bash
# tmux-dev project: 디렉토리 하나를 골라 그 디렉토리의 세션으로 간다. 세션이 없으면 만들고, 디렉토리가 없으면 만든다.
#
# 멘탈 모델 (자세히: 저장소의 docs/tmux-dev/design/session-picker.md)
#   세션 = 디렉토리. 세션의 정체는 이름이 아니라 디렉토리의 실제 경로다. 같은 경로의 세션이 있으면 전환만 한다.
#   모드는 "무엇을 후보로 보여 주나" 만 정한다. 어느 모드에서 골라도 결과는 같다.
#   피커(fzf)는 결정만 한다. 만들기·전환은 fzf 가 끝난 뒤 이 스크립트가 한다. 셸에서 경로를 주는 것과 같은 길이다.
#   순정 대응은 `tmux new -s 이름 -c 경로` + `prefix s`. 이 스크립트는 "없으면 만들어 준다" 와 레이아웃만 보탠다.
#
# 사용
#   tmux-dev project                  피커 (tmux 안에서는 prefix S 가 modal floating pane 으로 띄운다. tmux-dev open)
#   tmux-dev project <디렉토리>       바로 그 디렉토리의 세션으로 (있는 디렉토리만. 최근 내역에는 남기지 않는다)
#   tmux-dev project --layout <이름>  새 세션의 레이아웃. 없으면 저장소 설정 → 전역 → plain (lib/layout.sh). --layouts 로 목록
#   tmux-dev project --list [repo|dir|loc]  후보 목록만 출력 (디버그. loc 은 위치 피커)
#
# 피커 (fzf 순정 키는 그대로. 아래는 비어 있던 키와, 같은 뜻으로 덮은 enter·esc)
#   alt-m / alt-n     모드 전환: 저장소(메인 체크아웃만) ↔ 디렉토리(모든 디렉토리). prefix W 와 같은 키 (tab 은 fzf 에 돌려줬다)
#   모드 이름 클릭    그 모드로 (맨 위 헤더의 탭. fzf 의 click-header)
#   enter             커서 항목으로. 열기만 한다. 걸리는 항목이 없으면 벨과 안내 (경로를 쳤고 있으면 연다)
#   alt-enter         친 이름으로 새로 만들기. 위치 피커가 겹쳐 뜬다(최근 만든 곳 → 커서 옆 → 디렉토리 전부).
#                     거기서 enter 는 여기에 만들기, alt-l 은 레이아웃 골라 만들기, esc 는 돌아가기.
#                     저장소 모드는 git init 까지. 경로(/ 나 ~ 로 시작)를 쳤으면 위치를 묻지 않고 그 자리에
#   alt-l             레이아웃을 골라서 열기. 겹쳐 뜬 목록에서 enter 는 이번만, alt-enter 는 저장소 기본으로도 저장
#   ctrl-]            커서 항목의 경로를 검색어에 채운다
#   alt-p             미리보기 오른쪽 → 아래 → 숨김 (겹쳐 뜬 위치·레이아웃 목록에서도)
#   alt-h             키 안내를 미리보기 자리에 (다시 누르면 원래대로)
#   esc               닫기 (ctrl-c 도). 겹쳐 뜬 목록(위치, 레이아웃)에서는 돌아가기
#   경로 모양 검색어는 퍼지가 아니라 경로 접두 일치로 거른다. 끝 슬래시는 "이 디렉토리 아래" 다.
#
# 목록: 열린 세션(●) → 최근 고른 곳(◷) → 홈 전체 탐색 (lib/dirs.sh). 한 경로는 한 번만, 모드 조건에 맞는 것만.
# 파일: ~/.config/tmux-dev/ignore (탐색 제외, gitignore 문법), ~/.local/state/tmux-dev/history (피커로 고른 곳만),
#   ~/.local/state/tmux-dev/parents (위치 피커로 무언가를 만든 곳)
# 세션 찾기: 세션 옵션 @tmux-dev-path 가 그 경로 → 옵션 없는 세션의 session_path 가 그 경로 → 없으면 만든다.
#   여럿이면 최근에 붙었던 것. 만들 때 @tmux-dev-path 를 붙이고, 저장소면 첫 윈도우에 @worktree 를 둔다 (worktree 가 읽는다).
# 워크트리(.git 이 파일)를 고르면 그 워크트리로 이동한다: 그 경로의 세션 → 그 워크트리를 연 윈도우(@worktree)
#   → 메인 저장소 세션에 윈도우를 열어 준다 (tmux-dev worktree 에 넘김). 세션 = 저장소, 윈도우 = 워크트리.
set -euo pipefail

SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
LIB=$(cd "$(dirname "$SELF")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"
# shellcheck source=../lib/dirs.sh
. "$LIB/dirs.sh"             # 홈 탐색(scan_repos, scan_dirs)·미리보기. worktree 의 dir 모드와 공유
# shellcheck source=../lib/layout.sh
. "$LIB/layout.sh"           # 새 세션의 첫 윈도우에 한 번 적용. worktree 와 공유
# shellcheck source=../lib/picker.sh
. "$LIB/picker.sh"           # 상태 디렉토리·판정·탭·테두리·위치 피커·레이아웃 목록. worktree 와 공유
WORKTREE_BIN="$(dirname "$SELF")/tmux-dev-worktree"

LAYOUT=""          # --layout 으로 명시한 값, 또는 피커의 alt-l. 비어 있으면 resolve_layout
RECENT_MAX=20      # 목록 위쪽에 보여 줄 최근 항목 수
HISTORY_MAX=500    # 히스토리 파일 상한 (줄)
C=$'\033[36m'      # 브랜치 색

# --- 모드 ------------------------------------------------------------------------
# 작은 도구(act, pathish, norm_path, canon_dir, worktree_main, ...)는 lib/picker.sh 에 있다.
fits_mode() { if [ "$1" = repo ]; then [ -d "$2/.git" ]; else [ -d "$2" ]; fi; }
mode_name() { if [ "$1" = repo ]; then printf 'repository'; else printf 'directory'; fi; }

# --- 상태 (피커 하나당 디렉토리 하나. st_get/st_set/st_del 은 lib/picker.sh) -------------------
#   mode     repo | dir             help    1 이면 미리보기 자리에 키 안내
#   layout   고른 레이아웃 "<이름>\t<save 또는 빈 값>"
#   pending  레이아웃을 고를 대상 "<만들기: none|dir|repo>\t<경로>"
#   name     새로 만들 이름 (alt-enter)      near  커서 항목의 부모 (위치 피커 후보)      loc  위치 피커에서 고른 부모
#   decision fzf 를 끝낼 때 쓰는 결정 "<경로>US<만들기>US<레이아웃>US<save>US<고른 부모>" (빈 칸이 있어 US)

# --- 후보 (행 꼴은 lib/picker.sh 의 row) ------------------------------------------------
branch_mark() { local b; b=$(git_branch "$1"); [ -n "$b" ] && printf ' %s%s%s' "$C" "$b" "$R"; return 0; }
session_list() {  # "<최근 붙은 시각>US<id>US<이름>US<@tmux-dev-path>US<session_path>", 최근 붙은 순
  tmux list-sessions -F "#{session_last_attached}${US}#{session_id}${US}#{session_name}${US}#{@tmux-dev-path}${US}#{session_path}" 2>/dev/null \
    | sort -t "$US" -k1,1nr || true
}
session_rows() {
  local _t _id name tag sp p
  while IFS=$US read -r _t _id name tag sp; do
    # 세션 디렉토리가 지워졌으면 canon_dir 이 실패한다. set -e 아래서 대입이 그 실패를 받으면
    # 스크립트 전체가 끝나 목록이 비므로, || p="" 로 받아 그 세션만 건너뛴다
    p=$tag; [ -n "$p" ] || p=$(canon_dir "$sp") || p=""
    [ -n "$p" ] || continue
    fits_mode "$1" "$p" || continue
    row "$p" "${G}●${R} ${D}$name${R}$(branch_mark "$p")"
  done < <(session_list)
}
recent_rows() {
  local p n=0
  while IFS= read -r p; do
    [ "$n" -lt "$RECENT_MAX" ] || break
    fits_mode "$1" "$p" || continue   # 지금 없는 곳은 건너뛴다 (파일에서는 지우지 않는다)
    row "$p" "${D}◷${R}$(branch_mark "$p")"; n=$((n + 1))
  done < <(hist_paths "$TMUX_DEV_HISTORY")
}
scan_rows() {
  if [ "$1" = repo ]; then
    local p; while IFS= read -r p; do row "$p" "$(branch_mark "$p")"; done < <(scan_repos)
  else
    dir_rows
  fi
}
rows() {  # 앞에 나온 것이 이긴다. fflush 로 한 줄씩 흘려 보내 fzf 가 찾는 대로 그린다
  { session_rows "$1"; recent_rows "$1"; scan_rows "$1"; } | awk -F'\t' '!seen[$3]++ { print; fflush() }'
}

# --- 세션 찾기·만들기 --------------------------------------------------------------
find_session() {  # $1 실제 경로 → 세션 id. 옵션이 붙은 세션이 먼저, 그다음 옵션 없는 세션의 session_path
  local _t id _n tag sp by_path=""
  while IFS=$US read -r _t id _n tag sp; do
    if [ -n "$tag" ]; then [ "$tag" = "$1" ] && { printf '%s' "$id"; return 0; }
    elif [ -z "$by_path" ] && [ "$(canon_dir "$sp")" = "$1" ]; then by_path=$id; fi
  done < <(session_list)
  [ -n "$by_path" ] && printf '%s' "$by_path"
  return 0
}
session_name_for() {  # 표시용 이름. 겹치면 부모 이름을 붙이고, 그래도 겹치면 -2, -3
  local base parent name i=2
  base=$(basename "$1" | tr '.:' '__'); name=$base
  tmux has-session -t "=$name" 2>/dev/null || { printf '%s' "$name"; return; }
  parent=$(basename "$(dirname "$1")" | tr '.:' '__'); name="${parent}_$base"
  while tmux has-session -t "=$name" 2>/dev/null; do name="${parent}_$base-$i"; i=$((i + 1)); done
  printf '%s' "$name"
}
ensure_session() {  # $1 실제 경로 → 세션 id (없으면 만들고 레이아웃)
  local sid win
  sid=$(find_session "$1")
  if [ -z "$sid" ]; then
    win=$(tmux new-session -d -s "$(session_name_for "$1")" -c "$1" -P -F '#{window_id}')
    sid=$(tmux display-message -p -t "$win" '#{session_id}')
    tmux set-option -t "$sid" @tmux-dev-path "$1"
    [ -d "$1/.git" ] && tmux set-option -w -t "$win" @worktree "$1"
    apply_layout "$(resolve_layout "$LAYOUT" "$1")" "$win" "$1"
  fi
  printf '%s' "$sid"
}
# 피커는 창 안의 패널이라, -c 없는 switch-client 는 "가장 최근에 쓴 클라이언트" 를 옮긴다. prefix S 를 누른 클라이언트를
# 런처가 TMUX_DEV_CLIENT 로 넘겨 준다 (libexec/tmux-dev-open). 셸에서 부르면 비어 있어 순정 동작 그대로다.
switch_to() {
  if [ -n "${TMUX:-}" ]; then tmux switch-client ${TMUX_DEV_CLIENT:+-c "$TMUX_DEV_CLIENT"} -t "$1"
  else tmux attach-session -t "$1"; fi
}
# 워크트리를 고르면 그 워크트리로 이동한다 (session-picker.md 결정 3). 읽기를 바꾸려면 이 함수만 고친다.
open_worktree() {
  local path=$1 sid _t win tag main
  sid=$(find_session "$path")                       # 순정으로 만든 워크트리 세션은 존중한다
  if [ -n "$sid" ]; then switch_to "$sid"; return; fi
  while IFS=$US read -r _t sid win tag; do          # 그 워크트리를 연 윈도우가 어느 세션에든 있으면 그리로
    [ "$tag" = "$path" ] || continue
    tmux select-window -t "$win"; switch_to "$sid"; return
  done < <(tmux list-windows -a -F "#{session_last_attached}${US}#{session_id}${US}#{window_id}${US}#{@worktree}" 2>/dev/null | sort -t "$US" -k1,1nr)
  main=$(worktree_main "$path")
  if [ -z "$main" ]; then switch_to "$(ensure_session "$path")"; return; fi
  sid=$(LAYOUT="" ensure_session "$main")           # 메인 세션은 기본 레이아웃으로. 고른 레이아웃은 워크트리 윈도우에
  "$WORKTREE_BIN" -t "$sid" ${LAYOUT:+--layout "$LAYOUT"} "$path"
  switch_to "$sid"
}
open_path() {  # $1 실제 경로
  if [ -f "$1/.git" ]; then open_worktree "$1"; else switch_to "$(ensure_session "$1")"; fi
}
# 결정을 실행한다: $1 경로 $2 만들기(none|dir|repo) $3 레이아웃 $4 save $5 위치 피커에서 고른 부모
apply_decision() {
  local path=$1 create=$2
  case $create in
    dir)  mkdir -p "$path" || die "cannot create: $(home_disp "$path")" ;;
    repo) mkdir -p "$path" && git -C "$path" init -q || die "cannot create repository: $(home_disp "$path")" ;;
  esac
  path=$(canon_dir "$path") || die "not a directory: $1"
  LAYOUT=$3
  [ -n "$4" ] && [ -n "$LAYOUT" ] && [ -d "$path/.git" ] && git -C "$path" config tmux-dev.layout "$LAYOUT"
  hist_record "$TMUX_DEV_HISTORY" "$path" "$HISTORY_MAX"   # 피커로 고른 것만 기록한다 (CLI 는 기록하지 않는다)
  [ -n "${5:-}" ] && hist_record "$TMUX_DEV_PARENTS" "$5" 100   # 다음 위치 피커의 위쪽에 둔다
  open_path "$path"
}

# --- 피커 화면 -------------------------------------------------------------------
# 경로 판정(classify, name_ok), 탭(picker_tabs), 테두리(style_opts)는 lib/picker.sh 에 있다.
tabs() { picker_tabs "$1" repo dir; }   # 맨 위 헤더의 모드 탭. 클릭하면 그 모드로 (on_tab_click)
hint() { printf '%s' "${D}enter open · alt-enter new · alt-l layout · alt-m mode · alt-h keys${R}"; }
create_hint() {  # 검색어가 있으면 늘 보이는 만들기 안내 (결과가 있어도 alt-enter 는 친 이름으로 만든다)
  local q=${1%/} what="directory"; st_get mode; [ "${ST:-repo}" = repo ] && what="repository"
  printf '%s' "alt-enter create $what ${B}'$q'${R} ${D}· enter open · alt-h keys${R}"
}
help_keys() {
  cat <<EOF
${B}prefix S: directory → session${R}

enter         go to the item's session (created if missing)
alt-enter     create new from the typed name → pick a location
alt-l         open with a chosen layout
                enter this time only · alt-enter also save as repo default
alt-m         mode: repository ↔ directory (or click a mode name at the top)
ctrl-]        put the item's path into the query
alt-p         preview right → bottom → hidden (overlaid lists too)
alt-h         toggle this help
esc / ctrl-c  close (in overlaid lists: go back)

${B}create new${R}
Type a name and press alt-enter. A location list opens on top.
  enter       create there and open (repository mode runs git init)
  alt-l       create with a chosen layout and open
  esc         go back
Recently used locations first, then the item's parent.

${B}path input${R}
A query starting with / or ~ filters by path prefix.
  enter       open that path if it exists (even outside the list)
  alt-enter   create at that path directly
A trailing slash means "under this directory".

${B}list${R}
● open session · ◷ recently picked · the rest scans your home
excluded from scan: ~/.config/tmux-dev/ignore (gitignore syntax)
EOF
}

# --- 콜백 (fzf 가 이벤트마다 부른다. 액션 한 줄을 출력한다) -----------------------------
footer_now() {  # 메인 목록의 푸터
  local q=${FZF_QUERY:-}
  if [ -z "$q" ]; then hint
  elif pathish "$q"; then
    if [ "${FZF_MATCH_COUNT:-1}" -eq 0 ]; then local mode; st_get mode; mode=${ST:-repo}; classify "$q" "$mode"; printf '%s' "$J_SAY"
    else printf '%s' "enter open the item ${D}· alt-enter create at the typed path${R}"; fi
  else create_hint "$q"; fi
}
decide() {  # $1 경로 $2 만들기(none|dir|repo) [$3 위치 피커에서 고른 부모] → 결정 파일을 쓰고 fzf 를 끝낸다
  local l="" s=""; st_get layout; [ -n "$ST" ] && IFS=$'\t' read -r l s <<< "$ST"
  st_set decision "$1$US$2$US$l$US$s$US${3:-}"   # 빈 칸이 있으므로 US. 탭이면 read 가 연속 탭을 하나로 합친다
  printf 'accept'
}
# 열 대상을 정한다: 커서 항목, 아니면 경로 모양 검색어가 가리키는 있는 디렉토리. J_KIND/J_PATH 를 채운다.
# 열 것이 없으면 안내 액션을 출력하고 1 (만들기는 alt-enter 의 몫이다)
open_target() {  # $1 커서 항목의 실제 경로 (없으면 빈 값)
  local mode q=${FZF_QUERY:-}; st_get mode; mode=${ST:-repo}
  if [ -n "$1" ]; then J_PATH=$1; if [ -f "$1/.git" ]; then J_KIND=worktree; else J_KIND=open; fi; return 0; fi
  if pathish "$q"; then
    classify "$q" "$mode"
    case $J_KIND in open|worktree) return 0 ;; esac
    nope "$J_SAY"; return 1
  fi
  if [ -n "$q" ]; then nope "${Y}no match${R} · $(create_hint "$q")"; else nope "$(hint)"; fi
  return 1
}
on_enter() {
  st_del layout
  open_target "${1:-}" || return 0
  decide "$J_PATH" none
}
on_layout() {  # alt-l: 열 대상을 정해 두고 레이아웃 목록을 겹쳐 띄운다
  st_del layout
  open_target "${1:-}" || return 0
  st_set pending none$'\t'"$J_PATH"
  printf 'execute(%s --choose-layout)+transform(%s --on after-layout)' "$SELF" "$SELF"
}
on_after_layout() {  # 레이아웃에서 esc 면 그대로 목록, 골랐으면 연다
  local create path; st_get layout; [ -n "$ST" ] || return 0
  st_get pending; IFS=$'\t' read -r create path <<< "$ST"
  decide "$path" "$create"
}
on_create() {  # alt-enter: 경로를 쳤으면 그 자리에 바로, 이름을 쳤으면 위치 피커를 겹쳐 띄운다
  local mode q=${FZF_QUERY:-}; st_get mode; mode=${ST:-repo}
  st_del layout loc
  if [ -z "$q" ]; then nope "${Y}type a name first${R}"; return; fi
  if pathish "$q"; then
    classify "$q" "$mode"
    case $J_KIND in
      create) decide "$J_PATH" "$J_CREATE" ;;
      open|worktree) decide "$J_PATH" none ;;       # 이미 있으면 연다
      *) nope "$J_SAY" ;;
    esac
    return
  fi
  name_ok "$q" || { nope "${Y}not a valid name: $q${R} (no .. or empty parts)"; return; }
  st_set name "${q%/}"
  [ -n "${1:-}" ] && st_set near "$(dirname "$1")" || st_del near
  printf 'execute(%s --choose-location)+transform(%s --on after-location)' "$SELF" "$SELF"
}
on_after_location() {  # 위치 피커에서 esc 면 그대로 목록, 골랐으면 만든다(이미 있으면 연다)
  local mode parent name; st_get loc; parent=$ST; [ -n "$parent" ] || return 0
  st_get name; name=$ST; st_get mode; mode=${ST:-repo}
  classify "$parent/$name" "$mode"
  case $J_KIND in
    create) decide "$J_PATH" "$J_CREATE" "$parent" ;;
    open|worktree) decide "$J_PATH" none ;;
    *) nope "$J_SAY" ;;
  esac
}
on_change() {
  local out="bg-cancel+"   # 이전 검색어로 돌던 푸터 판정(bg-transform)을 버린다. 늦게 끝난 낡은 결과가 덮지 않게
  if pathish "${FZF_QUERY:-}"; then printf '%srebind(result)+first+%s' "$out" "$(search_action "$FZF_QUERY")"
  else printf '%sunbind(result)+first+%s' "$out" "$(act change-footer "$(footer_now)")"; fi
}
on_result() { pathish "${FZF_QUERY:-}" && act change-footer "$(footer_now)"; return 0; }  # 경로 모양 검색어일 때만 묶인다
on_esc() { printf 'abort'; }
to_mode() {  # $1 새 모드 → 목록·탭·푸터를 바꾸는 액션 (푸터 판정이 모드를 읽으므로 상태를 먼저 바꾼다)
  st_set mode "$1"
  printf 'reload(%s --list %s)+%s+first+%s' "$SELF" "$1" "$(act change-header "$(tabs "$1")")" "$(act change-footer "$(footer_now)")"
}
on_mode() { st_get mode; if [ "${ST:-repo}" = repo ]; then to_mode dir; else to_mode repo; fi; }
on_tab_click() {  # 헤더의 모드 이름을 클릭: 그 모드로. 이미 그 모드거나 이름 밖(빈 자리)이면 아무것도 안 한다
  local want
  case ${FZF_CLICK_HEADER_WORD:-} in
    "$(mode_name repo)") want=repo ;; "$(mode_name dir)") want=dir ;; *) return 0 ;;
  esac
  st_get mode; [ "${ST:-repo}" = "$want" ] && return 0
  to_mode "$want"
}
on_fill() {  # ctrl-]: 커서 항목의 경로를 검색어에 (끝 슬래시 없이. 이어서 /이름 을 치면 그 아래)
  [ -n "${1:-}" ] || return 0
  printf '%s+rebind(result)+first+%s' "$(act change-query "$1")" "$(search_action "$1")"
}
on_help() {
  st_get help
  if [ "$ST" = 1 ]; then st_del help; act change-preview "$SELF --preview {3}"
  else st_set help 1; printf '%s+show-preview' "$(act change-preview "$SELF --help-keys")"; fi
}

# 위치 피커(alt-enter 로 겹쳐 뜬다)와 레이아웃 목록(alt-l)은 lib/picker.sh 에 있다. 콜백은 아래 인자 처리로 돌아온다.

pick() {
  command -v fzf >/dev/null || die "fzf is required"
  picker_state_init tmux-dev-project
  st_set mode repo
  style_opts
  # 정렬: --scheme=path 의 점수에 동점이면 파일 이름 일치 → 입력 순서(열린 세션 → 최근 → 탐색). path 의 기본 length 대신 index.
  # 바인딩은 fzf 기본 키와 겹치지 않는 것만. enter·esc·double-click 은 같은 뜻으로 덮는다(판정을 거치게).
  # 모드 키는 alt-m / alt-n (prefix W 와 같다. W 는 tab 을 fzf 순정의 다중 선택으로 쓴다)
  # 테두리 라벨은 화면 제목(겹쳐 뜨는 위치·레이아웃 목록과 같은 문법), 모드 탭은 맨 위 헤더 (session-picker.md 화면 절).
  fzf --ansi --delimiter '\t' --with-nth 1,2 --nth 1 --tabstop 2 --scheme path --tiebreak pathname,index \
      "${STYLE[@]}" --border-label ' open session ' --header "$(tabs repo)" --header-first --prompt '> ' \
      --footer "$(hint)" --footer-border line \
      --preview "$SELF --preview {3}" --preview-window 'right,45%,border-left' \
      --bind 'start:unbind(result)' \
      --bind "change:transform($SELF --on change)" \
      --bind "result:bg-transform($SELF --on result)" \
      --bind "enter:transform($SELF --on enter {3})" \
      --bind "double-click:transform($SELF --on enter {3})" \
      --bind "alt-enter:transform($SELF --on create {3})" \
      --bind "alt-l:transform($SELF --on layout {3})" \
      --bind "esc:transform($SELF --on esc)" \
      --bind "alt-m:transform($SELF --on mode)" --bind "alt-n:transform($SELF --on mode)" \
      --bind "click-header:transform($SELF --on tab-click)" \
      --bind "ctrl-]:transform($SELF --on fill {1})" \
      --bind 'alt-p:change-preview-window(down,40%,border-top|hidden|right,45%,border-left)' \
      --bind "alt-h:transform($SELF --on help)" \
      < <(rows repo) > /dev/null || true
  [ -f "$TMUX_DEV_STATE/decision" ] || exit 0     # 결정 없이 끝남 = 취소 (ctrl-c 는 130)
  local path create layout save parent
  IFS=$US read -r path create layout save parent < "$TMUX_DEV_STATE/decision"
  apply_decision "$path" "$create" "$layout" "$save" "$parent"
}

# --- 인자 ------------------------------------------------------------------------
target=""
while [ $# -gt 0 ]; do
  case "$1" in
    --on)
      # 콜백은 출력이 전부다. 마지막 조건식의 종료 코드로 set -e 가 끊지 않게 || true
      case $2 in
        enter) on_enter "${3:-}" || true ;; layout) on_layout "${3:-}" || true ;; after-layout) on_after_layout || true ;;
        create) on_create "${3:-}" || true ;; after-location) on_after_location || true ;;
        loc-enter) on_loc_enter "${3:-}" || true ;; loc-layout) on_loc_layout "${3:-}" || true ;;
        loc-after-layout) on_loc_after_layout || true ;;
        esc) on_esc || true ;; change) on_change || true ;; result) on_result || true ;; mode) on_mode || true ;;
        tab-click) on_tab_click || true ;; fill) on_fill "${3:-}" || true ;; help) on_help || true ;;
      esac; exit 0 ;;
    --choose-layout)   choose_layout_step; exit 0 ;;
    --choose-location) choose_location_step; exit 0 ;;
    --loc-preview)     loc_preview "${2:-}"; exit 0 ;;
    --preview)    dir_preview "${2:-}"; exit 0 ;;
    --help-keys)  help_keys; exit 0 ;;
    --list)       if [ "${2:-}" = loc ]; then loc_rows; else rows "${2:-repo}"; fi; exit 0 ;;
    --layout)     LAYOUT=$2; shift 2 ;;
    --layouts)    layout_list; exit 0 ;;
    --layout-art) layout_art "${2:-}"; exit 0 ;;
    -h|--help) sed -n '2,/^set -euo/{/^set -euo/d;p;}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) target=$1; shift ;;
  esac
done

if [ -z "$target" ]; then pick; exit 0; fi
target=$(canon_dir "$target") || die "not a directory: $target"   # CLI 는 있는 디렉토리만. 최근 내역에 남기지 않는다
open_path "$target"
