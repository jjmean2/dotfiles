#!/usr/bin/env bash
# tmux-dev project: 프로젝트 디렉토리를 골라 그 이름의 tmux 세션으로 들어간다 (없으면 만든다).
#
# 멘탈 모델: 세션 = 프로젝트. 세션에 프로젝트 이름을 붙이고 그 디렉토리에서 시작하면 세션 전환이
# 곧 프로젝트 전환이다. 분리(prefix d)해도 세션은 살아 있어 Claude, 셸 히스토리, nvim 버퍼가
# 프로젝트별로 보존된다. 순정 대응은 `tmux new -s 이름 -c 경로` + `prefix s` 이고, 이 스크립트는
# "없으면 만들어 준다" 와 "기본 레이아웃" 만 보탠다. 프로젝트는 git 저장소가 아니어도 된다.
#
# 사용
#   tmux-dev project                  fzf 로 고른다 (tmux 안에서는 prefix S 가 팝업으로 띄움)
#   tmux-dev project <디렉토리>       바로 그 프로젝트로
#   tmux-dev project --layout plain   새 세션의 레이아웃을 명시. 없으면 저장소 설정 → 전역 → ide (lib/layout.sh). --layouts 로 목록
#   tmux-dev project --add [디렉토리] 목록에 고정 등록 (생략하면 현재 디렉토리)
#   tmux-dev project --remove <디렉토리>  목록에서 제거 (자동 수집된 것은 숨김으로)
#   tmux-dev project --edit           목록 파일을 $EDITOR 로 열기
#   tmux-dev project --list           후보 목록만 출력 (디버그)
#
# 팝업(fzf) 안에서 (fzf 기본 키와 겹치지 않는 키만 썼다. ctrl-p/n, ctrl-a/e 등은 순정 그대로)
#   tab / shift-tab            모드 순환: project(목록) → dir(파일시스템 검색) → recent(최근 연 곳)
#                              검색어는 모드를 바꿔도 유지된다
#   Enter                      선택. 맞는 후보가 없으면 입력한 글자를 경로로 해석한다
#   alt-enter                  후보가 있어도 입력한 글자를 경로로 쓴다 (없는 경로면 만들지 물어봄).
#                              macOS Ghostty 는 왼쪽 option 이 alt (macos-option-as-alt = left)
#   alt-l                      레이아웃을 골라서 이번만 그것으로 연다 (두 번째 fzf, 그림 미리보기). 거기서 alt-enter
#                              로 고르면 저장소의 기본으로도 남는다 (git config tmux-dev.layout).
#                              Enter 는 묻지 않고 저장소 설정 → 전역 → ide 순으로 쓴다
#   ctrl-t / ctrl-x / ctrl-o   커서 항목을 목록에 등록 / 목록에서 제거 / 목록 파일 열어 편집
#                              (후보가 비어 있을 때 ctrl-t 는 팝업을 띄운 패널의 디렉토리를 등록)
#
# 목록 파일: ~/.config/tmux-dev/projects (머신마다 다르다. 형식은 그 파일의 주석 참고)
# 후보 = 목록 파일의 저장소·고정 항목 + 지금 열려 있는 세션. 세션 이름은 디렉토리 이름이고
# tmux 가 못 쓰는 . 과 : 은 _ 로 바꾼다. 이미 있는 세션으로 갈 때는 레이아웃을 건드리지 않는다.
#
# 워크트리 (tmux-dev worktree, prefix W 와 짝). 세션 = 저장소, 윈도우 = 워크트리 라는 관례를 지키기 위해
#   - 자동 수집은 .git 이 파일인 디렉토리(= 워크트리)를 프로젝트로 보지 않는다. 고정 항목은 적은 대로 쓴다.
#   - 워크트리 경로를 골랐는데 그 이름의 세션이 없고 고정 항목도 아니면, 메인 체크아웃의 세션으로 가서
#     그 워크트리의 윈도우를 연다 (worktree 에 넘김). 그 이름의 세션이 이미 있으면 그냥 그 세션으로
#     간다 (순정 `tmux new -c <워크트리>` 로 만든 세션을 존중).
#   - 세션을 만들 때 저장소면 첫 윈도우에 사용자 옵션 @worktree <경로> 를 둔다 (worktree 가 읽는다).
set -euo pipefail

SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
LIB=$(cd "$(dirname "$SELF")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"
# shellcheck source=../lib/dirs.sh
. "$LIB/dirs.sh"             # dir 모드 검색(list_dirs)·미리보기. worktree 의 dir 모드와 공유
# shellcheck source=../lib/layout.sh
. "$LIB/layout.sh"           # 새 세션의 첫 윈도우에 한 번 적용. worktree 와 공유 (ide, ide-dev, nvim, nvim-dev, plain)
WORKTREE_BIN="$(dirname "$SELF")/tmux-dev-worktree"

# --- 설정 --------------------------------------------------------------------
CONFIG=$TMUX_DEV_CONFIG
HISTORY=$TMUX_DEV_HISTORY
LAYOUT=""              # --layout 으로 명시한 값. 비어 있으면 resolve_layout (저장소 설정 → 전역 → ide). alt-l 로 고르면 채워진다
PICK_LAYOUT=""         # 피커에서 alt-l 을 눌렀다
RECENT_MAX=30          # recent 모드에 보여 줄 수
HISTORY_MAX=500        # 히스토리 파일 상한 (줄). 무한정 쌓지 않는다

# --- git 도우미 ----------------------------------------------------------------
# 워크트리의 메인 체크아웃. .git 파일의 "gitdir: <메인>/.git/worktrees/<이름>" 에서 역산한다 (git 프로세스 없음).
# 워크트리가 아니거나 메인을 못 찾으면 빈 문자열.
worktree_main() {
  local g=$1/.git line
  [ -f "$g" ] || return 0
  IFS= read -r line < "$g" || return 0
  g=${line#gitdir: }; [[ $g = /* ]] || g=$1/$g
  case $g in */.git/worktrees/*) g=${g%/.git/worktrees/*}; [ -d "$g/.git" ] && printf '%s' "$g" ;; esac
  return 0
}

# --- 목록 파일 ----------------------------------------------------------------
# 형식(한 줄에 하나, # 은 주석):
#   <경로>:<깊이>      루트. 깊이만큼 내려가며 .git 이 있는 디렉토리를 자동 수집
#   <경로>             고정 항목. git 저장소가 아니어도 된다
#   !<경로>            자동 수집에서 숨김 (열려 있는 세션은 그대로 보인다)
#   search <경로>:<깊이>   dir 모드가 뒤지는 범위. 여러 줄 가능
#   exclude <이름>...  dir 모드에서 건너뛸 디렉토리 이름
# (search·exclude 는 lib/dirs.sh 가 읽는다. prefix W 의 dir 모드도 같은 범위를 쓴다)
config_roots()    { config_lines | grep -E '^[^!s][^[:space:]]*:[0-9]+$' || true; }
config_pins()     { config_lines | grep -vE '^(!|search |exclude )' | grep -vE ':[0-9]+$' || true; }
config_hidden()   { config_lines | sed -n 's/^!//p'; }

ensure_config() {
  [ -f "$CONFIG" ] && return 0
  mkdir -p "$(dirname "$CONFIG")"
  cat > "$CONFIG" <<'EOF'
# tmux-dev project (prefix S) 가 팝업에 보여줄 프로젝트 목록. 이 파일은 머신마다 다르다.
#   <경로>:<깊이>    루트. 깊이만큼 내려가며 .git 이 있는 디렉토리를 자동 수집 (워크트리는 제외)
#   <경로>           고정 항목 (git 저장소가 아니어도 됨)
#   !<경로>          자동 수집에서 숨김
#   search <경로>:<깊이>   dir 모드 검색 범위 (기본 ~:4)
#   exclude <이름>...      dir 모드가 건너뛸 디렉토리 이름
~/dev:2
EOF
}

# --- 후보 수집 ----------------------------------------------------------------
list_roots() {  # 설정의 루트 아래 git 저장소
  local entry root depth
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    root=$(expand_tilde "${entry%:*}"); depth=${entry##*:}
    [ -d "$root" ] || continue
    # 루트 자신은 적은 대로 후보. 그 아래는 depth 까지 .git 디렉토리를 검색한다. .git 이 파일이면
    # 워크트리라 건너뛴다 (워크트리는 세션이 아니라 메인 저장소 세션의 윈도우. tmux-dev worktree 참고).
    [ -e "$root/.git" ] && printf '%s\n' "$root"
    [ "$depth" -gt 0 ] && find "$root" -mindepth 2 -maxdepth $((depth + 1)) -name .git -prune \
      2>/dev/null | while IFS= read -r g; do [ -d "$g" ] && printf '%s\n' "${g%/.git}"; done
  done < <(config_roots)
}
list_pins() {
  local p; while IFS= read -r p; do [ -n "$p" ] && canon "$(expand_tilde "$p")"; done < <(config_pins)
}
list_hidden() {
  local p; while IFS= read -r p; do [ -n "$p" ] && canon "$(expand_tilde "$p")"; done < <(config_hidden)
}
list_sessions() {
  tmux list-sessions -F '#{session_path}' 2>/dev/null || true
}
# 표시용 줄로 바꾼다: "<~경로> [<브랜치>]<TAB><절대경로>". fzf 는 TAB 앞만 보여주고 뒤를 돌려준다.
annotate() {
  local p b rows=() w=0 n
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    b=$(git_branch "$p")
    rows+=("$(abbrev_home "$p")|$b|$p")
    n=$(abbrev_home "$p"); n=${#n}; [ "$n" -gt "$w" ] && w=$n
  done
  [ "$w" -gt 60 ] && w=60
  for p in "${rows[@]+"${rows[@]}"}"; do
    local disp=${p%%|*} rest=${p#*|} br abs
    br=${rest%%|*}; abs=${rest#*|}
    if [ -n "$br" ]; then
      printf '%-*s \033[2;36m%s\033[0m\t%s\n' "$w" "$disp" "$br" "$abs"
    else
      printf '%s\t%s\n' "$disp" "$abs"
    fi
  done
}
registered() {  # 설정으로 들어온 항목 (고정 + 자동 수집, 숨김 제외). 열려 있는 세션은 포함하지 않는다
  local hidden; hidden=$(list_hidden)
  { list_pins; list_roots | grep -vxF -f <(printf '%s\n' "$hidden"; echo '//none//') || true; } | awk '!seen[$0]++'
}
candidates() {  # project 모드 = 열려 있는 세션 + 설정 항목. 순서 유지하며 경로로 중복 제거
  { list_sessions; registered; } | awk '!seen[$0]++' | annotate
}
list_recent() { # recent 모드. 최근 연 순서, 중복 제거, 사라진 디렉토리 제외
  [ -f "$HISTORY" ] || return 0
  tail -r "$HISTORY" 2>/dev/null || tac "$HISTORY"
}
recent_rows() {
  list_recent | awk '!seen[$0]++' | while IFS= read -r p; do [ -d "$p" ] && printf '%s\n' "$p"; done \
    | head -n "$RECENT_MAX" | annotate
}
record_history() {  # 최근 순. 같은 경로는 최신 하나만 남기고, 파일은 HISTORY_MAX 줄로 자른다 (fzf --history, 에디터 최근 파일과 같은 관행)
  mkdir -p "$(dirname "$HISTORY")"
  local tmp; tmp=$(mktemp "$HISTORY.XXXXXX")
  { [ -f "$HISTORY" ] && grep -vxF -- "$1" "$HISTORY" || true; printf '%s\n' "$1"; } | tail -n "$HISTORY_MAX" > "$tmp" && mv -f "$tmp" "$HISTORY"
}

# --- 목록 편집 ----------------------------------------------------------------
# 설정에서 내용이 $1 또는 $2 와 같은 줄을 지운다 (뒤따르는 주석·공백은 무시). 정규식을 쓰지 않는다.
delete_lines() {
  local tmp; tmp=$(mktemp "$CONFIG.XXXXXX")
  awk -v a="$1" -v b="$2" '{ l=$0; sub(/[ \t]*#.*$/, "", l); sub(/[ \t]+$/, "", l); if (l==a || l==b) next; print }' \
    "$CONFIG" > "$tmp" && mv "$tmp" "$CONFIG"
}
add_entry() {
  local dir; dir=$(canon "${1:-$PWD}")
  [ -n "$dir" ] || die "디렉토리가 아닙니다: ${1:-$PWD}"
  ensure_config
  local short; short=$(abbrev_home "$dir")
  # 숨김 줄이 있으면 그것을 지우는 것으로 충분하다 (다시 자동 수집된다)
  if config_hidden | grep -xF -e "$short" -e "$dir" >/dev/null; then
    delete_lines "!$short" "!$dir"
    return 0
  fi
  registered | grep -xF "$dir" >/dev/null && return 0   # 이미 설정에 있음 (열려 있는 세션일 뿐이면 등록한다)
  printf '%s\n' "$short" >> "$CONFIG"
}
remove_entry() {
  local dir; dir=$(canon "$1")
  [ -n "$dir" ] || die "디렉토리가 아닙니다: $1"
  ensure_config
  local short; short=$(abbrev_home "$dir")
  if config_pins | grep -xF -e "$short" -e "$dir" >/dev/null; then   # 고정 항목이면 줄을 지운다
    delete_lines "$short" "$dir"
  elif registered | grep -xF "$dir" >/dev/null; then                  # 자동 수집 항목이면 숨김 줄 추가
    printf '!%s\n' "$short" >> "$CONFIG"
  fi                                                                  # 열려 있는 세션일 뿐이면 할 일 없음
}
edit_config() { ensure_config; "${EDITOR:-nvim}" "$CONFIG"; }

# --- fzf ------------------------------------------------------------------------
header_for() {  # 모드 탭 + 키 안내. 현재 모드만 굵게
  local p="project" f="dir" r="recent"
  case "$1" in project) p="${B}[project]${R}" ;; dir) f="${B}[dir]${R}" ;; recent) r="${B}[recent]${R}" ;; esac
  printf '%s   %s   %s\n%s\n%s\n' "$p" "$f" "$r" \
    "${D}tab/shift-tab 모드 순환   enter 선택 (후보 없으면 친 글자가 경로)   alt-enter 친 글자 강제   alt-l 레이아웃 골라 열기${R}" \
    "${D}ctrl-t 등록   ctrl-x 제거   ctrl-o 목록 파일 편집   esc 검색어 지우기   ctrl-c 닫기${R}"
}
source_for() {
  case "$1" in project) echo "$SELF --list" ;; dir) echo "$SELF --list-dirs" ;; recent) echo "$SELF --list-recent" ;; esac
}
# transform 액션에서 호출된다. $FZF_PROMPT 로 현재 모드를 알아내 그 모드의 목록을 다시 읽는다.
mode_from_prompt() {
  case "${FZF_PROMPT:-}" in dir*) echo dir ;; recent*) echo recent ;; *) echo project ;; esac
}
next_mode() {  # $1 = next | prev
  local cur; cur=$(mode_from_prompt)
  case "$1:$cur" in
    next:project) echo dir ;;    next:dir) echo recent ;; next:recent) echo project ;;
    prev:project) echo recent ;; prev:dir) echo project ;; prev:recent) echo dir ;;
  esac
}
action_switch() {  # $1 = 바꿀 모드 (next / prev 는 지금 모드 기준으로 순환)
  local mode=$1
  case "$mode" in next|prev) mode=$(next_mode "$mode") ;; esac
  printf 'reload(%s)+first+change-prompt(%s> )+change-header(%s)\n' "$(source_for "$mode")" "$mode" "$(header_for "$mode")"
}
action_after_edit() {  # 목록을 고친 뒤: 지금 모드 그대로 다시 읽기
  printf 'reload(%s)\n' "$(source_for "$(mode_from_prompt)")"
}
pick() {
  command -v fzf >/dev/null || die "fzf 가 필요합니다"
  local out rc=0 query key sel
  # 후보는 < <(...) 로 넣는다. 파이프로 넣으면 pipefail 때문에 candidates 의 종료 코드가 fzf 의 것을 가릴 수 있다.
  # change:first — 검색어가 바뀌면 커서를 맨 위(가장 잘 맞는 후보)로. fzf 기본은 커서 줄 위치를 유지한다 (man fzf 의 change 이벤트 예).
  # esc:clear-query — Esc 는 닫지 않고 검색어만 지운다. vim 습관으로 Esc 를 연타해도 팝업이 꺼지지 않게.
  # 닫기는 fzf 기본 abort 키 ctrl-c (ctrl-g, ctrl-q 도 같다). nvim 피커와 같은 규칙 (picker.lua).
  out=$(fzf --ansi --delimiter=$'\t' --with-nth=1 --nth=1 --scheme=path \
      --prompt='project> ' --header="$(header_for project)" --height=100% --reverse \
      --print-query --expect=alt-enter,alt-l \
      --bind 'change:first' --bind 'esc:clear-query' \
      --preview="$SELF --preview {2}" --preview-window='right,45%,border-left,<60(down,40%,border-top)' \
      --bind "tab:transform($SELF --action switch next)" \
      --bind "shift-tab:transform($SELF --action switch prev)" \
      --bind "ctrl-t:execute-silent($SELF --add {2})+transform($SELF --action refresh)" \
      --bind "ctrl-x:execute-silent($SELF --remove {2})+transform($SELF --action refresh)" \
      --bind "ctrl-o:execute($SELF --edit)+transform($SELF --action refresh)" \
      < <(candidates)) || rc=$?
  # 종료 코드: 0 선택, 1 후보 없음(입력을 경로로), 130 취소
  [ "$rc" -eq 130 ] && exit 0
  [ "$rc" -gt 1 ] && exit "$rc"
  { IFS= read -r query; IFS= read -r key; IFS= read -r sel; } <<< "$out" || true
  [ "$key" = alt-l ] && PICK_LAYOUT=1     # 경로가 정해진 뒤(아래) 레이아웃을 고른다
  # alt-enter 는 친 글자 강제. 후보가 없을 때도 친 글자. 그 밖(enter, alt-l)은 커서 항목
  if [ "$key" != alt-enter ] && [ -n "${sel:-}" ]; then
    target=${sel##*$'\t'}
  else
    target=$(query_dir "$query") || exit 0   # 상대 경로는 패널의 디렉토리 기준, 없으면 만들지 묻는다 (lib/dirs.sh)
  fi
}

# --- 인자 ---------------------------------------------------------------------
target=""
while [ $# -gt 0 ]; do
  case "$1" in
    --layout) LAYOUT=$2; shift 2 ;;
    --layouts)    layout_list; exit 0 ;;
    --layout-art) layout_art "${2:-}"; exit 0 ;;
    --list)        candidates;  exit 0 ;;
    --list-dirs)   list_dirs;   exit 0 ;;
    --list-recent) recent_rows; exit 0 ;;
    --add)    add_entry "${2:-}";    exit $? ;;
    --remove) remove_entry "${2:?--remove 에는 디렉토리가 필요합니다}"; exit $? ;;
    --edit)   edit_config; exit $? ;;
    --preview) dir_preview "${2:-}"; exit 0 ;;
    --action) case "$2" in switch) action_switch "$3" ;; refresh) action_after_edit ;; esac; exit 0 ;;
    -h|--help) sed -n '2,/^set -euo/{/^set -euo/d;p;}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "모르는 옵션: $1" ;;
    *) target=$1; shift ;;
  esac
done

# --- 고르기 -------------------------------------------------------------------
[ -z "$target" ] && pick
[ -d "$target" ] || die "디렉토리가 아닙니다: $target"
target=$(cd "$target" && pwd)
name=$(basename "$target" | tr '.:' '__')
record_history "$target"

# alt-l: 레이아웃을 골라서 이번만 그것으로 연다. 레이아웃 목록에서 alt-enter 로 골랐고 저장소면 그 저장소의
# 기본값으로도 남긴다 (lib/layout.sh 의 resolve_layout 순서)
if [ -n "$PICK_LAYOUT" ]; then
  can_save=""; [ -e "$target/.git" ] && can_save=save
  picked=$(choose_layout "$SELF --layout-art" "$can_save") || exit 0
  IFS=$'\t' read -r LAYOUT save_layout <<< "$picked"
  if [ -n "$save_layout" ]; then git -C "$target" config tmux-dev.layout "$LAYOUT"; fi
fi

# 워크트리를 골랐으면 메인 저장소의 세션으로 바꾸고, 워크트리는 그 세션의 윈도우로 연다 (아래).
# 예외: 그 이름의 세션이 이미 있거나(순정으로 만든 세션 존중) 목록 파일에 직접 적은 고정 항목이면 적은 대로.
worktree=""
if [ -f "$target/.git" ] && ! tmux has-session -t "=$name" 2>/dev/null && ! list_pins | grep -xF "$target" >/dev/null; then
  main=$(worktree_main "$target")
  if [ -n "$main" ]; then
    worktree=$target; target=$main; name=$(basename "$target" | tr '.:' '__')
  fi
fi

# --- 세션 만들기 / 전환 -------------------------------------------------------
if ! tmux has-session -t "=$name" 2>/dev/null; then
  win=$(tmux new-session -d -s "$name" -c "$target" -P -F '#{window_id}')
  # 저장소면 첫 윈도우가 "이 체크아웃의 윈도우" 임을 사용자 옵션으로 남긴다 (worktree 가 읽는다)
  [ -e "$target/.git" ] && tmux set-option -w -t "$win" @worktree "$target"
  apply_layout "$(resolve_layout "$LAYOUT" "$target")" "$win" "$target"
fi
if [ -n "$worktree" ]; then
  # 레이아웃을 명시했을 때만 넘긴다. 아니면 worktree 가 저장소 설정 → 전역 순으로 스스로 정한다
  "$WORKTREE_BIN" -t "$name" ${LAYOUT:+--layout "$LAYOUT"} "$worktree"
fi
if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "=$name"
else
  tmux attach-session -t "=$name"
fi
