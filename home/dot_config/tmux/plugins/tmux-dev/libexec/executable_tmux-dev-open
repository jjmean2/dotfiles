#!/usr/bin/env bash
# tmux-dev open: 피커를 modal floating pane 으로 띄운다. tmux-dev.tmux 가 묶은 키(prefix S, prefix W)가 run-shell 로 부른다.
#
#   tmux-dev open <project|worktree> <클라이언트> <패널> <디렉토리>
#     예: run-shell -b "tmux-dev open project '#{client_name}' '#{pane_id}' #{q:pane_current_path}"
#
# 왜 이 런처를 거치나 (tmux 3.8 에서 시험으로 확인)
#   - 키를 누른 클라이언트를 알 길이 run-shell 의 #{client_name} 뿐이다. new-pane 은 -e 값과 명령 문자열의 #{} 를
#     펼치지 않고, 뒤에 이어 붙인 set -pF 는 피커가 읽을 때 아직 비어 있었다. 피커는 이 이름(TMUX_DEV_CLIENT)으로
#     그 클라이언트만 전환한다. 패널 안에서 -c 없이 부른 switch-client 는 "가장 최근에 쓴 클라이언트" 를 옮긴다.
#     (worktree 는 세션 안에서 창만 고르므로 클라이언트를 옮기지 않지만, 오류 메시지를 그 클라이언트에 띄운다)
#   - floating pane 의 기본 위치는 왼쪽 위 계단식이고 -X/-Y 는 정수 % 만 받는다. 가운데 자리를 여기서 칸으로 계산한다.
#   - 크기·스타일 옵션을 키를 누를 때 읽는다. tmux.conf 를 다시 읽지 않아도 prefix : 에서 바꾼 값이 바로 먹는다.
#
# new-pane 플래그
#   -O  modal: 피커가 포커스를 붙잡고 다른 패널은 못 만진다 (팝업과 같다). 창마다 하나뿐이다.
#   -K  prefix 까지 모든 키를 피커로 (팝업과 같다). 피커 안에서 prefix S·W 를 다시 눌러도 겹쳐 뜨지 않는다.
#   -B none  테두리는 fzf 가 그린다. 모드 탭·겹쳐 뜨는 목록 제목·입력/목록 구획이 한 주인 안에서 바뀐다 (session-picker.md 화면 절).
#   -D 는 쓰지 않는다: Esc 를 tmux 가 가로채 닫으면 W 의 "확인 중 Esc = 취소" 와 겹친 목록의 "Esc = 돌아가기" 가
#   깨진다. Esc 는 fzf 가 받아 닫거나(abort) 한 단계 물리고, fzf 가 끝나면 패널도 닫힌다.
#   zoom 상태에서도 modal 은 위에 뜬다 (-A 는 modal 의 기본).
#
# 옵션 (없으면 기본값)
#   @tmux-dev-popup-size  85%,75%  너비,높이 (% 또는 칸). 이름은 팝업 시절 그대로 둔다 (설정을 바꾸지 않아도 되게)
#   @tmux-dev-layout      plain    새 세션·윈도우의 레이아웃 (TMUX_DEV_LAYOUT 로 넘긴다)
#   @float-style          배경·글자 스타일 (tmux.conf). 없으면 popup-style
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)

[ $# -eq 4 ] || { echo "usage: tmux-dev open <project|worktree> <client> <pane> <dir>" >&2; exit 1; }
cmd=$1 client=$2 pane=$3 dir=$4
case $cmd in project|worktree) ;; *) echo "tmux-dev open: unknown subcommand '$cmd' (project, worktree)" >&2; exit 1 ;; esac

opt() { local v; v=$(tmux show-option -gqv "$1"); printf '%s' "${v:-$2}"; }
# 크기를 칸으로: $1 크기(N% 또는 칸) $2 창 크기(칸). 창보다 크면 창 크기. 가운데 자리도 칸으로 계산한다
# (% 로 넘기면 크기와 위치가 따로 버림돼 한 칸씩 어긋난다).
cells() { local n; case $1 in *%) n=$(( $2 * ${1%\%} / 100 )) ;; *) n=$1 ;; esac; [ "$n" -gt "$2" ] && n=$2; printf '%d' "$n"; }

size=$(opt @tmux-dev-popup-size '85%,75%')
read -r ww wh < <(tmux display-message -p -t "$pane" '#{window_width} #{window_height}')
w=$(cells "${size%,*}" "$ww") h=$(cells "${size#*,}" "$wh")
style=$(opt @float-style "$(tmux show-option -gqv popup-style)")

args=(-O -K -B none -t "$pane" -c "$dir" -x "$w" -y "$h" -X $(( (ww - w) / 2 )) -Y $(( (wh - h) / 2 )))
[ -n "$style" ] && args+=(-s "$style")
args+=(-e "TMUX_DEV_CLIENT=$client" -e "TMUX_DEV_LAYOUT=$(opt @tmux-dev-layout plain)")

# 실패(예: 이미 modal 이 떠 있다)는 그 클라이언트의 상태줄에. run-shell 출력으로 두면 패널을 보기 모드로 덮는다.
if ! out=$(tmux new-pane "${args[@]}" "$ROOT/bin/tmux-dev" "$cmd" 2>&1); then
  tmux display-message -c "$client" -d 5000 "tmux-dev: $out"
fi
