#!/bin/sh
# 패널의 포그라운드 프로그램이 listen 중인 TCP 포트를 " :3000 :9229" 처럼 출력한다. 없으면 아무것도 출력하지 않는다.
# tmux.conf 의 pane-border-format(@pane_ports) 이 #() 로 부른다 (패널 테두리의 포트 표시). 설계 설명은 그 절에 있다.
#
# 사용: pane-ports <패널 tty> [패널 셸 PID] [on]     예: pane-ports /dev/ttys003 12345 on
#       tmux 에서는 #{pane_tty} #{pane_pid} #{@pane_ports_link}.
#       세 번째 인자가 on 이면 포트마다 http://localhost:포트 로 가는 링크 스타일을 씌운다:
#         " #[link=http://localhost:3000]:3000#[nolink]"
#       link= 스타일은 tmux 3.8 에서 생겼으므로 tmux.conf 가 3.8 이상에서만 on 을 넘긴다 (그 절의 "링크" 설명).
#
# 방법: 1) ps -t 로 그 tty 의 프로세스를 읽고 STAT 에 + 가 있는 것(포그라운드 프로세스 그룹)만 고른다. 셸은 빠진다.
#       2) ps -A 한 번으로 PID·부모 PID 를 읽어 1) 의 자손을 모두 더한다. 자식이 다른 프로세스 그룹·세션·tty 에
#          있어도 잡기 위해서다. turbo 는 TUI·stream 어느 쪽이든 태스크마다 PTY 를 따로 열어 띄워서(turbo 2.11 실측)
#          1) 만으로는 dev 서버가 하나도 안 잡혔다. 부모가 끝나 init(launchd) 으로 넘어간 프로세스는 자손으로 못 찾는다.
#       3) 그 PID 들만 lsof 에 넘겨 LISTEN 상태의 TCP 소켓을 본다. 나가는 연결(ESTABLISHED)은 나오지 않는다.
#          -a 가 없으면 lsof 가 조건을 OR 로 묶어 시스템 전체의 LISTEN 포트가 나온다.
#          -nP 는 주소·포트를 이름으로 바꾸지 않는다(DNS 조회 없음). -b 는 응답 없는 네트워크 마운트 등에서
#          커널 호출에 붙잡히지 않게 한다 (그때 내는 경고는 버린다).
#       포그라운드가 패널의 셸 자신뿐이면(프롬프트에서 기다리는 중) lsof 를 부르지 않고 끝낸다. 대부분의 패널이 이 상태다.
#       이 판별을 tmux 쪽(pane_current_command 가 셸 이름인지)에서 하지 않는 이유: ./dev.sh 처럼 셸 스크립트로 띄운 서버도
#       pane_current_command 가 bash 로 보여(Linux 실측) 포트가 숨는다.
#       IPv4·IPv6 로 같은 포트를 열면 하나로 합친다.
# 안 잡히는 것: UDP, 데몬화로 부모를 끊고 떨어져 나간 프로세스(docker compose 의 컨테이너 포함), 다른 사용자(sudo)로 도는
#       프로세스의 소켓.
# 비용: Linux 에서 lsof 까지 한 번에 15ms 남짓(실측). -p 로 대상을 좁혀 시스템 전체를 훑지 않는다.
#       셸만 떠 있는 패널은 ps 한 번으로 끝난다. 무언가 돌고 있으면 ps -A 가 한 번 더 든다 (macOS 에서 40ms 남짓).

tty=${1#/dev/}
shell_pid=$2
link=$3
[ -n "$tty" ] || exit 0

pids=$(ps -t "$tty" -o pid=,stat= 2>/dev/null | awk '$2 ~ /\+/ { printf "%s%s", sep, $1; sep = "," }')
[ -n "$pids" ] || exit 0
[ "$pids" = "$shell_pid" ] && exit 0

# 자손 더하기: 부모 → 자식 목록을 만든 뒤 포그라운드 PID 들에서 시작해 너비 우선으로 내려간다.
pids=$(ps -A -o pid=,ppid= 2>/dev/null | awk -v roots="$pids" '
  { kids[$2] = kids[$2] " " $1 }
  END {
    n = split(roots, q, ","); out = roots
    for (i = 1; i <= n; i++) {
      m = split(kids[q[i]], c, " ")
      for (j = 1; j <= m; j++) if (!(c[j] in seen)) { seen[c[j]] = 1; q[++n] = c[j]; out = out "," c[j] }
    }
    print out
  }')

lsof -nPb -a -p "$pids" -iTCP -sTCP:LISTEN -Fn 2>/dev/null \
  | sed -n 's/^n.*:\([0-9][0-9]*\)$/\1/p' | sort -un \
  | awk -v link="$link" '{
      if (link == "on") printf " #[link=http://localhost:%s]:%s#[nolink]", $1, $1
      else              printf " :%s", $1
    }'
