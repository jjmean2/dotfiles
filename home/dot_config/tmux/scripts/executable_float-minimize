#!/bin/sh
# prefix _: floating pane 을 "최소화" 하거나 되돌린다. tmux.conf 의 bind-key _ 가 run-shell 로 부른다.
#
# 사용: float-minimize <pane_id>
#
# tmux 에는 패널을 숨기는 명령이 없다 (3.8). 그래서 패널을 그대로 두고 크기와 위치만 바꾼다:
#   - 최소화: 지금 크기·위치를 패널 옵션(@fm_*)에 적고, 내용 한 줄짜리 막대로 줄여 윈도우 오른쪽 위에 붙인 뒤,
#             포커스를 다른 패널로 넘긴다. 테두리 제목(pane-border-status)이 막대에 남아 무엇인지 보인다.
#   - 복원:   적어 둔 크기·위치로 되돌리고 그 패널을 고른다.
# 패널·프로세스·pane id 는 그대로라 break-pane 처럼 "어디로 갔는지" 를 따로 추적할 필요가 없다.
#
# 대상에 따라:
#   최소화된 floating pane  → 복원
#   보통 floating pane      → 최소화 (modal 은 늘 active 라 포커스를 넘길 수 없어 거절)
#   타일 패널               → 이 윈도우에서 가장 최근에 최소화한 패널을 복원 (최소화 뒤 포커스가 타일로 넘어오므로
#                             같은 키를 한 번 더 누르면 되돌아온다)
#
# 크기·위치 숫자의 기준:
#   resize-pane -x/-y, move-pane -X/-Y 는 테두리를 포함한 바깥 크기·바깥 왼쪽 위 모서리를 받는데,
#   #{pane_width}/#{pane_left} 는 테두리 안쪽 값이다. 테두리 두께는 -B(선 종류)에 따라 0 이나 1 이라
#   짐작하지 않고, 최소화하면서 실제로 옮기고 줄인 결과를 읽어 차이를 잰다.
# 여러 개를 최소화하면: 오른쪽 위에서 아래로 칸(@fm_slot)을 채우고, 높이가 모자라면 왼쪽 열로 넘어간다.
# 복원할 때 윈도우가 그새 작아졌으면 크기와 위치를 윈도우 안으로 줄여 맞춘다 (밖이면 tmux 가 거절하므로).

pane=$1
[ -n "$pane" ] || exit 1
msg_ms=2000

BAR_W=30   # 막대의 바깥 폭 (원래 폭이 더 좁으면 그것)
BAR_H=3    # 막대의 바깥 높이: 테두리 위아래 + 내용 한 줄

t() { tmux "$@"; }
msg() { t display-message -d "$msg_ms" "$1"; }

# 패널 하나의 값들을 한 줄로 읽는다
info=$(t display-message -p -t "$pane" \
  '#{window_id} #{pane_floating_flag} #{pane_modal_flag} #{window_width} #{window_height} #{?#{@fm_w},1,0}') || exit 1
set -- $info
win=$1 floating=$2 modal=$3 ww=$4 wh=$5 minimized=$6

restore() {
  p=$1
  set -- $(t display-message -p -t "$p" '#{@fm_x} #{@fm_y} #{@fm_w} #{@fm_h}')
  x=$1 y=$2 w=$3 h=$4
  [ "$w" -gt "$ww" ] && w=$ww
  [ "$h" -gt "$wh" ] && h=$wh
  [ $((x + w)) -gt "$ww" ] && x=$((ww - w))
  [ $((y + h)) -gt "$wh" ] && y=$((wh - h))
  [ "$x" -lt 0 ] && x=0
  [ "$y" -lt 0 ] && y=0
  # 줄인 채 옮기면 넓어진 쪽이 윈도우 밖으로 나갈 수 있어 순서를 가린다: 먼저 목표 위치로 옮기고(막대는 작아 들어간다)
  # 그다음 키운다. 키울 때는 왼쪽 위 모서리가 고정된다.
  t move-pane -t "$p" -X "$x" -Y "$y" \; resize-pane -t "$p" -x "$w" -y "$h" \
    \; move-pane -t "$p" -P front \; select-pane -t "$p" || return 1
  for o in @fm_x @fm_y @fm_w @fm_h @fm_slot @fm_seq; do t set -pu -t "$p" "$o"; done
}

minimize() {
  p=$1
  set -- $(t display-message -p -t "$p" '#{pane_left} #{pane_top} #{pane_width} #{pane_height}')
  il=$1 it=$2 iw=$3 ih=$4

  # 비어 있는 가장 앞 칸을 찾는다
  used=$(t list-panes -t "$win" -F '#{@fm_slot}' | grep -v '^$')
  slot=0
  while printf '%s\n' "$used" | grep -qx "$slot"; do slot=$((slot + 1)); done
  rows=$((wh / BAR_H)); [ "$rows" -lt 1 ] && rows=1
  col=$((slot / rows)) row=$((slot % rows))

  bw=$BAR_W
  # 바깥 폭은 안쪽 폭 + 좌우 테두리라 원래 폭을 넘지 않게: 안쪽 폭 + 2 를 상한으로 (테두리가 없어도 손해는 2칸뿐)
  [ $((iw + 2)) -lt "$bw" ] && bw=$((iw + 2))
  bx=$((ww - bw * (col + 1))); [ "$bx" -lt 0 ] && bx=0
  by=$((row * BAR_H))

  # 줄이고 옮긴 뒤 실제 안쪽 값을 읽어 테두리 두께를 잰다
  t resize-pane -t "$p" -x "$bw" -y "$BAR_H" \; move-pane -t "$p" -X "$bx" -Y "$by" || return 1
  set -- $(t display-message -p -t "$p" '#{pane_left} #{pane_top} #{pane_width} #{pane_height}')
  bl=$((bw - $3)) bt=$((BAR_H - $4))      # 좌우·위아래 테두리 합
  ol=$(($1 - bx)) ot=$(($2 - by))         # 왼쪽·위 테두리

  seq=$(t show -wqv -t "$win" @fm_seq_next); seq=${seq:-0}
  t set -p -t "$p" @fm_x $((il - ol)) \; set -p -t "$p" @fm_y $((it - ot)) \
    \; set -p -t "$p" @fm_w $((iw + bl)) \; set -p -t "$p" @fm_h $((ih + bt)) \
    \; set -p -t "$p" @fm_slot "$slot" \; set -p -t "$p" @fm_seq "$seq" \
    \; set -w -t "$win" @fm_seq_next $((seq + 1)) \; move-pane -t "$p" -P front

  # 포커스: 직전 패널이 최소화되지 않은 패널이면 그리로, 아니면 최소화되지 않은 첫 패널(타일 우선)로
  target=$(t list-panes -t "$win" -F '#{pane_last} #{pane_id} #{?#{@fm_w},1,0} #{pane_floating_flag}' |
    awk -v me="$p" '$2 != me && $3 == 0 { if ($1 == 1) { print $2; found=1; exit } if (!first && $4 == 0) first=$2; if (!any) any=$2 }
                    END { if (!found) print (first ? first : any) }' | head -1)
  [ -n "$target" ] && t select-pane -t "$target"
}

if [ "$floating" = 1 ] && [ "$minimized" = 1 ]; then
  restore "$pane"
elif [ "$floating" = 1 ]; then
  if [ "$modal" = 1 ]; then
    msg "float-minimize: a modal pane cannot be minimized"
  else
    minimize "$pane"
  fi
else
  last=$(t list-panes -t "$win" -F '#{@fm_seq} #{pane_id}' | awk '$1 != "" && NF == 2' | sort -n | tail -1 | cut -d' ' -f2)
  if [ -n "$last" ]; then
    restore "$last"
  else
    msg "float-minimize: no minimized pane in this window"
  fi
fi
