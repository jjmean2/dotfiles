# =============================================================================
# Ghostty 설정
# 위치: ~/.config/ghostty/config
#
# 유용한 명령어
#   ghostty +show-config --default --docs   # 전체 옵션과 설명 보기
#   ghostty +validate-config                # 설정 문법/옵션명 검사
#   ghostty +edit-config                    # 설정 파일 편집
#   ghostty +list-fonts                     # 사용 가능한 폰트 이름 확인
#   ghostty +list-themes                    # 내장 테마 목록 미리보기
#   ghostty +list-keybinds --default        # 기본 키바인딩 목록
#
# 설정 리로드: cmd+shift+, (macOS 기본 단축키, reload_config)
# 일부 옵션(폰트 등)은 새 창/탭부터 적용될 수 있음
# =============================================================================


# -----------------------------------------------------------------------------
# 폰트
# -----------------------------------------------------------------------------

#font-family = "Cascadia Code Light"
font-family = "Fira Code Light"

# 폰트 크기 (기본값: macOS 13)
font-size = 11

# 패밀리 이름 + 스타일을 분리해서 지정하는 방식
# "Fira Code Light"가 별도 패밀리로 설치돼 있지 않으면 아래 방식이 확실함
#font-family = "Fira Code"
#font-style = Light

# 리거처(=>, != 등의 합자) 끄기
#font-feature = -calt
#font-feature = -liga

# 줄 간격 조정 (퍼센트 또는 픽셀 단위)
#adjust-cell-height = 10%

# 한글 등 특정 글리프를 다른 폰트로 대체 (font-family 를 여러 번 쓰면 fallback 순서가 됨)
#font-family = "D2Coding"

# macOS에서 폰트를 약간 더 굵게 렌더링 (Retina에서 얇게 보일 때)
#font-thicken = true


# -----------------------------------------------------------------------------
# 테마 / 외관
# -----------------------------------------------------------------------------

# 테마 지정. 이름은 `ghostty +list-themes`로 확인 (버전에 따라 표기가 다를 수 있음)
# 시스템 라이트/다크 모드에 따라 자동 전환하려면 light:/dark: 문법 사용
#theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# 배경 투명도 (0.0 ~ 1.0). 1 미만이면 투명
#background-opacity = 0.95

# 투명 배경 뒤를 블러 처리 (macOS). true 또는 반경 숫자
#background-blur = 20

# 창 내부 여백 (픽셀)
#window-padding-x = 8
#window-padding-y = 6

# 여백 영역을 터미널 배경색으로 채움 (extend: 가장자리 셀 색을 확장)
#window-padding-color = extend

# 분할 창에서 포커스 없는 창을 흐리게 (0.0 ~ 1.0)
#unfocused-split-opacity = 0.85


# -----------------------------------------------------------------------------
# 창 / 타이틀바 (macOS)
# -----------------------------------------------------------------------------

# 타이틀바 스타일: native | transparent | tabs | hidden
#   tabs: 탭을 타이틀바에 통합 (Safari 스타일)
#   hidden: 타이틀바 완전 숨김 (창 이동은 cmd+드래그 등으로)
#macos-titlebar-style = tabs

# 새 창 크기 (셀 단위)
#window-width = 140
#window-height = 40

# 앱 재실행 시 창/탭/분할 상태 복원: default | never | always
#window-save-state = always

# 새 탭/창/분할이 현재 작업 디렉터리를 이어받음 (기본 true)
#window-inherit-working-directory = true

# 마지막 창을 닫으면 앱 종료 (macOS 기본은 false)
#quit-after-last-window-closed = true

# 실행 중인 프로세스가 있을 때 닫기 확인: true | false | always
#confirm-close-surface = false


# -----------------------------------------------------------------------------
# 키보드
# -----------------------------------------------------------------------------

# 왼쪽 Option 키를 Alt(Meta)로 사용
# → 셸에서 alt+b / alt+f 단어 이동, tmux/vim의 Meta 바인딩 등이 동작
# 오른쪽 Option은 macOS 기본 동작(특수문자 입력) 유지
macos-option-as-alt = left

# ctrl+[ 를 ESC로 동작하도록 설정
# Ghostty는 Kitty Keyboard Protocol(KKP)을 지원해서, 이를 활성화한 프로그램에는
# ctrl+[ 가 ESC(\x1b) 대신 CSI 91 ; 5 u 로 전달됨
# 강제로 ESC 바이트를 보내도록 재정의
# 참고: https://github.com/ghostty-org/ghostty/discussions/5071#discussioncomment-11857652
keybind = ctrl+left_bracket=text:\x1b

# --- 많이 쓰는 키바인딩 예시 ---

# shift+enter 로 줄바꿈 입력 (Claude Code 등 CLI 에이전트에서 멀티라인 입력)
#keybind = shift+enter=text:\x1b\r

# 분할 창 만들기 / 이동 (기본값은 cmd+d, cmd+shift+d, cmd+[ / cmd+])
#keybind = cmd+d=new_split:right
#keybind = cmd+shift+d=new_split:down
#keybind = cmd+alt+left=goto_split:left
#keybind = cmd+alt+right=goto_split:right
#keybind = cmd+alt+up=goto_split:up
#keybind = cmd+alt+down=goto_split:down

# 현재 분할 창 확대/복귀 토글
#keybind = cmd+shift+enter=toggle_split_zoom

# 시스템 설정을 다시 읽기
#keybind = cmd+shift+r=reload_config

# 프롬프트 단위로 스크롤 이동 (셸 통합 필요)
#keybind = cmd+up=jump_to_prompt:-1
#keybind = cmd+down=jump_to_prompt:1


# -----------------------------------------------------------------------------
# Quick Terminal (드롭다운 터미널)
# -----------------------------------------------------------------------------

# 포커스를 잃으면 자동으로 숨김
quick-terminal-autohide = true

# 화면 대비 크기
quick-terminal-size = 50%

# 나타나는 위치: top | bottom | left | right | center
#quick-terminal-position = top

# 어느 모니터에 띄울지: main | mouse | macos-menu-bar
#quick-terminal-screen = mouse

# 애니메이션 시간 (초). 0이면 즉시
#quick-terminal-animation-duration = 0.15


# -----------------------------------------------------------------------------
# 전역 단축키
# global: 접두사 = Ghostty가 포커스가 없어도 동작
# macOS에서는 시스템 설정 > 개인정보 보호 및 보안 > 손쉬운 사용 권한이 필요
# -----------------------------------------------------------------------------

# Quick Terminal 토글
keybind = global:ctrl+alt+9=toggle_quick_terminal

# Ghostty 전체 창 표시/숨김 토글
keybind = global:ctrl+alt+0=toggle_visibility


# -----------------------------------------------------------------------------
# 커서
# -----------------------------------------------------------------------------

# 커서 모양: block | bar | underline | block_hollow
#cursor-style = bar

# 커서 깜빡임
#cursor-style-blink = false

# 참고: 셸 통합이 켜져 있으면 프롬프트에서 커서가 bar로 바뀜.
# cursor-style 을 고정하고 싶으면 shell-integration-features 에 no-cursor 추가


# -----------------------------------------------------------------------------
# 마우스 / 클립보드
# -----------------------------------------------------------------------------

# 드래그로 선택하면 자동 복사: true(선택 버퍼) | clipboard(시스템 클립보드) | false
#copy-on-select = clipboard

# 입력 중 마우스 커서 숨기기
#mouse-hide-while-typing = true

# 스크롤 속도 배율
#mouse-scroll-multiplier = 2

# 프로그램이 OSC 52로 클립보드 읽기/쓰기 요청할 때: allow | deny | ask
# (원격 tmux/neovim에서 로컬 클립보드로 복사할 때 쓰기 허용이 필요)
#clipboard-read = ask
#clipboard-write = allow

# 여러 줄 붙여넣기 시 확인 창 끄기
#clipboard-paste-protection = false


# -----------------------------------------------------------------------------
# 셸 통합
# -----------------------------------------------------------------------------

# 셸 자동 감지 후 통합 스크립트 주입 (기본 detect)
#shell-integration = detect

# 통합 기능 목록 (쉼표 구분, no- 접두사로 끄기)
#   cursor       : 프롬프트에서 bar 커서
#   sudo         : sudo 실행 시 terminfo 유지
#   title        : 실행 중인 명령/경로를 탭 제목으로
#   ssh-terminfo : ssh 접속 시 원격에 xterm-ghostty terminfo 자동 설치
#   ssh-env      : ssh 접속 시 TERM 등 환경변수 호환 처리
# ssh-* 는 원격 서버에서 "unknown terminal type" 에러가 날 때 유용 (최신 버전 필요)
#shell-integration-features = sudo,title,ssh-terminfo,ssh-env


# -----------------------------------------------------------------------------
# 기타
# -----------------------------------------------------------------------------

# 스크롤백 버퍼 크기 (바이트 단위, 줄 수 아님)
#scrollback-limit = 100000000

# 자동 업데이트: off | check | download
#auto-update = check

# 실행할 셸/명령 지정 (기본: 로그인 셸)
#command = /opt/homebrew/bin/fish

# 설정을 여러 파일로 나눠 관리 (? 접두사: 파일이 없어도 에러 안 냄)
#config-file = ?local.config
