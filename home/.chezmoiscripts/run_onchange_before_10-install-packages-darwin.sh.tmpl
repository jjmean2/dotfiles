{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# macOS 개발 환경에 필요한 기본 도구를 설치한다.
# Homebrew(.chezmoidata/packages.yaml 의 brews 와 casks)와 mise 본체를 설치하며
# 이미 설치되어 있으면 건너뛰므로 여러 번 실행해도 안전하다(멱등).
# run_onchange_ 스크립트라서 packages.yaml 의 목록이 바뀌어 이 스크립트 내용이 바뀔 때만 다시 실행된다.

# brew 명령의 canonical 경로는 Apple Silicon과 Intel Mac에서 다르므로, PATH가
# 아직 안 잡혀 있어 command -v로 못 찾는 경우까지 대비해 두 경로를 직접 확인한다.
ensure_brew() {
	if command -v brew &>/dev/null; then
		return 0
	elif [ -x /opt/homebrew/bin/brew ]; then
		eval "$(/opt/homebrew/bin/brew shellenv)"
	elif [ -x /usr/local/bin/brew ]; then
		eval "$(/usr/local/bin/brew shellenv)"
	else
		return 1
	fi
}

if ! ensure_brew; then
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	ensure_brew || {
		echo "brew 설치에 실패했습니다." >&2
		exit 1
	}
fi

# 메타데이터 최신화. formula 설치 스크립트가 바뀔 수도 있으므로 brew bundle 전에 명시적으로 한번 수행한다.
brew update
# 설치 안 되어 있는 것만 설치하고, 이미 설치된 formula의 버전 업그레이드는 하지 않는다.
HOMEBREW_NO_AUTO_UPDATE=1 brew bundle --file=/dev/stdin --no-upgrade <<'EOF'
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
{{- /* 이 머신에서 켠 기능(features.<이름>)의 묶음만 넣는다. 스위치가 없으면(init 전 config) 끈 것으로 본다.
       스위치를 바꾸면 이 렌더링 결과가 달라져 run_onchange 가 다시 돈다. 끈 기능은 지우지 않는다. */ -}}
{{ range $name, $group := .packages.darwin.features -}}
{{ if dig "features" $name false $ -}}
{{ range (dig "brews" list $group) -}}
brew {{ . | quote }}
{{ end -}}
{{ range (dig "casks" list $group) -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{ end -}}
EOF

if ! command -v mise &>/dev/null; then
	echo "mise 명령을 찾을 수 없습니다. brew bundle 이 정상적으로 끝났는지 확인해 주세요." >&2
	exit 1
fi

eval "$(mise activate bash)"

# 언어 런타임 설치는 여기서 하지 않는다. 이 스크립트는 run_onchange_before_ 라 dotfiles 가
# 깔리기 전에 돌기 때문에 ~/.config/mise/conf.d/shared.toml 이 아직 없을 수 있다.
# run_onchange_after_20-install-mise-tools 가 파일 적용 뒤에 mise install 을 실행한다.

echo "macOS 기본 도구 설치 완료"
{{ end -}}
