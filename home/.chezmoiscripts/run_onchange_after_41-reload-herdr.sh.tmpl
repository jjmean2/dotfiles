{{ if has "herdr" (includeTemplate "enabled-features" . | fromJson) -}}
#!/usr/bin/env bash
set -euo pipefail

# Herdr 설정이 바뀌면 살아 있는 Herdr 서버에 다시 읽힌다 (40-reload-tmux 와 같은 역할).
# features.herdr 가 켜진 머신에서만 돈다 (꺼지면 이 템플릿이 빈 파일이 되어 chezmoi 가 실행하지 않는다).
#
# run_onchange_ 라서 내용이 바뀔 때만 실행된다. 배포되는 config.toml 은 관리 기본값과 머신 로컬 파일을 합친
# 결과이므로 그 결과 전체의 해시를 박아 둔다. 그래서 로컬 파일만 고친 뒤 chezmoi apply 해도 다시 읽힌다.
# config hash: {{ includeTemplate "dot_config/herdr/config.toml.tmpl" . | sha256sum }}

command -v herdr >/dev/null 2>&1 || exit 0
# reload-config 는 기본 세션의 서버에 보낸다. 서버가 없으면 실패하는데, 다음에 시작할 때 새 설정을 읽으므로
# 할 일이 없다. 다시 읽기만으로 안 바뀌는 설정(세션 복원 등)은 서버를 다시 시작해야 한다 (docs/herdr.md).
if herdr server reload-config >/dev/null 2>&1; then
  echo "herdr: 서버에 config.toml 을 다시 읽혔다"
else
  echo "herdr: 실행 중인 서버가 없거나 다시 읽기에 실패해 건너뜀 (확인: herdr server reload-config)"
fi
{{ end -}}
