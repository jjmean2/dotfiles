{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# tmux 패널 안에서 쓰는 TERM(tmux-256color)의 terminfo 를 ~/.terminfo 에 설치한다.
#
# 왜: macOS 가 /usr/share/terminfo 에 넣어 둔 tmux-256color 는 ncurses 5.7 시절 것이라
#     kf13 이후(Shift/Ctrl + F키) 항목이 없다. 그래서 tmux 안의 htop 이 Shift+F3 를
#     인식하지 못한다. ~/.config/tmux/tmux-256color.terminfo 는 ncurses 6.6 의 공식 항목을
#     infocmp 로 그대로 뽑은 것(수정 없음)이며, 이것을 같은 이름으로 ~/.terminfo 에
#     컴파일해 두면 ncurses 가 시스템 경로보다 먼저 찾는다. 이 사용자에게만 적용되고
#     시스템 파일은 건드리지 않는다. Linux 배포판의 항목은 이미 완전해서 macOS 에서만 돈다.
#
# run_onchange_ 스크립트라서 내용이 바뀔 때만 다시 실행된다. terminfo 소스가 바뀌면
# 아래 해시가 바뀌어 함께 다시 실행되도록 소스 파일의 해시를 박아 둔다.
# source hash: {{ include "dot_config/tmux/tmux-256color.terminfo" | sha256sum }}

src="$HOME/.config/tmux/tmux-256color.terminfo"

# macOS 기본 tic(ncurses 5.7)으로도 컴파일된다. -x 는 표준 밖의 확장 항목(Smulx 등)도 받아들이고,
# -o 는 결과를 쓸 terminfo 디렉토리다 (~/.terminfo/74/tmux-256color 가 만들어진다).
/usr/bin/tic -x -o "$HOME/.terminfo" "$src"

echo "terminfo 설치 완료: $HOME/.terminfo/74/tmux-256color"
{{ end -}}
