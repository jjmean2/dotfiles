{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
# shellcheck shell=sh
set -eu

# Linux(dev container, 서버)에 필수 도구를 설치한다. 목록은 .chezmoidata/packages.yaml 의 packages.linux 와
# 이 머신에서 켜진 기능(packages.features)의 linux 묶음이다. 설계는 docs/machines.md.
#
#   tools  미리 빌드된 바이너리를 mise 로 ~/.local/opt/<이름> 에 받고 ~/.local/bin/<이름> 으로 링크한다.
#          sudo 가 필요 없고, 배포판과 상관없이 같은 최신 버전이다. 시스템에 같은 도구가 있어도 받는다
#          (~/.local/bin 이 PATH 앞이라 받은 것이 쓰인다). ~/.local/bin 에 이미 있으면 건너뛴다.
#   pkgs   받을 바이너리가 없는 것만 패키지 매니저(apt, apk, dnf, pacman)로 깐다. root 이거나 sudo 를 쓸 수
#          있을 때만 하고, 못 깔면 알리고 넘어간다.
#
# 받은 바이너리가 이 시스템에서 실행되지 않으면(Alpine 의 musl, 오래된 glibc) 지우고, 시스템에 그 도구가 없을 때만
# 그 도구의 pkg 이름을 패키지 매니저로 넘긴다.
#
# 끝나는 코드: mise 로 받기에 실패한 도구(네트워크 등)가 있을 때만 실패로 끝난다. chezmoi 는 실패한 스크립트를
# 다음 apply 때 다시 돌리고, 이미 받은 도구는 건너뛴다. 그 밖의 문제(sudo 없음, 배포판에 없는 패키지 이름)는
# 알리기만 한다.
#
# run_onchange_after_ 인 이유: 설정 파일이 먼저 깔리게 한다 (macOS 의 설치 스크립트는 before 다). 도구가 없어도
# 설정 파일은 쓸 수 있으므로, 도구를 받다가 실패해도 설정까지 막지 않는다. 번호 10 이라 mise 를 쓰는
# 20-install-mise-tools 보다 먼저 돈다. run_onchange_ 라서 목록이 바뀌어 이 스크립트 내용이 달라질 때만 다시 실행된다.
# sh 로 쓴 이유: Alpine 처럼 bash 가 없는 이미지에서도 돌아야 한다 (bash 는 아래 pkgs 로 깐다).
#
# 받아 둔 도구를 새 버전으로 바꾸려면 ~/.local/bin/<이름> 을 지우고 이 스크립트를 다시 돌린다:
#   chezmoi state delete-bucket --bucket=entryState && chezmoi apply
# (run_onchange 스크립트 전부가 다시 돈다. 이 스크립트는 ~/.local/bin 에 없는 도구만 다시 받는다.)

BIN="$HOME/.local/bin"
OPT="$HOME/.local/opt"
PATH="$BIN:$PATH"
export MISE_YES=1
{{- /* 필수 목록에 이 머신에서 켜진 기능의 linux 묶음을 더한다 (darwin 스크립트와 같은 규칙). */}}
{{- $tools := .packages.linux.tools }}
{{- $pkgs := .packages.linux.pkgs }}
{{- $on := includeTemplate "enabled-features" . | fromJson }}
{{- range $name, $def := .packages.features }}
{{-   if has $name $on }}
{{-     $tools = concat $tools (dig "linux" "tools" list $def) }}
{{-     $pkgs = concat $pkgs (dig "linux" "pkgs" list $def) }}
{{-   end }}
{{- end }}

# 한 줄에 "실행 파일 이름, mise 도구 이름, 대체 패키지 이름"
tools='
{{- range $tools }}
{{ .bin }} {{ dig "mise" .bin . }} {{ dig "pkg" .bin . }}
{{- end }}
'
pkgs='{{ $pkgs | join " " }}'

log() { printf '[linux-tools] %s\n' "$*" >&2; }
has() { command -v "$1" >/dev/null 2>&1; }

# 이 시스템에서 실행되는 바이너리인가. 버전을 물어 0 으로 끝나면 된다 (tmux 는 -V 만 안다).
runs() { "$1" --version >/dev/null 2>&1 || "$1" -V >/dev/null 2>&1; }

# root 권한으로 실행할 수 있는가. sudo 는 비밀번호 없이 되거나, 터미널이 있어 물을 수 있을 때만 쓴다.
can_root() {
	[ "$(id -u)" -eq 0 ] && return 0
	has sudo || return 1
	sudo -n true 2>/dev/null || { [ -t 0 ] && sudo -v; }
}
as_root() {
	if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

# ---- mise 본체 ----
if ! has mise; then
	has curl || {
		log "curl 이 필요하다 (mise 를 받는 데 쓴다). curl 을 깐 뒤 chezmoi apply 를 다시 실행할 것"
		exit 1
	}
	log "mise 를 $BIN 에 받는다"
	curl -fsSL https://mise.run | sh >/dev/null 2>&1 || true
	has mise || {
		log "mise 를 받지 못했다 (curl -fsSL https://mise.run | sh 를 직접 실행해 원인을 확인할 것)"
		exit 1
	}
fi

# ---- tools: mise 로 받는다 ----
mkdir -p "$BIN" "$OPT"
out="$(mktemp)"
trap 'rm -f "$out"' EXIT
failed=""   # 받기에 실패한 도구. 있으면 실패로 끝내 다음 apply 가 다시 시도하게 한다
fallback="" # 받은 바이너리가 실행되지 않아 패키지 매니저로 넘길 패키지
while read -r bin spec pkg; do
	[ -n "$bin" ] || continue
	[ -x "$BIN/$bin" ] && continue
	dir="$OPT/$bin"
	rm -rf "$dir"
	if ! mise install-into "$spec@latest" "$dir" >"$out" 2>&1; then
		log "$bin: $spec 을 받지 못했다: $(grep -v '^[[:space:]]*$' "$out" | tail -n 1)"
		rm -rf "$dir"
		failed="$failed $bin"
		continue
	fi
	exe="$(find -L "$dir" -type f -name "$bin" -perm -u+x | head -n 1)"
	if [ -n "$exe" ] && runs "$exe"; then
		ln -sf "$exe" "$BIN/$bin"
		log "$bin: $spec → $BIN/$bin"
	else
		rm -rf "$dir"
		if has "$bin"; then
			log "$bin: 받은 바이너리가 이 시스템에서 실행되지 않는다. 시스템의 $(command -v "$bin") 을 쓴다"
		else
			log "$bin: 받은 바이너리가 이 시스템에서 실행되지 않는다. 패키지 매니저의 $pkg 로 넘긴다"
			fallback="$fallback $pkg"
		fi
	fi
done <<EOF
$tools
EOF

# ---- pkgs: 패키지 매니저로 깐다 ----
if has apt-get; then
	manager=apt
elif has apk; then
	manager=apk
elif has dnf; then
	manager=dnf
elif has pacman; then
	manager=pacman
else
	manager=""
fi

installed() {
	case "$manager" in
	apt) dpkg -s "$1" >/dev/null 2>&1 ;;
	apk) apk info -e "$1" >/dev/null 2>&1 ;;
	dnf) rpm -q "$1" >/dev/null 2>&1 ;;
	pacman) pacman -Qi "$1" >/dev/null 2>&1 ;;
	esac
}
install_pkg() {
	case "$manager" in
	apt) as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y "$1" ;;
	apk) as_root apk add --no-cache "$1" ;;
	dnf) as_root dnf install -y "$1" ;;
	pacman) as_root pacman -S --noconfirm --needed "$1" ;;
	esac
}

want=""
if [ -n "$manager" ]; then
	for p in $pkgs $fallback; do
		installed "$p" || want="$want $p"
	done
else
	want="$pkgs $fallback"
fi
want="${want# }"

skipped="" # 깔지 못한 패키지
if [ -z "$want" ]; then
	:
elif [ -z "$manager" ]; then
	log "지원하는 패키지 매니저(apt, apk, dnf, pacman)가 없다"
	skipped="$want"
elif ! can_root; then
	log "root 가 아니고 sudo 도 쓸 수 없다"
	skipped="$want"
else
	# 패키지 목록 갱신은 깔 것이 있을 때만 한다 (없으면 네트워크를 쓰지 않는다)
	case "$manager" in
	apt) as_root env DEBIAN_FRONTEND=noninteractive apt-get update >/dev/null 2>&1 || true ;;
	pacman) as_root pacman -Sy --noconfirm >/dev/null 2>&1 || true ;;
	esac
	# 하나씩 깐다. 이 배포판에 없는 이름 하나 때문에 나머지가 같이 빠지지 않게 한다
	for p in $want; do
		if install_pkg "$p" >"$out" 2>&1; then
			log "$p: $manager 로 설치"
		else
			log "$p: $manager 로 깔지 못했다: $(grep -v '^[[:space:]]*$' "$out" | tail -n 1)"
			skipped="$skipped $p"
		fi
	done
fi

# ---- 결과 ----
missing=""
while read -r bin rest; do
	[ -n "$bin" ] || continue
	has "$bin" || missing="$missing $bin"
done <<EOF
$tools
EOF

skipped="${skipped# }"
[ -z "$skipped" ] || log "깔지 못한 패키지: $skipped (직접 깔거나 없이 쓴다)"
[ -z "$missing" ] || log "없는 필수 도구:$missing (설정 파일은 그대로 쓸 수 있다. 그 도구를 쓰는 기능만 빠진다)"
if [ -n "$failed" ]; then
	log "받기에 실패한 도구:$failed. chezmoi apply 를 다시 실행하면 이 스크립트가 다시 돈다"
	exit 1
fi
log "끝"
{{ end -}}
