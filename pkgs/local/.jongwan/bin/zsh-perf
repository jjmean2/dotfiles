#!/usr/bin/env zsh

emulate -L zsh
setopt no_unset

# --- defaults -----------------------------------------------------------------

typeset subcmd=run bare=1

# zsh invocation (run, record)
typeset login=0 interactive=0
typeset zsh_command="" has_command=0
typeset output_file=""

# report
typeset report_file=""
typeset min_elapsed=0.5
typeset sort_mode=exec top=0
typeset truncate_enabled=1 truncate_length=80
typeset time_format=human
typeset color_mode=auto
typeset warn_threshold=2 crit_threshold=10

# --- help / errors ------------------------------------------------------------

usage() {
	cat <<'EOF'
Usage:
  zsh-perf [options]                    Same as: zsh-perf run -c exit [options]
  zsh-perf run [options]                Record a zsh run, then report it
  zsh-perf record -o FILE [options]     Record the xtrace of a zsh run to FILE
  zsh-perf report [FILE] [options]      Report a recorded trace (FILE or stdin)

Measures how long each command traced by zsh's xtrace takes.

Zsh options (run, record):
  -l, --login                Start zsh as a login shell
  -i, --interactive          Start zsh as an interactive shell
  -c, --command CMD          Run CMD in zsh and exit. Without -c, zsh stays open
                             and everything you run is recorded until you exit.

Recording (record):
  -o, --output FILE          Write the trace to FILE

Interactive sessions (no -c) record every command you run. To leave out the time
spent waiting at the prompt, add this line at the end of your .zshrc:
  [[ -n ${ZSH_PERF_HOOK-} ]] && source "$ZSH_PERF_HOOK"

Filtering (run, report; default: min-elapsed 0.5):
  -m, --min-elapsed MS       Only show steps taking at least MS ms
                                Use 0 to include every command, no exclusion

Sort order (run, report; default: exec):
  -s, --sort MODE            exec, asc, or desc
                                exec: zsh's own execution order (no --top);
                                      steps with no measurable time show "-"
                                asc/desc: sort by elapsed time
  -n, --top N                Show only the top N rows (asc/desc only)

Command truncation (run, report; default: truncate 80):
  -t, --truncate LENGTH      Truncate commands longer than LENGTH
      --no-truncate          Do not truncate commands

Time display (run, report; default: human):
  -f, --time-format MODE     human (aligned, with unit) or raw (bare number)

Color (run, report; default: auto):
  -C, --color MODE           auto, always, or none
  -w, --warn-threshold MS    Elapsed time (ms) at which color turns yellow (default: 2)
  -r, --crit-threshold MS    Elapsed time (ms) at which color turns red (default: 10)

  -h, --help                 Show this help

Short options may be combined, e.g. -li, -sn desc, -t40.
EOF
}

die() {
	print -u2 "zsh-perf: $*"
	print -u2 "Try 'zsh-perf --help' for usage."
	exit 2
}

is_nonnegative_integer() { [[ $1 =~ '^[0-9]+$' ]]; }
is_positive_integer() { [[ $1 =~ '^[1-9][0-9]*$' ]]; }
is_nonnegative_number() { [[ $1 =~ '^[0-9]+(\.[0-9]+)?$' ]]; }

# --- option table -------------------------------------------------------------

typeset -A option_kind=(
	login flag interactive flag no-truncate flag help flag
	command value output value min-elapsed value sort value top value
	truncate value time-format value color value
	warn-threshold value crit-threshold value
)

typeset -A short_option=(
	l login i interactive h help
	c command o output m min-elapsed s sort n top
	t truncate f time-format C color w warn-threshold r crit-threshold
)

typeset -a shell_options=(login interactive command)
typeset -a report_options=(min-elapsed sort top truncate no-truncate time-format color warn-threshold crit-threshold)

typeset -A allowed_options=(
	run "$shell_options $report_options"
	record "$shell_options output"
	report "$report_options"
)

typeset -a given_options=() positionals=()

apply_option() {
	local name=$1 value=${2-}
	case $name in
	help)
		usage
		exit 0
		;;
	login) login=1 ;;
	interactive) interactive=1 ;;
	command)
		zsh_command=$value
		has_command=1
		;;
	output) output_file=$value ;;
	min-elapsed) min_elapsed=$value ;;
	sort) sort_mode=$value ;;
	top) top=$value ;;
	truncate)
		truncate_length=$value
		truncate_enabled=1
		;;
	no-truncate) truncate_enabled=0 ;;
	time-format) time_format=$value ;;
	color) color_mode=$value ;;
	warn-threshold) warn_threshold=$value ;;
	crit-threshold) crit_threshold=$value ;;
	esac
	given_options+=("$name")
}

# --- argument parsing ---------------------------------------------------------

case ${1-} in
run | record | report)
	subcmd=$1
	bare=0
	shift
	;;
esac

while (($#)); do
	arg=$1
	shift
	case $arg in
	--)
		positionals+=("$@")
		break
		;;
	--*=*)
		name=${${arg%%=*}#--}
		case ${option_kind[$name]-} in
		value) apply_option "$name" "${arg#*=}" ;;
		flag) die "option --$name does not take a value" ;;
		*) die "unknown option: --$name" ;;
		esac
		;;
	--*)
		name=${arg#--}
		case ${option_kind[$name]-} in
		flag) apply_option "$name" ;;
		value)
			(($# >= 1)) || die "missing value for $arg"
			apply_option "$name" "$1"
			shift
			;;
		*) die "unknown option: $arg" ;;
		esac
		;;
	-?*)
		rest=${arg#-}
		while [[ -n $rest ]]; do
			letter=${rest[1]}
			rest=${rest:1}
			name=${short_option[$letter]-}
			[[ -n $name ]] || die "unknown option: -$letter"
			if [[ ${option_kind[$name]} == flag ]]; then
				apply_option "$name"
			else
				if [[ -n $rest ]]; then
					value=$rest
					rest=""
				else
					(($# >= 1)) || die "missing value for -$letter"
					value=$1
					shift
				fi
				apply_option "$name" "$value"
			fi
		done
		;;
	*) positionals+=("$arg") ;;
	esac
done

# --- validation ---------------------------------------------------------------

for name in $given_options; do
	[[ " ${allowed_options[$subcmd]} " == *" $name "* ]] || die "--$name is not valid for '$subcmd'"
done

if [[ $subcmd == report ]]; then
	((${#positionals} <= 1)) || die "unexpected argument: ${positionals[2]}"
	report_file=${positionals[1]-}
else
	((${#positionals} == 0)) || die "unexpected argument: ${positionals[1]}"
fi

[[ $subcmd != record || -n $output_file ]] || die "record requires -o FILE"

if ((bare && !has_command)); then
	zsh_command=exit
	has_command=1
fi

[[ $sort_mode == (exec|asc|desc) ]] || die "sort must be exec, asc, or desc"
[[ $time_format == (human|raw) ]] || die "time-format must be human or raw"
[[ $color_mode == (auto|always|none) ]] || die "color must be auto, always, or none"
is_positive_integer "$truncate_length" || die "truncate length must be a positive integer"
is_nonnegative_integer "$top" || die "top must be a non-negative integer"
is_nonnegative_number "$warn_threshold" || die "warn-threshold must be a non-negative number"
is_nonnegative_number "$crit_threshold" || die "crit-threshold must be a non-negative number"
is_nonnegative_number "$min_elapsed" || die "min-elapsed must be a non-negative number"
((warn_threshold < crit_threshold)) || die "warn-threshold must be less than crit-threshold"
[[ $sort_mode == exec && $top -gt 0 ]] && die "--top is only valid with --sort asc|desc"

typeset use_color=0
if [[ $color_mode == always || ($color_mode == auto && -t 1) ]]; then
	use_color=1
fi

# --- record -------------------------------------------------------------------

typeset trace_file="" hook_file=""

cleanup() {
	[[ -z $trace_file ]] || rm -f "$trace_file"
	[[ -z $hook_file ]] || rm -f "$hook_file"
}

make_temp() {
	local dir=${TMPDIR:-/tmp}
	mktemp "${dir%/}/$1.XXXXXX" || die "cannot create temporary file"
}

# Sourced by the recorded interactive shell (from .zshrc, via $ZSH_PERF_HOOK).
# It writes marker lines into the xtrace stream (stderr) so the report knows
# where each command starts and ends and can drop the time spent at the prompt.
# The marker functions come first/last in the hook arrays so that the user's
# own preexec/precmd hooks are counted as part of the command/prompt.
hook_source() {
	cat <<'EOF'
__zsh_perf_mark() {
	setopt local_options no_xtrace
	local ts
	print -Pv ts '%D{%s%6.}'
	print -ru2 -- "@zsh-perf $1 $ts${2:+ $2}"
}
__zsh_perf_preexec() { __zsh_perf_mark cmd-start "${1//$'\n'/ }"; }
__zsh_perf_precmd_first() { __zsh_perf_mark cmd-end; }
__zsh_perf_precmd_last() { __zsh_perf_mark idle-start; }
if [[ -z ${preexec_functions[(r)__zsh_perf_preexec]-} ]]; then
	preexec_functions=(__zsh_perf_preexec ${preexec_functions[@]})
	precmd_functions=(__zsh_perf_precmd_first ${precmd_functions[@]} __zsh_perf_precmd_last)
fi
EOF
}

# Runs zsh with xtrace on and writes the trace (zsh's stderr) to $1.
record_trace() {
	setopt local_traps
	local output=$1
	local -a zsh_args=(-x)
	((login)) && zsh_args+=(-l)
	((interactive)) && zsh_args+=(-i)
	((has_command)) && zsh_args+=(-c "$zsh_command")

	if ((!has_command)); then
		print -u2 "zsh-perf: recording to $output; exit the shell to finish"
		hook_file=$(make_temp zsh-perf-hook) || exit 2
		hook_source >"$hook_file"
		# An interactive session gets its own Ctrl-C; this wrapper must outlive it.
		trap : INT
	fi

	ZSH_PERF_HOOK=$hook_file PS4='+%D{%s%6.} %N:%i> ' zsh "${zsh_args[@]}" 2>"$output"

	if ((!has_command)) && ! grep -q '^@zsh-perf ' "$output"; then
		print -u2 "zsh-perf: no prompt markers recorded, so time spent waiting at the prompt is included."
		print -u2 "zsh-perf: add this line at the end of your .zshrc:"
		print -u2 '  [[ -n ${ZSH_PERF_HOOK-} ]] && source "$ZSH_PERF_HOOK"'
	fi
}

# --- report -------------------------------------------------------------------

# Reads the raw xtrace log and emits one TSV record per step: elapsed_ms
# (or "-" when unknown), sequence, file, line, command. Elapsed time is the
# gap to the *next* event, so a step's time is what happens until the shell
# moves on. Steps whose time cannot be measured are listed as "-" (exec order
# only, since they cannot be ranked by time): the very last command, which
# has no next event, and the stale lines described below.
#
# Assignments like x=$(cmd), (( )) and [[ ]] make zsh print "PS4 x=", run the
# substitution (whose own trace lands on the same physical line), and later
# print the finished "PS4 x=value" again with the *original* timestamp. So:
#   - a second PS4 prefix inside a line (timestamp not older than the line's
#     own) starts a new step; the text before it is a step of its own
#   - a step whose timestamp is older than the latest one seen is such a
#     repeat: it is shown as "-" and does not take part in any timing
#
# Interactive sessions also contain marker lines written by the hook
# (see hook_source): "@zsh-perf cmd-end|idle-start|cmd-start TS [TEXT]".
# They end the step in flight, and everything between idle-start and the next
# cmd-start (waiting at the prompt, line-editor widgets) is dropped so that
# the user's thinking time is never charged to a step.
parse_trace() {
	local trace_file=$1
	awk -v min_elapsed="$min_elapsed" -v sort_mode="$sort_mode" '
    function emit(ms_field, seq, raw_line,    rest, sep, location, command, colon, file, line) {
      rest = raw_line
      sub(/^\+[^ ]+ /, "", rest)

      sep = index(rest, ">")
      if (sep > 0) {
        location = substr(rest, 1, sep - 1)
        command = substr(rest, sep + 1)
        sub(/^ /, "", command)
      } else {
        location = rest
        command = ""
      }

      colon = match(location, /:[0-9]+$/)
      if (colon > 0) {
        file = substr(location, 1, colon - 1)
        line = substr(location, colon + 1)
      } else {
        file = location
        line = ""
      }

      printf "%s\t%d\t%s\t%s\t%s\n", ms_field, seq, file, line, command
    }

    function timestamp_of(text) {
      match(text, /^\+[0-9]+/)
      return substr(text, 2, RLENGTH - 1) + 0
    }

    # Splits one physical line at every embedded PS4 prefix that is not older
    # than the line'"'"'s own timestamp (older ones are quoted text, not prefixes).
    function split_line(raw, parts,    n, offset, from, pos, first_ts) {
      split("", parts)
      n = 0
      offset = 1
      from = 2
      first_ts = timestamp_of(raw)
      while (match(substr(raw, from), /\+[0-9]+ [^>]+:[0-9]+> /)) {
        pos = from + RSTART - 1
        if (timestamp_of(substr(raw, pos)) >= first_ts) {
          parts[++n] = substr(raw, offset, pos - offset)
          offset = pos
        }
        from = pos + 1
      }
      parts[++n] = substr(raw, offset)
      return n
    }

    function flush(end_timestamp,    elapsed_ms) {
      if (!have_previous)
        return
      elapsed_ms = (end_timestamp - previous_timestamp) / 1000
      if (elapsed_ms >= min_elapsed)
        emit(sprintf("%.3f", elapsed_ms), previous_seq, previous_line)
      have_previous = 0
    }

    function process(step,    ts, seq) {
      ts = timestamp_of(step)
      seq = arrivals++
      if (ts < last_seen) {
        if (sort_mode == "exec")
          emit("-", seq, step)
        return
      }
      last_seen = ts
      flush(ts)
      previous_timestamp = ts
      previous_line = step
      previous_seq = seq
      have_previous = 1
    }

    /^@zsh-perf / {
      flush($3)
      if ($3 + 0 > last_seen)
        last_seen = $3 + 0
      in_idle = ($2 == "idle-start")
      next
    }

    /^\+[0-9]/ {
      if (in_idle)
        next
      count = split_line($0, parts)
      for (i = 1; i <= count; i++)
        if (parts[i] !~ /^\+[0-9]+ __zsh_perf_/)
          process(parts[i])
    }

    END {
      if (have_previous && sort_mode == "exec")
        emit("-", previous_seq, previous_line)
    }
  ' "$trace_file"
}

sort_records() {
	case $sort_mode in
	exec) LC_ALL=C sort -t $'\t' -k2,2n ;;
	asc) LC_ALL=C sort -t $'\t' -k1,1n -k2,2n ;;
	desc) LC_ALL=C sort -t $'\t' -k1,1nr -k2,2n ;;
	esac
}

limit_top() {
	if [[ $sort_mode != exec ]] && ((top > 0)); then
		head -n "$top"
	else
		cat
	fi
}

format_output() {
	awk -F '\t' \
		-v do_truncate="$truncate_enabled" \
		-v max_length="$truncate_length" \
		-v time_format="$time_format" \
		-v use_color="$use_color" \
		-v warn_threshold="$warn_threshold" \
		-v crit_threshold="$crit_threshold" '
    BEGIN {
      RED = "\033[1;31m"; YELLOW = "\033[1;33m"; GREEN = "\033[0;32m"
      CYAN = "\033[0;36m"; MAGENTA = "\033[0;35m"; DIM = "\033[2m"; RESET = "\033[0m"
      # Width of "%8.3f ms", so an unknown "-" duration still lines up.
      HUMAN_TIME_WIDTH = 11
    }
    {
      unknown = ($1 == "-")
      file = $3
      line = $4
      command = $5

      if (do_truncate && length(command) > max_length) {
        command = (max_length > 3) \
          ? substr(command, 1, max_length - 3) "..." \
          : substr(command, 1, max_length)
      }

      if (unknown) {
        time_str = (time_format == "human") ? sprintf("%*s", HUMAN_TIME_WIDTH, "-") : "-"
      } else {
        ms = $1 + 0
        time_str = (time_format == "human") ? sprintf("%8.3f ms", ms) : sprintf("%.3f", ms)
      }

      if (use_color) {
        if (unknown) time_colored = time_str
        else {
          if (ms >= crit_threshold) time_color = RED
          else if (ms >= warn_threshold) time_color = YELLOW
          else time_color = GREEN
          time_colored = time_color time_str RESET
        }

        printf "%s  %s%s%s:%s%s%s  %s%s%s\n", \
          time_colored, \
          CYAN, file, RESET, MAGENTA, line, RESET, \
          DIM, command, RESET
      } else {
        printf "%s  %s:%s  %s\n", time_str, file, line, command
      }
    }
  '
}

report_trace() {
	parse_trace "$1" | sort_records | limit_top | format_output
}

# --- main ---------------------------------------------------------------------

trap cleanup EXIT
trap 'exit 1' INT HUP TERM

case $subcmd in
record)
	record_trace "$output_file"
	;;
report)
	if [[ -z $report_file ]]; then
		[[ ! -t 0 ]] || die "report needs a trace FILE or piped input"
		report_file=-
	fi
	[[ $report_file == - || -r $report_file ]] || die "cannot read trace file: $report_file"
	report_trace "$report_file"
	;;
run)
	trace_file=$(make_temp zsh-perf) || exit 2
	record_trace "$trace_file"
	report_trace "$trace_file"
	;;
esac
