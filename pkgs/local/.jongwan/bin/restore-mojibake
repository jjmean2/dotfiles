#!/usr/bin/env python3
import sys


def restore_mojibake():
    try:
        # 1. STDIN에서 UTF-8로 오염된 원시 바이트 스트림 읽기
        corrupted_bytes = sys.stdin.buffer.read()

        if not corrupted_bytes:
            return

        # 2. UTF-8 문자열로 디코딩 후 Latin-1 바이트로 재인코딩 (0xC2 0x8B -> 0x8B 복원)
        restored_gzip_bytes = corrupted_bytes.decode("utf-8").encode("latin-1")

        # 3. 복원된 Gzip 바이트를 STDOUT으로 출력
        sys.stdout.buffer.write(restored_gzip_bytes)
        sys.stdout.buffer.flush()

    except UnicodeDecodeError as e:
        sys.stderr.write(
            f"[Error] 유효하지 않은 UTF-8 시퀀스가 포함되어 있습니다: {e}\n"
        )
        sys.exit(1)
    except UnicodeEncodeError as e:
        sys.stderr.write(
            f"[Error] Latin-1 범위를 초과하는 유니코드 문자가 있습니다: {e}\n"
        )
        sys.exit(1)


if __name__ == "__main__":
    restore_mojibake()
